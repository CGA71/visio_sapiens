########################################################################
# Visio Sapiens — HOME Dashboard (main dashboard, two views)
#
# EN | *** GENERATED FILE — DO NOT EDIT BY HAND ***
# EN | Source: home.yaml.j2 + model/house.yaml + locales/<code>.yaml
# EN | Regenerate with: python3 generate_dashboards.py
# FR | *** FICHIER GENERE — NE PAS EDITER A LA MAIN ***
# FR | Source : home.yaml.j2 + model/house.yaml + locales/<code>.yaml
# FR | Regenerer avec : python3 generate_dashboards.py
#
# EN | ONE view: /visio-sapiens/home — HUD, KPI row, central video, energy,
# EN | events. The admin console used to be a second view here; it now lives
# EN | in admin.yaml.j2 as its own dashboard.
# FR | UNE vue : /visio-sapiens/home — HUD, ligne KPI, video centrale,
# FR | energie, evenements. La console d administration etait une seconde vue
# FR | ici ; elle vit desormais dans admin.yaml.j2, comme son propre dashboard.
#
# EN | TWO FIXES APPLIED WHILE TEMPLATING — read before comparing with the
# EN | previous hand-written file:
# EN |   1. The weather card and the clock card were indented INSIDE the ad
# EN |      banner's `ads:` list. They were passed as advertisement entries
# EN |      instead of being cards, so neither ever rendered, and grid areas
# EN |      header3..header6 stayed empty. Both are restored through the
# EN |      shared _header.j2 partial.
# EN |   2. The header row is now a single `header` area spanning the width
# EN |      (title + weather + clock), instead of six one-cell areas of which
# EN |      four were unused.
# EN |   3. The scrolling ad banner is gone, along with its grid area and its
# EN |      osv-ad-banner-card.js resource. It only ever existed on the tablet
# EN |      view.
# FR | DEUX CORRECTIONS APPLIQUEES A LA TEMPLATISATION — a lire avant de
# FR | comparer avec l'ancien fichier ecrit a la main :
# FR |   1. La carte meteo et la carte heure etaient indentees A L'INTERIEUR
# FR |      de la liste `ads:` du bandeau publicitaire. Elles etaient passees
# FR |      comme entrees de publicite au lieu d'etre des cartes, donc
# FR |      aucune des deux ne s'affichait, et les zones header3..header6
# FR |      restaient vides. Les deux sont retablies via le partial partage
# FR |      _header.j2.
# FR |   2. La ligne d'en-tete est desormais une seule zone `header` sur
# FR |      toute la largeur (titre + meteo + heure), au lieu de six zones
# FR |      d'une cellule dont quatre inutilisees.
# FR |   3. Le bandeau publicitaire defilant est supprime, avec sa zone de
# FR |      grille et sa ressource osv-ad-banner-card.js. Il n'a jamais
# FR |      existe que sur la vue tablette.
#
# EN | Lovelace dependencies (HACS + declared in resources):
# FR | Dependances Lovelace (HACS + declarees dans resources) :
#   button-card, card-mod, layout-card, custom:stack-in-card,
#   apexcharts-card, config-template-card, decluttering-card, browser_mod
########################################################################

title: {{ house.name | title }}
path: visio-sapiens
theme: {{ house.theme }}

# EN | Paths relative to dashboards/views/, where every generated dashboard
# EN | now lives. The hand-written home.yaml sat one level up, in
# EN | dashboards/, and used `templates/...`; keeping all outputs in one
# EN | directory means one include convention instead of two.
# FR | Chemins relatifs a dashboards/views/, ou vivent desormais tous les
# FR | dashboards generes. Le home.yaml ecrit a la main etait un niveau
# FR | au-dessus, dans dashboards/, et utilisait `templates/...` ; regrouper
# FR | toutes les sorties dans un seul repertoire donne une seule convention
# FR | d'include au lieu de deux.
button_card_templates: !include ../templates/button_card_templates.yaml
decluttering_templates: !include ../templates/decluttering_templates.yaml

views:
  # =====================================================================
  # EN | HOME — the hub / FR | HOME — le hub
  # =====================================================================
  - title: {{ t('page.home.name') }}
    path: home
    subview: true
    type: custom:grid-layout
    layout:
      grid-template-columns: minmax(200px, auto) minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1fr) 565px
      grid-template-rows: 105px 113px 444px 400px
      grid-template-areas: |
        "nav header header header header header header"
        "nav kpi1 kpi2 kpi3 kpi4 kpi5 kpi5"
        "nav floor floor floor floor floor right"
        "nav egy1 egy1 egy2 events events meteo"
      margin: 12px
      grid-gap: 14px 14px
    cards:
      # ═══════════════════════════════════════════════════════════════
      # EN | HEADER BAND — shared partial (title / weather / clock)
      # FR | BANDEAU HORIZONTAL — partial partage (titre / meteo / heure)
      # ═══════════════════════════════════════════════════════════════
{% set page_title = t('page.home.name') %}
{% set page_subtitle = t('page.home.subtitle') %}
{% set page_path = '/visio-sapiens/home' %}
{% include '_header.j2' %}

      # ═══════════════════════════════════════════════════════════════
      # EN | NAVIGATION RAIL — shared partial, dynamic
      # FR | BANDEAU DE NAVIGATION — partial partage, dynamique
      # ═══════════════════════════════════════════════════════════════
{% include '_nav.j2' %}

      # --- KPI row (System Status / Energy Status / Pièces actives / Connexions / Sécurité) ----
      - type: horizontal-stack
        view_layout:
          grid-area: kpi1
          grid-column: kpi1 / kpi5
        cards:
          # Case 1 — System Status : vert nominal / orange dégradé / rouge
          # critique, seuils 70 % / 90 %.
          #
          # EN | Was `template: vssp_status_indicator` + entity:
          # EN | sensor.vssp_core_health, itself reading
          # EN | sensor.processor_use / sensor.memory_use_percent — the
          # EN | default entity ids of HA's own systemmonitor integration,
          # EN | which this install does not have configured, so both always
          # EN | resolved to "unknown". core.html (this project's own CORE
          # EN | dashboard) never assumes a fixed entity id for this exact
          # EN | reason: it keyword-searches every state for something that
          # EN | looks like a CPU/RAM sensor. Same technique here, inlined
          # EN | (button-card's [[[ ]]] blocks cannot share a JS function),
          # EN | so this card lights up on whatever monitoring integration
          # EN | is actually installed instead of one specific one.
          # FR | Etait `template: vssp_status_indicator` + entity:
          # FR | sensor.vssp_core_health, qui lisait elle-meme
          # FR | sensor.processor_use / sensor.memory_use_percent — les
          # FR | identifiants par defaut de l'integration systemmonitor de
          # FR | HA, que cette installation n'a pas configuree, donc les deux
          # FR | valaient toujours "unknown". core.html (le propre dashboard
          # FR | CORE de ce projet) ne suppose jamais un identifiant fixe
          # FR | pour cette meme raison : il cherche par mot-cle dans tous
          # FR | les etats ce qui ressemble a un capteur CPU/RAM. Meme
          # FR | technique ici, en ligne (les blocs [[[ ]]] de button-card ne
          # FR | peuvent pas partager une fonction JS), pour que cette carte
          # FR | s'allume avec l'integration de supervision reellement
          # FR | installee plutot qu'une seule en particulier.
          - type: custom:button-card
            icon: mdi:circle
            show_state: false
            show_label: true
            name: "{{ t('home.kpi.system_status') }}"
            label: >
              [[[
                const norm = s => (s || '').toLowerCase();
                const find = (keys, exclude) => Object.values(states).find(e => {
                  const c = norm(e.entity_id) + ' ' + norm(e.attributes.friendly_name);
                  return keys.every(k => c.includes(k)) && !(exclude || []).some(x => c.includes(x));
                });
                const cpu = find(['cpu', 'use'], ['core', 'temp']) || find(['processor_use']);
                const ram = find(['ram', 'use'], ['swap']) || find(['memory_use_percent']);
                if (!cpu && !ram) return "{{ t('home.kpi.system_status_hint') }}";
                const c = cpu ? Math.round(parseFloat(cpu.state)) + '%' : '—';
                const r = ram ? Math.round(parseFloat(ram.state)) + '%' : '—';
                return 'CPU ' + c + ' · RAM ' + r;
              ]]]
            styles:
              grid:
                - grid-template-areas: '"n" "i" "l"'
                - grid-template-rows: min-content min-content min-content
                - row-gap: 10px
                - justify-items: start
              card:
                - background: rgba(8,18,28,0.72)
                - border-radius: 18px
                - border: 1px solid rgba(0,229,255,0.20)
                - padding: 14px 18px
                - height: 100%
              name:
                - color: "#FFFFFF"
                - font-size: 13px
                - font-weight: 700
                - letter-spacing: 0.5px
                - justify-self: start
              icon:
                - color: >
                    [[[
                      const norm = s => (s || '').toLowerCase();
                      const find = (keys, exclude) => Object.values(states).find(e => {
                        const c = norm(e.entity_id) + ' ' + norm(e.attributes.friendly_name);
                        return keys.every(k => c.includes(k)) && !(exclude || []).some(x => c.includes(x));
                      });
                      const cpu = find(['cpu', 'use'], ['core', 'temp']) || find(['processor_use']);
                      const ram = find(['ram', 'use'], ['swap']) || find(['memory_use_percent']);
                      if (!cpu && !ram) return "#56707E";
                      const v = Math.max(cpu ? parseFloat(cpu.state) : 0, ram ? parseFloat(ram.state) : 0);
                      if (v >= 90) return "#FF3D71";
                      if (v >= 70) return "#FFA726";
                      return "#00FFC3";
                    ]]]
                - "--mdc-icon-size": 20px
                - justify-self: start
                - filter: >
                    [[[
                      const norm = s => (s || '').toLowerCase();
                      const find = (keys, exclude) => Object.values(states).find(e => {
                        const c = norm(e.entity_id) + ' ' + norm(e.attributes.friendly_name);
                        return keys.every(k => c.includes(k)) && !(exclude || []).some(x => c.includes(x));
                      });
                      const cpu = find(['cpu', 'use'], ['core', 'temp']) || find(['processor_use']);
                      const ram = find(['ram', 'use'], ['swap']) || find(['memory_use_percent']);
                      if (!cpu && !ram) return "none";
                      const v = Math.max(cpu ? parseFloat(cpu.state) : 0, ram ? parseFloat(ram.state) : 0);
                      if (v >= 90) return "drop-shadow(0 0 8px rgba(255,61,113,.6))";
                      if (v >= 70) return "drop-shadow(0 0 8px rgba(255,167,38,.6))";
                      return "drop-shadow(0 0 8px rgba(0,255,195,.6))";
                    ]]]
              label:
                - color: "#56707E"
                - font-size: 11px
                - justify-self: start

          # Case 2 — Energy Status : vert si production >= consommation,
          # orange si on couvre au moins la moitie, rouge sinon.
          #
          # EN | Was `template: vssp_status_indicator` + entity:
          # EN | binary_sensor.vssp_energy_health, itself comparing
          # EN | sensor.solar_power_production (no such sensor exists on
          # EN | this install — every other view in this project already
          # EN | marks it `# TODO`) against sensor.home_power_consumption
          # EN | (real). No production reading defaulted to 0, so this read
          # EN | "off"/red at all times the house drew any power — always,
          # EN | in practice — which looks broken even though it was
          # EN | technically doing what it was told. energy.solar.power is
          # EN | tried first in case a real inverter integration gets added
          # EN | later; failing that, same keyword search as System Status
          # EN | above for anything that looks like a solar power sensor;
          # EN | failing THAT, the card reads neutral/grey instead of a false
          # EN | "critical" — same spirit as the Sécurité card's
          # EN | "non configuré", never a red alert for a metric nobody wired
          # EN | up yet.
          # FR | Etait `template: vssp_status_indicator` + entity:
          # FR | binary_sensor.vssp_energy_health, qui comparait elle-meme
          # FR | sensor.solar_power_production (aucun capteur de ce nom
          # FR | n'existe sur cette installation — tout le reste de ce projet
          # FR | le marque deja `# TODO`) a sensor.home_power_consumption
          # FR | (reel). Sans lecture de production, retombee sur 0, donc
          # FR | lecture "off"/rouge des que la maison tirait la moindre
          # FR | puissance — en pratique tout le temps — ce qui a l'air
          # FR | casse meme si techniquement conforme a ce qu'on lui
          # FR | demandait. energy.solar.power est tente en premier au cas ou
          # FR | une vraie integration onduleur serait ajoutee plus tard ;
          # FR | a defaut, meme recherche par mot-cle que System Status
          # FR | ci-dessus pour tout ce qui ressemble a un capteur de
          # FR | puissance solaire ; a defaut encore, la carte reste
          # FR | neutre/grise plutot qu'un faux "critique" — meme esprit que
          # FR | le "non configuré" de la carte Sécurité, jamais d'alerte
          # FR | rouge pour une metrique que personne n'a encore branchee.
          - type: custom:button-card
            icon: mdi:circle
            show_state: false
            show_label: true
            name: "{{ t('home.kpi.energy_status') }}"
            label: >
              [[[
                const cons = states['{{ energy.totals.power }}'];
                let prod = states['{{ energy.solar.power }}'];
                if (!prod || isNaN(parseFloat(prod.state))) {
                  const norm = s => (s || '').toLowerCase();
                  prod = Object.values(states).find(e => {
                    const c = norm(e.entity_id) + ' ' + norm(e.attributes.friendly_name);
                    return c.includes('solar') && c.includes('power')
                      && !c.includes('today') && !c.includes('month') && !c.includes('year');
                  });
                }
                if (!prod || isNaN(parseFloat(prod.state))) return "{{ t('home.kpi.energy_status_hint') }}";
                const p = Math.round(parseFloat(prod.state));
                const c = cons && !isNaN(parseFloat(cons.state)) ? Math.round(parseFloat(cons.state)) : '—';
                return p + 'W · ' + c + 'W';
              ]]]
            styles:
              grid:
                - grid-template-areas: '"n" "i" "l"'
                - grid-template-rows: min-content min-content min-content
                - row-gap: 10px
                - justify-items: start
              card:
                - background: rgba(8,18,28,0.72)
                - border-radius: 18px
                - border: 1px solid rgba(0,229,255,0.20)
                - padding: 14px 18px
                - height: 100%
              name:
                - color: "#FFFFFF"
                - font-size: 13px
                - font-weight: 700
                - letter-spacing: 0.5px
                - justify-self: start
              icon:
                - color: >
                    [[[
                      const cons = states['{{ energy.totals.power }}'];
                      let prod = states['{{ energy.solar.power }}'];
                      if (!prod || isNaN(parseFloat(prod.state))) {
                        const norm = s => (s || '').toLowerCase();
                        prod = Object.values(states).find(e => {
                          const c = norm(e.entity_id) + ' ' + norm(e.attributes.friendly_name);
                          return c.includes('solar') && c.includes('power')
                            && !c.includes('today') && !c.includes('month') && !c.includes('year');
                        });
                      }
                      if (!prod || isNaN(parseFloat(prod.state))) return "#56707E";
                      const p = parseFloat(prod.state);
                      const c = cons && !isNaN(parseFloat(cons.state)) ? parseFloat(cons.state) : 0;
                      if (p >= c) return "#00FFC3";
                      if (c > 0 && p / c >= 0.5) return "#FFA726";
                      return "#FF3D71";
                    ]]]
                - "--mdc-icon-size": 20px
                - justify-self: start
                - filter: >
                    [[[
                      const cons = states['{{ energy.totals.power }}'];
                      let prod = states['{{ energy.solar.power }}'];
                      if (!prod || isNaN(parseFloat(prod.state))) {
                        const norm = s => (s || '').toLowerCase();
                        prod = Object.values(states).find(e => {
                          const c = norm(e.entity_id) + ' ' + norm(e.attributes.friendly_name);
                          return c.includes('solar') && c.includes('power')
                            && !c.includes('today') && !c.includes('month') && !c.includes('year');
                        });
                      }
                      if (!prod || isNaN(parseFloat(prod.state))) return "none";
                      const p = parseFloat(prod.state);
                      const c = cons && !isNaN(parseFloat(cons.state)) ? parseFloat(cons.state) : 0;
                      if (p >= c) return "drop-shadow(0 0 8px rgba(0,255,195,.6))";
                      if (c > 0 && p / c >= 0.5) return "drop-shadow(0 0 8px rgba(255,167,38,.6))";
                      return "drop-shadow(0 0 8px rgba(255,61,113,.6))";
                    ]]]
              label:
                - color: "#56707E"
                - font-size: 11px
                - justify-self: start

          # Case 3 — Pièces actives
          #
          # EN | sensor.vssp_pieces_actives (packages/vssp_home_status.yaml)
          # EN | counted with area_entities()/areas(), which only sees what
          # EN | Home Assistant's own Area registry has entities filed under.
          # EN | This project's room↔device mapping is a SEPARATE concept —
          # EN | model/house.yaml `rooms[].slots`, written by the discovery
          # EN | scan (vssp_discovery.py) and the assignment step
          # EN | (vssp_assign_apply.py) — and never touches the HA Area
          # EN | registry, so area_entities() reported ~0 regardless of what
          # EN | was actually on. vssp_discovery.py's own UNASSIGNED_DOMAINS
          # EN | comment documents this exact gap. Fix: bake each room's
          # EN | actually-assigned lights/appliances entity ids in at
          # EN | generate time (rooms_rendered, the SAME source room.yaml.j2
          # EN | uses to draw each room's own panels) and check their live
          # EN | state client-side — no HA-side sensor, no Area registry.
          # FR | sensor.vssp_pieces_actives (packages/vssp_home_status.yaml)
          # FR | comptait avec area_entities()/areas(), qui ne voit que ce
          # FR | que le registre de Zones de Home Assistant a classe. La
          # FR | correspondance piece↔appareil de ce projet est un concept
          # FR | SEPARE — `rooms[].slots` de model/house.yaml, ecrit par le
          # FR | scan de decouverte (vssp_discovery.py) et l'etape
          # FR | d'assignation (vssp_assign_apply.py) — qui ne touche jamais
          # FR | le registre de Zones HA, donc area_entities() rapportait
          # FR | ~0 quel que soit l'etat reel. Le commentaire
          # FR | UNASSIGNED_DOMAINS de vssp_discovery.py documente exactement
          # FR | ce manque. Correctif : figer les entites lights/appliances
          # FR | reellement assignees de chaque piece au moment de la
          # FR | generation (rooms_rendered, la MEME source que room.yaml.j2
          # FR | utilise pour dessiner les tableaux de chaque piece) et
          # FR | verifier leur etat en direct cote client — aucun capteur
          # FR | HA, aucun registre de Zones.
{% set active_rooms_map = [] %}
{% for r in rooms_rendered %}
{% set ns = namespace(ents=[]) %}
{% for slot in r.slots.values() %}
{% if slot.id in ['lights', 'appliances'] %}
{% set ns.ents = ns.ents + slot.entities %}
{% endif %}
{% endfor %}
{% set _ = active_rooms_map.append(ns.ents) %}
{% endfor %}
          - type: custom:button-card
            template: vssp_kpi_card
            icon: mdi:door-open
            name: "{{ t('home.kpi.active_rooms') }}"
            state_display: >
              [[[
                const perRoom = {{ active_rooms_map | tojson }};
                const active = perRoom.filter(ents =>
                  ents.some(e => states[e] && states[e].state === 'on')
                ).length;
                return active + " / " + perRoom.length;
              ]]]
            label: "{{ t('home.kpi.active_rooms_hint') }}"
            variables:
              icon_color: "#3AA7FF"
              value_color: "#3AA7FF"

          # Case 4 — Connexions (total appareils enregistrés dans HA)
          - type: custom:button-card
            template: vssp_kpi_card
            icon: mdi:vector-polygon
            name: "{{ t('home.kpi.connections') }}"
            entity: sensor.vssp_total_appareils
            label: "{{ t('home.kpi.connections_hint') }}"
            variables:
              icon_color: "#B084FF"
              value_color: "#B084FF"

          # Case 5 — Sécurité / Alarme
          - type: custom:button-card
            template: vssp_kpi_card
            icon: mdi:shield-lock
            name: "{{ t('common.security') }}"
            entity: alarm_control_panel.maison  # TODO: remplacer par votre entité alarme
            state_display: >
              [[[
                if (!entity) return '{{ t("home.alarm.not_configured") }}';
                switch (entity.state) {
                  case "disarmed": return '{{ t("home.alarm.ok") }}';
                  case "triggered": return '{{ t("home.alarm.alert") }}';
                  case "armed_home": return '{{ t("home.alarm.armed") }}';
                  case "armed_away": return '{{ t("home.alarm.armed") }}';
                  default: return entity.state;
                }
              ]]]
            label: >
              [[[
                if (!entity) return '{{ t("home.alarm.no_entity") }}';
                return entity.state === "triggered" ? '{{ t("home.alarm.intrusion") }}' : '{{ t("home.alarm.no_alert") }}';
              ]]]
            variables:
              icon_color: "#00FFC3"
              value_color: "#00FFC3"

      # --- Video centrale VISIO SAPIENS (remplace le floorplan) -----------
      # Lecture auto, en boucle, sans son.
      # Fichier a deposer dans : /config/www/vssp/movies/vs-sp.mp4
      - type: custom:button-card
        view_layout:
          grid-area: floor
        show_icon: false
        show_name: false
        show_label: false
        tap_action:
          action: none
        custom_fields:
          video: >
            <video autoplay muted loop playsinline
              style="width:100%;height:100%;object-fit:cover;display:block;">
              <source src="/local/vssp/movies/vs-sp.mp4" type="video/mp4" />
            </video>
        styles:
          card:
            - padding: 0
            - background: transparent
            - border: 1px solid rgba(0,229,255,0.28)
            - box-shadow: 0 0 24px rgba(0,229,255,.12)
            - border-radius: 20px
            - overflow: hidden
            - height: 100%
          grid:
            - grid-template-areas: '"video"'
            - height: 100%
          custom_fields:
            video:
              - height: 100%
              - width: 100%
        card_mod:
          style: |
            :host { height: 100%; }
            ha-card { height: 100% !important; overflow: hidden; border-radius: 20px; }

      # --- egy1 (colonnes 2-3, ligne 4) — laisse volontairement vide -------
      # EN | Used to hold the Top 10 / Production-Consommation panel, moved
      # EN | to the "right" grid area above (see the comment there). The
      # EN | grid-template-areas still names egy1 (kpi1/right/etc. reference
      # EN | the same column indices), so the cell is simply blank for now
      # EN | rather than reflowing the whole row.
      # FR | Contenait le panneau Top 10 / Production-Consommation, deplace
      # FR | vers la zone de grille "right" ci-dessus (voir le commentaire
      # FR | la-bas). grid-template-areas nomme toujours egy1 (kpi1/right/etc.
      # FR | referencent les memes index de colonne), donc la cellule reste
      # FR | simplement vide pour l'instant plutot que de reorganiser toute
      # FR | la ligne.

      # --- Événements récents (aligné avec le bas de la sidebar) --------
      - type: logbook
        title: "{{ t('home.events_recent') }}"
        hours_to_show: 24
        view_layout:
          grid-area: events
        target:
          # EN | Generated from the declared rooms rather than hardcoded. The
          # EN | hand-written list already named areas that no longer match
          # EN | house.yaml (kitchen, garden_1, livingroom...), so the logbook
          # EN | silently dropped events for any room added since.
          # EN | `area_id` defaults to the room id; set it explicitly in
          # EN | house.yaml when the Home Assistant area is named differently.
          # FR | Genere depuis les pieces declarees plutot que code en dur. La
          # FR | liste ecrite a la main nommait deja des zones qui ne
          # FR | correspondent plus a house.yaml (kitchen, garden_1,
          # FR | livingroom...), donc le journal ignorait en silence les
          # FR | evenements de toute piece ajoutee depuis.
          # FR | `area_id` vaut l'id de la piece par defaut ; le definir
          # FR | explicitement dans house.yaml quand la zone Home Assistant
          # FR | porte un autre nom.
          area_id:
{% for r in rooms_rendered %}
            - {{ r.area_id }}
{% endfor %}
        card_mod:
          style: |
            :host {
              height: 100%;
              display: block;
              overflow: hidden;
            }
            ha-card {
              background: var(--osv-panel) !important;
              height: 100% !important;
              min-height: 0;
              display: flex;
              flex-direction: column;
              overflow: hidden;
              --primary-text-color: #B8E8F5 !important;
              --secondary-text-color: #8FB6C9 !important;
              --primary-color: #00E5FF !important;
              --text-primary-color: #FFFFFF !important;
              --card-background-color: var(--osv-panel) !important;
            }
            ha-card .card-header {
              color: #FFFFFF !important;
            }
            ha-logbook {
              flex: 1 1 0;
              min-height: 0;
              overflow-y: auto;
            }

      # --- Météo et prévisions (alignée avec le bas de la sidebar) ------
      - type: custom:dynamic-weather-card
        entity: weather.meteo_france_forecast_for_city_sausset_les_pins_provence_alpes_cote_d_azur_13_fr_sausset_les_pins
        name: Sausset les Pins
        height: 400
        show_feels_like: true
        show_wind: true
        show_wind_gust: true
        show_wind_direction: true
        show_humidity: true
        show_min_temp: true
        show_hourly_forecast: false
        hourly_forecast_hours: 5
        show_daily_forecast: true
        daily_forecast_days: 5
        show_sunrise_sunset: false
        show_clock: false
        clock_position: top
        clock_format: 24h
        overlay_opacity: 0.1
        # EN | Was hardcoded `fr` — the card's own internal UI strings
        # EN | ("Ressenti", weekday names, etc.) never followed the site's
        # EN | locale, French even on an English build. `locale` is the
        # EN | short code from the same catalogue every t() call uses
        # EN | ('fr'/'en'), injected by the generator.
        # FR | Etait code en dur `fr` — les chaines d'interface propres a la
        # FR | carte (« Ressenti », noms de jours, etc.) ne suivaient jamais
        # FR | la langue du site, francaises meme sur une build anglaise.
        # FR | `locale` est le code court venant du meme catalogue que
        # FR | chaque appel t(), injecte par le generateur.
        language: "{{ locale }}"
        wind_speed_unit: ms
        sunrise_entity: ""
        sunset_entity: ""        
        view_layout:
          grid-area: meteo
        card_mod:
          style: |
            :host {
              height: 100%;
              display: block;
              overflow: hidden;
            }
            ha-card {
              background: var(--osv-panel) !important;
              height: 100% !important;
              min-height: 0;
              display: flex;
              flex-direction: column;
              overflow: hidden;
            }

      # --- Colonne de droite : TOP 10 CONSOMMATION, puis PRODUCTION et
      # CONSOMMATION avec leur courbe ---------------------------------------
      # EN | Replaces INTERPHONE / AUDIO STREAM — neither button had a real
      # EN | entity or action behind it. This is the SAME panel that used to
      # EN | sit in the egy1 row below (400px tall, split three ways with
      # EN | egy2/events/meteo), moved here rather than duplicated: this
      # EN | column is 444px tall and does not share its width with
      # EN | anything, so Top 10 (Cadre 1) stacks above Production/
      # EN | Consommation (Cadre 2) instead of sitting side by side. egy1's
      # EN | grid cell is left declared but empty — nothing else claims it
      # EN | yet.
      # FR | Remplace INTERPHONE / AUDIO STREAM — aucun des deux boutons
      # FR | n'avait de vraie entite ou action derriere. C'est le MEME
      # FR | panneau qui occupait la ligne egy1 plus bas (400px de haut,
      # FR | partagee en trois avec egy2/events/meteo), deplace ici plutot
      # FR | que duplique : cette colonne fait 444px de haut et ne partage
      # FR | pas sa largeur, donc Top 10 (Cadre 1) s'empile au-dessus de
      # FR | Production/Consommation (Cadre 2) plutot que cote a cote. La
      # FR | zone de grille egy1 reste declaree mais vide — rien d'autre ne
      # FR | la reclame pour l'instant.
      - type: vertical-stack
        view_layout:
          grid-area: right
        card_mod:
          style: |
            :host { height: 100%; display: block; }
            #root { height: 100%; overflow-y: auto; }
        cards:
          # Cadre 1 — top 10 appareils par consommation. Meme motif que le
          # panneau « Consommation par appareil » d'ENERGY (meme template
          # vssp_energy_device_row, meme liste defilante dans un unique
          # button-card) — seule la source change : les 10 premieres
          # entrees de energy_devices au lieu de la liste complete.
          - type: vertical-stack
            cards:
              # EN | Not `template: vssp_section_title` — that template is
              # EN | shared by every panel title across the whole project
              # EN | (energy.yaml.j2, core.yaml, room panels...), all
              # EN | left-aligned by design. Centering it there would
              # EN | recentre every one of them. Inlined here instead,
              # EN | identical styling except justify-content/justify-self:
              # EN | center — scoped to this one title only.
              # FR | Pas `template: vssp_section_title` — ce template est
              # FR | partage par tous les titres de panneau du projet
              # FR | (energy.yaml.j2, core.yaml, panneaux de piece...), tous
              # FR | alignes a gauche par conception. Le centrer la-bas
              # FR | recentrerait chacun d'entre eux. Mis en ligne ici a la
              # FR | place, style identique sauf justify-content/
              # FR | justify-self: center — limite a ce seul titre.
              - type: custom:button-card
                show_icon: false
                show_state: false
                show_label: false
                name: "{{ t('home.top_devices') }}"
                styles:
                  card:
                    - background: transparent
                    - box-shadow: none
                    - border: none
                    - padding: 2px 2px 10px 2px
                    - justify-content: center
                    - cursor: default
                    - pointer-events: none
                  name:
                    - color: "#FFFFFF"
                    - font-size: 15px
                    - font-weight: 600
                    - letter-spacing: 1px
                    - justify-self: center
                    - text-align: center
                    - font-family: "Orbitron, sans-serif"

              # EN | Fixed pixel height, NOT height:100% — a percentage here
              # EN | has nothing concrete to resolve against, so the list
              # EN | never actually capped itself and just grew to fit all
              # EN | 10 rows. 300px, same overflow-y: auto scrollbar as
              # EN | ENERGY's own per-device panel (energy.yaml.j2), is the
              # EN | fix.
              # FR | Hauteur fixe en pixels, PAS height:100% — un pourcentage
              # FR | ici n'a rien de concret ou se resoudre, donc la liste ne
              # FR | se limitait jamais vraiment et grandissait pour caser
              # FR | les 10 lignes. 300px, meme ascenseur overflow-y: auto
              # FR | que le panneau par appareil d'ENERGY (energy.yaml.j2),
              # FR | est le correctif.
              - type: custom:button-card
                show_icon: false
                show_name: false
                show_state: false
                tap_action:
                  action: none
                styles:
                  grid:
                    - grid-template-areas: '"list"'
                  card:
                    - background: transparent
                    - box-shadow: none
                    - border: none
                    - border-radius: 0
                    - padding: 0
                    - cursor: default
                  custom_fields:
                    list:
                      - display: block
                      - width: 100%
                      - height: 300px
                      - overflow-y: auto
                      - overflow-x: hidden
                      - padding-right: 4px
                      - scrollbar-width: thin
                      - scrollbar-color: rgba(0,229,255,0.35) rgba(0,229,255,0.06)
                custom_fields:
                  list:
                    card:
                      type: vertical-stack
                      cards:
{% for d in energy_devices[:10] %}
                        - type: custom:button-card
                          template: vssp_energy_device_row
                          entity: {{ d.power_entity }}
                          name: "{{ d.name }}"
                          icon: {{ d.icon }}
                          variables:
                            room: "{{ d.room }}"
                            model: "{{ d.model | default('—', true) }}"
                            energy_entity: {{ d.energy_entity }}
                          tap_action:
                            action: more-info

{% endfor %}
{% if not energy_devices %}
                        - type: custom:button-card
                          template: vssp_energy_device_row
                          name: "{{ t('energy.empty.devices') }}"
                          icon: mdi:help-circle-outline
                          variables:
                            room: "—"
{% endif %}

          # Cadre 2 — PRODUCTION puis son historique, CONSOMMATION puis le
          # sien : deux courbes a un seul flux chacune, empilees sous leur
          # propre metrique. Hauteurs fixes (et non plus flex sur toute la
          # hauteur de la ligne) puisque ce cadre est maintenant empile sous
          # le Cadre 1 plutot que seul sur sa propre ligne pleine hauteur.
          - type: vertical-stack
            cards:
              - type: custom:button-card
                template: vssp_metric
                show_icon: true
                icon: mdi:solar-power
                name: PRODUCTION
                entity: sensor.solar_power_production  # TODO: remplacer par votre entité production solaire
              - type: custom:apexcharts-card
                header:
                  show: false
                graph_span: 24h
                card_mod:
                  style: |
                    ha-card {
                      background: var(--osv-panel) !important;
                      height: 110px;
                      overflow: hidden;
                    }
                series:
                  - entity: sensor.solar_power_production  # TODO: remplacer par votre entité production solaire
                    name: Production
                    type: area
                    color: "#00FFC3"
                    stroke_width: 2
                    opacity: 0.15
              - type: custom:button-card
                template: vssp_metric
                show_icon: true
                icon: mdi:flash
                name: CONSOMMATION
                entity: sensor.home_power_consumption  # TODO: remplacer par votre entité consommation
              - type: custom:apexcharts-card
                header:
                  show: false
                graph_span: 24h
                card_mod:
                  style: |
                    ha-card {
                      background: var(--osv-panel) !important;
                      height: 110px;
                      overflow: hidden;
                    }
                series:
                  - entity: sensor.home_power_consumption  # TODO: remplacer par votre entité consommation
                    name: Consommation
                    type: line
                    color: "#00E5FF"
                    stroke_width: 2


    card_mod:
      style: |
        hui-view {
          background: center / cover no-repeat fixed url("/local/vssp/backgrounds/home.png");
        }

  # =====================================================================
  # EN | REMOVED: `- !include views/core.yaml` and the commented-out room
  # EN | includes that followed it.
  # EN | core.yaml is a STANDALONE dashboard — it carries its own
  # EN | `title: / views: [...]` wrapper and is declared in
  # EN | configuration.yaml under its own url_path. Including it here made
  # EN | Lovelace parse a whole dashboard as if it were a single view, which
  # EN | is exactly what energy_config_snippets.yaml warns against. The two
  # EN | usages are mutually exclusive.
  # EN | Room views are no longer included either: each room is its own
  # EN | generated dashboard, declared in config-fragment-rooms.yaml.
  # FR | SUPPRIME : `- !include views/core.yaml` et les includes de pieces
  # FR | commentes qui suivaient.
  # FR | core.yaml est un dashboard AUTONOME — il porte son propre wrapper
  # FR | `title: / views: [...]` et est declare dans configuration.yaml sous
  # FR | son propre url_path. L'inclure ici faisait analyser par Lovelace un
  # FR | dashboard entier comme s'il s'agissait d'une seule vue, ce que
  # FR | energy_config_snippets.yaml deconseille explicitement. Les deux
  # FR | usages sont exclusifs.
  # FR | Les vues de pieces ne sont plus incluses non plus : chaque piece est
  # FR | son propre dashboard genere, declare dans config-fragment-rooms.yaml.
