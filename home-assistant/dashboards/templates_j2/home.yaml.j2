########################################################################
# Visio Sapiens — HOME Dashboard (main dashboard, two views)
#
# EN | *** GENERATED FILE — DO NOT EDIT BY HAND ***
# EN | Source: home.yaml.j2 + model/house.yaml + locales/<code>.yaml
# EN | Regenerate with: python3 generate_dashboards.py
# FR | *** FICHIER GENERE — NE PAS EDITER A LA MAIN ***
# FR | Source : home.yaml.j2 + model/house.yaml + locales/<code>.yaml
# FR | Regenerer avec : python3 generate_dashboards.py
#
# EN | ONE view: /visio-sapiens/home — HUD, KPI row, central video, energy,
# EN | events. The admin console used to be a second view here; it now lives
# EN | in admin.yaml.j2 as its own dashboard.
# FR | UNE vue : /visio-sapiens/home — HUD, ligne KPI, video centrale,
# FR | energie, evenements. La console d administration etait une seconde vue
# FR | ici ; elle vit desormais dans admin.yaml.j2, comme son propre dashboard.
#
# EN | TWO FIXES APPLIED WHILE TEMPLATING — read before comparing with the
# EN | previous hand-written file:
# EN |   1. The weather card and the clock card were indented INSIDE the ad
# EN |      banner's `ads:` list. They were passed as advertisement entries
# EN |      instead of being cards, so neither ever rendered, and grid areas
# EN |      header3..header6 stayed empty. Both are restored through the
# EN |      shared _header.j2 partial.
# EN |   2. The header row is now a single `header` area spanning the width
# EN |      (title + weather + clock), instead of six one-cell areas of which
# EN |      four were unused.
# EN |   3. The scrolling ad banner is gone, along with its grid area and its
# EN |      osv-ad-banner-card.js resource. It only ever existed on the tablet
# EN |      view.
# FR | DEUX CORRECTIONS APPLIQUEES A LA TEMPLATISATION — a lire avant de
# FR | comparer avec l'ancien fichier ecrit a la main :
# FR |   1. La carte meteo et la carte heure etaient indentees A L'INTERIEUR
# FR |      de la liste `ads:` du bandeau publicitaire. Elles etaient passees
# FR |      comme entrees de publicite au lieu d'etre des cartes, donc
# FR |      aucune des deux ne s'affichait, et les zones header3..header6
# FR |      restaient vides. Les deux sont retablies via le partial partage
# FR |      _header.j2.
# FR |   2. La ligne d'en-tete est desormais une seule zone `header` sur
# FR |      toute la largeur (titre + meteo + heure), au lieu de six zones
# FR |      d'une cellule dont quatre inutilisees.
# FR |   3. Le bandeau publicitaire defilant est supprime, avec sa zone de
# FR |      grille et sa ressource osv-ad-banner-card.js. Il n'a jamais
# FR |      existe que sur la vue tablette.
#
# EN | Lovelace dependencies (HACS + declared in resources):
# FR | Dependances Lovelace (HACS + declarees dans resources) :
#   button-card, card-mod, layout-card,
#   apexcharts-card, config-template-card, decluttering-card, browser_mod,
#   calendar-card-pro
#
# EN | COLOR-MIX FIX (2026-09-06): every translucent cyan border/box-shadow/
# EN | scrollbar-color in this project used to read
# EN | `color-mix(in srgb, var(--primary-color, #00E5FF) N%, transparent)`.
# EN | On this install's rendering engine that CSS function silently failed
# EN | (the whole `border` shorthand was dropped, not just miscolored), so
# EN | System Status / Energy Status / Rooms & Devices / Thermostat rendered
# EN | with NO visible frame while Security (vssp_kpi_card, a plain rgba()
# EN | border) still showed one — same 20% alpha, only the CSS function
# EN | differed. Replaced project-wide with the precomputed
# EN | `rgba(0, 229, 255, 0.NN)` equivalent (identical output under the
# EN | default theme, since design_system.yaml's palette.primary IS
# EN | #00E5FF) in every .j2 template and button_card_templates.yaml. A
# EN | custom accent color set later via the ADMIN theme editor will no
# EN | longer tint these borders — an acceptable trade given color-mix()
# EN | was not rendering ANY border here regardless of color.
# FR | CORRECTIF COLOR-MIX (2026-09-06) : chaque bordure/ombre/couleur de
# FR | scrollbar cyan translucide du projet s'ecrivait
# FR | `color-mix(in srgb, var(--primary-color, #00E5FF) N%, transparent)`.
# FR | Sur le moteur de rendu de cette installation, cette fonction CSS
# FR | echouait silencieusement (tout le raccourci `border` etait rejete, pas
# FR | seulement mal colore), donc System Status / Energy Status / Rooms &
# FR | Devices / Thermostat s'affichaient SANS cadre visible alors que
# FR | Security (vssp_kpi_card, une bordure rgba() brute) en montrait un —
# FR | meme alpha 20%, seule la fonction CSS differait. Remplace partout par
# FR | l'equivalent precalcule `rgba(0, 229, 255, 0.NN)` (rendu identique
# FR | avec le theme par defaut, palette.primary de design_system.yaml
# FR | valant deja #00E5FF) dans chaque template .j2 et dans
# FR | button_card_templates.yaml. Une couleur d'accent personnalisee via
# FR | l'editeur de theme ADMIN ne teintera plus ces bordures — compromis
# FR | acceptable puisque color-mix() n'affichait AUCUNE bordure ici, quelle
# FR | que soit la couleur.
########################################################################

title: {{ house.name | title }}
path: visio-sapiens
theme: {{ house.theme }}

# EN | Paths relative to dashboards/views/, where every generated dashboard
# EN | now lives. The hand-written home.yaml sat one level up, in
# EN | dashboards/, and used `templates/...`; keeping all outputs in one
# EN | directory means one include convention instead of two.
# FR | Chemins relatifs a dashboards/views/, ou vivent desormais tous les
# FR | dashboards generes. Le home.yaml ecrit a la main etait un niveau
# FR | au-dessus, dans dashboards/, et utilisait `templates/...` ; regrouper
# FR | toutes les sorties dans un seul repertoire donne une seule convention
# FR | d'include au lieu de deux.
button_card_templates: !include ../templates/button_card_templates.yaml
decluttering_templates: !include ../templates/decluttering_templates.yaml

views:
  # =====================================================================
  # EN | HOME — the hub / FR | HOME — le hub
  # =====================================================================
  - title: {{ t('page.home.name') }}
    path: home
    subview: true
    type: custom:grid-layout
    layout:
      grid-template-columns: minmax(200px, auto) minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1fr) 565px
      grid-template-rows: 130px 113px 444px 400px
      grid-template-areas: |
        "nav header header header header header header"
        "nav kpi1 kpi2 kpi3 kpi4 kpi5 kpi5"
        "nav floor floor floor floor floor right"
        "nav events events events events events meteo"
      margin: 12px
      grid-gap: 14px 14px
    cards:
      # ═══════════════════════════════════════════════════════════════
      # EN | HEADER BAND — shared partial (title / weather / clock)
      # FR | BANDEAU HORIZONTAL — partial partage (titre / meteo / heure)
      # ═══════════════════════════════════════════════════════════════
{% set page_title = t('page.home.name') %}
{% set page_subtitle = t('page.home.subtitle') %}
{% set page_path = '/visio-sapiens/home' %}
{# EN | WAS HARDCODED to calendar.calebar (the only calendar.* entity this
   EN | install had when the header's agenda cell was added). It is now
   EN | chosen in the ADMIN console's GOOGLE CALENDAR screen, which stores
   EN | the entity in input_text.vssp_google_calendar_entity and passes it to
   EN | generate_dashboards.py as --calendar-entity; house.calendar_entity
   EN | (model/house.yaml) is the default when the flag is absent. Linking a
   EN | Google account therefore changes what this header shows without
   EN | touching this template.
   FR | ETAIT CODE EN DUR sur calendar.calebar (la seule entite calendar.* de
   FR | cette installation quand la case agenda du bandeau a ete ajoutee).
   FR | L'entite se choisit desormais dans l'ecran CALENDRIER GOOGLE de la
   FR | console ADMIN, qui la memorise dans
   FR | input_text.vssp_google_calendar_entity et la passe a
   FR | generate_dashboards.py via --calendar-entity ; house.calendar_entity
   FR | (model/house.yaml) sert de defaut en l'absence du flag. Lier un
   FR | compte Google change donc ce qu'affiche ce bandeau sans toucher a ce
   FR | template. #}
{% set calendar_entity = house.calendar_entity | default('calendar.calebar', true) %}
{# EN | No regenerate_dashboard_service here on purpose: the header's
   EN | optional Cell 4 (mdi:refresh, calls script.vssp_regenerate_home_
   EN | dashboard) was removed from HOME per user request — use ADMIN's own
   EN | REGENERATE HOME instead. HOME is still the one dashboard protected
   EN | against automatic overwrite (--protect-existing home, see
   EN | vssp_admin.yaml).
   FR | Pas de regenerate_dashboard_service ici, volontairement : la case 4
   FR | optionnelle de l'en-tete (mdi:refresh, appelle script.vssp_
   FR | regenerate_home_dashboard) a ete retiree de HOME a la demande de
   FR | l'utilisateur — passer par le REGENERER HOME d'ADMIN a la place.
   FR | HOME reste le seul dashboard protege contre l'ecrasement automatique
   FR | (--protect-existing home, voir vssp_admin.yaml). #}
{% include '_header.j2' %}

      # ═══════════════════════════════════════════════════════════════
      # EN | NAVIGATION RAIL — shared partial, dynamic
      # FR | BANDEAU DE NAVIGATION — partial partage, dynamique
      # ═══════════════════════════════════════════════════════════════
{% include '_nav.j2' %}

      # --- KPI row (System Status / Energy Status / Pièces actives / Connexions / Sécurité) ----
      - type: horizontal-stack
        view_layout:
          grid-area: kpi1
          grid-column: kpi1 / kpi5
        cards:
          # Case 1 — System Status : une seule bar card, moyenne CPU+RAM+HDD.
          #
          # EN | Was a keyword search for a CPU/RAM sensor (same idea as
          # EN | core.html), which found nothing: this install's System
          # EN | Monitor integration exists but exposes French entity ids
          # EN | (custom names given at setup, not the HA-default
          # EN | sensor.processor_use etc. the keyword search was tuned for)
          # EN | — confirmed directly by the user via Developer Tools >
          # EN | States. Fixed entity ids now that the real ones are known.
          # EN | Redesigned as one bar (not the 3-tier coloured-circle
          # EN | layout every other status card here uses) per request: a
          # EN | single average of the three metrics, CPU/RAM/HDD broken out
          # EN | as small labels above it.
          # FR | Etait une recherche par mot-cle d'un capteur CPU/RAM (meme
          # FR | idee que core.html), qui ne trouvait rien : l'integration
          # FR | System Monitor de cette installation existe mais expose des
          # FR | entity id en francais (noms personnalises donnes a la
          # FR | configuration, pas les sensor.processor_use etc. par defaut
          # FR | de HA pour lesquels la recherche par mot-cle etait calee) —
          # FR | confirme directement par l'utilisateur via Outils de
          # FR | developpement > Etats. Entity id figes maintenant que les
          # FR | vrais sont connus. Redessine en une seule barre (pas le
          # FR | disque colore a 3 paliers que chaque autre carte de statut
          # FR | ici utilise) sur demande : une moyenne unique des trois
          # FR | metriques, CPU/RAM/HDD detailles en petites etiquettes
          # FR | au-dessus.
          # EN | Later, the user asked for two dedicated CPU/RAM bars
          # EN | (stacked, one above the other) instead of the single
          # EN | averaged bar, dropping HDD — same layout as Case 2's
          # EN | production/consumption bars below.
          # FR | Ensuite, l'utilisateur a demande deux barres dediees
          # FR | CPU/RAM (empilees l'une sous l'autre) au lieu de la barre
          # FR | moyenne unique, en abandonnant le HDD — meme mise en page
          # FR | que les barres production/consommation du Case 2 ci-dessous.
          - type: custom:button-card
            show_icon: false
            show_state: false
            show_label: false
            name: "{{ t('home.kpi.system_status') }}"
            entity: sensor.system_monitor_utilisation_du_processeur
            tap_action:
              action: more-info
            custom_fields:
              bars: >
                [[[
                  const cpu = parseFloat(states['sensor.system_monitor_utilisation_du_processeur']?.state) || 0;
                  const ram = parseFloat(states['sensor.system_monitor_utilisation_de_la_memoire']?.state) || 0;
                  const colorFor = (v) => v >= 90 ? '#FF3D71' : v >= 70 ? '#FFA726' : '#00FFC3';
                  const cpuColor = colorFor(cpu);
                  const ramColor = colorFor(ram);
                  return `
                    <div style="margin-bottom:6px;">
                      <div style="font-size:9px;color:${cpuColor};margin-bottom:2px;">CPU ${Math.round(cpu)}%</div>
                      <div style="position:relative;width:100%;height:9px;background:rgba(255,255,255,.08);border-radius:5px;overflow:hidden;">
                        <div style="width:${Math.min(cpu,100)}%;height:100%;background:${cpuColor};border-radius:5px;transition:width .3s;"></div>
                      </div>
                    </div>
                    <div>
                      <div style="font-size:9px;color:${ramColor};margin-bottom:2px;">RAM ${Math.round(ram)}%</div>
                      <div style="position:relative;width:100%;height:9px;background:rgba(255,255,255,.08);border-radius:5px;overflow:hidden;">
                        <div style="width:${Math.min(ram,100)}%;height:100%;background:${ramColor};border-radius:5px;transition:width .3s;"></div>
                      </div>
                    </div>
                  `;
                ]]]
            styles:
              grid:
                - grid-template-areas: '"n" "bars"'
                - grid-template-rows: min-content 1fr
                - row-gap: 6px
                - justify-items: start
              card:
                - background: var(--card-background-color, rgba(8,18,28,0.72))
                - border-radius: var(--ha-card-border-radius, 18px)
                - border: 1px solid rgba(0, 229, 255, 0.2)
                - padding: 14px 18px
                - height: 100%
              name:
                - color: "var(--text-primary-color, #FFFFFF)"
                - font-size: 13px
                - font-weight: 700
                - letter-spacing: 0.5px
                - justify-self: start
                - text-align: left
              custom_fields:
                bars:
                  - width: 100%

          # Case 2 — Energy Status : deux barres distinctes (production /
          # consommation du jour), meme motif que Case 3 (Pieces +
          # Connexions) plutot qu'une seule barre de ratio.
          #
          # EN | Was energy.totals.power / energy.solar.power (instantaneous
          # EN | W) — the user pointed out the consumption reading looked
          # EN | far too low ("2W") for a whole house and asked for the
          # EN | TOTAL instead. Switched to energy.totals.today /
          # EN | energy.solar.today (sensor.home_energy_today /
          # EN | sensor.solar_energy_today — daily kWh totals, already
          # EN | declared in house.yaml's `energy:` block). Unit is read from
          # EN | the entity's own unit_of_measurement rather than hardcoded,
          # EN | so this displays correctly whatever the real unit is.
          # EN | Later, the user asked for two separate bars (production and
          # EN | consumption) instead of the single coverage-ratio bar, so
          # EN | each value now gets its own bar scaled against the max of
          # EN | the two (matching the Case 3 rooms/devices pattern) rather
          # EN | than one bar showing prod-as-%-of-cons.
          # FR | Etait energy.totals.power / energy.solar.power (W
          # FR | instantane) — l'utilisateur a signale que la consommation
          # FR | affichee semblait beaucoup trop faible (« 2W ») pour une
          # FR | maison entiere et a demande LE TOTAL a la place. Bascule
          # FR | vers energy.totals.today / energy.solar.today
          # FR | (sensor.home_energy_today / sensor.solar_energy_today —
          # FR | totaux kWh du jour, deja declares dans le bloc `energy:` de
          # FR | house.yaml). L'unite est lue depuis le unit_of_measurement
          # FR | propre a l'entite plutot que codee en dur, donc l'affichage
          # FR | reste correct quelle que soit l'unite reelle. Ensuite,
          # FR | l'utilisateur a demande deux barres distinctes (production
          # FR | et consommation) au lieu de l'unique barre de ratio de
          # FR | couverture : chaque valeur a maintenant sa propre barre,
          # FR | mise a l'echelle du max des deux (meme motif que Pieces/
          # FR | Connexions du Case 3) plutot qu'une barre montrant
          # FR | prod-en-%-de-cons.
          - type: custom:button-card
            show_icon: false
            show_state: false
            show_label: false
            name: "{{ t('home.kpi.energy_status') }}"
            entity: "{{ energy.totals.today }}"
            tap_action:
              action: more-info
            custom_fields:
              bars: >
                [[[
                  const prodEnt = states['{{ energy.solar.today }}'];
                  const consEnt = states['{{ energy.totals.today }}'];
                  const prod = parseFloat(prodEnt?.state) || 0;
                  const cons = parseFloat(consEnt?.state) || 0;
                  const prodUnit = prodEnt?.attributes?.unit_of_measurement || 'kWh';
                  const consUnit = consEnt?.attributes?.unit_of_measurement || 'kWh';
                  const maxVal = Math.max(prod, cons, 0.001);
                  const prodRatio = prod / maxVal * 100;
                  const consRatio = cons / maxVal * 100;
                  return `
                    <div style="margin-bottom:6px;">
                      <div style="font-size:9px;color:#00FFC3;margin-bottom:2px;">{{ t('home.kpi.production') }} ${prod.toFixed(1)}${prodUnit}</div>
                      <div style="position:relative;width:100%;height:9px;background:rgba(255,255,255,.08);border-radius:5px;overflow:hidden;">
                        <div style="width:${prodRatio}%;height:100%;background:#00FFC3;border-radius:5px;transition:width .3s;"></div>
                      </div>
                    </div>
                    <div>
                      <div style="font-size:9px;color:#FFA726;margin-bottom:2px;">{{ t('home.kpi.consumption') }} ${cons.toFixed(1)}${consUnit}</div>
                      <div style="position:relative;width:100%;height:9px;background:rgba(255,255,255,.08);border-radius:5px;overflow:hidden;">
                        <div style="width:${consRatio}%;height:100%;background:#FFA726;border-radius:5px;transition:width .3s;"></div>
                      </div>
                    </div>
                  `;
                ]]]
            styles:
              grid:
                - grid-template-areas: '"n" "bars"'
                - grid-template-rows: min-content 1fr
                - row-gap: 6px
                - justify-items: start
              card:
                - background: var(--card-background-color, rgba(8,18,28,0.72))
                - border-radius: var(--ha-card-border-radius, 18px)
                - border: 1px solid rgba(0, 229, 255, 0.2)
                - padding: 14px 18px
                - height: 100%
              name:
                - color: "var(--text-primary-color, #FFFFFF)"
                - font-size: 13px
                - font-weight: 700
                - letter-spacing: 0.5px
                - justify-self: start
                - text-align: left
              custom_fields:
                bars:
                  - width: 100%

          # Case 3 — Pièces + Connexions, fusionnees en une bar card (meme
          # motif que System/Energy Status), sur demande : barre bleue
          # pieces, barre violette appareils connectes.
          #
          # EN | "Pièces" is the count of DECLARED rooms (ROOMS & FLOORS in
          # EN | the admin console), not a live "currently occupied" ratio —
          # EN | two earlier attempts (area_entities()/areas(), then
          # EN | rooms[].slots device assignment) both tried to compute an
          # EN | on/off activity ratio, which was never what this card was
          # EN | supposed to show; the user clarified after the second
          # EN | attempt still read 0 for a different reason (assignment was
          # EN | never done) that "actives" here just means the rooms that
          # EN | exist. rooms_rendered — the exact list ROOMS & FLOORS
          # EN | manages and room.yaml.j2 draws one dashboard per entry of —
          # EN | is the correct, already-reliable source; its length is
          # EN | baked in at generate time, no client-side state check
          # EN | needed at all.
          # EN | Devices: sensor.vssp_total_appareils already counted
          # EN | CONNECTED devices (device_id() dedup, excluding unavailable/
          # EN | unknown); its new total_devices attribute (same dedup,
          # EN | every device regardless of state) is what makes a
          # EN | connected/total ratio possible for that bar.
          # FR | « Pièces » est le compte des pieces DECLAREES (ROOMS &
          # FR | FLOORS dans la console admin), pas un ratio live "actuellement
          # FR | occupee" — deux tentatives precedentes (area_entities()/
          # FR | areas(), puis l'assignation d'appareils rooms[].slots) ont
          # FR | toutes deux essaye de calculer un ratio d'activite on/off,
          # FR | ce que cette carte n'a jamais ete censee montrer ; l'utilisateur
          # FR | a clarifie apres que la seconde tentative lisait encore 0
          # FR | pour une autre raison (l'assignation n'avait jamais ete
          # FR | faite) que « actives » signifie ici simplement les pieces
          # FR | qui existent. rooms_rendered — exactement la liste que ROOMS
          # FR | & FLOORS gere et dont room.yaml.j2 dessine un dashboard par
          # FR | entree — est la bonne source, deja fiable ; sa longueur est
          # FR | figee au moment de la generation, aucune verification d'etat
          # FR | cote client necessaire.
          # FR | Appareils : sensor.vssp_total_appareils comptait deja les
          # FR | appareils CONNECTES (deduplication device_id(), unavailable/
          # FR | unknown exclus) ; son nouvel attribut total_devices (meme
          # FR | deduplication, tout appareil quel que soit l'etat) est ce
          # FR | qui rend possible un ratio connecte/total pour cette barre.
          - type: custom:button-card
            show_icon: false
            show_state: false
            show_label: false
            name: "{{ t('common.security') }}"
            entity: {{ house.alarm_entity | default('alarm_control_panel.vssp_alarme', true) }}
            # EN | The card itself is not a button - every tap target inside
            # EN | it is one, and a tap that lands between them should do
            # EN | nothing rather than open a more-info dialog over the
            # EN | controls someone was aiming at.
            # FR | La carte elle-meme n est pas un bouton - chaque cible de
            # FR | pression a l interieur en est une, et une pression qui
            # FR | tombe entre deux ne doit rien faire plutot qu ouvrir une
            # FR | fiche par-dessus les commandes qu on visait.
            tap_action:
              action: none
            custom_fields:
              # EN | THE CURRENT POSITION, in words. `arming` and `pending`
              # EN | are the two transient states the manual platform passes
              # EN | through - the walk-out and walk-in delays - and naming
              # EN | them is the difference between "it is counting down" and
              # EN | a panel that looks stuck between positions.
              # FR | LA POSITION COURANTE, en toutes lettres. `arming` et
              # FR | `pending` sont les deux etats transitoires que traverse
              # FR | la plateforme manual - les delais de sortie et
              # FR | d entree - et les nommer fait la difference entre « elle
              # FR | decompte » et un panneau qui semble coince entre deux
              # FR | positions.
              now: >
                [[[
                  const st = entity ? entity.state : 'unavailable';
                  const map = {
                    armed_away: ['{{ t('home.alarm.state_away') | js }}', '#00FFC3'],
                    armed_home: ['{{ t('home.alarm.state_home') | js }}', '#00FFC3'],
                    disarmed:   ['{{ t('home.alarm.state_off') | js }}', '#8FB6C9'],
                    triggered:  ['{{ t('home.alarm.state_triggered') | js }}', '#FF3D71'],
                    arming:     ['{{ t('home.alarm.state_arming') | js }}', '#FF9800'],
                    pending:    ['{{ t('home.alarm.state_pending') | js }}', '#FF9800']
                  };
                  const m = map[st] || ['{{ t('home.alarm.not_configured') | js }}', '#56707E'];
                  return `<div style="font-size:15px;font-weight:700;color:${m[1]};">${m[0]}</div>`;
                ]]]

              # EN | THE THREE POSITIONS. The active one is filled rather than
              # EN | outlined, because on a wall tablet read at two metres the
              # EN | fill is the only thing that reads at a glance.
              # EN | `hass` is reached through document.querySelector(
              # EN | 'home-assistant') - the app's root element sits directly
              # EN | under <body>, never inside a shadow root, so a plain
              # EN | document query finds it however deep in shadow DOM this
              # EN | card is. Same pattern as the thermostat card.
              # FR | LES TROIS POSITIONS. L active est pleine plutot que
              # FR | cerclee, parce que sur une tablette murale lue a deux
              # FR | metres, le remplissage est la seule chose qui se lise
              # FR | d un coup d oeil.
              # FR | `hass` s atteint via document.querySelector(
              # FR | 'home-assistant') - l element racine de l application est
              # FR | directement sous <body>, jamais dans un shadow root, donc
              # FR | une simple requete document le trouve quelle que soit la
              # FR | profondeur de shadow DOM de cette carte. Meme motif que
              # FR | la carte thermostat.
              modes: >
                [[[
                  const eid = '{{ house.alarm_entity | default('alarm_control_panel.vssp_alarme', true) }}';
                  const st = entity ? entity.state : 'unavailable';
                  const call = svc => `document.querySelector('home-assistant')`
                    + `.hass.callService('alarm_control_panel','${svc}',`
                    + `{entity_id:'${eid}'})`;
                  const modes = [
                    ['armed_away', 'alarm_arm_away', '{{ t('home.alarm.mode_away') | js }}'],
                    ['armed_home', 'alarm_arm_home', '{{ t('home.alarm.mode_home') | js }}'],
                    ['disarmed',   'alarm_disarm',   '{{ t('home.alarm.mode_off') | js }}']
                  ];
                  const cells = modes.map(m => {
                    const on = st === m[0];
                    return `<div onclick="${call(m[1])}" title="${m[2]}" style="
                        flex:1;text-align:center;padding:5px 2px;border-radius:7px;
                        cursor:pointer;font-size:8px;font-weight:700;
                        letter-spacing:.2px;line-height:1.15;
                        background:${on ? 'rgba(0,255,195,0.16)' : 'rgba(255,255,255,0.04)'};
                        border:1px solid ${on ? 'rgba(0,255,195,0.55)' : 'rgba(0,229,255,0.18)'};
                        color:${on ? '#00FFC3' : '#8FB6C9'};
                      ">${m[2]}</div>`;
                  }).join('');
                  return `<div style="display:flex;gap:4px;width:100%;">${cells}</div>`;
                ]]]

              # EN | PANIC. Fires alarm_trigger, which the package routes to
              # EN | an immediate `triggered` whatever position the panel is
              # EN | in - a panic button that honours a twenty-second entry
              # EN | delay is not a panic button.
              # EN | It asks first. On a tablet on a wall, an accidental brush
              # EN | is far likelier than a real emergency, and a siren that
              # EN | starts at three in the morning because someone leaned on
              # EN | the hallway screen teaches the household to ignore it.
              # EN | One extra tap is the cost; say the word and it goes.
              # FR | PANIQUE. Declenche alarm_trigger, que le package route
              # FR | vers un `triggered` immediat quelle que soit la position
              # FR | du panneau - un bouton panique qui respecte un delai
              # FR | d entree de vingt secondes n est pas un bouton panique.
              # FR | Il demande confirmation. Sur une tablette murale, un
              # FR | frolement accidentel est bien plus probable qu une vraie
              # FR | urgence, et une sirene qui part a trois heures du matin
              # FR | parce que quelqu un s est appuye sur l ecran du couloir
              # FR | apprend a la maisonnee a l ignorer. Une pression de plus
              # FR | est le prix ; un mot et elle disparait.
              panic: >
                [[[
                  const eid = '{{ house.alarm_entity | default('alarm_control_panel.vssp_alarme', true) }}';
                  const st = entity ? entity.state : 'unavailable';
                  const live = st === 'triggered';
                  const act = `document.querySelector('home-assistant')`
                    + `.hass.callService('alarm_control_panel','`
                    + (live ? 'alarm_disarm' : 'alarm_trigger') + `',`
                    + `{entity_id:'${eid}'})`;
                  const guard = live ? act
                    : `if(confirm('{{ t('home.alarm.panic_confirm') | js }}')){${act}}`;
                  return `<div onclick="${guard}" style="
                      width:100%;text-align:center;padding:6px 2px;border-radius:7px;
                      cursor:pointer;font-size:9px;font-weight:800;letter-spacing:.6px;
                      background:${live ? 'rgba(255,61,113,0.30)' : 'rgba(255,61,113,0.10)'};
                      border:1px solid rgba(255,61,113,${live ? '0.9' : '0.45'});
                      color:#FF3D71;
                    ">${live ? '{{ t('home.alarm.panic_stop') | js }}'
                             : '{{ t('home.alarm.panic') | js }}'}</div>`;
                ]]]
            styles:
              grid:
                - grid-template-areas: '"n" "now" "modes" "panic"'
                - grid-template-rows: min-content min-content min-content min-content
                - row-gap: 5px
                - justify-items: start
              card:
                - background: var(--card-background-color, rgba(8,18,28,0.72))
                - border-radius: var(--ha-card-border-radius, 18px)
                - border: 1px solid rgba(0, 229, 255, 0.2)
                - padding: 12px 14px
                - height: 100%
              name:
                - color: "var(--text-primary-color, #FFFFFF)"
                - font-size: 13px
                - font-weight: 700
                - letter-spacing: 0.5px
                - justify-self: start
                - text-align: left
              custom_fields:
                now:
                  - width: 100%
                  - text-align: left
                modes:
                  - width: 100%
                panic:
                  - width: 100%
          # Case 4 — Température : moyenne des thermostats (climate.*), +/-
          # ajuste la consigne de CHAQUE thermostat de 0.5 °C (relatif a sa
          # propre consigne, donc les ecarts entre pieces sont preserves),
          # borne a 10-30 °C. Decouverte par domaine plutot qu'une liste
          # d'entites figee a la generation, pour rester a jour si un
          # thermostat est ajoute/retire sans regenerer le dashboard.
          #
          # EN | document.querySelector('home-assistant').hass is the
          # EN | standard community pattern for reaching the live hass
          # EN | object from an inline onclick handler inside a
          # EN | button-card custom_field: <home-assistant> is the app's
          # EN | root custom element, sitting directly under <body> — not
          # EN | itself inside any shadow root — so a plain
          # EN | document.querySelector reaches it regardless of how deep
          # EN | in shadow DOM the button-card itself is.
          # FR | document.querySelector('home-assistant').hass est le motif
          # FR | standard de la communaute pour atteindre l'objet hass en
          # FR | direct depuis un gestionnaire onclick en ligne dans un
          # FR | custom_field de button-card : <home-assistant> est
          # FR | l'element racine de l'application, place directement sous
          # FR | <body> — jamais lui-meme dans un shadow root — donc un
          # FR | simple document.querySelector l'atteint quelle que soit la
          # FR | profondeur de shadow DOM du button-card lui-meme.
          - type: custom:button-card
            show_icon: false
            show_state: false
            show_label: false
            name: "{{ t('home.kpi.thermostats') }}"
            tap_action:
              action: none
            custom_fields:
              temp: >
                [[[
                  const clims = Object.values(states).filter(s =>
                    s.entity_id.startsWith('climate.') && s.attributes.temperature != null
                  );
                  const avg = clims.length
                    ? clims.reduce((a, s) => a + s.attributes.temperature, 0) / clims.length
                    : null;
                  const avgText = avg === null ? "{{ t('home.kpi.thermostats_hint') }}" : avg.toFixed(1) + '°C';
                  const adjustJs = (delta) => `
                    event.stopPropagation();
                    var hass = document.querySelector('home-assistant').hass;
                    Object.values(hass.states).filter(function(s) {
                      return s.entity_id.startsWith('climate.') && s.attributes.temperature != null;
                    }).forEach(function(s) {
                      var t = Math.max(10, Math.min(30, Math.round((s.attributes.temperature + (${delta})) * 2) / 2));
                      hass.callService('climate', 'set_temperature', {entity_id: s.entity_id, temperature: t});
                    });
                  `.replace(/\n/g, ' ').replace(/"/g, '&quot;');
                  const btnStyle = avg === null
                    ? 'font-size:22px;color:#00E5FF;width:28px;text-align:center;user-select:none;opacity:.3;pointer-events:none;'
                    : 'font-size:22px;color:#00E5FF;width:28px;text-align:center;user-select:none;cursor:pointer;';
                  return `
                    <div style="display:flex;align-items:center;justify-content:space-between;width:100%;">
                      <span onclick="${adjustJs(-0.5)}" style="${btnStyle}">−</span>
                      <span style="font-size:17px;font-weight:700;color:#FFFFFF;">${avgText}</span>
                      <span onclick="${adjustJs(0.5)}" style="${btnStyle}">+</span>
                    </div>
                  `;
                ]]]
            styles:
              grid:
                - grid-template-areas: '"n" "temp"'
                - grid-template-rows: min-content 1fr
                - row-gap: 10px
                - justify-items: start
              card:
                - background: var(--card-background-color, rgba(8,18,28,0.72))
                - border-radius: var(--ha-card-border-radius, 18px)
                - border: 1px solid rgba(0, 229, 255, 0.2)
                - padding: 14px 18px
                - height: 100%
              name:
                - color: "var(--text-primary-color, #FFFFFF)"
                - font-size: 13px
                - font-weight: 700
                - letter-spacing: 0.5px
                - justify-self: start
                - text-align: left
              custom_fields:
                temp:
                  - width: 100%

          # Case 5 — UPGRADE : le feu vert / orange / rouge
          #
          # EN | ONE LIGHT FOR THE WHOLE ESTATE, and the question it answers
          # EN | is narrow on purpose: "is anything unpatched against a known
          # EN | vulnerability, and is anything about to need a real
          # EN | migration?" It is NOT a count of pending updates — the
          # EN | UPDATES screen already lists those, and a light that turns
          # EN | orange because a Lovelace card has a new version teaches you
          # EN | to ignore it by the end of the week.
          # EN |   GREEN   no security patch waiting, anywhere.
          # EN |   ORANGE  security patches waiting.
          # EN |   RED     a MAJOR version is available — the upgrade that
          # EN |           reads release notes, takes a backup and picks its
          # EN |           moment, rather than one that runs tonight.
          # EN |   GREY    never probed. A security light that shows green
          # EN |           when it has not looked is worse than no light, so
          # EN |           the one state the design refuses is a confident
          # EN |           green over missing data.
          # FR | UN SEUL FEU POUR TOUT LE PARC, et la question a laquelle il
          # FR | repond est etroite a dessein : « reste-t-il quelque chose
          # FR | d expose a une faille connue, et quelque chose reclame-t-il
          # FR | bientot une vraie migration ? » Ce n est PAS un decompte de
          # FR | mises a jour en attente — l ecran MISES A JOUR les liste
          # FR | deja, et un feu qui passe a l orange parce qu une carte
          # FR | Lovelace a une nouvelle version vous apprend a l ignorer
          # FR | avant la fin de la semaine.
          # FR |   VERT    aucun correctif de securite en attente, nulle part.
          # FR |   ORANGE  des correctifs de securite attendent.
          # FR |   ROUGE   une version MAJEURE est disponible — la mise a
          # FR |           niveau qui lit les notes de version, prend une
          # FR |           sauvegarde et choisit son moment, pas celle qui
          # FR |           tourne cette nuit.
          # FR |   GRIS    jamais sonde. Un feu de securite qui affiche vert
          # FR |           sans avoir regarde est pire que pas de feu ; le
          # FR |           seul etat que ce dessin refuse est donc un vert
          # FR |           confiant par-dessus des donnees absentes.
          #
          # EN | Reads both worlds, because "whatever the component" was the
          # EN | requirement: the update.* entities Home Assistant holds, and
          # EN | the infrastructure components the probe publishes as an
          # EN | attribute. Neither knows about the other, so the arbitration
          # EN | happens here and nowhere else.
          # FR | Lit les deux mondes, parce que « peu importe le composant »
          # FR | etait la demande : les entites update.* que detient Home
          # FR | Assistant, et les composants d infrastructure que la sonde
          # FR | publie en attribut. Aucun des deux ne connait l autre,
          # FR | l arbitrage a donc lieu ici et nulle part ailleurs.
          - type: custom:button-card
            template: vssp_kpi_card
            name: "{{ t('home.kpi.upgrade') }}"
            entity: sensor.vssp_updates_verdict
            tap_action:
              action: navigate
              navigation_path: /visio-sapiens-admin/updates
            # EN | Everything below RENDERS a decision; it does not make one.
            # EN | The verdict, and the list of what drove it, are computed in
            # EN | packages/vssp_updates.yaml so that this light and the
            # EN | UPDATES screen it opens are the same answer rather than two
            # EN | that agree until they do not. The first version computed the
            # EN | colour here, went orange, and sent whoever tapped it to a
            # EN | screen showing nothing that explained why.
            # FR | Tout ce qui suit AFFICHE une decision ; il n en prend pas.
            # FR | Le verdict, et la liste de ce qui l a decide, sont calcules
            # FR | dans packages/vssp_updates.yaml pour que ce feu et l ecran
            # FR | MISES A JOUR qu il ouvre soient la meme reponse plutot que
            # FR | deux reponses qui concordent jusqu au jour ou non. La
            # FR | premiere version calculait la couleur ici, passait a
            # FR | l orange, et envoyait qui la touchait vers un ecran qui
            # FR | n expliquait rien.
            icon: >
              [[[
                const v = entity ? entity.state : 'green';
                if (v === 'red') return 'mdi:shield-alert';
                if (v === 'orange') return 'mdi:shield-sync';
                return 'mdi:shield-check';
              ]]]
            state_display: >
              [[[
                const v = entity ? entity.state : 'green';
                if (v === 'red') return '{{ t("home.upgrade.major") | js }}';
                if (v === 'orange') return '{{ t("home.upgrade.patches") | js }}';
                return '{{ t("home.upgrade.clear") | js }}';
              ]]]
            label: >
              [[[
                const items = (entity && entity.attributes.items) || [];
                const majors = items.filter(i => i.kind === 'major');
                if (majors.length) {
                  return majors.slice(0, 2).map(i => i.name).join(', ');
                }
                if (items.length) {
                  return items.length + ' {{ t("home.upgrade.patch_hint") | js }}';
                }
                // EN | Green with the server unprobed is still green - three
                // EN | colours, no fourth - but the label says so, so it is
                // EN | legible as "nothing in Home Assistant" rather than as
                // EN | a claim about the whole estate.
                // FR | Vert avec le serveur non sonde reste vert - trois
                // FR | couleurs, pas de quatrieme - mais le libelle le dit,
                // FR | pour que cela se lise « rien dans Home Assistant »
                // FR | plutot que comme une affirmation sur tout le parc.
                if (entity && entity.attributes.infra_probed === false) {
                  return '{{ t("home.upgrade.clear_unprobed") | js }}';
                }
                return '{{ t("home.upgrade.clear_hint") | js }}';
              ]]]
            variables:
              icon_color: >
                [[[
                  const c = { red: '#FF3D71', orange: '#FF9800',
                              green: '#00FFC3' };
                  return c[entity ? entity.state : 'green'] || c.green;
                ]]]
              value_color: >
                [[[
                  const c = { red: '#FF3D71', orange: '#FF9800',
                              green: '#00FFC3' };
                  return c[entity ? entity.state : 'green'] || c.green;
                ]]]
            styles:
              # EN | The card border carries the verdict too. At the distance a
              # EN | wall tablet is actually read from, the icon is a smudge
              # EN | and the outline is what registers.
              # FR | La bordure de la carte porte aussi le verdict. A la
              # FR | distance ou une tablette murale est reellement lue,
              # FR | l icone est une tache et c est le contour qui se voit.
              card:
                - border: >
                    [[[
                      const c = { red: 'rgba(255,61,113,0.75)',
                                  orange: 'rgba(255,152,0,0.75)',
                                  green: 'rgba(0,255,195,0.45)' };
                      return '1px solid ' +
                        (c[entity ? entity.state : 'green'] || c.green);
                    ]]]
                - box-shadow: >
                    [[[
                      const c = { red: '0 0 18px rgba(255,61,113,0.35)',
                                  orange: '0 0 18px rgba(255,152,0,0.28)',
                                  green: 'none' };
                      return c[entity ? entity.state : 'green'] || 'none';
                    ]]]
                - cursor: pointer
      # --- Video centrale VISIO SAPIENS (remplace le floorplan) -----------
