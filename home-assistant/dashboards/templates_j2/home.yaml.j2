      # --- Colonne de droite : TOP 10 CONSOMMATION, puis PRODUCTION et
      # CONSOMMATION avec leur courbe ---------------------------------------
      # EN | Replaces INTERPHONE / AUDIO STREAM — neither button had a real
      # EN | entity or action behind it. This is the SAME panel that used to
      # EN | sit in the egy1 row below (400px tall, split three ways with
      # EN | egy2/events/meteo), moved here rather than duplicated: this
      # EN | column is 444px tall and does not share its width with
      # EN | anything, so Top 10 (Cadre 1) stacks above Production/
      # EN | Consommation (Cadre 2) instead of sitting side by side. egy1's
      # EN | grid cell is left declared but empty — nothing else claims it
      # EN | yet.
      # FR | Remplace INTERPHONE / AUDIO STREAM — aucun des deux boutons
      # FR | n'avait de vraie entite ou action derriere. C'est le MEME
      # FR | panneau qui occupait la ligne egy1 plus bas (400px de haut,
      # FR | partagee en trois avec egy2/events/meteo), deplace ici plutot
      # FR | que duplique : cette colonne fait 444px de haut et ne partage
      # FR | pas sa largeur, donc Top 10 (Cadre 1) s'empile au-dessus de
      # FR | Production/Consommation (Cadre 2) plutot que cote a cote. La
      # FR | zone de grille egy1 reste declaree mais vide — rien d'autre ne
      # FR | la reclame pour l'instant.
      - type: vertical-stack
        view_layout:
          grid-area: right
        card_mod:
          style: |
            :host { height: 100%; display: block; }
            #root { height: 100%; overflow-y: auto; }
        cards:
          # Cadre 1 — top 10 appareils par consommation. Meme motif que le
          # panneau « Consommation par appareil » d'ENERGY (meme template
          # vssp_energy_device_row, meme liste defilante dans un unique
          # button-card) — seule la source change : les 10 premieres
          # entrees de energy_devices au lieu de la liste complete.
          # EN | card_mod on #root, not styles.card on the child button-cards
          # EN | (those keep background:transparent/border:none so the title
          # EN | and list don't double-frame each other) — this draws the
          # EN | single outer border/background around both, same recipe
          # EN | (background/border-radius/border) as the KPI row cards
          # EN | (System Status, Energy Status...) above — plain rgba(), not
          # EN | color-mix(): see the project-wide color-mix fix note near
          # EN | the top of this file.
          # FR | card_mod sur #root, pas styles.card sur les button-cards
          # FR | enfants (qui gardent background:transparent/border:none pour
          # FR | ne pas s'encadrer deux fois) — ceci dessine le seul cadre
          # FR | exterieur autour des deux, meme recette (background/
          # FR | border-radius/border) que les cartes de la ligne KPI (System
          # FR | Status, Energy Status...) ci-dessus — rgba() brut, pas
          # FR | color-mix() : voir la note de correction color-mix pres du
          # FR | debut de ce fichier.
          - type: vertical-stack
            card_mod:
              style: |
                #root {
                  background: var(--card-background-color, rgba(8,18,28,0.72));
                  border-radius: var(--ha-card-border-radius, 18px);
                  border: 1px solid rgba(0, 229, 255, 0.2);
                  padding: 14px 18px;
                }
            cards:
              # EN | Not `template: vssp_section_title` — that template is
              # EN | shared by every panel title across the whole project
              # EN | (energy.yaml.j2, core.yaml, room panels...), all
              # EN | left-aligned by design. Centering it there would
              # EN | recentre every one of them. Inlined here instead,
              # EN | identical styling except justify-content/justify-self:
              # EN | center — scoped to this one title only.
              # FR | Pas `template: vssp_section_title` — ce template est
              # FR | partage par tous les titres de panneau du projet
              # FR | (energy.yaml.j2, core.yaml, panneaux de piece...), tous
              # FR | alignes a gauche par conception. Le centrer la-bas
              # FR | recentrerait chacun d'entre eux. Mis en ligne ici a la
              # FR | place, style identique sauf justify-content/
              # FR | justify-self: center — limite a ce seul titre.
              - type: custom:button-card
                show_icon: false
                show_state: false
                show_label: false
                name: "{{ t('home.top_devices') }}"
                styles:
                  card:
                    - background: transparent
                    - box-shadow: none
                    - border: none
                    - padding: 2px 2px 10px 2px
                    - justify-content: center
                    - cursor: default
                    - pointer-events: none
                  name:
                    - color: "var(--text-primary-color, #FFFFFF)"
                    - font-size: 15px
                    - font-weight: 600
                    - letter-spacing: 1px
                    - justify-self: center
                    - text-align: center
                    - font-family: "Orbitron, sans-serif"

              # EN | Fixed pixel height, NOT height:100% — a percentage here
              # EN | has nothing concrete to resolve against, so the list
              # EN | never actually capped itself and just grew to fit all
              # EN | 10 rows. 300px, same overflow-y: auto scrollbar as
              # EN | ENERGY's own per-device panel (energy.yaml.j2), is the
              # EN | fix.
              # FR | Hauteur fixe en pixels, PAS height:100% — un pourcentage
              # FR | ici n'a rien de concret ou se resoudre, donc la liste ne
              # FR | se limitait jamais vraiment et grandissait pour caser
              # FR | les 10 lignes. 300px, meme ascenseur overflow-y: auto
              # FR | que le panneau par appareil d'ENERGY (energy.yaml.j2),
              # FR | est le correctif.
              - type: custom:button-card
                show_icon: false
                show_name: false
                show_state: false
                tap_action:
                  action: none
                styles:
                  grid:
                    - grid-template-areas: '"list"'
                  card:
                    - background: transparent
                    - box-shadow: none
                    - border: none
                    - border-radius: 0
                    - padding: 0
                    - cursor: default
                  custom_fields:
                    list:
                      - display: block
                      - width: 100%
                      - height: 300px
                      - overflow-y: auto
                      - overflow-x: hidden
                      - padding-right: 4px
                      - scrollbar-width: thin
                      - scrollbar-color: rgba(0, 229, 255, 0.35) rgba(0, 229, 255, 0.06)
                custom_fields:
                  list:
                    card:
                      type: vertical-stack
                      cards:
{% for d in energy_devices[:10] %}
                        - type: custom:button-card
                          template: vssp_energy_device_row
                          entity: {{ d.power_entity }}
                          name: "{{ d.name }}"
                          icon: {{ d.icon }}
                          variables:
                            room: "{{ d.room }}"
                            model: "{{ d.model | default('—', true) }}"
                            energy_entity: {{ d.energy_entity }}
                          tap_action:
                            action: more-info

{% endfor %}
{% if not energy_devices %}
                        - type: custom:button-card
                          template: vssp_energy_device_row
                          name: "{{ t('energy.empty.devices') }}"
                          icon: mdi:help-circle-outline
                          variables:
                            room: "—"
{% endif %}

          # Cadre 2 — Chatbot.
          # EN | Functional inline bar, not a trigger-only mockup anymore: a
          # EN | real `<input>` typed and sent from HOME itself, no popup
          # EN | involved in sending. custom_fields raw HTML cannot carry a
          # EN | working <script>, so the input/mic/send elements below call
          # EN | window.vsspChatbot's functions (js/vssp.js, loaded once as a
          # EN | lovelace resource) through plain onclick/onkeydown
          # EN | attributes — that file does the actual fetch() to
          # EN | /api/webhook/vssp_chatbot_send and polls
          # EN | chatbot_status.json exactly like vssp_chatbot.html does,
          # EN | showing the reply in a floating bubble anchored under the
          # EN | input (position:fixed, appended to <body> — see
          # EN | _ensureBubble there). The card's `entity:` is the provider
          # EN | selector so the leading badge (logo, or a generic icon for
          # EN | "custom") re-renders only when the active provider changes,
          # EN | not on every unrelated Home Assistant state update — that
          # EN | re-render would otherwise wipe whatever the user is
          # EN | mid-typing. That same badge is now the only way left to
          # EN | open the full conversation popup (input/mic/send handle
          # EN | their own actions), via window.vsspChatbot.openFullChat().
          # EN | Voice input is the Web Speech API, browser-side only — see
          # EN | the mic() comment in js/vssp.js for why it fills the input
          # EN | rather than auto-sending.
          # EN | Every onclick/onkeydown below passes `this` (the actual DOM
          # EN | element), never the input's id as a string: button-card
          # EN | renders custom_fields inside its own shadow root, and
          # EN | `document.getElementById()` from js/vssp.js cannot see past
          # EN | that boundary — it silently returns null, which is why send()
          # EN | and mic() resolve the bar's `<input>` through `.vssp-chat-bar`
          # EN | + `closest`/`querySelector` from the clicked element instead
          # EN | (see `_resolveInput()` in js/vssp.js).
          # FR | Barre en ligne fonctionnelle, plus une simple maquette
          # FR | declencheuse : un vrai `<input>` saisi et envoye depuis HOME
          # FR | lui-meme, aucun popup implique dans l'envoi. Le HTML brut
          # FR | des custom_fields ne peut pas porter de <script> qui
          # FR | s'execute, donc les elements input/mic/envoi ci-dessous
          # FR | appellent les fonctions de window.vsspChatbot (js/vssp.js,
          # FR | charge une fois comme ressource lovelace) via de simples
          # FR | attributs onclick/onkeydown — ce fichier fait le vrai
          # FR | fetch() vers /api/webhook/vssp_chatbot_send et interroge
          # FR | chatbot_status.json exactement comme vssp_chatbot.html,
          # FR | affichant la reponse dans une bulle flottante ancree sous
          # FR | le champ (position:fixed, ajoutee a <body> — voir
          # FR | _ensureBubble la-bas). Le `entity:` de la carte est le
          # FR | selecteur de fournisseur pour que le badge de tete (logo,
          # FR | ou une icone generique pour "custom") ne se re-rende que
          # FR | quand le fournisseur actif change, pas a chaque mise a jour
          # FR | d'etat Home Assistant sans rapport — ce re-rendu
          # FR | effacerait sinon ce que l'utilisateur est en train de
          # FR | taper. Ce meme badge est desormais le seul moyen restant
          # FR | d'ouvrir le popup de conversation complete (input/mic/envoi
          # FR | gerent leurs propres actions), via
          # FR | window.vsspChatbot.openFullChat(). La saisie vocale est la
          # FR | Web Speech API, cote navigateur uniquement — voir le
          # FR | commentaire de mic() dans js/vssp.js pour pourquoi elle
          # FR | remplit le champ plutot que d'envoyer automatiquement.
          # FR | Chaque onclick/onkeydown ci-dessous passe `this` (l'element
          # FR | DOM reel), jamais l'id du champ en chaine : button-card rend
          # FR | ses custom_fields dans son propre shadow root, et
          # FR | `document.getElementById()` depuis js/vssp.js ne voit pas au
          # FR | dela de cette frontiere — il renvoie null en silence, d'ou le
          # FR | fait que send() et mic() resolvent le `<input>` de la barre
          # FR | via `.vssp-chat-bar` + `closest`/`querySelector` depuis
          # FR | l'element clique a la place (voir `_resolveInput()` dans
          # FR | js/vssp.js).
          - type: custom:button-card
            template: vssp_panel
            entity: input_select.vssp_chatbot_provider
            show_name: false
            show_label: false
            show_icon: false
            show_state: false
            styles:
              card:
                - height: 100%
                - padding: 10px 14px
                - justify-content: center
              grid:
                - grid-template-areas: '"bar"'
              custom_fields:
                bar:
                  - width: 100%
                  - height: 100%
            custom_fields:
              bar: >
                [[[
                  const provider = (states['input_select.vssp_chatbot_provider'] || {}).state || 'claude';
                  const logos = {
                    gemini: '/local/vssp/images/providers/gemini.svg',
                    claude: '/local/vssp/images/providers/claude.svg',
                    chatgpt: '/local/vssp/images/providers/chatgpt.svg',
                  };
                  const logo = logos[provider];
                  const badge = logo
                    ? `<img src="${logo}" alt="${provider}" data-title="{{ t('home.chatbot') }}" onclick="window.vsspChatbot.openFullChat(this)" style="width:22px;height:22px;border-radius:6px;cursor:pointer;flex:0 0 auto;" />`
                    : `<ha-icon icon="mdi:tune-variant" data-title="{{ t('home.chatbot') }}" onclick="window.vsspChatbot.openFullChat(this)" style="--mdc-icon-size:22px;color:var(--primary-color,#00E5FF);cursor:pointer;flex:0 0 auto;"></ha-icon>`;
                  return `
                    <div class="vssp-chat-bar" style="display:flex;align-items:center;width:100%;height:100%;gap:10px;">
                      ${badge}
                      <input
                        id="vssp_home_chat_input"
                        type="text"
                        placeholder="{{ t('home.chatbot_placeholder') }}"
                        autocomplete="off"
                        data-error-prefix="{{ t('home.chatbot_error_prefix') }}"
                        data-no-reply="{{ t('home.chatbot_no_reply') }}"
                        data-empty-reply="{{ t('home.chatbot_empty_reply') }}"
                        data-mic-unsupported="{{ t('home.chatbot_mic_unsupported') }}"
                        onkeydown="if (event.key === 'Enter') window.vsspChatbot.send(this);"
                        style="flex:1 1 auto;min-width:0;border:none;outline:none;background:transparent;color:var(--primary-text-color,#DCEEF6);font-size:14px;padding:0;"
                      />
                      <ha-icon
                        icon="mdi:microphone-outline"
                        onclick="window.vsspChatbot.mic(this)"
                        style="--mdc-icon-size:20px;color:var(--secondary-text-color,#56707E);cursor:pointer;flex:0 0 auto;"
                      ></ha-icon>
                      <ha-icon
                        icon="mdi:arrow-up-circle"
                        onclick="window.vsspChatbot.send(this)"
                        style="--mdc-icon-size:26px;color:var(--primary-color,#00E5FF);cursor:pointer;flex:0 0 auto;"
                      ></ha-icon>
                    </div>
                  `;
                ]]]


    card_mod:
      style: |
        hui-view {
          background: center / cover no-repeat fixed url("/local/vssp/backgrounds/home.png");
        }

