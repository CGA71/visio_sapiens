      # --- Événements récents (aligné avec le bas de la sidebar) --------
      # EN | Spans the full row now (nav..meteo) — egy1/egy2 used to hold
      # EN | the Top 10 / Production-Consommation panel, moved to the
      # EN | "right" grid area above (see the comment there), and both
      # EN | freed columns were added to this slot rather than left empty.
      # FR | Occupe toute la ligne desormais (nav..meteo) — egy1/egy2
      # FR | contenaient le panneau Top 10 / Production-Consommation,
      # FR | deplace vers la zone de grille "right" ci-dessus (voir le
      # FR | commentaire la-bas), et les deux colonnes liberees ont ete
      # FR | ajoutees a ce tableau plutot que laissees vides.
      - type: logbook
        title: "{{ t('home.events_recent') }}"
        hours_to_show: 24
        view_layout:
          grid-area: events
{% if rooms_rendered %}
        target:
          # EN | Generated from the declared rooms rather than hardcoded. The
          # EN | hand-written list already named areas that no longer match
          # EN | house.yaml (kitchen, garden_1, livingroom...), so the logbook
          # EN | silently dropped events for any room added since.
          # EN | `area_id` defaults to the room id; set it explicitly in
          # EN | house.yaml when the Home Assistant area is named differently.
          # FR | Genere depuis les pieces declarees plutot que code en dur. La
          # FR | liste ecrite a la main nommait deja des zones qui ne
          # FR | correspondent plus a house.yaml (kitchen, garden_1,
          # FR | livingroom...), donc le journal ignorait en silence les
          # FR | evenements de toute piece ajoutee depuis.
          # FR | `area_id` vaut l'id de la piece par defaut ; le definir
          # FR | explicitement dans house.yaml quand la zone Home Assistant
          # FR | porte un autre nom.
          area_id:
{% for r in rooms_rendered %}
            - {{ r.area_id }}
{% endfor %}
{% else %}
        # EN | No room declared yet: an empty `area_id:` list renders as a
        # EN | null target, which Home Assistant's logbook card rejects as
        # EN | an invalid config ("Erreur de configuration") instead of
        # EN | showing anything. Omitting `target` entirely falls back to
        # EN | every event, which is the sane behaviour before ROOMS has run.
        # FR | Aucune piece declaree pour l'instant : une liste `area_id:`
        # FR | vide se rend en cible null, que la carte logbook de Home
        # FR | Assistant rejette comme configuration invalide (« Erreur de
        # FR | configuration ») plutot que d'afficher quoi que ce soit. Omettre
        # FR | `target` bascule sur tous les evenements, comportement sense
        # FR | avant le premier passage de ROOMS.
{% endif %}
        card_mod:
          style: |
            # EN | height:100% alone left this card shorter than its 400px
            # EN | grid row — percentage height only resolves against a
            # EN | parent with a DEFINITE height, and whatever
            # EN | custom:grid-layout wraps this card in apparently is not
            # EN | one. The weather card next to it never had this problem
            # EN | because dynamic-weather-card takes an explicit `height:
            # EN | 400` YAML property (an actual pixel value, not CSS
            # EN | percentage) — logbook has no such option, so min-height:
            # EN | 400px here is the equivalent hard floor.
            # FR | height:100% seul laissait cette carte plus courte que sa
            # FR | ligne de grille de 400px — une hauteur en pourcentage ne
            # FR | se resout que contre un parent de hauteur DEFINIE, et ce
            # FR | dans quoi custom:grid-layout enveloppe cette carte n'en
            # FR | est visiblement pas un. La carte meteo juste a cote n'a
            # FR | jamais eu ce probleme car dynamic-weather-card prend une
            # FR | propriete YAML `height: 400` explicite (une vraie valeur
            # FR | en pixels, pas un pourcentage CSS) — logbook n'a pas cette
            # FR | option, donc min-height: 400px ici est le plancher
            # FR | equivalent.
            :host {
              height: 100%;
              min-height: 400px;
              display: block;
              overflow: hidden;
            }
            ha-card {
              background: var(--osv-panel) !important;
              height: 100% !important;
              min-height: 400px;
              display: flex;
              flex-direction: column;
              overflow: hidden;
              --primary-text-color: #B8E8F5 !important;
              --secondary-text-color: #8FB6C9 !important;
              --primary-color: #00E5FF !important;
              --text-primary-color: #FFFFFF !important;
              --card-background-color: var(--osv-panel) !important;
            }
            ha-card .card-header {
              color: #FFFFFF !important;
            }
            ha-logbook {
              flex: 1 1 0;
              min-height: 0;
              overflow-y: auto;
            }

