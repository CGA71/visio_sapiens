########################################################################
# Visio Sapiens — ENERGY Dashboard
#
# *** GENERATED FILE — DO NOT EDIT BY HAND ***
# *** FICHIER GENERE — NE PAS EDITER A LA MAIN ***
#
# EN | Source: energy.yaml.j2 + model/house.yaml + locales/<code>.yaml
# FR | Source : energy.yaml.j2 + model/house.yaml + locales/<code>.yaml
# EN | Regenerate with: python3 generate_dashboards.py
# FR | Regenerer avec : python3 generate_dashboards.py
#
# EN | Expected location in the repo:
# FR | Emplacement attendu dans le depot :
#   home-assistant/dashboards/views/energy.yaml
#
# EN | Same principle as core.yaml: a STANDALONE Lovelace dashboard,
# EN | declared in configuration.yaml under `lovelace: dashboards:` with
# EN | url_path "vssp-energy". It therefore keeps the full
# EN | "title: / views: [...]" wrapper at root level — without it Lovelace
# EN | displays no card at all.
# FR | Meme principe que core.yaml : dashboard Lovelace AUTONOME, declare
# FR | dans configuration.yaml sous `lovelace: dashboards:` avec url_path
# FR | "vssp-energy". Il garde donc le wrapper complet
# FR | "title: / views: [...]" au niveau racine — sans lui, Lovelace
# FR | n'affiche plus aucune carte.
#
# EN | The header band and the navigation rail now come from the shared
# EN | partials _header.j2 and _nav.j2. They used to be ~165 duplicated
# EN | lines here. Two consequences worth knowing:
# EN |   - the date is produced by Intl.DateTimeFormat(locale_tag), so it
# EN |     follows the language with no hardcoded weekday arrays;
# EN |   - the rail is dynamic: 4 system entries + the declared rooms.
# FR | Le bandeau horizontal et le bandeau de navigation viennent desormais
# FR | des partials partages _header.j2 et _nav.j2. C'etait auparavant ~165
# FR | lignes dupliquees ici. Deux consequences a connaitre :
# FR |   - la date est produite par Intl.DateTimeFormat(locale_tag), elle
# FR |     suit donc la langue sans tableau de jours code en dur ;
# FR |   - le bandeau est dynamique : 4 entrees systeme + les pieces
# FR |     declarees.
#
# EN | Every displayed string goes through t('key'). Nothing is hardcoded
# EN | in one language — including the input_select tab labels, whose
# EN | STORED VALUES stay Day/Month/Year because the JS below compares
# EN | them. See the migration note in energy_config_snippets.yaml.
# FR | Toute chaine affichee passe par t('cle'). Rien n'est code en dur
# FR | dans une langue — y compris les libelles d'onglets de l'input_select,
# FR | dont les VALEURS STOCKEES restent Day/Month/Year car le JS ci-dessous
# FR | les compare. Voir la note de migration dans
# FR | energy_config_snippets.yaml.
#
# EN | PREREQUISITES / FR | PREREQUIS
# EN | 1. Append the templates from button_card_templates_energy_append.yaml
# EN |    TO THE END of templates/button_card_templates.yaml
# EN | 2. Create the helpers and sensors from energy_config_snippets.yaml
# EN | 3. Entities, rooms, devices and circuits are defined in
# EN |    model/house.yaml — that is where a new object is added, never here.
# FR | 1. Ajouter les templates du fichier
# FR |    button_card_templates_energy_append.yaml A LA FIN de
# FR |    templates/button_card_templates.yaml
# FR | 2. Creer les helpers + capteurs du fichier energy_config_snippets.yaml
# FR | 3. Les entites, pieces, appareils et circuits sont definis dans
# FR |    model/house.yaml — c'est LA qu'on ajoute un nouvel objet, jamais ici.
#
# EN | HACS cards used: button-card, card-mod, layout-card,
# EN | apexcharts-card, mini-graph-card, config-template-card.
# FR | Cartes HACS utilisees : button-card, card-mod, layout-card,
# FR | apexcharts-card, mini-graph-card, config-template-card.
########################################################################
title: {{ energy.title }}
theme: {{ house.theme }}

# EN | Required: without these includes every custom:button-card shows
# EN | "Configuration error". Path is relative to dashboards/views/.
# FR | Indispensable : sans ces includes, chaque custom:button-card affiche
# FR | « Erreur de configuration ». Chemin relatif a dashboards/views/.
button_card_templates: !include ../templates/button_card_templates.yaml
decluttering_templates: !include ../templates/decluttering_templates.yaml

views:
  - title: {{ energy.title }}
    path: {{ energy.view_path }}
    subview: false
    type: custom:grid-layout
    layout:
      grid-template-columns: max-content 1fr 1fr 1fr 1fr 1fr
      grid-template-rows: auto 418px 236px auto
      grid-template-areas: |
        "nav header header header header header"
        "nav solar solar devices devices total"
        "nav flow flow flow edf edf"
        "nav board board board board board"
      margin: 12px
      grid-gap: 14px 14px
    cards:
      # ═══════════════════════════════════════════════════════════════
      # EN | HEADER BAND — shared partial, identical on every dashboard
      # FR | BANDEAU HORIZONTAL — partial partage, identique partout
      # ═══════════════════════════════════════════════════════════════
      # EN | Was ~95 lines duplicated here. Extracting it means the date now
      # EN | comes from Intl.DateTimeFormat(locale_tag) instead of hardcoded
      # EN | French weekday and month arrays — one change, every language.
      # FR | C'etait ~95 lignes dupliquees ici. L'extraire fait que la date
      # FR | vient desormais d'Intl.DateTimeFormat(locale_tag) au lieu de
      # FR | tableaux de jours et de mois francais codes en dur — un seul
      # FR | changement, toutes les langues.
{% set page_title = energy.title %}
{% set page_subtitle = t('page.energy.subtitle') %}
{% set page_path = '/' ~ energy.url_path ~ '/' ~ energy.view_path %}
{% include '_header.j2' %}

      # ═══════════════════════════════════════════════════════════════
      # EN | NAVIGATION RAIL — shared partial, dynamic
      # FR | BANDEAU DE NAVIGATION — partial partage, dynamique
      # ═══════════════════════════════════════════════════════════════
      # EN | The rail length is now 4 system entries + the declared rooms.
      # EN | It used to be a fixed hand-maintained list.
      # FR | La longueur du bandeau vaut desormais 4 entrees systeme + les
      # FR | pieces declarees. C'etait auparavant une liste fixe maintenue
      # FR | a la main.
{% include '_nav.j2' %}

      # ═══════════════════════════════════════════════════════════════
      # EN | PANEL 1 — SOLAR PRODUCTION
      # FR | PANNEAU 1 — PRODUCTION SOLAIRE
      # ═══════════════════════════════════════════════════════════════
      - type: vertical-stack
        view_layout:
          grid-area: solar
        card_mod:
          style: |
            {# EN | border-box, like PER-DEVICE CONSUMPTION: in content-box the
               EN | 32px of padding and 2px of border were ADDED to height 100%,
               EN | so this frame measured 440px in its 406px cell — 34px taller
               EN | than its neighbour and spilling over the row below.
               FR | border-box, comme CONSOMMATION PAR APPAREIL : en content-box
               FR | les 32px de padding et 2px de bordure s'AJOUTAIENT a height
               FR | 100%, ce cadre mesurait donc 440px dans sa cellule de 406px —
               FR | 34px de plus que son voisin, en debordant sur la ligne du
               FR | dessous. #}
            :host {
              display: flex;
              flex-direction: column;
              height: 100%;
              box-sizing: border-box;
              background: var(--card-background-color, rgba(8,18,28,0.75));
              border-radius: var(--ha-card-border-radius, 20px);
              border: 1px solid rgba(0, 229, 255, 0.28);
              backdrop-filter: blur(12px);
              box-shadow: 0 0 18px rgba(0, 229, 255, 0.15);
              padding: 16px 18px;
              overflow: hidden;
            }
        cards:
          - type: custom:button-card
            template: vssp_section_title
            name: "{{ t('energy.panel.solar_production') }}"

          # ── Haut : capacité + illustration | jauge + cumuls ─────────
          - type: horizontal-stack
            cards:
              - type: vertical-stack
                card_mod:
                  style: |
                    :host { flex: 1 1 0; }
                cards:
                  - type: custom:button-card
                    template: vssp_energy_stat
                    entity: {{ energy.solar.capacity_helper }}
                    label: "{{ t('energy.stat.annual_capacity') }}"
                    variables:
                      accent: "#00FFC3"
                      size: "20px"
                  - type: custom:button-card
                    show_name: false
                    show_state: false
                    show_icon: true
                    icon: mdi:solar-power-variant
                    styles:
                      card:
                        - background: transparent
                        - box-shadow: none
                        - border: none
                        - padding: 10px 0
                        - cursor: default
                        - pointer-events: none
                      icon:
                        - color: "#FFD700"
                        - "--mdc-icon-size": 82px
                        - filter: drop-shadow(0 0 18px rgba(255,215,0,.45))

              # ── Jauge de production instantanée ────────────────────
              - type: vertical-stack
                card_mod:
                  style: |
                    :host { flex: 1 1 0; }
                cards:
                  - type: custom:apexcharts-card
                    chart_type: radialBar
                    header:
                      show: false
                    series:
                      - entity: {{ energy.solar.power }}
                        name: "{{ t('energy.flow.current_production') }}"
                        min: 0
                        max: 10                                  # TODO : puissance crête kW
                    apex_config:
                      chart:
                        height: 168
                      plotOptions:
                        radialBar:
                          startAngle: -110
                          endAngle: 110
                          hollow:
                            size: "64%"
                          track:
                            background: "rgba(255,255,255,0.07)"
                          dataLabels:
                            name:
                              show: false
                            value:
                              fontSize: "24px"
                              fontWeight: 700
                              color: "#FFFFFF"
                              offsetY: 4
                      colors: ["#00FFC3"]
                      stroke:
                        lineCap: round
                    card_mod:
                      style: |
                        ha-card {
                          background: transparent !important;
                          border: none !important;
                          box-shadow: none !important;
                        }

                  - type: horizontal-stack
                    cards:
                      - type: custom:button-card
                        template: vssp_energy_stat
                        entity: {{ energy.solar.today }}
                        label: "{{ t('energy.stat.today') }}"
                        variables:
                          accent: "#FFFFFF"
                          size: "18px"
                      - type: custom:button-card
                        template: vssp_energy_stat
                        entity: {{ energy.solar.month }}
                        label: "{{ t('energy.stat.this_month') }}"
                        variables:
                          accent: "#FFFFFF"
                          size: "18px"

                  - type: custom:button-card
                    template: vssp_energy_stat
                    entity: {{ energy.solar.year }}
                    label: "{{ t('energy.stat.this_year') }}"
                    variables:
                      accent: "#00FFC3"
                      size: "18px"

          # ── Bas : sous-panneau courbe de production ─────────────────
          - type: vertical-stack
            card_mod:
              style: |
                :host {
                  display: block;
                  margin-top: 10px;
                  background: rgba(0,0,0,.25);
                  border: 1px solid rgba(0, 229, 255, 0.14);
                  border-radius: 16px;
                  padding: 12px 14px;
                }
            cards:
              - type: horizontal-stack
                cards:
                  - type: custom:button-card
                    template: vssp_section_title
                    name: "Production (kWh)"
                    styles:
                      name:
                        - font-size: calc(12px * var(--vssp-scale-title, 1))
                        - font-family: inherit
                      card:
                        - padding: 0
                    card_mod:
                      style: |
                        :host { flex: 1.4 1 0; display: flex; align-items: center; }
                  # EN | Day / Month / Year tabs (they drive the input_select).
          # EN | The DISPLAYED label is translated; the STORED value stays
          # EN | English because the JS below compares it.
          # FR | Onglets Jour / Mois / Annee (pilotent l'input_select).
          # FR | Le libelle AFFICHE est traduit ; la valeur STOCKEE reste
          # FR | en anglais car le JS ci-dessous la compare.
                  - type: custom:button-card
                    template: vssp_energy_tab
                    entity: {{ energy.period_helper }}
                    name: "{{ t('energy.tab.day') }}"
                    icon: mdi:weather-sunny
                    variables:
                      period: Day
                    tap_action:
                      action: call-service
                      service: input_select.select_option
                      service_data:
                        entity_id: {{ energy.period_helper }}
                        option: Day
                  - type: custom:button-card
                    template: vssp_energy_tab
                    entity: {{ energy.period_helper }}
                    name: "{{ t('energy.tab.month') }}"
                    icon: mdi:calendar-month
                    variables:
                      period: Month
                    tap_action:
                      action: call-service
                      service: input_select.select_option
                      service_data:
                        entity_id: {{ energy.period_helper }}
                        option: Month
                  - type: custom:button-card
                    template: vssp_energy_tab
                    entity: {{ energy.period_helper }}
                    name: "{{ t('energy.tab.year') }}"
                    icon: mdi:calendar
                    variables:
                      period: Year
                    tap_action:
                      action: call-service
                      service: input_select.select_option
                      service_data:
                        entity_id: {{ energy.period_helper }}
                        option: Year

              # Courbe : la période suit l'input_select via config-template-card
              - type: custom:config-template-card
                entities:
                  - {{ energy.period_helper }}
                card:
                  type: custom:apexcharts-card
                  header:
                    show: false
                  graph_span: >-
                    ${ states['{{ energy.period_helper }}'].state === 'Day' ? '24h'
                       : states['{{ energy.period_helper }}'].state === 'Month' ? '30d' : '365d' }
                  span:
                    start: >-
                      ${ states['{{ energy.period_helper }}'].state === 'Day' ? 'day'
                         : states['{{ energy.period_helper }}'].state === 'Month' ? 'month' : 'year' }
                  series:
                    - entity: {{ energy.solar.power }}
                      name: "{{ t('energy.panel.solar_production') }}"
                      type: column
                      color: "#00FFC3"
                      group_by:
                        func: avg
                        duration: >-
                          ${ states['{{ energy.period_helper }}'].state === 'Day' ? '30min'
                             : states['{{ energy.period_helper }}'].state === 'Month' ? '1d' : '30d' }
                  apex_config:
                    chart:
                      height: 132
                    legend:
                      show: true
                      position: top
                      horizontalAlign: left
                      labels:
                        colors: "#8FB6C9"
                    grid:
                      borderColor: "rgba(255,255,255,0.06)"
                    xaxis:
                      labels:
                        style:
                          colors: "#56707E"
                          fontSize: "10px"
                    yaxis:
                      labels:
                        style:
                          colors: "#56707E"
                          fontSize: "10px"
                    plotOptions:
                      bar:
                        columnWidth: "62%"
                        borderRadius: 2
                  card_mod:
                    style: |
                      ha-card {
                        background: transparent !important;
                        border: none !important;
                        box-shadow: none !important;
                      }

              # Pied : capacité annuelle + % de l'objectif
              - type: custom:button-card
                show_icon: false
                show_name: false
                show_state: false
                entity: {{ energy.solar.year }}
                custom_fields:
                  cap: |
                    [[[
                      const LOCALE = '{{ locale_tag }}';
                      const c = states['{{ energy.solar.capacity_helper }}'];
                      const cap = c ? Number(c.state) : 12500;
                      return '<span style="color:#56707E;font-size:calc(11px * var(--vssp-scale-label, 1))">{{ t('energy.stat.annual_capacity') }}: ' +
                             cap.toLocaleString(LOCALE) + ' kWh</span>';
                    ]]]
                  goal: |
                    [[[
                      const LOCALE = '{{ locale_tag }}';
                      const c = states['{{ energy.solar.capacity_helper }}'];
                      const cap = c ? Number(c.state) : 12500;
                      const y = entity && !isNaN(Number(entity.state)) ? Number(entity.state) : 0;
                      const pct = cap > 0 ? (y / cap * 100) : 0;
                      return '<span style="color:#00E5FF;font-size:calc(11px * var(--vssp-scale-label, 1));font-weight:600">' +
                             pct.toLocaleString(LOCALE, { maximumFractionDigits: 1 }) +
                             '% de l\'objectif annuel</span>';
                    ]]]
                styles:
                  grid:
                    - grid-template-areas: '"cap goal"'
                    - grid-template-columns: 1fr auto
                    - align-items: center
                  card:
                    - background: transparent
                    - box-shadow: none
                    - border: none
                    - border-top: 1px solid rgba(0, 229, 255, 0.1)
                    - border-radius: 0
                    - padding: 10px 0 0 0
                    - cursor: default
                    - pointer-events: none
                  custom_fields:
                    cap:
                      - justify-self: start
                      - text-align: left
                    goal:
                      - justify-self: end
                      - text-align: right

      # ═══════════════════════════════════════════════════════════════
      # EN | PANEL 2 — PER-DEVICE CONSUMPTION
      # FR | PANNEAU 2 — CONSOMMATION PAR APPAREIL
      # ═══════════════════════════════════════════════════════════════
      - type: vertical-stack
        view_layout:
          grid-area: devices
        card_mod:
          style: |
            :host {
              display: flex;
              flex-direction: column;
              height: 100%;
              box-sizing: border-box;
              background: var(--card-background-color, rgba(8,18,28,0.75));
              border-radius: var(--ha-card-border-radius, 20px);
              border: 1px solid rgba(0, 229, 255, 0.28);
              backdrop-filter: blur(12px);
              box-shadow: 0 0 18px rgba(0, 229, 255, 0.15);
              padding: 16px 18px;
              overflow: hidden;
            }
        cards:
          - type: custom:button-card
            template: vssp_section_title
            name: "{{ t('energy.panel.per_device') }}"

          # ── En-têtes de colonnes ───────────────────────────────────
          - type: custom:button-card
            show_icon: false
            show_name: false
            show_state: false
            custom_fields:
              c1: '<span style="color:#56707E;font-size:calc(11px * var(--vssp-scale-label, 1))">{{ t('energy.col.device') }}</span>'
              # EN | "Power", not the Total Consumption panel title it used to
              # EN | borrow: this column is the instant draw in W, and the
              # EN | panel title does not fit a 52px column.
              # FR | « Puissance », pas le titre du panneau Consommation totale
              # FR | qu'elle empruntait : cette colonne est l'appel instantane
              # FR | en W, et ce titre ne tient pas dans 52px.
              c2: >
                <span style="color:#8FB6C9;font-size:calc(11px * var(--vssp-scale-label, 1));display:block;text-align:right">{{ t('energy.col.power') }}<br>
                <span style="color:#56707E;font-size:calc(9px * var(--vssp-scale-label, 1))">{{ t('energy.col.power_hint') }}</span></span>
              c3: >
                <span style="color:#8FB6C9;font-size:calc(11px * var(--vssp-scale-label, 1));display:block;text-align:right">{{ t('energy.col.energy') }}<br>
                <span style="color:#56707E;font-size:calc(9px * var(--vssp-scale-label, 1))">{{ t('energy.col.energy_hint') }}</span></span>
            styles:
              grid:
                # EN | Same columns as vssp_energy_device_row, c1 spanning its
                # EN | icon + name, so the headings sit over their values.
                # FR | Memes colonnes que vssp_energy_device_row, c1 couvrant
                # FR | icone + nom, pour que les titres tombent sur leurs valeurs.
                - grid-template-areas: '"c1 c2 c3 pad"'
                - grid-template-columns: 1fr 52px 62px 12px
                - column-gap: 6px
                - align-items: center
              card:
                - background: rgba(0,0,0,.22)
                - box-shadow: none
                - border: none
                - border-radius: 10px
                - padding: 8px 10px
                - margin-bottom: 4px
                - cursor: default
                - pointer-events: none
              custom_fields:
                c1:
                  - justify-self: start
                  - text-align: left
                c2:
                  - justify-self: end
                  - text-align: right
                c3:
                  - justify-self: end
                  - text-align: right

          # ── Liste des appareils (défilante) ────────────────────────
          # Même principe que le panneau « Événements récents » de
          # home.yaml : le défilement vit DANS une vraie carte unique.
          # Ici les 9 lignes sont embarquées dans un button-card dont
          # le champ « list » a une hauteur fixe + overflow — c'est le
          # moteur de styles de button-card qui s'en charge, pas
          # card-mod. Ajustez `height` (250px) si besoin.
          - type: custom:button-card
            show_icon: false
            show_name: false
            show_state: false
            tap_action:
              action: none
            styles:
              grid:
                - grid-template-areas: '"list"'
              card:
                - background: transparent
                - box-shadow: none
                - border: none
                - border-radius: 0
                - padding: 0
                - cursor: default
              custom_fields:
                list:
                  - display: block
                  - width: 100%
                  - height: 250px
                  - overflow-y: auto
                  - overflow-x: hidden
                  - padding-right: 4px
                  - scrollbar-width: thin
                  - scrollbar-color: rgba(0, 229, 255, 0.35) rgba(0, 229, 255, 0.06)
            custom_fields:
              list:
                card:
                  type: vertical-stack
                  cards:
                    # ── Lignes appareils ──────────────────────────────
                    # EN | FLAT list: the ENERGY dashboard is not a room
                    # EN | dashboard, and the rows carry no room column.
                    # FR | Liste PLATE : le dashboard ENERGY n'est pas un
                    # FR | dashboard de pièce, et les lignes n'ont pas de
                    # FR | colonne pièce.
                    # Alimentée par vssp_energy_sync.py (ajout/retrait
                    # automatique selon les entités présentes dans HA).
{% for d in energy_devices %}
                    - type: custom:button-card
                      template: vssp_energy_device_row
                      entity: {{ d.power_entity }}
                      name: "{{ d.name }}"
                      icon: {{ d.icon }}
                      variables:
                        model: "{{ d.model | default('—', true) }}"
                        energy_entity: {{ d.energy_entity }}
                      tap_action:
                        action: more-info

{% endfor %}
{% if not energy_devices %}
                    # Aucun appareil avec capteurs puissance + énergie
                    # détecté. Lancez vssp_energy_sync.py ou complétez
                    # model/energy_devices.yaml.
                    - type: custom:button-card
                      template: vssp_energy_device_row
                      name: "{{ t('energy.empty.devices') }}"
                      icon: mdi:help-circle-outline
                      variables:
                        model: "vssp_energy_sync.py"
{% endif %}
          # ── EN | Total / FR | Total ───────────────────────────────
          - type: custom:button-card
            template: vssp_energy_total_row
            entity: {{ energy.totals.power }}
            name: "{{ t('energy.stat.total') }}"

      # ═══════════════════════════════════════════════════════════════
      # EN | PANEL 3 — TOTAL CONSUMPTION
      # FR | PANNEAU 3 — CONSOMMATION TOTALE
      # ═══════════════════════════════════════════════════════════════
      - type: vertical-stack
        view_layout:
          grid-area: total
        card_mod:
          style: |
            {# EN | border-box — same 34px overflow as SOLAR PRODUCTION above.
               FR | border-box — meme debordement de 34px que PRODUCTION SOLAIRE. #}
            :host {
              display: flex;
              flex-direction: column;
              height: 100%;
              box-sizing: border-box;
              background: var(--card-background-color, rgba(8,18,28,0.75));
              border-radius: var(--ha-card-border-radius, 20px);
              border: 1px solid rgba(0, 229, 255, 0.28);
              backdrop-filter: blur(12px);
              box-shadow: 0 0 18px rgba(0, 229, 255, 0.15);
              padding: 16px 18px;
              overflow: hidden;
            }
        cards:
          - type: custom:button-card
            template: vssp_section_title
            name: "{{ t('energy.panel.total_consumption') }}"

          # Onglets (partagent le même input_select que la production)
          - type: horizontal-stack
            cards:
              - type: custom:button-card
                template: vssp_energy_tab
                entity: {{ energy.period_helper }}
                name: "{{ t('energy.tab.day') }}"
                icon: mdi:weather-sunny
                variables:
                  period: Day
                tap_action:
                  action: call-service
                  service: input_select.select_option
                  service_data:
                    entity_id: {{ energy.period_helper }}
                    option: Day
              - type: custom:button-card
                template: vssp_energy_tab
                entity: {{ energy.period_helper }}
                name: "{{ t('energy.tab.month') }}"
                icon: mdi:calendar-month
                variables:
                  period: Month
                tap_action:
                  action: call-service
                  service: input_select.select_option
                  service_data:
                    entity_id: {{ energy.period_helper }}
                    option: Month
              - type: custom:button-card
                template: vssp_energy_tab
                entity: {{ energy.period_helper }}
                name: "{{ t('energy.tab.year') }}"
                icon: mdi:calendar
                variables:
                  period: Year
                tap_action:
                  action: call-service
                  service: input_select.select_option
                  service_data:
                    entity_id: {{ energy.period_helper }}
                    option: Year

          - type: custom:button-card
            template: vssp_energy_kpi
            entity: {{ energy.totals.today }}
            icon: mdi:chart-bar
            label: "{{ t('energy.stat.today') }}"
            variables:
              accent: "#00E5FF"

          - type: custom:button-card
            template: vssp_energy_kpi
            entity: {{ energy.totals.month }}
            icon: mdi:calendar-month
            label: "{{ t('energy.stat.this_month') }}"
            variables:
              accent: "#00E5FF"

          - type: custom:button-card
            template: vssp_energy_kpi
            entity: {{ energy.totals.year }}
            icon: mdi:calendar-star
            label: "{{ t('energy.stat.this_year') }}"
            variables:
              accent: "#00E5FF"

      # ═══════════════════════════════════════════════════════════════
      # PANNEAU 4 — SCHÉMA DE FONCTIONNEMENT (flux d'énergie)
      # ═══════════════════════════════════════════════════════════════
      - type: vertical-stack
        view_layout:
          grid-area: flow
        card_mod:
          style: |
            :host {
              display: flex;
              flex-direction: column;
              height: 100%;
              background: var(--card-background-color, rgba(8,18,28,0.75));
              border-radius: var(--ha-card-border-radius, 20px);
              border: 1px solid rgba(0, 229, 255, 0.28);
              backdrop-filter: blur(12px);
              box-shadow: 0 0 18px rgba(0, 229, 255, 0.15);
              padding: 16px 18px;
              overflow: hidden;
            }
        cards:
          - type: custom:button-card
            template: vssp_section_title
            name: "{{ t('energy.panel.flow') }}"

          - type: custom:button-card
            show_icon: false
            show_name: false
            show_state: false
            triggers_update:
              - {{ energy.solar.power }}
              - {{ energy.totals.power }}
              - {{ energy.grid.export_power }}
              - {{ energy.grid.import_power }}
              - {{ energy.solar.inverter_running }}
            custom_fields:
              diagram: |
                [[[
                  const LOCALE = '{{ locale_tag }}';
                  const val = (id, dec) => {
                    const s = states[id];
                    if (!s || isNaN(Number(s.state))) return '—';
                    return Number(s.state).toLocaleString(LOCALE, { minimumFractionDigits: dec, maximumFractionDigits: dec });
                  };
                  const node = (icon, title, sub, subColor, val, valColor) =>
                    '<div style="display:flex;flex-direction:column;align-items:center;gap:6px;min-width:96px;">' +
                      '<div style="color:#8FB6C9;font-size:calc(11px * var(--vssp-scale-label, 1));font-weight:600;letter-spacing:.5px;">' + title + '</div>' +
                      '<div style="width:64px;height:64px;border-radius:16px;display:flex;align-items:center;justify-content:center;' +
                        'background:rgba(0, 229, 255, 0.07);border:1px solid rgba(0, 229, 255, 0.2);">' +
                        '<ha-icon icon="' + icon + '" style="--mdc-icon-size:34px;color:' + valColor + ';"></ha-icon>' +
                      '</div>' +
                      '<div style="color:#56707E;font-size:calc(10px * var(--vssp-scale-label, 1));">' + sub + '</div>' +
                      '<div style="color:' + valColor + ';font-size:calc(15px * var(--vssp-scale-value, 1));font-weight:700;font-family:var(--vssp-font-display,Orbitron,sans-serif);">' + val + '</div>' +
                    '</div>';
                  const arrow = (color) =>
                    '<div style="flex:1;display:flex;align-items:center;justify-content:center;padding-top:34px;min-width:44px;">' +
                      '<div style="height:2px;width:100%;background:linear-gradient(90deg,transparent,' + color + ');"></div>' +
                      '<ha-icon icon="mdi:menu-right" style="--mdc-icon-size:20px;color:' + color + ';margin-left:-8px;"></ha-icon>' +
                    '</div>';
                  const inv = states['{{ energy.solar.inverter_running }}'];
                  const invTxt = !inv ? '{{ t("energy.flow.status_unknown") | js }}' : (inv.state === 'on' ? '{{ t("energy.flow.running") | js }}' : '{{ t("energy.flow.stopped") | js }}');
                  const invCol = (inv && inv.state === 'on') ? '#00FFC3' : '#FF3D71';
                  const exch =
                    '<div style="flex:1.2;display:flex;flex-direction:column;justify-content:center;gap:10px;padding-top:22px;min-width:86px;">' +
                      '<div style="text-align:center;color:#FFD700;font-size:calc(10px * var(--vssp-scale-label, 1));">{{ t('energy.stat.exported') | js }}<br>' +
                        '<b style="font-size:calc(13px * var(--vssp-scale-value, 1));">' + val('{{ energy.grid.export_power }}', 2) + ' kW</b></div>' +
                      '<div style="display:flex;align-items:center;">' +
                        '<div style="height:2px;width:100%;background:linear-gradient(90deg,transparent,#FFD700);"></div>' +
                        '<ha-icon icon="mdi:menu-right" style="--mdc-icon-size:18px;color:#FFD700;margin-left:-8px;"></ha-icon>' +
                      '</div>' +
                      '<div style="display:flex;align-items:center;">' +
                        '<ha-icon icon="mdi:menu-left" style="--mdc-icon-size:18px;color:#FF9800;margin-right:-8px;"></ha-icon>' +
                        '<div style="height:2px;width:100%;background:linear-gradient(90deg,#FF9800,transparent);"></div>' +
                      '</div>' +
                      '<div style="text-align:center;color:#FF9800;font-size:calc(10px * var(--vssp-scale-label, 1));">{{ t("energy.stat.imported") | js }}<br>' +
                        '<b style="font-size:calc(13px * var(--vssp-scale-value, 1));">' + val('{{ energy.grid.import_power }}', 2) + ' kW</b></div>' +
                    '</div>';
                  const legend = (color, txt) =>
                    '<div style="display:flex;align-items:center;gap:6px;">' +
                      '<div style="width:16px;height:2px;background:' + color + ';"></div>' +
                      '<span style="color:#8FB6C9;font-size:calc(10px * var(--vssp-scale-label, 1));">' + txt + '</span></div>';
                  return '<div style="width:100%;">' +
                    '<div style="display:flex;align-items:flex-start;justify-content:space-between;width:100%;gap:4px;">' +
                      node('mdi:solar-panel-large', '{{ t("energy.flow.solar_panels") | js }}', '{{ t("energy.flow.current_production") | js }}', '#56707E', val('{{ energy.solar.power }}', 2) + ' kW', '#00FFC3') +
                      arrow('#00FFC3') +
                      node('mdi:power-plug-battery', '{{ t("energy.flow.inverter") | js }}', '{{ t("energy.flow.status") | js }}', '#56707E', invTxt, invCol) +
                      arrow('#00E5FF') +
                      node('mdi:home-lightning-bolt', '{{ t("energy.flow.home") | js }}', '{{ t("energy.flow.current_consumption") | js }}', '#56707E', val('{{ energy.totals.power }}', 2) + ' kW', '#00E5FF') +
                      exch +
                      node('mdi:transmission-tower', '{{ t("energy.flow.grid") | js }}', '\u00A0', '#56707E', '\u00A0', '#8FB6C9') +
                    '</div>' +
                    '<div style="display:flex;gap:20px;justify-content:center;margin-top:12px;padding-top:10px;' +
                      'border-top:1px solid rgba(0, 229, 255, 0.1);">' +
                      legend('#00FFC3', '{{ t("energy.stat.produced") | js }}') + legend('#00E5FF', '{{ t("energy.stat.consumed") | js }}') +
                      legend('#FFD700', '{{ t("energy.stat.exported") | js }}') + legend('#FF9800', '{{ t("energy.stat.imported") | js }}') +
                    '</div></div>';
                ]]]
            styles:
              grid:
                - grid-template-areas: '"diagram"'
              card:
                - background: transparent
                - box-shadow: none
                - border: none
                - padding: 0
                - cursor: default
                - pointer-events: none
              custom_fields:
                diagram:
                  - width: 100%

      # ═══════════════════════════════════════════════════════════════
      # PANNEAU 5 — EXCÉDENT & REVENTE EDF
      # ═══════════════════════════════════════════════════════════════
      - type: vertical-stack
        view_layout:
          grid-area: edf
        card_mod:
          style: |
            :host {
              display: flex;
              flex-direction: column;
              height: 100%;
              background: var(--card-background-color, rgba(8,18,28,0.75));
              border-radius: var(--ha-card-border-radius, 20px);
              border: 1px solid rgba(0, 229, 255, 0.28);
              backdrop-filter: blur(12px);
              box-shadow: 0 0 18px rgba(0, 229, 255, 0.15);
              padding: 16px 18px;
              overflow: hidden;
            }
        cards:
          - type: custom:button-card
            template: vssp_section_title
            name: "{{ t('energy.panel.grid') }}"

          - type: horizontal-stack
            cards:
              - type: custom:button-card
                template: vssp_energy_stat
                entity: {{ energy.grid.export_today }}
                label: "{{ t('energy.stat.exported') }}"
                variables:
                  accent: "#00FFC3"
                  size: "22px"
              - type: custom:button-card
                template: vssp_energy_stat
                entity: {{ energy.grid.export_month }}
                label: "{{ t('energy.stat.export_revenue') }}"
                variables:
                  accent: "#00FFC3"
                  size: "22px"

          - type: custom:button-card
            show_icon: false
            show_name: false
            show_state: true
            show_label: true
            entity: {{ energy.grid.revenue_month }}
            label: "{{ t('energy.stat.estimate_month') }}"
            custom_fields:
              period: '<span style="color:#8FB6C9;font-size:calc(12px * var(--vssp-scale-label, 1));">{{ t("energy.stat.this_month") }}</span>'
              tarif: |
                [[[
                  const LOCALE = '{{ locale_tag }}';
                  const t = states['{{ energy.solar.tarif_helper }}'];
                  const v = t ? Number(t.state).toLocaleString(LOCALE, { minimumFractionDigits: 2 }) : '0,20';
                  return '<span style="color:#00E5FF;font-size:calc(11px * var(--vssp-scale-label, 1));border:1px solid rgba(0, 229, 255, 0.35);' +
                         'border-radius:8px;padding:4px 8px;background:rgba(0, 229, 255, 0.08);">' +
                         v + ' \u20AC/kWh</span>';
                ]]]
            styles:
              grid:
                - grid-template-areas: '"l l" "s period" "s tarif"'
                - grid-template-columns: auto 1fr
                - column-gap: 12px
                - row-gap: 2px
                - justify-items: start
                - align-items: center
              card:
                - background: transparent
                - box-shadow: none
                - border: none
                - border-top: 1px solid rgba(0, 229, 255, 0.1)
                - border-radius: 0
                - margin-top: 8px
                - padding: 12px 2px 4px 2px
                - cursor: default
                - pointer-events: none
              label:
                - color: "var(--secondary-text-color, #8FB6C9)"
                - font-size: calc(11px * var(--vssp-scale-label, 1))
                - justify-self: start
                - text-align: left
              state:
                - color: "#00FFC3"
                - font-size: calc(28px * var(--vssp-scale-value, 1))
                - font-weight: 700
                - justify-self: start
                - text-align: left
              custom_fields:
                period:
                  - justify-self: start
                  - text-align: left
                tarif:
                  - justify-self: end
                  - text-align: right

          - type: custom:button-card
            show_icon: false
            show_name: true
            show_state: true
            entity: {{ energy.grid.revenue_year }}
            name: "{{ t('energy.stat.estimate_year') }}"
            styles:
              grid:
                - grid-template-areas: '"n s"'
                - grid-template-columns: 1fr auto
                - align-items: center
              card:
                - background: transparent
                - box-shadow: none
                - border: none
                - border-top: 1px solid rgba(0, 229, 255, 0.1)
                - border-radius: 0
                - padding: 12px 2px 2px 2px
                - margin-top: 6px
                - cursor: default
                - pointer-events: none
              name:
                - color: "var(--secondary-text-color, #8FB6C9)"
                - font-size: calc(12px * var(--vssp-scale-text, 1))
                - justify-self: start
                - text-align: left
              state:
                - color: "var(--text-primary-color, #FFFFFF)"
                - font-size: calc(22px * var(--vssp-scale-value, 1))
                - font-weight: 700
                - justify-self: end
                - text-align: right

      # ═══════════════════════════════════════════════════════════════
      # PANNEAU 6 — TABLEAU ÉLECTRIQUE
      # EN | One frame, two halves: the switches on the left, the
      # EN | virtual board — the hardware, rail by rail — on the right.
      # FR | Un cadre, deux moities : les interrupteurs a gauche, le
      # FR | tableau virtuel — le materiel, rail par rail — a droite.
      # ═══════════════════════════════════════════════════════════════
      - type: vertical-stack
        view_layout:
          grid-area: board
        card_mod:
          style: |
            :host {
              display: flex;
              flex-direction: column;
              background: var(--card-background-color, rgba(8,18,28,0.75));
              border-radius: var(--ha-card-border-radius, 20px);
              border: 1px solid rgba(0, 229, 255, 0.28);
              backdrop-filter: blur(12px);
              box-shadow: 0 0 18px rgba(0, 229, 255, 0.15);
              padding: 16px 18px;
            }
        cards:
          - type: custom:button-card
            template: vssp_section_title
            name: "{{ t('energy.panel.breaker_panel') }}"

          # ── EN | Two halves under one frame ────────────────────────
          # ── FR | Deux moities sous un meme cadre ───────────────────
          # EN | LEFT: the switches — the control surface, one LINE per
          # EN | circuit, named the way the house names them, toggle on the
          # EN | same line. A list, not a grid of tiles: looking for one
          # EN | name among ten is a scan down a column, not a hunt.
          # EN | RIGHT: the enclosure — one rail per module MOUNTED IN THE
          # EN | PANEL (Shelly Pro, LAN Switch, anything on a DIN rail),
          # EN | each carrying its channels. A plug or a power strip is a
          # EN | Shelly module too, and it is still discovered, but it hangs
          # EN | off a wall socket: it is not in the enclosure, so it is not
          # EN | drawn on a rail. That is what `panel` filters.
          # EN | A circuit can appear on both sides, answering two different
          # EN | questions: "turn it off" left, "where does it come from"
          # EN | right.
          # FR | GAUCHE : les interrupteurs — la surface de commande, une
          # FR | LIGNE par circuit, nommee comme la maison les nomme, avec la
          # FR | bascule sur la meme ligne. Une liste, pas une grille de
          # FR | tuiles : chercher un nom parmi dix se parcourt en colonne,
          # FR | ce n'est pas une chasse.
          # FR | DROITE : le coffret — un rail par module MONTE DANS LE
          # FR | TABLEAU (Shelly Pro, LAN Switch, tout ce qui est sur rail
          # FR | DIN), chacun portant ses voies. Une prise ou une multiprise
          # FR | est un module Shelly elle aussi, et reste decouverte, mais
          # FR | elle pend au bout d'une prise murale : elle n'est pas dans
          # FR | le coffret, elle n'est donc pas dessinee sur un rail. C'est
          # FR | ce que filtre `panel`.
          # FR | Un circuit peut figurer des deux cotes, et repond a deux
          # FR | questions differentes : « coupe-le » a gauche, « d'ou
          # FR | vient-il » a droite.
          - type: horizontal-stack
            cards:
              # ═════════ EN | LEFT — SWITCHES / FR | GAUCHE — INTERRUPTEURS
              - type: vertical-stack
                card_mod:
                  style: |
                    :host {
                      display: block;
                      padding-right: 16px;
                    }
                cards:
                  - type: custom:button-card
                    template: vssp_subsection_title
                    name: "{{ t('energy.panel.switches') }}"
                    icon: mdi:toggle-switch-outline

{% if not circuits %}
                  - type: custom:button-card
                    template: vssp_section_title
                    name: "{{ t('energy.empty.circuits') }}"
{% endif %}
{% for c in circuits %}
                  - type: custom:button-card
                    template: vssp_circuit_row
                    entity: {{ c.entity }}
                    name: "{{ c.name }}"
                    icon: {{ c.icon }}
                    variables:
                      model: "{{ c.model | default('', true) }}"
                      amp: "{{ c.amp | default('', true) }}"
                      image: "{{ c.image | default('', true) }}"
{% endfor %}
                  # ── Légende ────────────────────────────────────────
                  - type: custom:button-card
                    show_icon: false
                    show_name: false
                    show_state: false
                    custom_fields:
                      legend: >
                        <div style="display:flex;gap:24px;justify-content:center;padding-top:12px;">
                          <div style="display:flex;align-items:center;gap:6px;">
                            <div style="width:9px;height:9px;border-radius:50%;background:#00FFC3;
                              box-shadow:0 0 8px rgba(0,255,195,.6);"></div>
                            <span style="color:#8FB6C9;font-size:calc(11px * var(--vssp-scale-label, 1));">{{ t('energy.legend.state_on') }}</span></div>
                          <div style="display:flex;align-items:center;gap:6px;">
                            <div style="width:9px;height:9px;border-radius:50%;background:#56707E;"></div>
                            <span style="color:#8FB6C9;font-size:calc(11px * var(--vssp-scale-label, 1));">{{ t('energy.legend.state_off') }}</span></div>
                        </div>
                    styles:
                      grid:
                        - grid-template-areas: '"legend"'
                      card:
                        - background: transparent
                        - box-shadow: none
                        - border: none
                        - padding: 0
                        - cursor: default
                        - pointer-events: none
                      custom_fields:
                        legend:
                          - width: 100%

              # ═════ EN | RIGHT — VIRTUAL BOARD / FR | DROITE — TABLEAU VIRTUEL
              - type: vertical-stack
                card_mod:
                  style: |
                    :host {
                      display: block;
                      padding-left: 18px;
                      border-left: 1px solid rgba(0, 229, 255, 0.18);
                    }
                cards:
                  - type: custom:button-card
                    template: vssp_subsection_title
                    name: "{{ t('energy.panel.virtual_board') }}"
                    icon: mdi:electric-switch

{% set rails = modules | selectattr('panel') | list %}
{% for m in rails %}
{% set channels = m.channels | default([], true) %}
{% set powers = channels | selectattr('power_entity') | map(attribute='power_entity') | list %}
                  # ── EN | Rail: {{ m.model | default('module', true) }} — {{ m.name }}
                  # ── FR | Rail : {{ m.model | default('module', true) }} — {{ m.name }}
                  - type: vertical-stack
                    card_mod:
                      style: |
                        :host {
                          display: block;
                          background: rgba(0, 0, 0, 0.22);
                          border: 1px solid rgba(0, 229, 255, 0.12);
                          border-radius: 12px;
                          padding: 10px 12px 12px 12px;
                          margin-bottom: 10px;
                        }
                    cards:
                      - type: custom:button-card
                        template: vssp_din_module
                        # EN | Title = the MODEL. This side answers "what is
                        # EN | installed", so the box's own name is the
                        # EN | subtitle, and identical boxes read alike.
                        # FR | Titre = le MODELE. Ce cote repond a « qu'est-ce
                        # FR | qui est installe », le nom du boitier passe donc
                        # FR | en sous-titre, et deux boitiers identiques se
                        # FR | lisent pareil.
                        name: "{{ m.model | default(t('energy.board.unknown_model'), true) }}"
                        label: "{{ m.name }}"
{% if m.switches | default([], true) %}
                        # EN | Master switch: the whole header is the target.
                        # FR | Interrupteur maitre : l'en-tete entier est la
                        # FR | cible.
                        tap_action:
                          action: call-service
                          service: homeassistant.toggle
                          service_data:
                            entity_id:
{% for e in m.switches %}
                              - {{ e }}
{% endfor %}
{% else %}
                        tap_action:
                          action: none
{% endif %}
{% set watched = powers + (m.switches | default([], true)) %}
{% if watched %}
                        # EN | A module has no entity of its own, so without
                        # EN | this the header would never repaint: neither
                        # EN | its total nor its master toggle would follow a
                        # EN | channel flipped from the list on the left.
                        # FR | Un module n'a pas d'entite propre : sans ceci
                        # FR | l'en-tete ne se redessinerait jamais, ni son
                        # FR | total ni sa bascule maitre ne suivraient une
                        # FR | voie basculee depuis la liste de gauche.
                        triggers_update:
{% for e in watched %}
                          - {{ e }}
{% endfor %}
{% endif %}
                        variables:
                          powers: [{{ powers | join(', ') }}]
                          switches: [{{ m.switches | default([], true) | join(', ') }}]
                          image: "{{ m.image | default('', true) }}"
                          icon: {{ m.icon | default('mdi:chip', true) }}

                      - type: horizontal-stack
                        cards:
{% for c in channels %}
{% set kind = 'meter' if not c.entity else ('cover' if c.entity.startswith('cover.') else 'switch') %}
                          - type: custom:button-card
                            template: vssp_din_pole
                            entity: {{ c.entity | default(c.power_entity, true) }}
                            name: "{{ c.name }}"
                            icon: {{ c.icon | default('mdi:power-plug', true) }}
{% if kind != 'switch' %}
                            tap_action:
                              action: more-info
{% endif %}
                            variables:
                              kind: {{ kind }}
                              amp: "{{ c.amp | default('', true) }}"
                              power_entity: "{{ c.power_entity | default('', true) }}"
{% endfor %}
{% for _ in range([(poles_per_rail | default(4)) - (channels | length), 0] | max) %}
                          - type: custom:button-card
                            template: vssp_din_blank
{% endfor %}
{% endfor %}

                  # ── EN | Bays the enclosure has and nothing occupies yet.
                  # ── FR | Emplacements que le coffret a, et que rien n'occupe.
{% for _ in range([(board_slots | default(4)) - (rails | length), 0] | max) %}
                  - type: custom:button-card
                    template: vssp_din_bay
                    icon: mdi:plus-box-outline
                    name: "{{ t('energy.board.free_slot') }}"
{% endfor %}

    # ── Fond de vue (même principe que core.yaml) ────────────────────
    # Déposez energy.png dans www/vssp/backgrounds/, ou
    # remplacez par core.png / home.png en attendant.
    card_mod:
      style: |
        hui-view {
          background: center / cover no-repeat fixed url("{{ energy.background }}");
        }
