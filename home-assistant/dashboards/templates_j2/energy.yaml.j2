########################################################################
# Visio Sapiens — ENERGY Dashboard
#
# *** FICHIER GÉNÉRÉ — NE PAS ÉDITER À LA MAIN ***
# Source : energy.yaml.j2 + model/house.yaml
# Régénérer avec : python3 generate_dashboards.py
#
# Emplacement attendu dans le repo :
#   home-assistant/dashboards/views/energy.yaml
#
# Même principe que core.yaml : dashboard Lovelace AUTONOME, déclaré dans
# configuration.yaml sous `lovelace: dashboards:` avec url_path
# "vssp-energy". Il garde donc le wrapper complet "title: / views: [...]"
# au niveau racine — sans lui, Lovelace n'affiche plus aucune carte.
#
# Structure conservée à l'identique de core.yaml :
#   - bandeau vertical (sidebar nav, grid-area "nav")
#   - première ligne du bandeau header (page_header + avatar OS)
# Seule la zone de contenu change : elle reprend la maquette énergie
# (production solaire, consommation par appareil, consommation totale,
# schéma de fonctionnement, excédent/revente EDF, tableau électrique).
#
# ── PRÉREQUIS ─────────────────────────────────────────────────────────
# 1. Ajouter les templates du fichier
#      button_card_templates_energy_append.yaml
#    À LA FIN de templates/button_card_templates.yaml
# 2. Créer les helpers + capteurs du fichier
#      energy_config_snippets.yaml
# 3. Les entités, pièces, appareils et circuits sont définis dans
#    model/house.yaml — c'est LÀ qu'on ajoute un nouvel objet, jamais ici.
#
# Cartes HACS utilisées : button-card, card-mod, layout-card,
# apexcharts-card, mini-graph-card, config-template-card.
########################################################################
title: {{ energy.title }}
theme: {{ house.theme }}

# Indispensable : sans ces includes, chaque custom:button-card affiche
# « Erreur de configuration ». Chemin relatif à dashboards/views/.
button_card_templates: !include ../templates/button_card_templates.yaml
decluttering_templates: !include ../templates/decluttering_templates.yaml

views:
  - title: {{ energy.title }}
    path: {{ energy.view_path }}
    subview: false
    type: custom:grid-layout
    layout:
      grid-template-columns: minmax(200px, auto) 1fr 1fr 1fr 1fr 1fr
      grid-template-rows: 105px 418px 236px auto
      grid-template-areas: |
        "nav header header header header header"
        "nav solar solar devices devices total"
        "nav flow flow flow edf edf"
        "nav board board board board board"
      margin: 12px
      grid-gap: 14px 14px
    cards:
      # ═══════════════════════════════════════════════════════════════
      # LIGNE 1 — HEADER : titre / météo / heure + logo
      # ═══════════════════════════════════════════════════════════════
      - type: horizontal-stack
        view_layout:
          grid-area: header
        cards:

          # ── Case 1 : titre ────────────────────────────────────────
          - type: custom:button-card
            template: vssp_page_header
            icon: mdi:chevron-left
            name: {{ energy.title }}
            label: "{{ energy.subtitle }}"
            tap_action:
              action: navigate
              navigation_path: /{{ energy.url_path }}/{{ energy.view_path }}
            card_mod:
              style: |
                :host { flex: 1 1 0; }
                ha-card {
                  background: rgba(16,27,39,0.85) !important;
                  border: 1px solid rgba(0,229,255,0.28) !important;
                  border-radius: 20px !important;
                  box-shadow: 0 0 18px rgba(0,229,255,.12) !important;
                  height: 100px
                }

          # ── Case 2 : météo (carte NATIVE, toujours disponible) ─────
          - type: custom:simple-weather-card
            entity: {{ house.weather_entity }}
            show_name: true
            tap_action:
              action: more-info
            primary_info:
              - extrema
            secondary_info:
              - precipitation
            state_content: state
            forecast_type: daily
            custom: []
            animated_icons: true
            backdrop:
              day: "#7cbfee"
              night: "#a6aae8"
              text: "#ffffff"
              bg: true
              fade: false
            card_mod:
              style: |
                :host { flex: 1 1 0; }
                ha-card {
                  background: rgba(16,27,39,0.85) !important;
                  border: 1px solid rgba(0,229,255,0.28) !important;
                  border-radius: 20px !important;
                  box-shadow: 0 0 18px rgba(0,229,255,.12) !important;
                  height: 100px
                }

          # ── Case 3 : heure (button-card autonome, sans dépendance) ─
          - type: custom:button-card
            entity: {{ house.time_entity }}                                  # {{ house.time_entity }} (intégration "time_date")
            show_name: false
            show_icon: false
            show_state: false
            show_label: true
            label: |
              [[[
                const d = new Date();
                const h = String(d.getHours()).padStart(2,'0');
                const m = String(d.getMinutes()).padStart(2,'0');
                const jours = ['Dimanche','Lundi','Mardi','Mercredi','Jeudi','Vendredi','Samedi'];
                const mois = ['janvier','février','mars','avril','mai','juin','juillet','août','septembre','octobre','novembre','décembre'];
                return `<div style="font-family:Orbitron,sans-serif;font-size:24px;color:#00E5FF;line-height:1;">${h}:${m}</div>
                        <div style="font-size:11px;color:#8FB6C9;letter-spacing:.5px;margin-top:4px;">
                          ${jours[d.getDay()]} ${d.getDate()} ${mois[d.getMonth()]} ${d.getFullYear()}</div>`;
              ]]]
            styles:
              card:
                - background: rgba(16,27,39,0.85)
                - border: 1px solid rgba(0,229,255,0.28)
                - border-radius: 20px
                - box-shadow: 0 0 18px rgba(0,229,255,.12)
                - padding: 0 20px
              label:
                - justify-self: start
                - text-align: left
            card_mod:
              style: |
                :host { flex: 1 1 0; }
                ha-card {
                  background: rgba(16,27,39,0.85) !important;
                  border: 1px solid rgba(0,229,255,0.28) !important;
                  border-radius: 20px !important;
                  box-shadow: 0 0 18px rgba(0,229,255,.12) !important;
                  height: 100px
                }

      # ═══════════════════════════════════════════════════════════════
      # SIDEBAR NAV — identique à core.yaml, ENERGY passe en actif
      # ═══════════════════════════════════════════════════════════════
      - type: vertical-stack
        view_layout:
          grid-area: nav
        card_mod:
          style: |
            :host {
              display: flex;
              flex-direction: column;
              height: 100%;
              width: 100%;
              min-width: 200px;
              background: rgba(5,11,18,0.85);
              border-radius: 20px;
              border: 1px solid rgba(0,229,255,0.18);
              padding: 16px 10px;
              box-shadow: 0 0 18px rgba(0,229,255,.12);
            }
        cards:
          - type: custom:button-card
            template: vssp_sidebar_logo
            icon: mdi:hexagon-outline
            name: "VISIO SAPIENS"
            label: "Smart Home OS"

{% for item in nav %}
          - type: custom:button-card
            template: vssp_nav_button
            icon: {{ item.icon }}
            name: {{ item.name }}
            label: "{{ item.label }}"
{% if item.id == active_nav %}
            variables:
              active: true
{% endif %}
            tap_action:
              action: navigate
              navigation_path: {{ item.path }}

{% endfor %}
          - type: custom:button-card
            show_icon: false
            show_name: false
            show_label: false
            tap_action:
              action: none
            custom_fields:
              logo: >
                <img src="/local/vssp/images/logo_VS-Sapiens.png"
                     style="width:100%;max-width:160px;display:block;margin:0 auto;mix-blend-mode:screen;filter:drop-shadow(0 0 8px rgba(0,229,255,.28));" />
            styles:
              card:
                - background: transparent
                - border: none
                - box-shadow: none
                - padding: 12px 6px 4px 6px
              grid:
                - grid-template-areas: '"logo"'
              custom_fields:
                logo:
                  - width: 100%
            card_mod:
              style: |
                :host { margin-top: auto; }
                ha-card {
                  background: transparent !important;
                  border: none !important;
                  box-shadow: none !important;
                }

      # ═══════════════════════════════════════════════════════════════
      # PANNEAU 1 — PRODUCTION SOLAIRE
      # ═══════════════════════════════════════════════════════════════
      - type: vertical-stack
        view_layout:
          grid-area: solar
        card_mod:
          style: |
            :host {
              display: flex;
              flex-direction: column;
              height: 100%;
              background: rgba(8,18,28,0.75);
              border-radius: 20px;
              border: 1px solid rgba(0,229,255,0.28);
              backdrop-filter: blur(12px);
              box-shadow: 0 0 18px rgba(0,229,255,.15);
              padding: 16px 18px;
              overflow: hidden;
            }
        cards:
          - type: custom:button-card
            template: vssp_section_title
            name: "Production Solaire"

          # ── Haut : capacité + illustration | jauge + cumuls ─────────
          - type: horizontal-stack
            cards:
              - type: vertical-stack
                card_mod:
                  style: |
                    :host { flex: 1 1 0; }
                cards:
                  - type: custom:button-card
                    template: vssp_energy_stat
                    entity: {{ energy.solar.capacity_helper }}
                    label: "Capacité maximale"
                    variables:
                      accent: "#00FFC3"
                      size: "20px"
                  - type: custom:button-card
                    show_name: false
                    show_state: false
                    show_icon: true
                    icon: mdi:solar-power-variant
                    styles:
                      card:
                        - background: transparent
                        - box-shadow: none
                        - border: none
                        - padding: 10px 0
                        - cursor: default
                        - pointer-events: none
                      icon:
                        - color: "#FFD700"
                        - "--mdc-icon-size": 82px
                        - filter: drop-shadow(0 0 18px rgba(255,215,0,.45))

              # ── Jauge de production instantanée ────────────────────
              - type: vertical-stack
                card_mod:
                  style: |
                    :host { flex: 1 1 0; }
                cards:
                  - type: custom:apexcharts-card
                    chart_type: radialBar
                    header:
                      show: false
                    series:
                      - entity: {{ energy.solar.power }}
                        name: "Production actuelle"
                        min: 0
                        max: 10                                  # TODO : puissance crête kW
                    apex_config:
                      chart:
                        height: 168
                      plotOptions:
                        radialBar:
                          startAngle: -110
                          endAngle: 110
                          hollow:
                            size: "64%"
                          track:
                            background: "rgba(255,255,255,0.07)"
                          dataLabels:
                            name:
                              show: false
                            value:
                              fontSize: "24px"
                              fontWeight: 700
                              color: "#FFFFFF"
                              offsetY: 4
                      colors: ["#00FFC3"]
                      stroke:
                        lineCap: round
                    card_mod:
                      style: |
                        ha-card {
                          background: transparent !important;
                          border: none !important;
                          box-shadow: none !important;
                        }

                  - type: horizontal-stack
                    cards:
                      - type: custom:button-card
                        template: vssp_energy_stat
                        entity: {{ energy.solar.today }}
                        label: "Aujourd'hui"
                        variables:
                          accent: "#FFFFFF"
                          size: "18px"
                      - type: custom:button-card
                        template: vssp_energy_stat
                        entity: {{ energy.solar.month }}
                        label: "Ce mois-ci"
                        variables:
                          accent: "#FFFFFF"
                          size: "18px"

                  - type: custom:button-card
                    template: vssp_energy_stat
                    entity: {{ energy.solar.year }}
                    label: "Cette année"
                    variables:
                      accent: "#00FFC3"
                      size: "18px"

          # ── Bas : sous-panneau courbe de production ─────────────────
          - type: vertical-stack
            card_mod:
              style: |
                :host {
                  display: block;
                  margin-top: 10px;
                  background: rgba(0,0,0,.25);
                  border: 1px solid rgba(0,229,255,.14);
                  border-radius: 16px;
                  padding: 12px 14px;
                }
            cards:
              - type: horizontal-stack
                cards:
                  - type: custom:button-card
                    template: vssp_section_title
                    name: "Production (kWh)"
                    styles:
                      name:
                        - font-size: 12px
                        - font-family: inherit
                      card:
                        - padding: 0
                    card_mod:
                      style: |
                        :host { flex: 1.4 1 0; display: flex; align-items: center; }
                  # Onglets Jour / Mois / Année (pilotent l'input_select)
                  - type: custom:button-card
                    template: vssp_energy_tab
                    entity: {{ energy.period_helper }}
                    name: Jour
                    icon: mdi:weather-sunny
                    variables:
                      period: Jour
                    tap_action:
                      action: call-service
                      service: input_select.select_option
                      service_data:
                        entity_id: {{ energy.period_helper }}
                        option: Jour
                  - type: custom:button-card
                    template: vssp_energy_tab
                    entity: {{ energy.period_helper }}
                    name: Mois
                    icon: mdi:calendar-month
                    variables:
                      period: Mois
                    tap_action:
                      action: call-service
                      service: input_select.select_option
                      service_data:
                        entity_id: {{ energy.period_helper }}
                        option: Mois
                  - type: custom:button-card
                    template: vssp_energy_tab
                    entity: {{ energy.period_helper }}
                    name: Année
                    icon: mdi:calendar
                    variables:
                      period: Année
                    tap_action:
                      action: call-service
                      service: input_select.select_option
                      service_data:
                        entity_id: {{ energy.period_helper }}
                        option: Année

              # Courbe : la période suit l'input_select via config-template-card
              - type: custom:config-template-card
                entities:
                  - {{ energy.period_helper }}
                card:
                  type: custom:apexcharts-card
                  header:
                    show: false
                  graph_span: >-
                    ${ states['{{ energy.period_helper }}'].state === 'Jour' ? '24h'
                       : states['{{ energy.period_helper }}'].state === 'Mois' ? '30d' : '365d' }
                  span:
                    start: >-
                      ${ states['{{ energy.period_helper }}'].state === 'Jour' ? 'day'
                         : states['{{ energy.period_helper }}'].state === 'Mois' ? 'month' : 'year' }
                  series:
                    - entity: {{ energy.solar.power }}
                      name: "Production solaire"
                      type: column
                      color: "#00FFC3"
                      group_by:
                        func: avg
                        duration: >-
                          ${ states['{{ energy.period_helper }}'].state === 'Jour' ? '30min'
                             : states['{{ energy.period_helper }}'].state === 'Mois' ? '1d' : '30d' }
                  apex_config:
                    chart:
                      height: 132
                    legend:
                      show: true
                      position: top
                      horizontalAlign: left
                      labels:
                        colors: "#8FB6C9"
                    grid:
                      borderColor: "rgba(255,255,255,0.06)"
                    xaxis:
                      labels:
                        style:
                          colors: "#56707E"
                          fontSize: "10px"
                    yaxis:
                      labels:
                        style:
                          colors: "#56707E"
                          fontSize: "10px"
                    plotOptions:
                      bar:
                        columnWidth: "62%"
                        borderRadius: 2
                  card_mod:
                    style: |
                      ha-card {
                        background: transparent !important;
                        border: none !important;
                        box-shadow: none !important;
                      }

              # Pied : capacité annuelle + % de l'objectif
              - type: custom:button-card
                show_icon: false
                show_name: false
                show_state: false
                entity: {{ energy.solar.year }}
                custom_fields:
                  cap: |
                    [[[
                      const c = states['{{ energy.solar.capacity_helper }}'];
                      const cap = c ? Number(c.state) : 12500;
                      return '<span style="color:#56707E;font-size:11px">Capacité annuelle : ' +
                             cap.toLocaleString('fr-FR') + ' kWh</span>';
                    ]]]
                  goal: |
                    [[[
                      const c = states['{{ energy.solar.capacity_helper }}'];
                      const cap = c ? Number(c.state) : 12500;
                      const y = entity && !isNaN(Number(entity.state)) ? Number(entity.state) : 0;
                      const pct = cap > 0 ? (y / cap * 100) : 0;
                      return '<span style="color:#00E5FF;font-size:11px;font-weight:600">' +
                             pct.toLocaleString('fr-FR', { maximumFractionDigits: 1 }) +
                             '% de l\'objectif annuel</span>';
                    ]]]
                styles:
                  grid:
                    - grid-template-areas: '"cap goal"'
                    - grid-template-columns: 1fr auto
                    - align-items: center
                  card:
                    - background: transparent
                    - box-shadow: none
                    - border: none
                    - border-top: 1px solid rgba(0,229,255,0.10)
                    - border-radius: 0
                    - padding: 10px 0 0 0
                    - cursor: default
                    - pointer-events: none
                  custom_fields:
                    cap:
                      - justify-self: start
                    goal:
                      - justify-self: end

      # ═══════════════════════════════════════════════════════════════
      # PANNEAU 2 — CONSOMMATION PAR APPAREIL
      # ═══════════════════════════════════════════════════════════════
      - type: vertical-stack
        view_layout:
          grid-area: devices
        card_mod:
          style: |
            :host {
              display: flex;
              flex-direction: column;
              height: 100%;
              box-sizing: border-box;
              background: rgba(8,18,28,0.75);
              border-radius: 20px;
              border: 1px solid rgba(0,229,255,0.28);
              backdrop-filter: blur(12px);
              box-shadow: 0 0 18px rgba(0,229,255,.15);
              padding: 16px 18px;
              overflow: hidden;
            }
        cards:
          - type: custom:button-card
            template: vssp_section_title
            name: "Consommation par appareil"

          # ── En-têtes de colonnes ───────────────────────────────────
          - type: custom:button-card
            show_icon: false
            show_name: false
            show_state: false
            custom_fields:
              c1: '<span style="color:#56707E;font-size:11px">Appareil</span>'
              cr: '<span style="color:#8FB6C9;font-size:11px;display:block;text-align:right">Pièce</span>'
              c2: >
                <span style="color:#8FB6C9;font-size:11px;display:block;text-align:right">Consommation<br>
                <span style="color:#56707E;font-size:9px">(actuelle)</span></span>
              c3: >
                <span style="color:#8FB6C9;font-size:11px;display:block;text-align:right">Énergie<br>
                <span style="color:#56707E;font-size:9px">(aujourd'hui)</span></span>
            styles:
              grid:
                - grid-template-areas: '"c1 cr c2 c3 pad"'
                - grid-template-columns: 1fr 96px 84px 84px 18px
                - column-gap: 8px
                - align-items: center
              card:
                - background: rgba(0,0,0,.22)
                - box-shadow: none
                - border: none
                - border-radius: 10px
                - padding: 8px 10px
                - margin-bottom: 4px
                - cursor: default
                - pointer-events: none
              custom_fields:
                c1:
                  - justify-self: start
                cr:
                  - justify-self: end
                c2:
                  - justify-self: end
                c3:
                  - justify-self: end

          # ── Liste des appareils (défilante) ────────────────────────
          # Même principe que le panneau « Événements récents » de
          # home.yaml : le défilement vit DANS une vraie carte unique.
          # Ici les 9 lignes sont embarquées dans un button-card dont
          # le champ « list » a une hauteur fixe + overflow — c'est le
          # moteur de styles de button-card qui s'en charge, pas
          # card-mod. Ajustez `height` (250px) si besoin.
          - type: custom:button-card
            show_icon: false
            show_name: false
            show_state: false
            tap_action:
              action: none
            styles:
              grid:
                - grid-template-areas: '"list"'
              card:
                - background: transparent
                - box-shadow: none
                - border: none
                - border-radius: 0
                - padding: 0
                - cursor: default
              custom_fields:
                list:
                  - display: block
                  - width: 100%
                  - height: 250px
                  - overflow-y: auto
                  - overflow-x: hidden
                  - padding-right: 4px
                  - scrollbar-width: thin
                  - scrollbar-color: rgba(0,229,255,0.35) rgba(0,229,255,0.06)
            custom_fields:
              list:
                card:
                  type: vertical-stack
                  cards:
                    # ── Lignes appareils ──────────────────────────────
                    # Liste PLATE : le dashboard ENERGY n'est pas un
                    # dashboard de pièce. `room` n'est qu'un libellé de
                    # provenance affiché sous le nom de l'appareil.
                    # Alimentée par vssp_energy_sync.py (ajout/retrait
                    # automatique selon les entités présentes dans HA).
{% for d in energy_devices %}
                    - type: custom:button-card
                      template: vssp_energy_device_row
                      entity: {{ d.power_entity }}
                      name: "{{ d.name }}"
                      icon: {{ d.icon }}
                      variables:
                        room: "{{ d.room }}"
                        model: "{{ d.model | default('—', true) }}"
                        energy_entity: {{ d.energy_entity }}
                      tap_action:
                        action: more-info

{% endfor %}
{% if not energy_devices %}
                    # Aucun appareil avec capteurs puissance + énergie
                    # détecté. Lancez vssp_energy_sync.py ou complétez
                    # model/energy_devices.yaml.
                    - type: custom:button-card
                      template: vssp_energy_device_row
                      name: "Aucun appareil detecte"
                      icon: mdi:help-circle-outline
                      variables:
                        room: "—"
                        model: "vssp_energy_sync.py"
{% endif %}
          # ── Total ──────────────────────────────────────────────────
          - type: custom:button-card
            template: vssp_energy_total_row
            entity: {{ energy.totals.power }}
            name: "Consommation totale actuelle"

      # ═══════════════════════════════════════════════════════════════
      # PANNEAU 3 — CONSOMMATION TOTALE
      # ═══════════════════════════════════════════════════════════════
      - type: vertical-stack
        view_layout:
          grid-area: total
        card_mod:
          style: |
            :host {
              display: flex;
              flex-direction: column;
              height: 100%;
              background: rgba(8,18,28,0.75);
              border-radius: 20px;
              border: 1px solid rgba(0,229,255,0.28);
              backdrop-filter: blur(12px);
              box-shadow: 0 0 18px rgba(0,229,255,.15);
              padding: 16px 18px;
              overflow: hidden;
            }
        cards:
          - type: custom:button-card
            template: vssp_section_title
            name: "Consommation Totale"

          # Onglets (partagent le même input_select que la production)
          - type: horizontal-stack
            cards:
              - type: custom:button-card
                template: vssp_energy_tab
                entity: {{ energy.period_helper }}
                name: Jour
                icon: mdi:weather-sunny
                variables:
                  period: Jour
                tap_action:
                  action: call-service
                  service: input_select.select_option
                  service_data:
                    entity_id: {{ energy.period_helper }}
                    option: Jour
              - type: custom:button-card
                template: vssp_energy_tab
                entity: {{ energy.period_helper }}
                name: Mois
                icon: mdi:calendar-month
                variables:
                  period: Mois
                tap_action:
                  action: call-service
                  service: input_select.select_option
                  service_data:
                    entity_id: {{ energy.period_helper }}
                    option: Mois
              - type: custom:button-card
                template: vssp_energy_tab
                entity: {{ energy.period_helper }}
                name: Année
                icon: mdi:calendar
                variables:
                  period: Année
                tap_action:
                  action: call-service
                  service: input_select.select_option
                  service_data:
                    entity_id: {{ energy.period_helper }}
                    option: Année

          - type: custom:button-card
            template: vssp_energy_kpi
            entity: {{ energy.totals.today }}
            icon: mdi:chart-bar
            label: "Aujourd'hui"
            variables:
              accent: "#00E5FF"

          - type: custom:button-card
            template: vssp_energy_kpi
            entity: {{ energy.totals.month }}
            icon: mdi:calendar-month
            label: "Ce mois-ci"
            variables:
              accent: "#00E5FF"

          - type: custom:button-card
            template: vssp_energy_kpi
            entity: {{ energy.totals.year }}
            icon: mdi:calendar-star
            label: "Cette année"
            variables:
              accent: "#00E5FF"

      # ═══════════════════════════════════════════════════════════════
      # PANNEAU 4 — SCHÉMA DE FONCTIONNEMENT (flux d'énergie)
      # ═══════════════════════════════════════════════════════════════
      - type: vertical-stack
        view_layout:
          grid-area: flow
        card_mod:
          style: |
            :host {
              display: flex;
              flex-direction: column;
              height: 100%;
              background: rgba(8,18,28,0.75);
              border-radius: 20px;
              border: 1px solid rgba(0,229,255,0.28);
              backdrop-filter: blur(12px);
              box-shadow: 0 0 18px rgba(0,229,255,.15);
              padding: 16px 18px;
              overflow: hidden;
            }
        cards:
          - type: custom:button-card
            template: vssp_section_title
            name: "Schéma de fonctionnement"

          - type: custom:button-card
            show_icon: false
            show_name: false
            show_state: false
            triggers_update:
              - {{ energy.solar.power }}
              - {{ energy.totals.power }}
              - {{ energy.grid.export_power }}
              - {{ energy.grid.import_power }}
              - {{ energy.solar.inverter_running }}
            custom_fields:
              diagram: |
                [[[
                  const val = (id, dec) => {
                    const s = states[id];
                    if (!s || isNaN(Number(s.state))) return '—';
                    return Number(s.state).toLocaleString('fr-FR', { minimumFractionDigits: dec, maximumFractionDigits: dec });
                  };
                  const node = (icon, title, sub, subColor, val, valColor) =>
                    '<div style="display:flex;flex-direction:column;align-items:center;gap:6px;min-width:96px;">' +
                      '<div style="color:#8FB6C9;font-size:11px;font-weight:600;letter-spacing:.5px;">' + title + '</div>' +
                      '<div style="width:64px;height:64px;border-radius:16px;display:flex;align-items:center;justify-content:center;' +
                        'background:rgba(0,229,255,0.07);border:1px solid rgba(0,229,255,0.20);">' +
                        '<ha-icon icon="' + icon + '" style="--mdc-icon-size:34px;color:' + valColor + ';"></ha-icon>' +
                      '</div>' +
                      '<div style="color:#56707E;font-size:10px;">' + sub + '</div>' +
                      '<div style="color:' + valColor + ';font-size:15px;font-weight:700;font-family:Orbitron,sans-serif;">' + val + '</div>' +
                    '</div>';
                  const arrow = (color) =>
                    '<div style="flex:1;display:flex;align-items:center;justify-content:center;padding-top:34px;min-width:44px;">' +
                      '<div style="height:2px;width:100%;background:linear-gradient(90deg,transparent,' + color + ');"></div>' +
                      '<ha-icon icon="mdi:menu-right" style="--mdc-icon-size:20px;color:' + color + ';margin-left:-8px;"></ha-icon>' +
                    '</div>';
                  const inv = states['{{ energy.solar.inverter_running }}'];
                  const invTxt = !inv ? 'Statut inconnu' : (inv.state === 'on' ? 'En fonctionnement' : 'À l\'arrêt');
                  const invCol = (inv && inv.state === 'on') ? '#00FFC3' : '#FF3D71';
                  const exch =
                    '<div style="flex:1.2;display:flex;flex-direction:column;justify-content:center;gap:10px;padding-top:22px;min-width:86px;">' +
                      '<div style="text-align:center;color:#FFD700;font-size:10px;">Excédent<br>' +
                        '<b style="font-size:13px;">' + val('{{ energy.grid.export_power }}', 2) + ' kW</b></div>' +
                      '<div style="display:flex;align-items:center;">' +
                        '<div style="height:2px;width:100%;background:linear-gradient(90deg,transparent,#FFD700);"></div>' +
                        '<ha-icon icon="mdi:menu-right" style="--mdc-icon-size:18px;color:#FFD700;margin-left:-8px;"></ha-icon>' +
                      '</div>' +
                      '<div style="display:flex;align-items:center;">' +
                        '<ha-icon icon="mdi:menu-left" style="--mdc-icon-size:18px;color:#FF9800;margin-right:-8px;"></ha-icon>' +
                        '<div style="height:2px;width:100%;background:linear-gradient(90deg,#FF9800,transparent);"></div>' +
                      '</div>' +
                      '<div style="text-align:center;color:#FF9800;font-size:10px;">Import<br>' +
                        '<b style="font-size:13px;">' + val('{{ energy.grid.import_power }}', 2) + ' kW</b></div>' +
                    '</div>';
                  const legend = (color, txt) =>
                    '<div style="display:flex;align-items:center;gap:6px;">' +
                      '<div style="width:16px;height:2px;background:' + color + ';"></div>' +
                      '<span style="color:#8FB6C9;font-size:10px;">' + txt + '</span></div>';
                  return '<div style="width:100%;">' +
                    '<div style="display:flex;align-items:flex-start;justify-content:space-between;width:100%;gap:4px;">' +
                      node('mdi:solar-panel-large', 'Panneaux Solaires', 'Production actuelle', '#56707E', val('{{ energy.solar.power }}', 2) + ' kW', '#00FFC3') +
                      arrow('#00FFC3') +
                      node('mdi:power-plug-battery', 'Onduleur', 'Statut', '#56707E', invTxt, invCol) +
                      arrow('#00E5FF') +
                      node('mdi:home-lightning-bolt', 'Maison', 'Consommation actuelle', '#56707E', val('{{ energy.totals.power }}', 2) + ' kW', '#00E5FF') +
                      exch +
                      node('mdi:transmission-tower', 'Réseau EDF', '\u00A0', '#56707E', '\u00A0', '#8FB6C9') +
                    '</div>' +
                    '<div style="display:flex;gap:20px;justify-content:center;margin-top:12px;padding-top:10px;' +
                      'border-top:1px solid rgba(0,229,255,0.10);">' +
                      legend('#00FFC3', 'Production') + legend('#00E5FF', 'Consommation') +
                      legend('#FFD700', 'Excédent') + legend('#FF9800', 'Import') +
                    '</div></div>';
                ]]]
            styles:
              grid:
                - grid-template-areas: '"diagram"'
              card:
                - background: transparent
                - box-shadow: none
                - border: none
                - padding: 0
                - cursor: default
                - pointer-events: none
              custom_fields:
                diagram:
                  - width: 100%

      # ═══════════════════════════════════════════════════════════════
      # PANNEAU 5 — EXCÉDENT & REVENTE EDF
      # ═══════════════════════════════════════════════════════════════
      - type: vertical-stack
        view_layout:
          grid-area: edf
        card_mod:
          style: |
            :host {
              display: flex;
              flex-direction: column;
              height: 100%;
              background: rgba(8,18,28,0.75);
              border-radius: 20px;
              border: 1px solid rgba(0,229,255,0.28);
              backdrop-filter: blur(12px);
              box-shadow: 0 0 18px rgba(0,229,255,.15);
              padding: 16px 18px;
              overflow: hidden;
            }
        cards:
          - type: custom:button-card
            template: vssp_section_title
            name: "Excédent & Revente EDF"

          - type: horizontal-stack
            cards:
              - type: custom:button-card
                template: vssp_energy_stat
                entity: {{ energy.grid.export_today }}
                label: "Excédent aujourd'hui"
                variables:
                  accent: "#00FFC3"
                  size: "22px"
              - type: custom:button-card
                template: vssp_energy_stat
                entity: {{ energy.grid.export_month }}
                label: "Excédent ce mois-ci"
                variables:
                  accent: "#00FFC3"
                  size: "22px"

          - type: custom:button-card
            show_icon: false
            show_name: false
            show_state: true
            show_label: true
            entity: {{ energy.grid.revenue_month }}
            label: "Estimation de revente"
            custom_fields:
              period: '<span style="color:#8FB6C9;font-size:12px;">Ce mois-ci</span>'
              tarif: |
                [[[
                  const t = states['{{ energy.solar.tarif_helper }}'];
                  const v = t ? Number(t.state).toLocaleString('fr-FR', { minimumFractionDigits: 2 }) : '0,20';
                  return '<span style="color:#00E5FF;font-size:11px;border:1px solid rgba(0,229,255,.35);' +
                         'border-radius:8px;padding:4px 8px;background:rgba(0,229,255,.08);">' +
                         v + ' \u20AC/kWh</span>';
                ]]]
            styles:
              grid:
                - grid-template-areas: '"l l" "s period" "s tarif"'
                - grid-template-columns: auto 1fr
                - column-gap: 12px
                - row-gap: 2px
                - justify-items: start
                - align-items: center
              card:
                - background: transparent
                - box-shadow: none
                - border: none
                - border-top: 1px solid rgba(0,229,255,0.10)
                - border-radius: 0
                - margin-top: 8px
                - padding: 12px 2px 4px 2px
                - cursor: default
                - pointer-events: none
              label:
                - color: "#8FB6C9"
                - font-size: 11px
                - justify-self: start
              state:
                - color: "#00FFC3"
                - font-size: 28px
                - font-weight: 700
                - justify-self: start
              custom_fields:
                period:
                  - justify-self: start
                tarif:
                  - justify-self: end

          - type: custom:button-card
            show_icon: false
            show_name: true
            show_state: true
            entity: {{ energy.grid.revenue_year }}
            name: "Estimation cette année"
            styles:
              grid:
                - grid-template-areas: '"n s"'
                - grid-template-columns: 1fr auto
                - align-items: center
              card:
                - background: transparent
                - box-shadow: none
                - border: none
                - border-top: 1px solid rgba(0,229,255,0.10)
                - border-radius: 0
                - padding: 12px 2px 2px 2px
                - margin-top: 6px
                - cursor: default
                - pointer-events: none
              name:
                - color: "#8FB6C9"
                - font-size: 12px
                - justify-self: start
              state:
                - color: "#FFFFFF"
                - font-size: 22px
                - font-weight: 700
                - justify-self: end

      # ═══════════════════════════════════════════════════════════════
      # PANNEAU 6 — TABLEAU ÉLECTRIQUE (contrôle des circuits Shelly)
      # ═══════════════════════════════════════════════════════════════
      - type: vertical-stack
        view_layout:
          grid-area: board
        card_mod:
          style: |
            :host {
              display: flex;
              flex-direction: column;
              background: rgba(8,18,28,0.75);
              border-radius: 20px;
              border: 1px solid rgba(0,229,255,0.28);
              backdrop-filter: blur(12px);
              box-shadow: 0 0 18px rgba(0,229,255,.15);
              padding: 16px 18px;
            }
        cards:
          - type: custom:button-card
            template: vssp_section_title
            name: "Tableau Électrique — Contrôle des Circuits (Shelly)"

          # ── Circuits (générés depuis house.yaml, par rangées) ──────
{% if not circuits %}
          - type: custom:button-card
            template: vssp_section_title
            name: "Aucun circuit detecte — lancez vssp_energy_sync.py"
{% endif %}
{% for row in circuits | batch(circuits_per_row | default(6)) %}
          - type: horizontal-stack
            cards:
{% for c in row %}
              - type: custom:button-card
                template: vssp_circuit_switch
                entity: {{ c.entity }}
                name: "{{ c.name }}"
                icon: {{ c.icon }}
                variables:
                  model: "{{ c.model | default('', true) }}"
                  amp: "{{ c.amp | default('—', true) }}"
{% endfor %}

{% endfor %}
          # ── Légende ────────────────────────────────────────────────
          - type: custom:button-card
            show_icon: false
            show_name: false
            show_state: false
            custom_fields:
              legend: >
                <div style="display:flex;gap:24px;justify-content:center;padding-top:12px;">
                  <div style="display:flex;align-items:center;gap:6px;">
                    <div style="width:9px;height:9px;border-radius:50%;background:#00FFC3;
                      box-shadow:0 0 8px rgba(0,255,195,.6);"></div>
                    <span style="color:#8FB6C9;font-size:11px;">Allumé</span></div>
                  <div style="display:flex;align-items:center;gap:6px;">
                    <div style="width:9px;height:9px;border-radius:50%;background:#56707E;"></div>
                    <span style="color:#8FB6C9;font-size:11px;">Éteint</span></div>
                </div>
            styles:
              grid:
                - grid-template-areas: '"legend"'
              card:
                - background: transparent
                - box-shadow: none
                - border: none
                - padding: 0
                - cursor: default
                - pointer-events: none
              custom_fields:
                legend:
                  - width: 100%

    # ── Fond de vue (même principe que core.yaml) ────────────────────
    # Déposez energy.png dans www/vssp/backgrounds/, ou
    # remplacez par core.png / home.png en attendant.
    card_mod:
      style: |
        hui-view {
          background: center / cover no-repeat fixed url("{{ energy.background }}");
        }
