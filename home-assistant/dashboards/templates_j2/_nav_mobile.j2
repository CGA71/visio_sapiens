{# =====================================================================
   Visio Sapiens — MOBILE NAVIGATION (standalone fragment)

   EN | STANDALONE ON PURPOSE — same reason as _nav.j2 (its tablet sibling):
   EN | rendered once per run into _nav_rail_mobile.yaml, written
   EN | unconditionally (never protected, never gated by --only), and
   EN | pulled in by every mobile dashboard via `!include
   EN | _nav_rail_mobile.yaml`. That native include is resolved by Home
   EN | Assistant on the dashboard's own next display, not by this script
   EN | at generate time — so even HOME_mobile.yaml, which
   EN | generate_dashboards.py protects from ever being rewritten once it
   EN | exists, keeps a live chip bar instead of freezing on whatever rooms
   EN | existed the last time it was actually regenerated.
   EN | Consequence: since one render now serves every mobile dashboard,
   EN | it can no longer know which chip is "the current page" the way
   EN | `active_nav` used to (a value only the per-dashboard render knew).
   EN | Each chip highlights itself live in the browser instead, via
   EN | button-card's [[[ ]]] JS templates comparing variables.path (set
   EN | per instance below, NOT read from the card's own config — button-
   EN | card's JS templates do not expose a `config` binding; reaching for
   EN | config.tap_action.navigation_path throws ButtonCardJSTemplateError
   EN | on every single chip) against window.location.pathname.
   FR | AUTONOME VOLONTAIREMENT — meme raison que _nav.j2 (son pendant
   FR | tablette) : rendu une seule fois par execution dans
   FR | _nav_rail_mobile.yaml, ecrit sans condition (jamais protege, jamais
   FR | filtre par --only), et tire par chaque dashboard mobile via
   FR | `!include _nav_rail_mobile.yaml`. Cet include natif est resolu par
   FR | Home Assistant au prochain affichage du dashboard, pas par ce
   FR | script au moment de la generation — donc meme home_mobile.yaml, que
   FR | generate_dashboards.py protege de toute reecriture une fois qu il
   FR | existe, garde une barre de chips vivante au lieu de se figer sur
   FR | les pieces d il y a sa derniere regeneration reelle.
   FR | Consequence : puisqu un seul rendu sert desormais chaque dashboard
   FR | mobile, il ne peut plus savoir quel chip est « la page courante »
   FR | comme le faisait `active_nav` (une valeur que seul le rendu par
   FR | dashboard connaissait). Chaque chip se surligne desormais lui-meme
   FR | en direct dans le navigateur, via les templates JS [[[ ]]] de
   FR | button-card qui comparent variables.path (pose par instance
   FR | ci-dessous, PAS lu depuis la config propre de la carte —
   FR | button-card n expose aucune liaison `config` dans ses templates JS ;
   FR | aller chercher config.tap_action.navigation_path leve
   FR | ButtonCardJSTemplateError sur chaque chip) a
   FR | window.location.pathname.

   EN | EXPECTED CONTEXT / FR | CONTEXTE ATTENDU
     nav
   ================================================================== #}
{# EN | An entry with `mobile: false` is dropped: the admin console is desk
       work and a phone has room for only a handful of chips. The width and
       column count below are computed from the FILTERED list, otherwise the
       bar would reserve space for a chip it never draws.
   FR | Une entree avec `mobile: false` est ecartee : la console admin est un
       travail de bureau et un telephone n a de place que pour une poignee de
       chips. La largeur et le nombre de colonnes ci-dessous sont calcules sur
       la liste FILTREE, sinon la barre reserverait la place d un chip qu elle
       ne dessine jamais. #}
{% set mobile_nav = nav | rejectattr('mobile', 'defined') | list
                  + nav | selectattr('mobile', 'defined') | selectattr('mobile') | list %}
{% set chip_width = 104 %}
type: custom:button-card
view_layout:
  grid-area: nav
show_icon: false
show_name: false
show_state: false
tap_action:
  action: none
styles:
  grid:
    - grid-template-areas: '"chips"'
  card:
    - background: transparent
    - box-shadow: none
    - border: none
    - border-radius: 0
    - padding: 0px 0px 4px 0px
    {# EN | Viewport-unit ceiling: bounds what the card contributes to
       EN | the grid computation, so the bar cannot claim its full
       EN | inner width from the page and the scrolling stays internal.
       FR | Plafond en unite viewport : borne la contribution de la
       FR | carte au calcul de la grille, donc la barre ne peut pas
       FR | reclamer sa largeur interne a la page et le defilement
       FR | reste interne. #}
    - max-width: calc(100vw - 16px)
    - overflow-x: auto
    - overflow-y: hidden
    - touch-action: pan-x
    - "-webkit-overflow-scrolling": touch
    - scrollbar-width: none
    - cursor: default
  custom_fields:
    chips:
      - display: block
      - width: {{ mobile_nav | length * chip_width }}px
custom_fields:
  chips:
    card:
      type: grid
      columns: {{ mobile_nav | length }}
      square: false
      cards:
{% for item in mobile_nav %}
        - type: custom:button-card
          name: "{{ item.name }}"
          icon: {{ item.icon }}
          size: 14px
          variables:
            path: {{ item.path_mobile }}
          tap_action:
            action: navigate
            navigation_path: {{ item.path_mobile }}
          styles:
            grid:
              - grid-template-areas: '"i n"'
              - grid-template-columns: auto 1fr
              - column-gap: 4px
              - align-items: center
            card:
              - height: 36px
              - padding: 0px 8px
              - border-radius: 12px
              - background: >
                  [[[ return window.location.pathname === variables.path ? 'rgba(0,229,255,0.14)' : 'rgba(16,27,39,0.85)'; ]]]
              - border: >
                  [[[ return '1px solid ' + (window.location.pathname === variables.path ? 'rgba(0,229,255,0.55)' : 'rgba(0,229,255,0.18)'); ]]]
              - box-shadow: >
                  [[[ return window.location.pathname === variables.path ? '0 0 12px rgba(0,229,255,.25)' : 'none'; ]]]
            icon:
              - width: 14px
              - color: >
                  [[[ return window.location.pathname === variables.path ? '#00E5FF' : '#8FB6C9'; ]]]
            name:
              - font-family: Orbitron, sans-serif
              - font-size: 8px
              - letter-spacing: 0.5px
              - color: >
                  [[[ return window.location.pathname === variables.path ? '#00E5FF' : '#8FB6C9'; ]]]
              - justify-self: start
              - white-space: nowrap
              - overflow: hidden
              - text-overflow: ellipsis
{% endfor %}
