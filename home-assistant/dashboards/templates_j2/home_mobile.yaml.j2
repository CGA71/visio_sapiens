########################################################################
# Visio Sapiens — HOME Dashboard, MOBILE format
#
# EN | *** GENERATED FILE — DO NOT EDIT BY HAND ***
# EN | Source: home_mobile.yaml.j2 + model/house.yaml + locales/<code>.yaml
# EN | Regenerate with: python3 generate_dashboards.py --format mobile
# FR | *** FICHIER GENERE — NE PAS EDITER A LA MAIN ***
# FR | Source : home_mobile.yaml.j2 + model/house.yaml + locales/<code>.yaml
# FR | Regenerer avec : python3 generate_dashboards.py --format mobile
#
# EN | A separate file from home.yaml.j2, not a branch inside it: the
# EN | navigation is a scrolling chip bar, the grid is a single column, the
# EN | header merges title and clock into one card, and the type scale is
# EN | smaller. See room_mobile.yaml.j2 for the same reasoning.
# FR | Un fichier separe de home.yaml.j2, pas une branche a l'interieur : la
# FR | navigation est une barre de chips defilante, la grille est une seule
# FR | colonne, l'en-tete fusionne titre et heure en une carte, et l'echelle
# FR | typographique est plus petite. Voir room_mobile.yaml.j2 pour le meme
# FR | raisonnement.
#
# EN | The ADMIN view is NOT duplicated here. It lives in home.yaml.j2 only:
# EN | the admin console is a desk task — declaring rooms, assigning devices,
# EN | regenerating — and a phone is the wrong place for it. The mobile
# EN | dashboard therefore has one view.
# FR | La vue ADMIN n'est PAS dupliquee ici. Elle vit uniquement dans
# FR | home.yaml.j2 : la console d'administration est un travail de bureau —
# FR | declarer les pieces, assigner les appareils, regenerer — et un
# FR | telephone est le mauvais endroit pour cela. Le dashboard mobile n'a
# FR | donc qu'une seule vue.
########################################################################

title: {{ house.name | title }}
path: visio-sapiens-m
theme: {{ house.theme }}

# EN | Path relative to dashboards/views/, where every generated dashboard
# EN | now lives.
# FR | Chemin relatif a dashboards/views/, ou vivent desormais tous les
# FR | dashboards generes.
button_card_templates: !include ../templates/button_card_templates.yaml
decluttering_templates: !include ../templates/decluttering_templates.yaml

views:
  - title: {{ t('page.home.name') }}
    path: home
    subview: false
    type: custom:grid-layout
    layout:
      # EN | minmax(0,1fr), not 1fr: `1fr` means minmax(auto,1fr) and refuses
      # EN | to go below the natural width of its content, so one wide element
      # EN | (the scrolling nav, a chart) would widen the whole page — the
      # EN | "tablet look" on a phone.
      # FR | minmax(0,1fr) et non 1fr : `1fr` vaut minmax(auto,1fr) et refuse
      # FR | de descendre sous la largeur naturelle de son contenu, donc un
      # FR | element large (la nav defilante, un graphe) elargirait toute la
      # FR | page — l'effet « format tablette » sur telephone.
      grid-template-columns: minmax(0, 1fr)
      grid-template-rows: auto
      grid-template-areas: |
        "header"
        "nav"
        "kpi"
        "video"
        "energy"
        "events"
        "meteo"
        "right"
      margin: 8px
      grid-gap: 12px 0px
    cards:

      # ═══════════════════════════════════════════════════════════════
      # EN | COMPACT HEADER — title + clock on a single card
      # FR | HEADER COMPACT — titre + heure sur une seule carte
      # ═══════════════════════════════════════════════════════════════
{% set page_title = t('page.home.name') %}
{% set page_subtitle = house.name ~ ' — ' ~ house.tagline %}
{% set page_icon = 'mdi:view-dashboard' %}
{% set page_path = '/visio-sapiens-m/home' %}
{% include '_header_mobile.j2' %}

      # ═══════════════════════════════════════════════════════════════
      # EN | NAVIGATION — one-line scrolling chip bar
      # FR | NAVIGATION — barre de chips defilante sur une ligne
      # ═══════════════════════════════════════════════════════════════
{% include '_nav_mobile.j2' %}

      # ═══════════════════════════════════════════════════════════════
      # KPI — grille 2 colonnes (5 cases du desktop repliées)
      # ═══════════════════════════════════════════════════════════════
      - type: vertical-stack
        view_layout:
          grid-area: kpi
        cards:
          - type: horizontal-stack
            cards:
              # Case 1 — System Status. Same fix as home.yaml.j2's Case 1 —
              # see the comment there: the keyword search found nothing
              # because this install's System Monitor entities carry French
              # custom entity ids, confirmed by the user. Fixed ids now.
              # Two dedicated CPU/RAM bars (stacked), HDD dropped — same
              # layout as Case 2's production/consumption bars below.
              - type: custom:button-card
                show_icon: false
                show_state: false
                show_label: false
                name: "{{ t('home.kpi.system_status') }}"
                entity: sensor.system_monitor_utilisation_du_processeur
                tap_action:
                  action: more-info
                custom_fields:
                  bars: >
                    [[[
                      const cpu = parseFloat(states['sensor.system_monitor_utilisation_du_processeur']?.state) || 0;
                      const ram = parseFloat(states['sensor.system_monitor_utilisation_de_la_memoire']?.state) || 0;
                      const colorFor = (v) => v >= 90 ? '#FF3D71' : v >= 70 ? '#FFA726' : '#00FFC3';
                      const cpuColor = colorFor(cpu);
                      const ramColor = colorFor(ram);
                      return `
                        <div style="margin-bottom:6px;">
                          <div style="font-size:9px;color:${cpuColor};margin-bottom:2px;">CPU ${Math.round(cpu)}%</div>
                          <div style="position:relative;width:100%;height:9px;background:rgba(255,255,255,.08);border-radius:5px;overflow:hidden;">
                            <div style="width:${Math.min(cpu,100)}%;height:100%;background:${cpuColor};border-radius:5px;transition:width .3s;"></div>
                          </div>
                        </div>
                        <div>
                          <div style="font-size:9px;color:${ramColor};margin-bottom:2px;">RAM ${Math.round(ram)}%</div>
                          <div style="position:relative;width:100%;height:9px;background:rgba(255,255,255,.08);border-radius:5px;overflow:hidden;">
                            <div style="width:${Math.min(ram,100)}%;height:100%;background:${ramColor};border-radius:5px;transition:width .3s;"></div>
                          </div>
                        </div>
                      `;
                    ]]]
                styles:
                  grid:
                    - grid-template-areas: '"n" "bars"'
                    - grid-template-rows: min-content 1fr
                    - row-gap: 6px
                    - justify-items: start
                  card:
                    - background: var(--card-background-color, rgba(8,18,28,0.72))
                    - border-radius: var(--ha-card-border-radius, 18px)
                    - border: 1px solid rgba(0, 229, 255, 0.2)
                    - padding: 14px 18px
                    - height: 100%
                  name:
                    - color: "var(--text-primary-color, #FFFFFF)"
                    - font-size: 13px
                    - font-weight: 700
                    - letter-spacing: 0.5px
                    - justify-self: start
                    - text-align: left
                  custom_fields:
                    bars:
                      - width: 100%

              # Case 2 — Energy Status. Now two separate bars (production /
              # consumption, each scaled to the max of the two) instead of
              # the single coverage-ratio bar — see home.yaml.j2's Case 2
              # for the full rationale.
              - type: custom:button-card
                show_icon: false
                show_state: false
                show_label: false
                name: "{{ t('home.kpi.energy_status') }}"
                entity: "{{ energy.totals.today }}"
                tap_action:
                  action: more-info
                custom_fields:
                  bars: >
                    [[[
                      const prodEnt = states['{{ energy.solar.today }}'];
                      const consEnt = states['{{ energy.totals.today }}'];
                      const prod = parseFloat(prodEnt?.state) || 0;
                      const cons = parseFloat(consEnt?.state) || 0;
                      const prodUnit = prodEnt?.attributes?.unit_of_measurement || 'kWh';
                      const consUnit = consEnt?.attributes?.unit_of_measurement || 'kWh';
                      const maxVal = Math.max(prod, cons, 0.001);
                      const prodRatio = prod / maxVal * 100;
                      const consRatio = cons / maxVal * 100;
                      return `
                        <div style="margin-bottom:6px;">
                          <div style="font-size:9px;color:#00FFC3;margin-bottom:2px;">{{ t('home.kpi.production') }} ${prod.toFixed(1)}${prodUnit}</div>
                          <div style="position:relative;width:100%;height:9px;background:rgba(255,255,255,.08);border-radius:5px;overflow:hidden;">
                            <div style="width:${prodRatio}%;height:100%;background:#00FFC3;border-radius:5px;transition:width .3s;"></div>
                          </div>
                        </div>
                        <div>
                          <div style="font-size:9px;color:#FFA726;margin-bottom:2px;">{{ t('home.kpi.consumption') }} ${cons.toFixed(1)}${consUnit}</div>
                          <div style="position:relative;width:100%;height:9px;background:rgba(255,255,255,.08);border-radius:5px;overflow:hidden;">
                            <div style="width:${consRatio}%;height:100%;background:#FFA726;border-radius:5px;transition:width .3s;"></div>
                          </div>
                        </div>
                      `;
                    ]]]
                styles:
                  grid:
                    - grid-template-areas: '"n" "bars"'
                    - grid-template-rows: min-content 1fr
                    - row-gap: 6px
                    - justify-items: start
                  card:
                    - background: var(--card-background-color, rgba(8,18,28,0.72))
                    - border-radius: var(--ha-card-border-radius, 18px)
                    - border: 1px solid rgba(0, 229, 255, 0.2)
                    - padding: 14px 18px
                    - height: 100%
                  name:
                    - color: "var(--text-primary-color, #FFFFFF)"
                    - font-size: 13px
                    - font-weight: 700
                    - letter-spacing: 0.5px
                    - justify-self: start
                    - text-align: left
                  custom_fields:
                    bars:
                      - width: 100%

          - type: horizontal-stack
            cards:
              # Case 3 — Pièces + Connexions fusionnees. Meme fix + meme
              # fusion que home.yaml.j2's Case 3 — voir le commentaire
              # la-bas : "Pièces" est le compte des pieces DECLAREES (ROOMS
              # & FLOORS), pas un ratio d'activite on/off — rooms_rendered
              # est la bonne source, figee au moment de la generation.
              # total_devices est le nouvel attribut de
              # sensor.vssp_total_appareils qui rend le ratio possible pour
              # les appareils.
              - type: custom:button-card
                template: vssp_kpi_card
                icon: mdi:shield-lock
                name: "{{ t('common.security') }}"
                entity: alarm_control_panel.maison  # TODO: remplacer par votre entité alarme
                state_display: >
                  [[[
                    if (!entity) return '{{ t("home.alarm.not_configured") | js }}';
                    switch (entity.state) {
                      case "disarmed": return '{{ t("home.alarm.ok") | js }}';
                      case "triggered": return '{{ t("home.alarm.alert") | js }}';
                      case "armed_home": return '{{ t("home.alarm.armed") | js }}';
                      case "armed_away": return '{{ t("home.alarm.armed") | js }}';
                      default: return entity.state;
                    }
                  ]]]
                label: >
                  [[[
                    if (!entity) return '{{ t("home.alarm.no_entity") | js }}';
                    return entity.state === "triggered" ? '{{ t("home.alarm.intrusion") | js }}' : '{{ t("home.alarm.no_alert") | js }}';
                  ]]]
                variables:
                  icon_color: "#00FFC3"
                  value_color: "#00FFC3"

              # Case 4 — Température : moyenne des thermostats, +/- ajuste
              # chaque climate.* de 0.5°C. Meme carte que home.yaml.j2's
              # Case 4 — voir le commentaire la-bas.
              - type: custom:button-card
                show_icon: false
                show_state: false
                show_label: false
                name: "{{ t('home.kpi.thermostats') }}"
                tap_action:
                  action: none
                custom_fields:
                  temp: >
                    [[[
                      const clims = Object.values(states).filter(s =>
                        s.entity_id.startsWith('climate.') && s.attributes.temperature != null
                      );
                      const avg = clims.length
                        ? clims.reduce((a, s) => a + s.attributes.temperature, 0) / clims.length
                        : null;
                      const avgText = avg === null ? "{{ t('home.kpi.thermostats_hint') }}" : avg.toFixed(1) + '°C';
                      const adjustJs = (delta) => `
                        event.stopPropagation();
                        var hass = document.querySelector('home-assistant').hass;
                        Object.values(hass.states).filter(function(s) {
                          return s.entity_id.startsWith('climate.') && s.attributes.temperature != null;
                        }).forEach(function(s) {
                          var t = Math.max(10, Math.min(30, Math.round((s.attributes.temperature + (${delta})) * 2) / 2));
                          hass.callService('climate', 'set_temperature', {entity_id: s.entity_id, temperature: t});
                        });
                      `.replace(/\n/g, ' ').replace(/"/g, '&quot;');
                      const btnStyle = avg === null
                        ? 'font-size:22px;color:#00E5FF;width:28px;text-align:center;user-select:none;opacity:.3;pointer-events:none;'
                        : 'font-size:22px;color:#00E5FF;width:28px;text-align:center;user-select:none;cursor:pointer;';
                      return `
                        <div style="display:flex;align-items:center;justify-content:space-between;width:100%;">
                          <span onclick="${adjustJs(-0.5)}" style="${btnStyle}">−</span>
                          <span style="font-size:17px;font-weight:700;color:#FFFFFF;">${avgText}</span>
                          <span onclick="${adjustJs(0.5)}" style="${btnStyle}">+</span>
                        </div>
                      `;
                    ]]]
                styles:
                  grid:
                    - grid-template-areas: '"n" "temp"'
                    - grid-template-rows: min-content 1fr
                    - row-gap: 10px
                    - justify-items: start
                  card:
                    - background: var(--card-background-color, rgba(8,18,28,0.72))
                    - border-radius: var(--ha-card-border-radius, 18px)
                    - border: 1px solid rgba(0, 229, 255, 0.2)
                    - padding: 14px 18px
                    - height: 100%
                  name:
                    - color: "var(--text-primary-color, #FFFFFF)"
                    - font-size: 13px
                    - font-weight: 700
                    - letter-spacing: 0.5px
                    - justify-self: start
                    - text-align: left
                  custom_fields:
                    temp:
                      - width: 100%

          # Case 5 — UPGRADE : le feu vert / orange / rouge
          #
          # EN | ONE LIGHT FOR THE WHOLE ESTATE, and the question it answers
          # EN | is narrow on purpose: "is anything unpatched against a known
          # EN | vulnerability, and is anything about to need a real
          # EN | migration?" It is NOT a count of pending updates — the
          # EN | UPDATES screen already lists those, and a light that turns
          # EN | orange because a Lovelace card has a new version teaches you
          # EN | to ignore it by the end of the week.
          # EN |   GREEN   no security patch waiting, anywhere.
          # EN |   ORANGE  security patches waiting.
          # EN |   RED     a MAJOR version is available — the upgrade that
          # EN |           reads release notes, takes a backup and picks its
          # EN |           moment, rather than one that runs tonight.
          # EN |   GREY    never probed. A security light that shows green
          # EN |           when it has not looked is worse than no light, so
          # EN |           the one state the design refuses is a confident
          # EN |           green over missing data.
          # FR | UN SEUL FEU POUR TOUT LE PARC, et la question a laquelle il
          # FR | repond est etroite a dessein : « reste-t-il quelque chose
          # FR | d expose a une faille connue, et quelque chose reclame-t-il
          # FR | bientot une vraie migration ? » Ce n est PAS un decompte de
          # FR | mises a jour en attente — l ecran MISES A JOUR les liste
          # FR | deja, et un feu qui passe a l orange parce qu une carte
          # FR | Lovelace a une nouvelle version vous apprend a l ignorer
          # FR | avant la fin de la semaine.
          # FR |   VERT    aucun correctif de securite en attente, nulle part.
          # FR |   ORANGE  des correctifs de securite attendent.
          # FR |   ROUGE   une version MAJEURE est disponible — la mise a
          # FR |           niveau qui lit les notes de version, prend une
          # FR |           sauvegarde et choisit son moment, pas celle qui
          # FR |           tourne cette nuit.
          # FR |   GRIS    jamais sonde. Un feu de securite qui affiche vert
          # FR |           sans avoir regarde est pire que pas de feu ; le
          # FR |           seul etat que ce dessin refuse est donc un vert
          # FR |           confiant par-dessus des donnees absentes.
          #
          # EN | Reads both worlds, because "whatever the component" was the
          # EN | requirement: the update.* entities Home Assistant holds, and
          # EN | the infrastructure components the probe publishes as an
          # EN | attribute. Neither knows about the other, so the arbitration
          # EN | happens here and nowhere else.
          # FR | Lit les deux mondes, parce que « peu importe le composant »
          # FR | etait la demande : les entites update.* que detient Home
          # FR | Assistant, et les composants d infrastructure que la sonde
          # FR | publie en attribut. Aucun des deux ne connait l autre,
          # FR | l arbitrage a donc lieu ici et nulle part ailleurs.
          - type: custom:button-card
            template: vssp_kpi_card
            name: "{{ t('home.kpi.upgrade') }}"
            entity: sensor.vssp_updates_infra
            tap_action:
              action: navigate
              navigation_path: /visio-sapiens-admin/updates
            icon: >
              [[[
                const v = variables.verdict;
                if (v === 'red') return 'mdi:shield-alert';
                if (v === 'orange') return 'mdi:shield-sync';
                if (v === 'grey') return 'mdi:shield-off-outline';
                return 'mdi:shield-check';
              ]]]
            state_display: >
              [[[
                const v = variables.verdict;
                if (v === 'red') return '{{ t("home.upgrade.major") | js }}';
                if (v === 'orange') return '{{ t("home.upgrade.security") | js }}';
                if (v === 'grey') return '{{ t("home.upgrade.unknown") | js }}';
                return '{{ t("home.upgrade.clear") | js }}';
              ]]]
            label: >
              [[[
                const v = variables.verdict;
                if (v === 'red') return variables.major_name || '{{ t("home.upgrade.major_hint") | js }}';
                if (v === 'orange') return variables.security_count + ' {{ t("home.upgrade.security_hint") | js }}';
                if (v === 'grey') return '{{ t("home.upgrade.unknown_hint") | js }}';
                return '{{ t("home.upgrade.clear_hint") | js }}';
              ]]]
            variables:
              # EN | The whole decision, computed once. button-card evaluates
              # EN | `variables` before the fields that read them, so icon,
              # EN | state and label all see the same verdict rather than
              # EN | each recomputing it and disagreeing on a slow frame.
              # FR | Toute la decision, calculee une fois. button-card evalue
              # FR | `variables` avant les champs qui les lisent, donc icone,
              # FR | etat et libelle voient tous le meme verdict au lieu de le
              # FR | recalculer chacun et de diverger sur une frame lente.
              security_count: >
                [[[
                  const infra = states['sensor.vssp_updates_infra'];
                  if (!infra) return 0;
                  const rows = infra.attributes.components || [];
                  const os = rows.find(r => r.key === 'os_packages');
                  return os && os.security ? os.security : 0;
                ]]]
              major_name: >
                [[[
                  // EN | A major gap is the FIRST number moving: 1.20 -> 2.1
                  // EN | is one, 1.36.2 -> 1.36.4 is not. Anything without
                  // EN | both versions known is skipped rather than guessed —
                  // EN | an empty upstream is not evidence of anything.
                  // FR | Un ecart majeur, c est le PREMIER nombre qui bouge :
                  // FR | 1.20 -> 2.1 en est un, 1.36.2 -> 1.36.4 non. Tout ce
                  // FR | dont les deux versions ne sont pas connues est ignore
                  // FR | plutot que devine — un amont vide ne prouve rien.
                  const major = s => {
                    const m = String(s || '').match(/\d+/);
                    return m ? parseInt(m[0], 10) : null;
                  };
                  const hits = [];
                  const infra = states['sensor.vssp_updates_infra'];
                  if (infra) {
                    for (const r of (infra.attributes.components || [])) {
                      const a = major(r.installed), b = major(r.latest);
                      if (a !== null && b !== null && b > a) hits.push(r.key);
                    }
                  }
                  for (const eid of Object.keys(states)) {
                    if (!eid.startsWith('update.')) continue;
                    const e = states[eid];
                    if (!e || e.state !== 'on') continue;
                    const a = major(e.attributes.installed_version);
                    const b = major(e.attributes.latest_version);
                    if (a !== null && b !== null && b > a) {
                      hits.push(e.attributes.friendly_name || eid);
                    }
                  }
                  return hits.length ? hits.slice(0, 2).join(', ') : '';
                ]]]
              verdict: >
                [[[
                  const infra = states['sensor.vssp_updates_infra'];
                  const probed = infra && infra.state !== 'unavailable'
                                       && infra.state !== 'unknown';
                  if (variables.major_name) return 'red';
                  if (variables.security_count > 0) return 'orange';
                  // EN | Green only once the infrastructure has actually been
                  // EN | looked at. Home Assistant's own updates are always
                  // EN | known, so an unprobed host is the only thing that can
                  // EN | leave this grey.
                  // FR | Vert seulement une fois l infrastructure reellement
                  // FR | regardee. Les mises a jour propres a Home Assistant
                  // FR | sont toujours connues, donc un hote non sonde est la
                  // FR | seule chose qui puisse laisser ceci en gris.
                  if (!probed) return 'grey';
                  return 'green';
                ]]]
              icon_color: >
                [[[
                  const c = { red: '#FF3D71', orange: '#FF9800',
                              grey: '#56707E', green: '#00FFC3' };
                  return c[variables.verdict] || c.green;
                ]]]
              value_color: >
                [[[
                  const c = { red: '#FF3D71', orange: '#FF9800',
                              grey: '#56707E', green: '#00FFC3' };
                  return c[variables.verdict] || c.green;
                ]]]
            styles:
              # EN | The card border carries the verdict too. At the distance a
              # EN | wall tablet is actually read from, the icon is a smudge
              # EN | and the outline is what registers.
              # FR | La bordure de la carte porte aussi le verdict. A la
              # FR | distance ou une tablette murale est reellement lue,
              # FR | l icone est une tache et c est le contour qui se voit.
              card:
                - border: >
                    [[[
                      const c = { red: 'rgba(255,61,113,0.75)',
                                  orange: 'rgba(255,152,0,0.75)',
                                  grey: 'rgba(86,112,126,0.45)',
                                  green: 'rgba(0,255,195,0.45)' };
                      return '1px solid ' + (c[variables.verdict] || c.green);
                    ]]]
                - box-shadow: >
                    [[[
                      const c = { red: '0 0 18px rgba(255,61,113,0.35)',
                                  orange: '0 0 18px rgba(255,152,0,0.28)',
                                  grey: 'none',
                                  green: 'none' };
                      return c[variables.verdict] || 'none';
                    ]]]
                - cursor: pointer

      - type: custom:button-card
        view_layout:
          grid-area: video
        show_icon: false
        show_name: false
        show_label: false
        tap_action:
          action: none
        custom_fields:
          video: >
            <video autoplay muted loop playsinline
              style="width:100%;display:block;aspect-ratio:16/9;object-fit:cover;">
              <source src="/local/vssp/movies/vs-sp.mp4" type="video/mp4" />
            </video>
        styles:
          card:
            - padding: 0
            - background: transparent
            - border: 1px solid rgba(0, 229, 255, 0.28)
            - box-shadow: 0 0 24px rgba(0, 229, 255, 0.12)
            - border-radius: var(--ha-card-border-radius, 20px)
            - overflow: hidden
          grid:
            - grid-template-areas: '"video"'
          custom_fields:
            video:
              - width: 100%
        card_mod:
          style: |
            ha-card { overflow: hidden; border-radius: var(--ha-card-border-radius, 20px); }

      # ═══════════════════════════════════════════════════════════════
      # ÉNERGIE — top 10 appareils + courbe production/consommation +
      # synthèse (empilés)
      # ═══════════════════════════════════════════════════════════════
      - type: vertical-stack
        view_layout:
          grid-area: energy
        cards:
          - type: custom:button-card
            template: vssp_section_title
            name: "{{ t('home.top_devices') }}"
            card_mod:
              style: |
                ha-card { padding: 0 0 6px 0 !important; }
                #name { font-size: 12px !important; letter-spacing: 1px !important; }

          # EN | Same fixed-height/overflow-y scroll box as ENERGY's own
          # EN | mobile device panel (energy_mobile.yaml.j2), touch-action:
          # EN | pan-y and all — that is this project's already-proven fix
          # EN | for a scrollable list nested inside a page that also
          # EN | scrolls (mirrors the pan-x used by the chip nav bar). No
          # EN | column headers either, same reasoning as ENERGY's: four
          # EN | labels over ~380px would wrap and cost more height than
          # EN | they explain — vssp_energy_device_row already labels its
          # EN | own values.
          # FR | Meme boite de defilement a hauteur fixe/overflow-y que le
          # FR | panneau appareils mobile d'ENERGY (energy_mobile.yaml.j2),
          # FR | touch-action: pan-y compris — c'est deja le correctif
          # FR | eprouve de ce projet pour une liste defilante imbriquee
          # FR | dans une page qui defile aussi (miroir du pan-x de la barre
          # FR | de chips de nav). Pas d'en-tetes de colonnes non plus, meme
          # FR | raisonnement que ENERGY : quatre libelles sur ~380px se
          # FR | replieraient et couteraient plus de hauteur qu'ils
          # FR | n'expliquent — vssp_energy_device_row etiquette deja ses
          # FR | propres valeurs.
          - type: custom:button-card
            show_icon: false
            show_name: false
            show_state: false
            tap_action:
              action: none
            styles:
              grid:
                - grid-template-areas: '"list"'
              card:
                - background: transparent
                - box-shadow: none
                - border: none
                - border-radius: 0
                - padding: 0
                - cursor: default
              custom_fields:
                list:
                  - display: block
                  - width: 100%
                  - height: 260px
                  - overflow-y: auto
                  - overflow-x: hidden
                  - touch-action: pan-y
                  - "-webkit-overflow-scrolling": touch
                  - padding-right: 4px
                  - scrollbar-width: none
            custom_fields:
              list:
                card:
                  type: vertical-stack
                  cards:
{% for d in energy_devices[:10] %}
                    - type: custom:button-card
                      template: vssp_energy_device_row
                      entity: {{ d.power_entity }}
                      name: "{{ d.name }}"
                      icon: {{ d.icon }}
                      variables:
                        room: "{{ d.room }}"
                        model: "{{ d.model | default('—', true) }}"
                        energy_entity: {{ d.energy_entity }}
                      tap_action:
                        action: more-info
{% endfor %}
{% if not energy_devices %}
                    - type: custom:button-card
                      template: vssp_energy_device_row
                      name: "{{ t('energy.empty.devices') }}"
                      icon: mdi:help-circle-outline
                      variables:
                        room: "—"
{% endif %}

          # Courbe production solaire vs consommation
          - type: custom:apexcharts-card
            header:
              show: true
              title: "{{ t('home.production_consumption') }}"
              show_states: false
            graph_span: 24h
            card_mod:
              style: |
                ha-card {
                  background: var(--osv-panel) !important;
                  overflow: hidden;
                }
            apex_config:
              chart:
                height: 180
            series:
              - entity: sensor.solar_power_production          # TODO
                name: Production
                type: area
                color: "#00FFC3"
                stroke_width: 2
                opacity: 0.15
              - entity: sensor.home_power_consumption          # TODO
                name: Consommation
                type: line
                color: "#00E5FF"
                stroke_width: 2

          # Synthèse kW production / consommation (côte à côte)
          - type: horizontal-stack
            cards:
              - type: custom:button-card
                template: vssp_metric
                show_icon: true
                icon: mdi:solar-power
                name: PRODUCTION
                entity: sensor.solar_power_production          # TODO
              - type: custom:button-card
                template: vssp_metric
                show_icon: true
                icon: mdi:flash
                name: CONSOMMATION
                entity: sensor.home_power_consumption          # TODO

      # ═══════════════════════════════════════════════════════════════
      # ÉVÉNEMENTS RÉCENTS (logbook, hauteur fixe défilante)
      # ═══════════════════════════════════════════════════════════════
      - type: logbook
        title: "Événements récents"
        hours_to_show: 24
        view_layout:
          grid-area: events
        target:
          # EN | Generated from the declared rooms, like the tablet view.
          # FR | Genere depuis les pieces declarees, comme la vue tablette.
          area_id:
{% for r in rooms_rendered %}
            - {{ r.area_id }}
{% endfor %}
        card_mod:
          style: |
            :host {
              display: block;
              overflow: hidden;
            }
            ha-card {
              background: var(--osv-panel) !important;
              height: 320px !important;
              min-height: 0;
              display: flex;
              flex-direction: column;
              overflow: hidden;
              --primary-text-color: #B8E8F5 !important;
              --secondary-text-color: #8FB6C9 !important;
              --primary-color: #00E5FF !important;
              --text-primary-color: #FFFFFF !important;
              --card-background-color: var(--osv-panel) !important;
            }
            ha-card .card-header {
              color: #FFFFFF !important;
            }
            ha-logbook {
              flex: 1 1 0;
              min-height: 0;
              overflow-y: auto;
              -webkit-overflow-scrolling: touch;
            }

      # ═══════════════════════════════════════════════════════════════
      # MÉTÉO ET PRÉVISIONS
      # ═══════════════════════════════════════════════════════════════
      - type: custom:dynamic-weather-card
        entity: weather.meteo_france_forecast_for_city_sausset_les_pins_provence_alpes_cote_d_azur_13_fr_sausset_les_pins
        name: Sausset les Pins
        height: 360
        show_feels_like: true
        show_wind: true
        show_wind_gust: true
        show_wind_direction: true
        show_humidity: true
        show_min_temp: true
        show_hourly_forecast: false
        hourly_forecast_hours: 5
        show_daily_forecast: true
        daily_forecast_days: 5
        show_sunrise_sunset: false
        show_clock: false
        clock_position: top
        clock_format: 24h
        overlay_opacity: 0.1
        # EN | Was hardcoded `fr` — see home.yaml.j2's weather card for why.
        # FR | Etait code en dur `fr` — voir la carte meteo de home.yaml.j2.
        language: "{{ locale }}"
        wind_speed_unit: ms
        sunrise_entity: ""
        sunset_entity: ""
        view_layout:
          grid-area: meteo
        card_mod:
          style: |
            :host {
              display: block;
              overflow: hidden;
            }
            ha-card {
              background: var(--osv-panel) !important;
              min-height: 0;
              display: flex;
              flex-direction: column;
              overflow: hidden;
            }

      # ═══════════════════════════════════════════════════════════════
      # INTERPHONE + AUDIO STREAM (côte à côte)
      # ═══════════════════════════════════════════════════════════════
      - type: horizontal-stack
        view_layout:
          grid-area: right
        cards:
          - type: custom:button-card
            template: vssp_panel
            show_name: true
            name: "{{ t('home.intercom') }}"
            icon: mdi:doorbell-video
            show_icon: true
            styles:
              card:
                - height: 120px
                - justify-content: center
                - align-items: center
              name:
                - color: "var(--secondary-text-color, #B8E8F5)"
                - font-size: 13px
                - letter-spacing: 2px
              icon:
                - color: "var(--paper-item-icon-color, #00E5FF)"
                - "--mdc-icon-size": 34px

          - type: custom:button-card
            template: vssp_panel
            show_name: true
            name: AUDIO STREAM
            icon: mdi:music-note
            show_icon: true
            styles:
              card:
                - height: 120px
                - justify-content: center
                - align-items: center
              name:
                - color: "var(--secondary-text-color, #B8E8F5)"
                - font-size: 13px
                - letter-spacing: 2px
              icon:
                - color: "var(--paper-item-icon-color, #00E5FF)"
                - "--mdc-icon-size": 34px

    # ── Fond de vue (même image que la version desktop) ──────────────
    card_mod:
      style: |
        hui-view {
          /* PAS de background-attachment:fixed : cassé sur iOS/Safari,
             l'image ne couvrait pas la longueur du dashboard. Sans
             `fixed`, l'image est peinte sur TOUTE la hauteur de la vue
             (cover s'étire sur la longueur totale du contenu) et
             défile avec la page. */
          min-height: 100%;
          background: center top / cover no-repeat url("/local/vssp/backgrounds/home.png");
        }