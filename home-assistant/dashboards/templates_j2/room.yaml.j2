########################################################################
# Visio Sapiens — ROOM Dashboard (single shared template)
#
# EN | *** GENERATED FILE — DO NOT EDIT BY HAND ***
# EN | Source: room.yaml.j2 + model/house.yaml + locales/<code>.yaml
# EN | Regenerate with: python3 generate_dashboards.py
# FR | *** FICHIER GENERE — NE PAS EDITER A LA MAIN ***
# FR | Source : room.yaml.j2 + model/house.yaml + locales/<code>.yaml
# FR | Regenerer avec : python3 generate_dashboards.py
#
# EN | ONE template renders EVERY room. The differences live in the data —
# EN | slot set and device lists — never in a second template. A kitchen and
# EN | a garage differ by what house.yaml says they contain, not by their
# EN | markup.
# FR | UN template rend TOUTES les pieces. Les differences vivent dans la
# FR | donnee — jeu de tableaux et listes d'appareils — jamais dans un second
# FR | template. Une cuisine et un garage different par ce que house.yaml dit
# FR | qu'elles contiennent, pas par leur balisage.
#
# EN | THE FIVE SLOTS / FR | LES CINQ TABLEAUX
#   1 sensors        temperature, humidity, heating, ventilation (VMC),
#                    battery — environmental readings and climate control
#   2 switches       ALWAYS a full-width horizontal strip, holding one
#                    titled FRAME per kind of switch, side by side:
#                    lights, connected outlets, shutters — each frame a
#                    list of rows with a state indicator on every line
#                    (see _switch_group.j2 and vssp_circuit_row — the
#                    reference presentation for a switch list)
#   3 appliances     white goods, TV, home cinema, console, wine fridge, spa,
#                    towel rail — LINE BY LINE, with a scrollbar
#   4 security       alarm, intercom, camera — OVERSIZED: an intercom video
#                    feed, a camera mosaic and the alarm state need room
#   5 infrastructure servers, network switches, ISP box, firewall — LINE BY
#                    LINE, with a scrollbar, same idiom as appliances
#
# EN | SLOT STATES — set by generate_dashboards.py, not decided here:
# EN |   filled  the slot holds at least one device
# EN |   empty   the slot holds nothing. NOT rendered — no placeholder card,
# EN |           no grid area, dropped entirely (see compute_room_layout() in
# EN |           generate_dashboards.py). The one exception: a room's
# EN |           `entrance`-preset `switches`/`security` slots always render,
# EN |           even empty — their content is hardcoded per the physical
# EN |           room (cameras, intercom), not device-driven.
# EN | A slot OUTSIDE the room's set never reaches this template: it is
# EN | absent from room.slots and absent from the grid areas below, so it
# EN | collapses and its neighbours expand.
# FR | ETATS DES TABLEAUX — poses par generate_dashboards.py, pas decides ici :
# FR |   filled  le tableau contient au moins un appareil
# FR |   empty   le tableau ne contient rien. PAS rendu — ni carte de
# FR |           remplacement, ni zone de grille, totalement absent (voir
# FR |           compute_room_layout() dans generate_dashboards.py). Seule
# FR |           exception : les tableaux `switches`/`security` d'une piece
# FR |           au preset `entrance` sont toujours rendus, meme vides — leur
# FR |           contenu est code en dur pour la piece physique (cameras,
# FR |           interphone), pas pilote par des appareils assignes.
# FR | Un tableau HORS du jeu de la piece n'atteint jamais ce template : il
# FR | est absent de room.slots et absent des grid areas ci-dessous, donc il
# FR | s'effondre et ses voisins s'etendent.
#
# EN | PREREQUISITES / FR | PREREQUIS
#   Same button-card templates as energy.yaml.j2
#   (vssp_page_header, vssp_nav_button, vssp_sidebar_logo,
#    vssp_section_title, vssp_energy_device_row).
########################################################################

{# EN | Plain {% ... %}, never {%- ... -%}. The environment already sets
   EN | trim_blocks and lstrip_blocks, so a tag alone on its line disappears
   EN | cleanly. Adding the `-` markers strips the surrounding newlines too,
   EN | which glued `title:` onto the closing #### line of the header comment
   EN | — the key ended up inside a comment and every generated dashboard
   EN | silently lost its title.
   FR | {% ... %} simple, jamais {%- ... -%}. L'environnement pose deja
   FR | trim_blocks et lstrip_blocks, donc une balise seule sur sa ligne
   FR | disparait proprement. Ajouter les marqueurs `-` supprime aussi les
   FR | sauts de ligne alentour, ce qui a colle `title:` sur la ligne ####
   FR | fermant le commentaire d'en-tete — la cle s'est retrouvee dans un
   FR | commentaire et chaque dashboard genere a perdu son titre en silence. #}
{# =====================================================================
    EN | GRID LAYOUT — computed per room by compute_room_layout() in
    EN | generate_dashboards.py from what the room actually contains (device
    EN | counts + its `default_slot`), NOT a fixed preset. See
    EN | docs/dashboards/Dashboard_Generator.md, "Room dashboard grid — dynamic slot
    EN | layout". Areas are generated FROM the present slots, so a slot with
    EN | no grid area can no longer happen by construction — nothing left to
    EN | validate here at render time.
    FR | GABARIT DE GRILLE — calcule par piece par compute_room_layout() dans
    FR | generate_dashboards.py a partir de ce que la piece contient
    FR | reellement (nombre d'appareils + son `default_slot`), pas un preset
    FR | fixe. Voir docs/dashboards/Dashboard_Generator.md, « Room dashboard grid —
    FR | dynamic slot layout ». Les zones sont generees A PARTIR des tableaux
    FR | presents, donc un tableau sans zone de grille ne peut plus arriver
    FR | par construction — rien a valider ici au rendu.
    ================================================================== #}
{% set layout = room.layout %}
{% set filler_media = house.filler_animation | default('/local/vssp/images/vssp_loop.gif', true) %}

title: {{ room.label }}
theme: {{ house.theme }}

# EN | Without these includes every custom:button-card shows "Configuration
# EN | error". Path is relative to dashboards/views/.
# FR | Sans ces includes, chaque custom:button-card affiche « Erreur de
# FR | configuration ». Chemin relatif a dashboards/views/.
button_card_templates: !include ../templates/button_card_templates.yaml
decluttering_templates: !include ../templates/decluttering_templates.yaml

views:
  - title: {{ room.label }}
    path: {{ room.id }}
    subview: false
{% if format == 'mobile' %}
    # EN | Mobile: one column, no rail. Reading order puts the slots you
    # EN | reach for first at the top — nobody wants to scroll to switch a
    # EN | light on.
    # FR | Mobile : une colonne, sans bandeau. L'ordre de lecture place en
    # FR | haut les tableaux qu'on cherche en premier — personne ne veut
    # FR | scroller pour allumer une lampe.
    type: custom:vertical-layout
    layout:
      margin: 8px
      card_margin: 8px
{% else %}
    type: custom:grid-layout
    layout:
      grid-template-columns: minmax(200px, auto) 1fr 1fr 1fr 1fr 1fr
      grid-template-rows: {{ layout.rows }}
      grid-template-areas: |
{% for line in layout.areas %}
        "{{ line }}"
{% endfor %}
      margin: 12px
      grid-gap: 14px 14px
{% endif %}
    cards:
      # ═══════════════════════════════════════════════════════════════
      # EN | HEADER BAND — shared partial, identical on every dashboard
      # FR | BANDEAU HORIZONTAL — partial partage, identique partout
      # ═══════════════════════════════════════════════════════════════
{% set page_title = room.name %}
{% set page_subtitle = room.label %}
{% set page_path = room.path_mobile if format == 'mobile' else room.path %}
{% include '_header.j2' %}

{% if format != 'mobile' %}
      # ═══════════════════════════════════════════════════════════════
      # EN | NAVIGATION RAIL — dynamic, 4 system entries + rooms
      # FR | BANDEAU DE NAVIGATION — dynamique, 4 entrees systeme + pieces
      # ═══════════════════════════════════════════════════════════════
{% include '_nav.j2' %}
{% endif %}

{% set slot_order = room.slot_order_mobile if format == 'mobile' else slots %}
{% for slot_id in slot_order if slot_id in room.rendered_slot_ids %}
{% set slot = room.slots[slot_id] %}
      # ═══════════════════════════════════════════════════════════════
      # EN | SLOT {{ loop.index }} — {{ slot_id | upper }} ({{ slot.state }})
      # FR | TABLEAU {{ loop.index }} — {{ slot_id | upper }} ({{ slot.state }})
      # ═══════════════════════════════════════════════════════════════
      - type: vertical-stack
{% if format != 'mobile' %}
        view_layout:
          grid-area: {{ slot_id }}
{% endif %}
        card_mod:
          style: |
            :host {
              display: flex;
              flex-direction: column;
              height: 100%;
              background: var(--card-background-color, rgba(8,18,28,0.75));
              border-radius: var(--ha-card-border-radius, 20px);
              border: 1px solid rgba(0, 229, 255, 0.28);
              backdrop-filter: blur(12px);
              box-shadow: 0 0 18px rgba(0, 229, 255, 0.15);
              padding: 16px 18px;
              overflow: hidden;
            }
        cards:
{% import '_slot_schedule.j2' as sched %}
{# EN | Devices this panel holds that the schedule engine will accept. Kept
   EN | in step with ALLOWED_DOMAINS in vssp/vssp_schedule_apply.py: offering
   EN | a device the engine refuses on save is worse than not offering it.
   EN | An empty list means no clock — a panel with nothing schedulable in it
   EN | gets a plain title, not an icon that opens an empty form.
   FR | Les appareils de ce tableau que le moteur de planification acceptera.
   FR | Tenu en phase avec ALLOWED_DOMAINS de vssp/vssp_schedule_apply.py :
   FR | proposer un appareil que le moteur refusera a l'enregistrement vaut
   FR | moins que de ne pas le proposer.
   FR | Une liste vide signifie pas d'horloge — un tableau sans rien de
   FR | planifiable recoit un titre simple, pas une icone qui ouvrirait un
   FR | formulaire vide. #}
{% set sched_domains = ['light', 'switch', 'cover', 'fan', 'media_player',
                        'input_boolean', 'climate', 'humidifier', 'siren'] %}
{% set sched_ids = [] %}
{% if slot_id == 'switches' %}
{% for e in slot.get('entities') or [] %}
{% if e.split('.')[0] in sched_domains %}
{% set _ = sched_ids.append(e) %}
{% endif %}
{% endfor %}
{% endif %}
{% if sched_ids %}
{{ sched.title_with_clock(t('slot.' ~ slot_id), t('slot.schedule'), sched_ids,
                          room.name, locale, build_stamp) }}
{% else %}
          - type: custom:button-card
            template: vssp_section_title
            name: "{{ t('slot.' ~ slot_id) }}"
{% endif %}

{% import '_switch_group.j2' as sw %}
{% set is_entrance_special = room.slot_set == 'entrance' and slot_id in ['switches', 'security'] %}
{% if slot.state == 'empty' and not is_entrance_special %}
          # EN | The slot belongs to this room's set but holds no device yet.
          # EN | It is NOT "coming soon": nothing is promised. It simply
          # EN | states that the place exists and is available — assign a
          # EN | device to it in the admin console and it fills in.
          # FR | Le tableau appartient au jeu de cette piece mais ne contient
          # FR | encore aucun appareil. Ce n'est PAS « bientot disponible » :
          # FR | rien n'est promis. Il indique simplement que la place existe
          # FR | et est disponible — assignez-lui un appareil dans la console
          # FR | admin et il se remplit.
          - type: custom:button-card
            show_icon: true
            show_name: false
            show_state: false
            show_label: true
            icon: mdi:tray-remove
            label: "{{ t('slot.empty') }}"
            tap_action:
              action: none
            styles:
              card:
                - background: transparent
                - box-shadow: none
                - border: none
                - flex: 1 1 auto
                - cursor: default
                - pointer-events: none
              icon:
                - color: rgba(143,182,201,0.35)
                - "--mdc-icon-size": 40px
              label:
                - color: rgba(143,182,201,0.55)
                - font-size: 12px
                - letter-spacing: .6px
                - margin-top: 8px

{% elif slot.state == 'filler' and not is_entrance_special %}
          # EN | Visio Sapiens animation. At most ONE per dashboard, chosen by
          # EN | the generator — several identical panels on one screen would
          # EN | read as a broken interface rather than a signature.
          # FR | Animation Visio Sapiens. Au plus UNE par dashboard, choisie
          # FR | par le generateur — plusieurs panneaux identiques sur un meme
          # FR | ecran se liraient comme une interface cassee, pas comme une
          # FR | signature.
          - type: custom:button-card
            show_icon: false
            show_name: false
            show_state: false
            tap_action:
              action: none
            custom_fields:
              anim: >
                <img src="{{ filler_media }}"
                     style="width:100%;height:100%;object-fit:cover;border-radius:14px;opacity:.75;mix-blend-mode:screen;" />
            styles:
              card:
                - background: transparent
                - box-shadow: none
                - border: none
                - padding: 0
                - flex: 1 1 auto
                - cursor: default
                - pointer-events: none
              grid:
                - grid-template-areas: '"anim"'
              custom_fields:
                anim:
                  - width: 100%
                  - height: 100%

{% elif slot_id in ['appliances', 'sensors'] %}
          # EN | LINE BY LINE, WITH A SCROLLBAR. Shared with `sensors` — same
          # EN | idiom, this block has no appliances-specific content, it
          # EN | only ever reads `slot.entities`/`format`.
          # FR | LIGNE PAR LIGNE, AVEC UN ASCENSEUR. Partage avec `sensors` —
          # FR | meme idiome, ce bloc n'a rien de propre a appliances, il ne
          # FR | lit que `slot.entities`/`format`.
          # EN | Same idiom as the ENERGY device list: the scrolling lives
          # EN | INSIDE a single button-card whose custom field has a fixed
          # EN | height and overflow-y. button-card's own style engine handles
          # EN | it, not card-mod.
          # EN | This is what keeps the HUD grid rigid: a kitchen with twelve
          # EN | devices and a hallway with one occupy exactly the same
          # EN | footprint, so every room dashboard looks like the others.
          # FR | LIGNE PAR LIGNE, AVEC UN ASCENSEUR.
          # FR | Meme idiome que la liste d'appareils ENERGY : le defilement
          # FR | vit DANS une seule button-card dont le champ custom a une
          # FR | hauteur fixe et overflow-y. C'est le moteur de styles de
          # FR | button-card qui s'en charge, pas card-mod.
          # FR | C'est ce qui garde la grille HUD rigide : une cuisine a douze
          # FR | appareils et un couloir a un seul occupent exactement la meme
          # FR | emprise, donc tous les dashboards de piece se ressemblent.
          - type: custom:button-card
            show_icon: false
            show_name: false
            show_state: false
            tap_action:
              action: none
            styles:
              grid:
                - grid-template-areas: '"list"'
              card:
                - background: transparent
                - box-shadow: none
                - border: none
                - border-radius: 0
                - padding: 0
                - cursor: default
              custom_fields:
                list:
                  - display: block
                  - width: 100%
                  - height: {{ '320px' if format != 'mobile' else '260px' }}
                  - overflow-y: auto
                  - overflow-x: hidden
                  - padding-right: 4px
                  - scrollbar-width: thin
                  - scrollbar-color: rgba(0, 229, 255, 0.35) rgba(0, 229, 255, 0.06)
            custom_fields:
              list:
                card:
                  type: vertical-stack
                  cards:
{% for e in slot.entities %}
                    # EN | Order is the one set in the admin console, not an
                    # EN | alphabetical sort — you decide the TV comes before
                    # EN | the console without renaming an entity.
                    # FR | L'ordre est celui defini dans la console admin, pas
                    # FR | un tri alphabetique — tu decides que la TV passe
                    # FR | avant la console sans renommer d'entite.
                    - type: custom:button-card
                      entity: {{ e }}
                      show_state: true
                      show_label: false
                      size: 22px
                      styles:
                        grid:
                          - grid-template-areas: '"i n s"'
                          - grid-template-columns: 32px 1fr auto
                          - align-items: center
                          - column-gap: 10px
                        card:
                          - background: rgba(0,0,0,.22)
                          - border: 1px solid rgba(0, 229, 255, 0.12)
                          - border-radius: 12px
                          - padding: 8px 12px
                          - margin-bottom: 6px
                          - height: 46px
                        name:
                          - justify-self: start
                          - text-align: left
                          - font-size: 13px
                          - color: "var(--text-primary-color, #DCEEF6)"
                        state:
                          - justify-self: end
                          - text-align: right
                          - font-size: 12px
                          - color: "#00E5FF"
                        icon:
                          - color: "var(--paper-item-icon-color, #00E5FF)"
                      tap_action:
                        action: toggle
                      hold_action:
                        action: more-info
{% endfor %}

{% elif slot_id == 'security' and room.slot_set == 'entrance' %}
          # EN | ENTRANCE-ONLY LAYOUT — three columns side by side across the
          # EN | full 510px-tall row (house.yaml `layouts.entrance`): camera
          # EN | mosaic + NVR access, the intercom feed + door/light
          # EN | controls, and the Jessica vacuum panel + its actions. Gated
          # EN | on room.slot_set == 'entrance' rather than replacing the
          # EN | generic security branch below, so every other room keeping
          # EN | the `security` slot (a bedroom's smoke detector, a garage's
          # EN | camera...) is untouched.
          # EN | The Jessica (Ecovacs) vacuum entities and the three NVR
          # EN | camera channels are now real, given directly by the user.
          # EN | The door lock/script entity and the NVR's own URL are still
          # EN | TODO — this project has no way to know them.
          # FR | GABARIT PROPRE A L'ENTREE — trois colonnes cote a cote sur
          # FR | toute la ligne de 510px (house.yaml `layouts.entrance`) :
          # FR | mosaique de cameras + acces NVR, flux de l'interphone +
          # FR | commandes porte/lumiere, et le panneau du robot Jessica +
          # FR | ses actions. Conditionne a room.slot_set == 'entrance'
          # FR | plutot que de remplacer le tableau security generique
          # FR | ci-dessous, pour que toute autre piece gardant le tableau
          # FR | `security` (le detecteur de fumee d'une chambre, la camera
          # FR | d'un garage...) reste inchangee.
          # FR | Les entites du robot Jessica (Ecovacs) et les trois canaux
          # FR | de cameras NVR sont desormais reelles, fournies directement
          # FR | par l'utilisateur. L'entite lock/script de la porte et
          # FR | l'URL du NVR restent des TODO — ce projet n'a aucun moyen de
          # FR | les connaitre.
          # EN | Cameras given directly by the user (Developer Tools >
          # EN | States did not have anything usable assigned to this slot
          # EN | via the admin console yet) rather than discovered from
          # EN | slot.by_domain — hardcoded here, same spirit as the
          # EN | System Monitor entity ids earlier. Explicit `name:` per
          # EN | camera because an NVR channel's own registered name is
          # EN | typically "Channel 1", not "Garage".
          # FR | Cameras fournies directement par l'utilisateur (rien
          # FR | d'exploitable assigne a ce tableau via la console admin
          # FR | pour l'instant) plutot que decouvertes depuis
          # FR | slot.by_domain — codees en dur ici, meme esprit que les
          # FR | entity id System Monitor plus tot. `name:` explicite par
          # FR | camera car le nom propre d'un canal NVR est typiquement
          # FR | « Channel 1 », pas « Garage ».
{% set entrance_cameras = [
  {'entity': 'camera.nvr_expanse_channel_1', 'name': 'Garage'},
  {'entity': 'camera.nvr_expanse_channel_2', 'name': 'Jardin'},
  {'entity': 'camera.nvr_expanse_channel_3', 'name': "Porte d'entrée"},
] %}
{% set ns = namespace(intercom=[], mosaic=[]) %}
{% for c in entrance_cameras %}
{% if 'interphone' in c.entity | lower or 'intercom' in c.entity | lower or 'portier' in c.entity | lower or 'doorbell' in c.entity | lower %}
{% set ns.intercom = ns.intercom + [c] %}
{% else %}
{% set ns.mosaic = ns.mosaic + [c] %}
{% endif %}
{% endfor %}
{% set intercom_cam = ns.intercom[0] if ns.intercom else None %}
{% set mosaic_cams = ns.mosaic %}
{# EN | Specifically a light-domain entity — the switches slot now also
   EN | carries outlets and shutters, so entities[0] could be any of the
   EN | three; by_domain (see normalise_slots()) picks the right one.
   FR | Specifiquement une entite du domaine light — le tableau switches
   FR | porte desormais aussi les prises et les volets, donc entities[0]
   FR | pourrait etre n'importe lequel des trois ; by_domain (voir
   FR | normalise_slots()) choisit le bon. #}
{% set entrance_light = room.slots['switches'].by_domain.light[0] if room.slots.get('switches') and room.slots['switches'].by_domain.get('light') else None %}
          - type: horizontal-stack
            card_mod:
              style: |
                :host { height: 100%; }
                #root { height: 100%; align-items: stretch; }
            cards:
              # ── Colonne 1 : mosaique de cameras (defilante) + acces NVR ──
              - type: vertical-stack
                card_mod:
                  style: |
                    :host { flex: 1 1 0; height: 100%; }
                    #root {
                      height: 100%;
                      box-sizing: border-box;
                      background: rgba(0,0,0,.16);
                      border: 1px solid rgba(0, 229, 255, 0.15);
                      border-radius: 16px;
                      padding: 10px;
                    }
                cards:
                  - type: custom:button-card
                    template: vssp_section_title
                    name: "{{ t('slot.security_camera') }}"
{% if mosaic_cams %}
                  - type: custom:button-card
                    show_icon: false
                    show_name: false
                    show_state: false
                    tap_action:
                      action: none
                    styles:
                      grid:
                        - grid-template-areas: '"mosaic"'
                      card:
                        - background: transparent
                        - box-shadow: none
                        - border: none
                        - padding: 0
                        - cursor: default
                      custom_fields:
                        mosaic:
                          - display: block
                          - width: 100%
                          - height: 320px
                          - overflow-y: auto
                          - overflow-x: hidden
                          - padding-right: 4px
                          - scrollbar-width: thin
                          - scrollbar-color: rgba(0, 229, 255, 0.35) rgba(0, 229, 255, 0.06)
                    custom_fields:
                      mosaic:
                        card:
                          type: grid
                          columns: 2
                          square: false
                          cards:
{% for c in mosaic_cams %}
                            - type: picture-entity
                              entity: {{ c.entity }}
                              name: "{{ c.name }}"
                              camera_view: live
                              show_name: true
                              show_state: false
                              card_mod:
                                style: |
                                  ha-card {
                                    background: rgba(0,0,0,.35) !important;
                                    border: 1px solid rgba(0, 229, 255, 0.18) !important;
                                    border-radius: 14px !important;
                                    overflow: hidden;
                                  }
{% endfor %}
{% else %}
                  - type: custom:button-card
                    show_icon: true
                    show_name: false
                    show_state: false
                    show_label: true
                    icon: mdi:cctv-off
                    label: "{{ t('slot.empty') }}"
                    tap_action:
                      action: none
                    styles:
                      card:
                        - background: transparent
                        - box-shadow: none
                        - border: none
                        - flex: 1 1 auto
                        - cursor: default
                        - pointer-events: none
                      icon:
                        - color: rgba(143,182,201,0.35)
                        - "--mdc-icon-size": 40px
                      label:
                        - color: rgba(143,182,201,0.55)
                        - font-size: 12px
{% endif %}
                  # NVR access — TODO: remplacer l'URL par celle de votre NVR
                  - type: custom:button-card
                    template: vssp_panel
                    show_name: true
                    show_icon: true
                    name: "{{ t('slot.nvr_access') }}"
                    icon: mdi:server-security
                    tap_action:
                      action: url
                      url_path: "http://TODO-NVR-IP:PORT"  # TODO: remplacer par votre entité/URL NVR
                    styles:
                      card:
                        - height: 72px
                        - justify-content: center
                        - align-items: center
                        - flex-direction: row
                        - gap: 12px
                      name:
                        - color: "var(--secondary-text-color, #B8E8F5)"
                        - font-size: 13px
                        - letter-spacing: 1px
                      icon:
                        - color: "var(--paper-item-icon-color, #00E5FF)"
                        - "--mdc-icon-size": 28px

              # ── Colonne 2 : ecran interphone + ouverture/fermeture/lumiere ──
              - type: vertical-stack
                card_mod:
                  style: |
                    :host { flex: 1 1 0; height: 100%; }
                    #root {
                      height: 100%;
                      box-sizing: border-box;
                      background: rgba(0,0,0,.16);
                      border: 1px solid rgba(0, 229, 255, 0.15);
                      border-radius: 16px;
                      padding: 10px;
                    }
                cards:
                  - type: custom:button-card
                    template: vssp_section_title
                    name: "{{ t('slot.security_intercom') }}"
{% if intercom_cam %}
                  - type: picture-entity
