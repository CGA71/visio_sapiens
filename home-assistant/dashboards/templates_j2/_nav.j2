{# =====================================================================
   Visio Sapiens — NAVIGATION RAIL (shared partial)
   Include:  {% raw %}{% include '_nav.j2' %}{% endraw %}

   EN | The rail is DYNAMIC: it is rendered from the `nav` list composed by
   EN | generate_dashboards.py as
   EN |     nav_system.before_rooms + declared rooms + nav_system.after_rooms
   EN | so its length is always 4 system entries + the number of rooms.
   EN | Adding a bathroom in the admin console adds its entry to the rail on
   EN | every dashboard at once. No navigation block is maintained by hand
   EN | anywhere in the repository.
   FR | Le bandeau est DYNAMIQUE : il est rendu depuis la liste `nav` composee
   FR | par generate_dashboards.py comme
   FR |     nav_system.before_rooms + pieces declarees + nav_system.after_rooms
   FR | donc sa longueur vaut toujours 4 entrees systeme + le nombre de pieces.
   FR | Ajouter une salle de bain dans la console admin ajoute son entree au
   FR | bandeau sur tous les dashboards d'un coup. Aucun bloc de navigation
   FR | n'est maintenu a la main dans le depot.

   EN | EXPECTED CONTEXT / FR | CONTEXTE ATTENDU
     house       - name, tagline, logo
     nav         - composed entry list
     active_nav  - id of the current dashboard, highlighted
     format      - 'tablet' | 'mobile', selects path vs path_mobile

   EN | WIDTH — the rail is as wide as its widest ENTRY and no wider: each
   EN | layout gives it a max-content column, and nothing here sets a
   EN | minimum. The brand title and the logo square carry
   EN | `contain: inline-size`, so they fit the width the entries chose
   EN | instead of imposing their own (the title wraps, the square shrinks).
   EN | It used to be min-width: 200px plus a 160px image, i.e. 230px for
   EN | entries that needed ~160. A longer room name or a larger text scale
   EN | widens it again, by exactly what it needs. The inner spacing is
   EN | tight on purpose (rail 6px, entry 8px, icon column 22px): 16px
   EN | between the longest text and the rail edge, not 46.
   FR | LARGEUR — le bandeau fait la largeur de sa plus large ENTREE et pas
   FR | plus : chaque layout lui donne une colonne max-content, et rien ici
   FR | n'impose de minimum. Le titre de marque et le carre du logo portent
   FR | `contain: inline-size`, ils s'adaptent donc a la largeur choisie par
   FR | les entrees au lieu d'imposer la leur (le titre passe a la ligne, le
   FR | carre retrecit). C'etait min-width: 200px plus une image de 160px,
   FR | soit 230px pour des entrees qui en demandaient ~160. Un nom de piece
   FR | plus long ou une echelle de texte plus grande l'elargit a nouveau,
   FR | d'exactement ce qu'il faut. L'espacement interne est serre a dessein
   FR | (bandeau 6px, entree 8px, colonne d'icone 22px) : 16px entre le
   FR | texte le plus long et le bord du bandeau, pas 46.
   ================================================================== #}
      - type: vertical-stack
        view_layout:
          grid-area: nav
        card_mod:
          style: |
            {# EN | border-box: with width 100% the 20px of padding and 2px
               EN | of border were ADDED to the column width, so the rail
               EN | overflowed its own column by 22px into the gap — measured
               EN | 205px wide in a 190px column.
               FR | border-box : avec width 100%, les 20px de padding et 2px
               FR | de bordure s'AJOUTAIENT a la largeur de la colonne, le
               FR | bandeau debordait donc de 22px sur l'espacement — mesure
               FR | a 205px dans une colonne de 190px. #}
            :host {
              box-sizing: border-box;
              display: flex;
              flex-direction: column;
              height: 100%;
              width: 100%;
              background: rgba(5,11,18,0.85);
              border-radius: 20px;
              border: 1px solid rgba(0, 229, 255, 0.18);
              padding: 14px 6px;
              box-shadow: 0 0 18px rgba(0, 229, 255, 0.12);
              overflow-y: auto;
              scrollbar-width: thin;
              scrollbar-color: rgba(0, 229, 255, 0.35) rgba(0, 229, 255, 0.06);
            }
        cards:
          - type: custom:button-card
            template: vssp_sidebar_logo
            icon: mdi:hexagon-outline
            name: "{{ house.name }}"
            label: "{{ house.tagline }}"
            styles:
              name:
                - white-space: normal
                - overflow-wrap: anywhere
              label:
                - white-space: normal
            card_mod:
              style: |
                :host { contain: inline-size; }

{# EN | HOME, ENERGY and CORE can be deactivated from the admin console,
   EN | which deletes their view file. Their entry is therefore wrapped in a
   EN | conditional on the presence sensor that watches that very file: the
   EN | link disappears from every rail the moment the file goes, instead of
   EN | staying until the next regeneration and leading to a broken page.
   EN | `state_not: off` rather than `state: on` on purpose — an unknown or
   EN | unavailable sensor (command_line not loaded yet, right after a
   EN | restart) keeps the link rather than emptying the rail.
   FR | HOME, ENERGY et CORE peuvent etre desactives depuis la console, ce
   FR | qui supprime leur fichier de vue. Leur entree est donc enveloppee
   FR | dans un conditional sur le capteur de presence qui surveille ce
   FR | fichier : le lien disparait de tous les bandeaux des que le fichier
   FR | part, au lieu d'attendre la prochaine regeneration et de mener a une
   FR | page cassee. `state_not: off` plutot que `state: on` a dessein — un
   FR | capteur inconnu ou indisponible (command_line pas encore charge,
   FR | juste apres un redemarrage) garde le lien plutot que de vider le
   FR | bandeau. #}
{% set presence = {'home': 'binary_sensor.vssp_dashboard_home_present',
                   'energy': 'binary_sensor.vssp_dashboard_energy_present',
                   'core': 'binary_sensor.vssp_dashboard_core_present'} %}
{% for item in nav %}
{% if item.id in presence %}
          - type: conditional
            conditions:
              - entity: {{ presence[item.id] }}
                state_not: "off"
            card:
              type: custom:button-card
              template: vssp_nav_button
              icon: {{ item.icon }}
              name: {{ item.name }}
              label: "{{ item.label }}"
{% if item.id == active_nav %}
              variables:
                active: true
{% endif %}
              tap_action:
                action: navigate
{% if format == 'mobile' %}
                navigation_path: {{ item.path_mobile }}
{% else %}
                navigation_path: {{ item.path }}
{% endif %}
{% else %}
          - type: custom:button-card
            template: vssp_nav_button
            icon: {{ item.icon }}
            name: {{ item.name }}
            label: "{{ item.label }}"
{% if item.id == active_nav %}
            variables:
              active: true
{% endif %}
            tap_action:
              action: navigate
{% if format == 'mobile' %}
              navigation_path: {{ item.path_mobile }}
{% else %}
              navigation_path: {{ item.path }}
{% endif %}
{% endif %}

{% endfor %}
          - type: custom:button-card
            show_icon: false
            show_name: false
            show_label: false
            tap_action:
              action: none
            {# EN | The logo is a SQUARE (aspect-ratio 1/1) as wide as the rail,
               EN | painted from the theme: --vssp-nav-logo is the image
               EN | chosen on the THEME screen (default, uploaded, or none),
               EN | --vssp-nav-logo-display hides the square for "none". Any
               EN | image fits it uncropped (contain). The url() fallback keeps
               EN | the house logo on a theme generated before the token.
               FR | Le logo est un CARRE (aspect-ratio 1/1) de la largeur du
               FR | bandeau, peint depuis le theme : --vssp-nav-logo est
               FR | l'image choisie sur l'ecran THEME (defaut, envoyee, ou
               FR | aucune), --vssp-nav-logo-display masque le carre pour
               FR | "none". Toute image y tient sans rognage (contain). Le repli
               FR | url() garde le logo maison sur un theme genere avant le
               FR | token. #}
            custom_fields:
              logo: >
                <div style="width:100%;max-width:160px;aspect-ratio:1 / 1;margin:0 auto;display:var(--vssp-nav-logo-display, block);background:var(--vssp-nav-logo, url('{{ house.logo }}')) center / contain no-repeat;mix-blend-mode:screen;filter:drop-shadow(0 0 8px rgba(0, 229, 255, 0.28));"></div>
            styles:
              card:
                - background: transparent
                - border: none
                - box-shadow: none
                - padding: 12px 6px 4px 6px
              grid:
                - grid-template-areas: '"logo"'
              custom_fields:
                logo:
                  - width: 100%
            card_mod:
              style: |
                :host { margin-top: auto; contain: inline-size; }
                ha-card {
                  background: transparent !important;
                  border: none !important;
                  box-shadow: none !important;
                }
