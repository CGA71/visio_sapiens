{# =====================================================================
   Visio Sapiens — HEADER BAND (shared partial)
   Include:  {% raw %}{% include '_header.j2' %}{% endraw %}

   EN | The horizontal band every dashboard opens with — room and system
   EN | alike: dashboard name, weather, date and time. Extracted from
   EN | energy.yaml.j2 so it exists once instead of being copied into each
   EN | template.
   FR | Le bandeau horizontal par lequel s'ouvre chaque dashboard — de piece
   FR | comme systeme : nom du dashboard, meteo, date et heure. Extrait de
   FR | energy.yaml.j2 pour qu'il existe une seule fois au lieu d'etre
   FR | recopie dans chaque template.

   EN | EXPECTED CONTEXT / FR | CONTEXTE ATTENDU
     house           - global identity (weather_entity, time_entity)
     page_title      - large title, already translated by the caller
     page_subtitle   - subtitle line, already translated
     page_path       - navigation target when the title is tapped
     locale_tag      - BCP-47 tag ('fr-FR', 'en-US') injected by the generator
     calendar_entity (optional) - EN | a calendar.* entity id; when set:
       - Cell 1 gets time/date merged in next to the title (single card,
         flex layout) instead of the plain title-only cell.
       - Cell 3 becomes a custom:calendar-card-pro alone, showing the
         agenda day by day (days_to_show: 7) with internal scroll
         (overflow-y: auto) since a week's worth of events can outgrow
         the row.
       Requires the calendar-card-pro Lovelace resource to be registered
       (HACS or manual resource) — NOT custom:stack-in-card, which isn't
       installed on this instance (confirmed in Settings > Dashboards >
       Resources).
       FR | id d'entite calendar.* ; si defini :
       - la Case 1 recoit l'heure/date fusionnee a cote du titre (carte
         unique, mise en page flex) au lieu de la case titre seule.
       - la Case 3 devient un custom:calendar-card-pro seul, affichant
         l'agenda jour par jour (days_to_show: 7) avec defilement interne
         (overflow-y: auto) puisqu'une semaine d'evenements peut depasser
         la ligne.
       Necessite que la ressource Lovelace calendar-card-pro soit
       enregistree (HACS ou ressource manuelle) — PAS custom:stack-in-card,
       qui n'est pas installee sur cette instance (confirme dans
       Parametres > Tableaux de bord > Ressources).
     regenerate_dashboard_service (optional) - EN | script/service id; when
       set, a 4th compact icon cell is added that calls it (with the same
       confirmation dialog as the ADMIN console's own REGENERATE button) —
       for a dashboard that goes stale on its own (HOME is protected against
       automatic overwrite, see vssp_admin.yaml) so its own regeneration
       can be triggered without leaving it for ADMIN.
       FR | id de script/service ; si defini, une 4e case compacte a icone
       est ajoutee et l'appelle (avec la meme boite de confirmation que le
       bouton REGENERER propre a la console ADMIN) — pour un dashboard qui se
       perime tout seul (HOME est protege contre l'ecrasement automatique,
       voir vssp_admin.yaml) sans avoir a repasser par ADMIN.

   EN | The date is produced by Intl.DateTimeFormat(locale_tag), NOT by
   EN | hardcoded arrays. That single change is what makes the band say
   EN | "Monday 4 August" or "lundi 4 août" with no translation work, and it
   EN | keeps working for any language added later.
   FR | La date est produite par Intl.DateTimeFormat(locale_tag), PAS par des
   FR | tableaux codes en dur. Ce seul changement fait dire au bandeau
   FR | « lundi 4 août » ou « Monday 4 August » sans aucun travail de
   FR | traduction, et il continuera de fonctionner pour toute langue
   FR | ajoutee plus tard.
   ================================================================== #}
      - type: horizontal-stack
        view_layout:
          grid-area: header
        cards:

          {# EN | Cell 1: title, and — when calendar_entity is set by the
             EN | caller — time/date moved in next to it (single card, flex
             EN | layout: icon+title+subtitle left, clock right) instead of
             EN | living in Cell 3. Optional so every other dashboard using
             EN | this partial keeps the plain title-only cell.
             FR | Case 1 : titre, et — quand calendar_entity est defini par
             FR | l'appelant — heure/date deplacees a cote (carte unique,
             FR | mise en page flex : icone+titre+sous-titre a gauche,
             FR | horloge a droite) au lieu de vivre en Case 3. Optionnel
             FR | pour que tous les autres dashboards utilisant ce partial
             FR | gardent la case titre seule. #}
{% if calendar_entity is defined %}
          - type: custom:button-card
            entity: {{ house.time_entity }}
            show_name: false
            show_icon: false
            show_state: false
            show_label: true
            tap_action:
              action: navigate
              navigation_path: {{ page_path }}
            label: |
              [[[
                // EN | The locale tag comes from the generator: one constant,
                // EN | and Intl handles every language on its own.
                // FR | L'etiquette de langue vient du generateur : une seule
                // FR | constante, et Intl gere toutes les langues tout seul.
                const LOCALE = '{{ locale_tag }}';
                const d = new Date();
                const time = new Intl.DateTimeFormat(LOCALE, {
                  hour: '2-digit', minute: '2-digit', hour12: false
                }).format(d);
                // EN | Short format (like the mobile header) — the long
                // EN | form ("Vendredi 4 Septembre 2026") pushed the
                // EN | right-hand block wide enough to truncate the
                // EN | title down to "AC...".
                // FR | Format court (comme le header mobile) — la forme
                // FR | longue (« Vendredi 4 Septembre 2026 ») elargissait
                // FR | le bloc de droite au point de tronquer le titre en
                // FR | « AC... ».
                const date = new Intl.DateTimeFormat(LOCALE, {
                  weekday: 'short', day: 'numeric', month: 'short'
                }).format(d);
                return `
                  <div style="display:flex;align-items:center;justify-content:space-between;width:100%;">
                    <div style="display:flex;align-items:center;gap:12px;min-width:0;">
                      <ha-icon icon="mdi:chevron-left" style="--mdc-icon-size:24px;color:#8FB6C9;flex:none;"></ha-icon>
                      <div style="min-width:0;">
                        <div style="font-family:Orbitron,sans-serif;font-size:20px;font-weight:700;
                          letter-spacing:1px;color:var(--text-primary-color, #FFFFFF);white-space:nowrap;
                          overflow:hidden;text-overflow:ellipsis;">{{ page_title }}</div>
                        <div style="font-size:13px;color:var(--secondary-text-color, #8FB6C9);margin-top:2px;
                          white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">{{ page_subtitle }}</div>
                      </div>
                    </div>
                    <div style="text-align:right;flex:none;padding-left:12px;">
                      <div style="font-family:Orbitron,sans-serif;font-size:24px;color:var(--text-primary-color, #FFFFFF);line-height:1;">${time}</div>
                      <div style="font-size:11px;color:var(--secondary-text-color, #8FB6C9);letter-spacing:.5px;margin-top:4px;text-transform:capitalize;white-space:nowrap;">${date}</div>
                    </div>
                  </div>`;
              ]]]
            styles:
              card:
                - background: transparent
                - box-shadow: none
                - border: none
                - padding: 6px 20px
              label:
                - width: 100%
            card_mod:
              style: |
                :host { flex: 1 1 0; }
                ha-card {
                  background: var(--card-background-color, rgba(16,27,39,0.85)) !important;
                  border: 1px solid color-mix(in srgb, var(--primary-color, #00E5FF) 28%, transparent) !important;
                  border-radius: var(--ha-card-border-radius, 20px) !important;
                  box-shadow: 0 0 18px color-mix(in srgb, var(--primary-color, #00E5FF) 12%, transparent) !important;
                  height: 100%
                }
{% else %}
          - type: custom:button-card
            template: vssp_page_header
            icon: mdi:chevron-left
            name: {{ page_title }}
            label: "{{ page_subtitle }}"
            tap_action:
              action: navigate
              navigation_path: {{ page_path }}
            card_mod:
              style: |
                :host { flex: 1 1 0; }
                ha-card {
                  background: var(--card-background-color, rgba(16,27,39,0.85)) !important;
                  border: 1px solid color-mix(in srgb, var(--primary-color, #00E5FF) 28%, transparent) !important;
                  border-radius: var(--ha-card-border-radius, 20px) !important;
                  box-shadow: 0 0 18px color-mix(in srgb, var(--primary-color, #00E5FF) 12%, transparent) !important;
                  height: 100%
                }
{% endif %}

          {# EN | Cell 2: weather (native card, always available)
             FR | Case 2 : meteo (carte native, toujours disponible) #}
          - type: custom:simple-weather-card
            entity: {{ house.weather_entity }}
            show_name: true
            tap_action:
              action: more-info
            primary_info:
              - extrema
            secondary_info:
              - precipitation
            state_content: state
            forecast_type: daily
            custom: []
            animated_icons: true
            backdrop:
              day: "#7cbfee"
              night: "#a6aae8"
              text: "#ffffff"
              bg: true
              fade: false
            card_mod:
              style: |
                :host { flex: 1 1 0; }
                ha-card {
                  background: var(--card-background-color, rgba(16,27,39,0.85)) !important;
                  border: 1px solid color-mix(in srgb, var(--primary-color, #00E5FF) 28%, transparent) !important;
                  border-radius: var(--ha-card-border-radius, 20px) !important;
                  box-shadow: 0 0 18px color-mix(in srgb, var(--primary-color, #00E5FF) 12%, transparent) !important;
                  height: 100%
                }

          {# EN | Cell 3: time (plain cell for every other dashboard), or —
             EN | when calendar_entity is set by the caller — the agenda
             EN | alone, day by day (days_to_show: 7), now that time/date
             EN | moved into Cell 1 next to the title.
             FR | Case 3 : heure (case simple pour tous les autres
             FR | dashboards), ou — quand calendar_entity est defini par
             FR | l'appelant — l'agenda seul, jour par jour
             FR | (days_to_show: 7), maintenant que l'heure/date a
             FR | rejoint la Case 1 a cote du titre. #}
{% if calendar_entity is defined %}
          - type: custom:calendar-card-pro
            entities:
              - {{ calendar_entity }}
            days_to_show: 7
            show_location: false
            show_month: false
            card_mod:
              style: |
                :host { flex: 1 1 0; }
                ha-card {
                  background: var(--card-background-color, rgba(16,27,39,0.85)) !important;
                  border: 1px solid color-mix(in srgb, var(--primary-color, #00E5FF) 28%, transparent) !important;
                  border-radius: var(--ha-card-border-radius, 20px) !important;
                  box-shadow: 0 0 18px color-mix(in srgb, var(--primary-color, #00E5FF) 12%, transparent) !important;
                  height: 100%;
                  overflow-y: auto;
                }
{% else %}
          - type: custom:button-card
            entity: {{ house.time_entity }}
            show_name: false
            show_icon: false
            show_state: false
            show_label: true
            label: |
              [[[
                // EN | The locale tag comes from the generator: one constant,
                // EN | and Intl handles every language on its own.
                // FR | L'etiquette de langue vient du generateur : une seule
                // FR | constante, et Intl gere toutes les langues tout seul.
                const LOCALE = '{{ locale_tag }}';
                const d = new Date();
                const time = new Intl.DateTimeFormat(LOCALE, {
                  hour: '2-digit', minute: '2-digit', hour12: false
                }).format(d);
                const date = new Intl.DateTimeFormat(LOCALE, {
                  weekday: 'long', day: 'numeric', month: 'long', year: 'numeric'
                }).format(d);
                return `<div style="font-family:Orbitron,sans-serif;font-size:24px;color:var(--text-primary-color, #FFFFFF);line-height:1;">${time}</div>
                        <div style="font-size:11px;color:var(--secondary-text-color, #8FB6C9);letter-spacing:.5px;margin-top:4px;text-transform:capitalize;">${date}</div>`;
              ]]]
            styles:
              card:
                - background: var(--card-background-color, rgba(16,27,39,0.85))
                - border: 1px solid color-mix(in srgb, var(--primary-color, #00E5FF) 28%, transparent)
                - border-radius: var(--ha-card-border-radius, 20px)
                - box-shadow: 0 0 18px color-mix(in srgb, var(--primary-color, #00E5FF) 12%, transparent)
                - padding: 6px 20px
              grid:
                - grid-template-areas: '"l"'
                - grid-template-rows: min-content
                - align-content: start
                - justify-items: end
              label:
                - justify-self: end
                - text-align: right
            card_mod:
              style: |
                :host { flex: 1 1 0; }
                ha-card {
                  background: var(--card-background-color, rgba(16,27,39,0.85)) !important;
                  border: 1px solid color-mix(in srgb, var(--primary-color, #00E5FF) 28%, transparent) !important;
                  border-radius: var(--ha-card-border-radius, 20px) !important;
                  box-shadow: 0 0 18px color-mix(in srgb, var(--primary-color, #00E5FF) 12%, transparent) !important;
                  height: 100px
                }
{% endif %}
{% if regenerate_dashboard_service is defined %}

          {# EN | Cell 4 (optional): regenerate this dashboard, in place —
             EN | see the note in EXPECTED CONTEXT above.
             FR | Case 4 (optionnelle) : regenerer ce dashboard, sur place —
             FR | voir la note dans CONTEXTE ATTENDU ci-dessus. #}
          - type: custom:button-card
            show_name: false
            show_label: false
            icon: mdi:refresh
            confirmation:
              text: "{{ t('admin.regenerate_home_confirm') }}"
            tap_action:
              action: call-service
              service: {{ regenerate_dashboard_service }}
            styles:
              card:
                - width: 56px
              icon:
                - color: "var(--primary-color, #00E5FF)"
                - "--mdc-icon-size": 22px
            card_mod:
              style: |
                :host { flex: 0 0 56px; }
                ha-card {
                  background: var(--card-background-color, rgba(16,27,39,0.85)) !important;
                  border: 1px solid color-mix(in srgb, var(--primary-color, #00E5FF) 28%, transparent) !important;
                  border-radius: var(--ha-card-border-radius, 20px) !important;
                  box-shadow: 0 0 18px color-mix(in srgb, var(--primary-color, #00E5FF) 12%, transparent) !important;
                  height: 100px
                }
{% endif %}
