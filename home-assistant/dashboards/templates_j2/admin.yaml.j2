########################################################################
# Visio Sapiens — ADMIN Dashboard (standalone)
#
# EN | *** GENERATED FILE — DO NOT EDIT BY HAND ***
# EN | Source: admin.yaml.j2 + model/house.yaml + locales/<code>.yaml
# EN | Regenerate with: python3 generate_dashboards.py
# FR | *** FICHIER GENERE — NE PAS EDITER A LA MAIN ***
# FR | Source : admin.yaml.j2 + model/house.yaml + locales/<code>.yaml
# FR | Regenerer avec : python3 generate_dashboards.py
#
# EN | ITS OWN DASHBOARD, NOT A VIEW OF HOME
# EN | The console used to be the second view of home.yaml, reachable at
# EN | /visio-sapiens/admin. That coupling had three costs: every change to
# EN | the console forced a regeneration of HOME; the admin work could not
# EN | grow past one screen without crowding the file; and hiding the console
# EN | meant hiding a view of a dashboard people use daily.
# EN | It is now url_path "visio-sapiens-admin", with `require_admin: true`
# EN | on the declaration — the protection belongs to the dashboard, not to a
# EN | view inside another one.
# FR | SON PROPRE DASHBOARD, PAS UNE VUE DE HOME
# FR | La console etait la seconde vue de home.yaml, joignable en
# FR | /visio-sapiens/admin. Ce couplage coutait trois choses : chaque
# FR | modification de la console forcait une regeneration de HOME ; le
# FR | travail d administration ne pouvait pas depasser un ecran sans
# FR | encombrer le fichier ; et masquer la console revenait a masquer une vue
# FR | d un dashboard utilise tous les jours.
# FR | Il est desormais url_path « visio-sapiens-admin », avec
# FR | `require_admin: true` sur la declaration — la protection appartient au
# FR | dashboard, pas a une vue a l interieur d un autre.
#
# EN | SHAPE — a menu and five screens, per the agreed diagram:
# FR | FORME — un menu et cinq ecrans, selon le schema convenu :
#   menu        the hub, one card per screen
#   rooms       declare rooms and floors
#   assign      send discovered devices to a room and a slot
#   energy      measured fleet and breaker panel
#   theme       import / export the CSS design system
#   dashboards  list, regenerate, delete
#
# EN | DISCOVERY SCAN is shared, not a screen. The diagram draws it feeding
# EN | two forms (assign, energy), so it appears as a card inside each of them
# EN | rather than as a sixth entry: a scan is a step you take while filling a
# EN | form, not a place you go. Rooms & floors is manual declaration, not
# EN | device discovery, so it does not carry the scan card.
# FR | Le SCAN DE DECOUVERTE est partage, pas un ecran. Le schema le montre
# FR | alimentant deux formulaires (assign, energie) : il apparait donc comme
# FR | une carte dans chacun d eux plutot que comme une sixieme entree — un
# FR | scan est une etape qu on fait en remplissant un formulaire, pas un
# FR | endroit ou on va. Pieces & etages est une declaration manuelle, pas une
# FR | decouverte d appareils, donc elle ne porte pas la carte de scan.
#
# EN | TWO SCREENS ARE NOT BUILT YET (energy, theme). Their view exists and
# EN | says so plainly. An empty menu entry that leads nowhere is worse than
# EN | one that states what it will do. ROOMS opens the standalone rooms &
# EN | floors wizard instead.
# FR | DEUX ECRANS NE SONT PAS ENCORE CONSTRUITS (energie, theme). Leur vue
# FR | existe et le dit franchement. Une entree de menu qui ne mene nulle part
# FR | vaut moins qu une qui annonce ce qu elle fera. PIECES ouvre a la place
# FR | l assistant autonome pieces & etages.
########################################################################

{% set admin_path = '/visio-sapiens-admin' %}
{% set screens = [
  ('rooms',      'mdi:floor-plan',        'rooms'),
  ('assign',     'mdi:transit-connection-variant', 'assign'),
  ('energy',     'mdi:lightning-bolt',    'energy'),
  ('theme',      'mdi:palette',           'theme'),
  ('dashboards', 'mdi:view-dashboard-variant', 'dashboards'),
] %}

title: {{ t('adminmenu.title') }}
theme: {{ house.theme }}

# EN | Paths relative to dashboards/views/, where every generated dashboard
# EN | lives.
# FR | Chemins relatifs a dashboards/views/, ou vivent tous les dashboards
# FR | generes.
button_card_templates: !include ../templates/button_card_templates.yaml
decluttering_templates: !include ../templates/decluttering_templates.yaml

views:
  # =====================================================================
  # EN | MENU — the hub / FR | MENU — le hub
  # =====================================================================
  - title: {{ t('adminmenu.title') }}
    path: menu
    subview: false
    type: custom:grid-layout
    layout:
      grid-template-columns: minmax(200px, auto) 1fr 1fr 1fr
      grid-template-rows: 105px auto
      grid-template-areas: |
        "nav header header header"
        "nav tiles tiles tiles"
      margin: 12px
      grid-gap: 14px 14px
    cards:
{% set page_title = t('adminmenu.title') %}
{% set page_subtitle = t('adminmenu.subtitle') %}
{% set page_path = admin_path ~ '/menu' %}
{% include '_header.j2' %}

{% include '_nav.j2' %}

      - type: grid
        columns: 3
        square: false
        view_layout:
          grid-area: tiles
        cards:
{% for screen, icon, key in screens %}
          - type: custom:button-card
            template: vssp_admin_button
            icon: {{ icon }}
            name: "{{ t('adminmenu.section.' ~ key) }}"
            label: "{{ t('adminmenu.section.' ~ key ~ '_hint') }}"
            tap_action:
              action: navigate
              navigation_path: {{ admin_path }}/{{ screen }}
{% endfor %}

{% for screen, icon, key in screens %}
  # =====================================================================
  # EN | SCREEN — {{ key | upper }}
  # FR | ECRAN — {{ key | upper }}
  # =====================================================================
  - title: "{{ t('adminmenu.section.' ~ key) }}"
    path: {{ screen }}
    # EN | subview: true hides it from the dashboard tab strip. The menu is
    # EN | the only way in, which is what makes this a console rather than
    # EN | six loose tabs.
    # FR | subview: true la masque de la barre d onglets du dashboard. Le menu
    # FR | est la seule entree, ce qui fait de ceci une console plutot que six
    # FR | onglets en vrac.
    subview: true
    type: custom:grid-layout
    layout:
      grid-template-columns: minmax(200px, auto) 1fr 1fr 1fr
      # EN | 1fr, not auto, for the screens that end in a full-height iframe
      # EN | (rooms, assign): auto sizes the row to its content's natural
      # EN | height, which is exactly what left the iframe's own
      # EN | calc(100vh - Npx) height stranded above a dead strip of page
      # EN | background whenever N didn't match the real content above it —
      # EN | a number that breaks every time a card is added or removed up
      # EN | there (as it just did when the DISCOVERY SCAN button was added
      # EN | to this screen). 1fr makes the row — and everything stretched
      # EN | to fill it below — consume exactly what's left of the
      # EN | viewport, no matter what sits above. Screens without a
      # EN | fill-the-rest iframe (energy, theme, dashboards) keep auto:
      # EN | their content should size to itself and let the page scroll,
      # EN | not stretch to the window.
      # FR | 1fr, pas auto, pour les ecrans qui se terminent par une iframe
      # FR | pleine hauteur (rooms, assign) : auto dimensionne la ligne a la
      # FR | hauteur naturelle de son contenu, ce qui est precisement ce qui
      # FR | laissait la hauteur calc(100vh - Npx) de l'iframe echouee
      # FR | au-dessus d'une bande morte de fond de page des que N ne
      # FR | correspondait plus au contenu reel au-dessus — un nombre qui
      # FR | casse a chaque carte ajoutee ou retiree la-haut (ce qui vient
      # FR | de se produire avec l'ajout du bouton DISCOVERY SCAN sur cet
      # FR | ecran). 1fr fait que la ligne — et tout ce qui s'y etire en
      # FR | dessous — consomme exactement ce qu'il reste du viewport, quoi
      # FR | qu'il y ait au-dessus. Les ecrans sans iframe a etirer
      # FR | (energy, theme, dashboards) gardent auto : leur contenu doit se
      # FR | dimensionner a lui-meme et laisser la page defiler, pas
      # FR | s'etirer jusqu'a la fenetre.
      grid-template-rows: 105px {{ '1fr' if screen in ['rooms', 'assign'] else 'auto' }}
      grid-template-areas: |
        "nav header header header"
        "nav body body body"
      margin: 12px
      grid-gap: 14px 14px
    cards:
{% set page_title = t('adminmenu.section.' ~ key) %}
{% set page_subtitle = t('adminmenu.back') %}
{% set page_path = admin_path ~ '/menu' %}
{% include '_header.j2' %}

{% include '_nav.j2' %}

      - type: vertical-stack
        view_layout:
          grid-area: body
        cards:
{% if screen == 'assign' %}
          # EN | The one screen that is fully built. An iframe rather than
          # EN | native cards: assigning eighty entities needs a filterable
          # EN | table with two dependent dropdowns per row, and Lovelace has
          # EN | no card for that. The page posts to a local-only webhook, so
          # EN | no API token ever reaches the browser.
          # FR | Le seul ecran entierement construit. Une iframe plutot que des
          # FR | cartes natives : assigner quatre-vingts entites demande un
          # FR | tableau filtrable avec deux listes dependantes par ligne, et
          # FR | Lovelace n a pas de carte pour cela. La page poste vers un
          # FR | webhook local uniquement, donc aucun jeton d API n atteint le
          # FR | navigateur.
          - type: custom:button-card
            template: vssp_admin_button
            icon: mdi:radar
            name: "{{ t('adminmenu.scan') }}"
            label: "{{ t('adminmenu.scan_hint') }}"
            tap_action:
              action: call-service
              service: script.vssp_scan_and_prepare
          # EN | ?v=0 is a placeholder the build's cache-busting sed step
          # EN | rewrites to ?v=<VTOKEN> on every build (see .gitlab-ci.yml,
          # EN | "Automatic cache-busting of Lovelace resources"). Without it
          # EN | this exact URL never changes between deployments, so a
          # EN | browser that already cached assign.html once keeps serving
          # EN | that copy forever — indistinguishable from "the fix didn't
          # EN | deploy" when it actually did.
          # FR | ?v=0 est un placeholder que l'etape sed de cache-busting du
          # FR | build reecrit en ?v=<VTOKEN> a chaque build (voir
          # FR | .gitlab-ci.yml, "Automatic cache-busting of Lovelace
          # FR | resources"). Sans lui cette URL ne change jamais entre deux
          # FR | deploiements, donc un navigateur qui a deja mis en cache
          # FR | assign.html continue de servir cette copie indefiniment — ce
          # FR | qui est indiscernable de "le correctif n'a pas ete deploye"
          # FR | alors qu'il l'a ete.
          - type: iframe
            url: /local/vssp/wizard/assign.html?v=0
            # EN | :host{flex:1 1 0} instead of a fixed calc(100vh-Npx): the
            # EN | same pattern already used in _header.j2 to make a card
            # EN | grow to fill its stack. This card is the last in a
            # EN | vertical-stack whose row is now 1fr (see this screen's
            # EN | grid-template-rows above), so it inherits exactly the
            # EN | height left over after its siblings — no magic number to
            # EN | keep recalculating by hand every time a card is added
            # EN | above it.
            # FR | :host{flex:1 1 0} plutot qu'un calc(100vh-Npx) fige : le
            # FR | meme procede deja utilise dans _header.j2 pour faire
            # FR | grandir une carte jusqu'a remplir son stack. Cette carte
            # FR | est la derniere d'un vertical-stack dont la ligne est
            # FR | maintenant 1fr (voir le grid-template-rows de cet ecran
            # FR | plus haut), elle herite donc exactement de la hauteur
            # FR | restante apres ses voisines — plus de nombre magique a
            # FR | recalculer a la main a chaque carte ajoutee au-dessus.
            card_mod:
              style: |
                :host {
                  flex: 1 1 0;
                  min-height: 520px;
                }
                ha-card {
                  background: transparent !important;
                  border: none !important;
                  box-shadow: none !important;
                  overflow: hidden;
                  height: 100%;
                  border-radius: 16px;
                }
                iframe { width: 100%; height: 100% !important; border: none; }

{% elif screen == 'rooms' %}
          # EN | Language and format are phase-0 choices in the wizard diagram
          # EN | — they drive what gets generated, so they sit on one row
          # EN | above the form: interface language, target format, and the
          # EN | two diagnostic sensors (deployed locale, unrendered
          # EN | placeholders) that show whether what's live matches the
          # EN | selection. No separate OPEN WIZARD button — the iframe below
          # EN | IS the wizard, so a link to the same page would be redundant.
          # EN | The language input_select is read live by the iframe itself
          # EN | (its own WebSocket subscription), so changing it here
          # EN | retranslates the form below without a page reload.
          # FR | La langue et le format sont des choix de phase 0 dans le
          # FR | schema du wizard — ils vivent sur une ligne au-dessus du
          # FR | formulaire : langue d'interface, format cible, et les deux
          # FR | capteurs de diagnostic (locale deployee, placeholders non
          # FR | rendus) qui montrent si ce qui est en ligne correspond a la
          # FR | selection. Pas de bouton OPEN WIZARD separe — l'iframe en
          # FR | dessous EST le wizard, un lien vers la meme page serait
          # FR | redondant. Le selecteur de langue est lu en direct par
          # FR | l'iframe elle-meme (son propre abonnement WebSocket), donc le
          # FR | changer ici retraduit le formulaire en dessous sans recharger
          # FR | la page.
          - type: horizontal-stack
            cards:
              - type: entities
                entities:
                  - entity: input_select.vssp_language
                    name: "{{ t('admin.select_language') }}"
                card_mod:
                  style: |
                    ha-card {
                      background: rgba(8,18,28,0.75) !important;
                      border: 1px solid rgba(0,229,255,0.28) !important;
                      border-radius: 20px !important;
                    }
              - type: entities
                entities:
                  - entity: input_select.vssp_format
                    name: "{{ t('admin.select_format') }}"
                card_mod:
                  style: |
                    ha-card {
                      background: rgba(8,18,28,0.75) !important;
                      border: 1px solid rgba(0,229,255,0.28) !important;
                      border-radius: 20px !important;
                    }
              - type: entities
                entities:
                  - entity: sensor.vssp_deployed_locale
                    name: "{{ t('admin.deployed_locale') }}"
                card_mod:
                  style: |
                    ha-card {
                      background: rgba(8,18,28,0.75) !important;
                      border: 1px solid rgba(0,229,255,0.28) !important;
                      border-radius: 20px !important;
                    }
              - type: entities
                entities:
                  - entity: sensor.vssp_unrendered_placeholders
                    name: "{{ t('admin.unrendered_markers') }}"
                card_mod:
                  style: |
                    ha-card {
                      background: rgba(8,18,28,0.75) !important;
                      border: 1px solid rgba(0,229,255,0.28) !important;
                      border-radius: 20px !important;
                    }
          # EN | Same DISCOVERY SCAN button as the ASSIGN screen, not just a
          # EN | link to it: vssp_rooms_floors.html's "Next" button loads
          # EN | assign.html INSIDE this same iframe (a sandboxed iframe can
          # EN | navigate itself but not the parent frame — see that file's
          # EN | NEXT_URL comment), which means a visitor can land on the
          # EN | assignment table through this screen without ever reaching
          # EN | the dedicated ASSIGN screen that normally carries this
          # EN | button. Without it there, assign_data.json is 404 with no
          # EN | way to produce it.
          # FR | Meme bouton DISCOVERY SCAN que l'ecran ASSIGN, pas juste un
          # FR | lien vers lui : le bouton « Suivant » de
          # FR | vssp_rooms_floors.html charge assign.html DANS cette meme
          # FR | iframe (une iframe sandboxee peut se naviguer elle-meme mais
          # FR | pas la frame parente — voir le commentaire NEXT_URL de ce
          # FR | fichier), ce qui veut dire qu'on peut atteindre le tableau
          # FR | d'assignation par cet ecran sans jamais passer par l'ecran
          # FR | ASSIGN dedie qui porte normalement ce bouton. Sans lui ici,
          # FR | assign_data.json est en 404 sans aucun moyen de le produire.
          - type: custom:button-card
            template: vssp_admin_button
            icon: mdi:radar
            name: "{{ t('adminmenu.scan') }}"
            label: "{{ t('adminmenu.scan_hint') }}"
            tap_action:
              action: call-service
              service: script.vssp_scan_and_prepare
          # EN | ?v=0 is a placeholder the build's cache-busting sed step
          # EN | rewrites to ?v=<VTOKEN> on every build (see .gitlab-ci.yml,
          # EN | "Automatic cache-busting of Lovelace resources"). Without it
          # EN | this exact URL never changes between deployments, so a
          # EN | browser that already cached vssp_rooms_floors.html once keeps
          # EN | serving that copy forever — which is indistinguishable from
          # EN | "the fix didn't deploy" when it actually did.
          # FR | ?v=0 est un placeholder que l'etape sed de cache-busting du
          # FR | build reecrit en ?v=<VTOKEN> a chaque build (voir
          # FR | .gitlab-ci.yml, "Automatic cache-busting of Lovelace
          # FR | resources"). Sans lui cette URL ne change jamais entre deux
          # FR | deploiements, donc un navigateur qui a deja mis en cache
          # FR | vssp_rooms_floors.html continue de servir cette copie
          # FR | indefiniment — ce qui est indiscernable de "le correctif n'a
          # FR | pas ete deploye" alors qu'il l'a ete.
          - type: iframe
            url: /local/vssp/wizard/vssp_rooms_floors.html?v=0
            # EN | Same :host{flex:1 1 0} technique as the ASSIGN screen's
            # EN | iframe — see the comment there. This card is the last in
            # EN | a vertical-stack whose row is 1fr, so it grows to fill
            # EN | whatever is left after the language/format row and the
            # EN | DISCOVERY SCAN button above it, instead of a fixed
            # EN | calc(100vh-260px) that fell out of date the moment that
            # EN | button was added and left a gap of dead page background
            # EN | below the card.
            # FR | Meme technique :host{flex:1 1 0} que l'iframe de l'ecran
            # FR | ASSIGN — voir le commentaire la-bas. Cette carte est la
            # FR | derniere d'un vertical-stack dont la ligne est 1fr, elle
            # FR | grandit donc pour combler ce qu'il reste apres la ligne
            # FR | langue/format et le bouton DISCOVERY SCAN au-dessus,
            # FR | plutot qu'un calc(100vh-260px) fige devenu obsolete des
            # FR | l'ajout de ce bouton, laissant une bande de fond de page
            # FR | morte sous la carte.
            card_mod:
              style: |
                :host {
                  flex: 1 1 0;
                  min-height: 520px;
                }
                ha-card {
                  background: transparent !important;
                  border: none !important;
                  box-shadow: none !important;
                  overflow: hidden;
                  height: 100%;
                  border-radius: 16px;
                }
                iframe { width: 100%; height: 100% !important; border: none; }

{% elif screen == 'dashboards' %}
          # EN | Generation controls, moved here from the old HOME view.
          # FR | Controles de generation, deplaces ici depuis l ancienne vue HOME.
          - type: entities
            entities:
              - entity: input_select.vssp_language
                name: "{{ t('admin.select_language') }}"
              - entity: input_select.vssp_format
                name: "{{ t('admin.select_format') }}"
              - entity: sensor.vssp_deployed_locale
                name: "{{ t('admin.deployed_locale') }}"
              - entity: sensor.vssp_unrendered_placeholders
                name: "{{ t('admin.unrendered_markers') }}"
            card_mod:
              style: |
                ha-card {
                  background: rgba(8,18,28,0.75) !important;
                  border: 1px solid rgba(0,229,255,0.28) !important;
                  border-radius: 20px !important;
                }
          - type: grid
            columns: 2
            square: false
            cards:
              - type: custom:button-card
                template: vssp_admin_button
                icon: mdi:translate
                name: "{{ t('admin.apply_language') }}"
                label: "{{ t('admin.apply_language_hint') }}"
                tap_action:
                  action: call-service
                  service: script.vssp_apply_language
              - type: custom:button-card
                template: vssp_admin_button
                icon: mdi:cog-sync
                name: "{{ t('admin.generate') }}"
                label: "{{ t('adminmenu.section.dashboards_hint') }}"
                tap_action:
                  action: call-service
                  service: script.vssp_run_generate
              - type: custom:button-card
                template: vssp_admin_button
                icon: mdi:rocket-launch
                name: "{{ t('admin.upgrade') }}"
                label: "{{ t('admin.upgrade_hint') }}"
                tap_action:
                  action: call-service
                  service: script.vssp_run_upgrade
              - type: custom:button-card
                template: vssp_admin_button
                icon: mdi:delete
                name: "{{ t('admin.delete_dashboard') }}"
                label: "{{ t('admin.delete_hint') }}"
                variables:
                  danger: true
                tap_action:
                  action: call-service
                  service: script.vssp_delete_dashboard
                  confirmation:
                    text: "{{ t('home.delete_confirm') }}"
          # EN | The generated dashboards, listed from the model rather than
          # EN | typed here — the list cannot drift from what exists.
          # FR | Les dashboards generes, listes depuis le modele plutot que
          # FR | saisis ici — la liste ne peut pas diverger de ce qui existe.
          - type: custom:button-card
            template: vssp_title
            name: "{{ t('admin.system_dashboards') }}"
          - type: grid
            columns: 3
            square: false
            cards:
{% for r in rooms_rendered %}
              - type: custom:button-card
                template: vssp_quick_action
                icon: {{ r.icon }}
                name: "{{ r.label }}"
                tap_action:
                  action: navigate
                  navigation_path: {{ r.path }}
{% endfor %}

{% else %}
          # EN | Placeholder, and it says so. Naming what is missing is more
          # EN | useful than an empty panel that looks broken.
          # EN |
          # EN | Styled inline rather than with the vssp_alert template. That
          # EN | template sets a CSS class (`osv-alert info`) defined in the
          # EN | style engine; when the class does not apply, the card falls
          # EN | back to the default Home Assistant rendering — a white
          # EN | surface — and the icon, having no size constraint, fills the
          # EN | whole panel. A template whose result depends on a stylesheet
          # EN | this file cannot see is a template to avoid here.
          # FR | Stylise en ligne plutot qu avec le template vssp_alert. Ce
          # FR | template pose une classe CSS (`osv-alert info`) definie dans
          # FR | le moteur de styles ; quand la classe ne s applique pas, la
          # FR | carte retombe sur le rendu Home Assistant par defaut — une
          # FR | surface blanche — et l icone, sans contrainte de taille,
          # FR | remplit tout le panneau. Un template dont le resultat depend
          # FR | d une feuille de style que ce fichier ne voit pas est un
          # FR | template a eviter ici.
          - type: custom:button-card
            show_icon: true
            show_name: true
            show_label: true
            show_state: false
            icon: mdi:hammer-wrench
            name: "{{ t('adminmenu.not_built') }}"
            label: "{{ t('adminmenu.section.' ~ key ~ '_hint') }}"
            tap_action:
              action: none
            styles:
              grid:
                - grid-template-areas: '"i n" "i l"'
                - grid-template-columns: 56px 1fr
                - align-items: center
                - column-gap: 14px
              card:
                - background: rgba(8,18,28,0.75)
                - border: 1px solid rgba(0,229,255,0.28)
                - border-radius: 18px
                - box-shadow: 0 0 18px rgba(0,229,255,.15)
                - padding: 20px 22px
                - cursor: default
                - pointer-events: none
              icon:
                - color: rgba(143,182,201,0.45)
                - "--mdc-icon-size": 34px
              name:
                - justify-self: start
                - font-family: Orbitron, sans-serif
                - font-size: 13px
                - letter-spacing: 1px
                - color: "#8FB6C9"
              label:
                - justify-self: start
                - font-size: 11px
                - color: rgba(143,182,201,0.65)
                - margin-top: 4px
{% if screen == 'energy' %}
          # EN | The scan feeds this screen too, per the diagram.
          # FR | Le scan alimente aussi cet ecran, selon le schema.
          - type: custom:button-card
            template: vssp_admin_button
            icon: mdi:radar
            name: "{{ t('adminmenu.scan') }}"
            label: "{{ t('adminmenu.scan_hint') }}"
            tap_action:
              action: call-service
              service: script.vssp_scan_and_prepare
{% endif %}
{% endif %}

{% endfor %}
