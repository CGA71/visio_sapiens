          # EN | local_only) handles better than a form of REST calls.
          # EN | Live preview and export/import are entirely client-side —
          # EN | only APPLY reaches Home Assistant, via webhook `vssp_theme`
          # EN | (packages/vssp_theme.yaml), which regenerates ONLY the theme
          # EN | file and reloads it live (frontend.reload_themes) — no
          # EN | dashboard regeneration, no lovelace.reload.
          # FR | Meme patron iframe + webhook que ASSIGN ci-dessus : l editeur
          # FR | ne peut pas atteindre l objet `hass` parent, et les couleurs/
          # FR | valeurs rgba() sont exactement le genre de payload qu un
          # FR | webhook (sans jeton, local_only) gere mieux qu un formulaire
          # FR | d appels REST.
          # FR | L apercu live et l export/import sont entierement cote
          # FR | client — seul APPLIQUER atteint Home Assistant, via le
          # FR | webhook `vssp_theme` (packages/vssp_theme.yaml), qui
          # FR | regenere UNIQUEMENT le fichier de theme et le recharge a
          # FR | chaud (frontend.reload_themes) — aucune regeneration de
          # FR | dashboard, aucun lovelace.reload.
          #
          # EN | RESTORE REFERENCE — the one action this screen exposes
          # EN | outside the iframe. It needs no data from the browser (it
          # EN | reads design_system.default.yaml on the pod), so it is a
          # EN | plain native button with a confirmation dialog, same shape
          # EN | as REGENERATE HOME/ENERGY in system_dashboards.yaml, rather
          # EN | than another iframe control.
          # FR | RESTAURER LA REFERENCE — la seule action que cet ecran
          # FR | expose hors de l iframe. Elle n a besoin d aucune donnee du
          # FR | navigateur (elle lit design_system.default.yaml sur le
          # FR | pod), donc c est un bouton natif simple avec confirmation,
          # FR | meme forme que REGENERER HOME/ENERGY dans
          # FR | system_dashboards.yaml, plutot qu un controle d iframe de
          # FR | plus.
          - type: custom:button-card
            template: vssp_admin_button
            icon: mdi:restore
            name: "{{ t('admin.restore_theme_reference') }}"
            label: "{{ t('admin.restore_theme_reference_hint') }}"
            confirmation:
              text: "{{ t('admin.restore_theme_reference_confirm') }}"
            tap_action:
              action: call-service
              service: script.vssp_restore_theme_reference

          - type: iframe
            url: /local/vssp/wizard/vssp_theme_editor.html?v={{ build_stamp }}
            card_mod:
              style: |
                :host {
                  flex: 1 1 0;
                  min-height: 520px;
                }
                ha-card {
                  background: transparent !important;
                  border: none !important;
                  box-shadow: none !important;
                  overflow: hidden;
                  height: 100%;
                  border-radius: var(--ha-card-border-radius, 16px);
                }
                iframe { width: 100%; height: 100% !important; border: none; }

{% else %}
          # EN | Placeholder, and it says so. Naming what is missing is more
          # EN | useful than an empty panel that looks broken.
          # EN |
          # EN | Styled inline rather than with the vssp_alert template. That
          # EN | template sets a CSS class (`osv-alert info`) defined in the
          # EN | style engine; when the class does not apply, the card falls
          # EN | back to the default Home Assistant rendering — a white
          # EN | surface — and the icon, having no size constraint, fills the
          # EN | whole panel. A template whose result depends on a stylesheet
          # EN | this file cannot see is a template to avoid here.
          # FR | Stylise en ligne plutot qu avec le template vssp_alert. Ce
          # FR | template pose une classe CSS (`osv-alert info`) definie dans
          # FR | le moteur de styles ; quand la classe ne s applique pas, la
          # FR | carte retombe sur le rendu Home Assistant par defaut — une
          # FR | surface blanche — et l icone, sans contrainte de taille,
          # FR | remplit tout le panneau. Un template dont le resultat depend
          # FR | d une feuille de style que ce fichier ne voit pas est un
          # FR | template a eviter ici.
          - type: custom:button-card
            show_icon: true
            show_name: true
            show_label: true
            show_state: false
            icon: mdi:hammer-wrench
            name: "{{ t('adminmenu.not_built') }}"
            label: "{{ t('adminmenu.section.' ~ key ~ '_hint') }}"
            tap_action:
              action: none
            styles:
              grid:
                - grid-template-areas: '"i n" "i l"'
                - grid-template-columns: 56px 1fr
                - align-items: center
                - column-gap: 14px
              card:
                - background: var(--card-background-color, rgba(8,18,28,0.75))
                - border: 1px solid rgba(0, 229, 255, 0.28)
                - border-radius: var(--ha-card-border-radius, 18px)
                - box-shadow: 0 0 18px rgba(0, 229, 255, 0.15)
                - padding: 20px 22px
                - cursor: default
                - pointer-events: none
              icon:
                - color: rgba(143,182,201,0.45)
                - "--mdc-icon-size": 34px
              name:
                - justify-self: start
                - text-align: left
                - font-family: Orbitron, sans-serif
                - font-size: 13px
                - letter-spacing: 1px
                - color: "var(--secondary-text-color, #8FB6C9)"
              label:
                - justify-self: start
                - text-align: left
                - font-size: 11px
                - color: rgba(143,182,201,0.65)
                - margin-top: 4px
{% if screen == 'energy' %}
          # EN | The scan feeds this screen too, per the diagram.
          # FR | Le scan alimente aussi cet ecran, selon le schema.
          - type: custom:button-card
            template: vssp_admin_button
            icon: mdi:radar
            name: "{{ t('adminmenu.scan') }}"
            label: "{{ t('adminmenu.scan_hint') }}"
            tap_action:
              action: call-service
              service: script.vssp_scan_and_prepare
{% endif %}
{% endif %}

{% endfor %}
