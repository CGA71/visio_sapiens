########################################################################
# Visio Sapiens — ADMIN Dashboard (standalone)
#
# EN | *** GENERATED FILE — DO NOT EDIT BY HAND ***
# EN | Source: admin.yaml.j2 + model/house.yaml + locales/<code>.yaml
# EN | Regenerate with: python3 generate_dashboards.py
# FR | *** FICHIER GENERE — NE PAS EDITER A LA MAIN ***
# FR | Source : admin.yaml.j2 + model/house.yaml + locales/<code>.yaml
# FR | Regenerer avec : python3 generate_dashboards.py
#
# EN | ITS OWN DASHBOARD, NOT A VIEW OF HOME
# EN | The console used to be the second view of home.yaml, reachable at
# EN | /visio-sapiens/admin. That coupling had three costs: every change to
# EN | the console forced a regeneration of HOME; the admin work could not
# EN | grow past one screen without crowding the file; and hiding the console
# EN | meant hiding a view of a dashboard people use daily.
# EN | It is now url_path "visio-sapiens-admin", with `require_admin: true`
# EN | on the declaration — the protection belongs to the dashboard, not to a
# EN | view inside another one.
# FR | SON PROPRE DASHBOARD, PAS UNE VUE DE HOME
# FR | La console etait la seconde vue de home.yaml, joignable en
# FR | /visio-sapiens/admin. Ce couplage coutait trois choses : chaque
# FR | modification de la console forcait une regeneration de HOME ; le
# FR | travail d administration ne pouvait pas depasser un ecran sans
# FR | encombrer le fichier ; et masquer la console revenait a masquer une vue
# FR | d un dashboard utilise tous les jours.
# FR | Il est desormais url_path « visio-sapiens-admin », avec
# FR | `require_admin: true` sur la declaration — la protection appartient au
# FR | dashboard, pas a une vue a l interieur d un autre.
#
# EN | SHAPE — a menu and five screens, per the agreed diagram:
# FR | FORME — un menu et cinq ecrans, selon le schema convenu :
#   menu        the hub, one card per screen
#   rooms       declare rooms and floors
#   assign      send discovered devices to a room and a slot
#   energy      measured fleet and breaker panel
#   theme       import / export the CSS design system
#   dashboards  list, regenerate, delete
#
# EN | DISCOVERY SCAN is shared, not a screen. The diagram draws it feeding
# EN | two forms (assign, energy), so it appears as a card inside each of them
# EN | rather than as a sixth entry: a scan is a step you take while filling a
# EN | form, not a place you go. Rooms & floors is manual declaration, not
# EN | device discovery, so it does not carry the scan card.
# FR | Le SCAN DE DECOUVERTE est partage, pas un ecran. Le schema le montre
# FR | alimentant deux formulaires (assign, energie) : il apparait donc comme
# FR | une carte dans chacun d eux plutot que comme une sixieme entree — un
# FR | scan est une etape qu on fait en remplissant un formulaire, pas un
# FR | endroit ou on va. Pieces & etages est une declaration manuelle, pas une
# FR | decouverte d appareils, donc elle ne porte pas la carte de scan.
#
# EN | ONE SCREEN IS NOT BUILT YET (energy). Its view exists and says so
# EN | plainly. An empty menu entry that leads nowhere is worse than one that
# EN | states what it will do. ROOMS opens the standalone rooms & floors
# EN | wizard instead. THEME (design system editor) follows the same
# EN | iframe + webhook pattern as ASSIGN — see vssp_theme_editor.html and
# EN | packages/vssp_theme.yaml.
# FR | UN SEUL ECRAN N EST PAS ENCORE CONSTRUIT (energie). Sa vue existe et le
# FR | dit franchement. Une entree de menu qui ne mene nulle part vaut moins
# FR | qu une qui annonce ce qu elle fera. PIECES ouvre a la place l assistant
# FR | autonome pieces & etages. THEME (editeur de charte graphique) suit le
# FR | meme patron iframe + webhook qu ASSIGN — voir vssp_theme_editor.html et
# FR | packages/vssp_theme.yaml.
########################################################################

{% set admin_path = '/visio-sapiens-admin' %}
{% set screens = [
  ('rooms',      'mdi:floor-plan',        'rooms'),
  ('devices',    'mdi:access-point-network', 'devices'),
  ('assign',     'mdi:transit-connection-variant', 'assign'),
  ('energy',     'mdi:lightning-bolt',    'energy'),
  ('calendar',   'mdi:calendar-account',  'calendar'),
  ('theme',      'mdi:palette',           'theme'),
  ('dashboards', 'mdi:view-dashboard-variant', 'dashboards'),
  ('updates',    'mdi:package-up',         'updates'),
  ('vault',      'mdi:safe',              'vault'),
] %}

# EN | THE SELECTOR TILE LOOK — every input_select in this console renders
# EN | as a `tile` card with inline `select-options` chips, NOT as an
# EN | `entities` row. The native Material picker inside an entities card
# EN | falls back to a wide white fill until every MDC theme variable is
# EN | defined, and stays a full-width inline picker rather than this compact
# EN | chip row. The background points at `selector_background` (editable in
# EN | the THEME screen) so it stays adjustable independently of every other
# EN | card.
# EN | Emitted by a macro rather than a YAML anchor on purpose: all screens
# EN | land in ONE document, in `screens` order, so an alias would depend on
# EN | which screen happens to be emitted first. A macro does not.
# EN | Both call sites nest the tile at the same depth, so the indentation is
# EN | fixed rather than a parameter.
# FR | L'ASPECT DES TUILES DE SELECTION — chaque input_select de cette
# FR | console se rend en carte `tile` avec des pastilles `select-options` en
# FR | ligne, PAS en ligne d'`entities`. Le picker Material natif d'une carte
# FR | entities retombe sur un remplissage blanc large tant que chaque
# FR | variable de theme MDC n'est pas definie, et reste un picker pleine
# FR | largeur plutot que cette rangee compacte. Le fond pointe vers
# FR | `selector_background` (modifiable dans l'ecran THEME) pour rester
# FR | ajustable independamment de toutes les autres cartes.
# FR | Emis par une macro plutot que par une ancre YAML a dessein : tous les
# FR | ecrans atterrissent dans UN document, dans l'ordre de `screens`, donc
# FR | un alias dependrait de l'ecran emis en premier. Une macro, non.
# FR | Les deux points d'appel imbriquent la tuile a la meme profondeur,
# FR | l'indentation est donc figee plutot que parametree.
{% macro selector_card_mod() -%}
card_mod:
                  style: |
                    ha-card {
                      background: var(--selector-background, #000000) !important;
                      border: 1px solid rgba(0,229,255,0.25) !important;
                      border-radius: var(--ha-card-border-radius, 16px) !important;
                    }
{%- endmacro %}

title: {{ t('adminmenu.title') }}
theme: {{ house.theme }}

# EN | Paths relative to dashboards/views/, where every generated dashboard
# EN | lives.
# FR | Chemins relatifs a dashboards/views/, ou vivent tous les dashboards
# FR | generes.
button_card_templates: !include ../templates/button_card_templates.yaml
decluttering_templates: !include ../templates/decluttering_templates.yaml

views:
  # =====================================================================
  # EN | MENU — the hub / FR | MENU — le hub
  # =====================================================================
  - title: {{ t('adminmenu.title') }}
    path: menu
    subview: false
    type: custom:grid-layout
    layout:
      grid-template-columns: minmax(200px, auto) 1fr 1fr 1fr
      grid-template-rows: 130px auto
      grid-template-areas: |
        "nav header header header"
        "nav tiles tiles tiles"
      margin: 12px
      grid-gap: 14px 14px
    cards:
{% set page_title = t('adminmenu.title') %}
{% set page_subtitle = t('adminmenu.subtitle') %}
{% set page_path = admin_path ~ '/menu' %}
{% include '_header.j2' %}

{% include '_nav.j2' %}

      # EN | A vertical list of rows (one screen per line), not a grid of
      # EN | big boxes — replaces the previous 3-column tile grid at the
      # EN | user's request. Wrapped in one vssp_panel-styled button-card
      # EN | (show_icon/name/label all false, real content in
      # EN | custom_fields.rows) purely so the list reads as one enclosed
      # EN | menu panel — same technique already used for the Top-10 list
      # EN | on HOME (home.yaml.j2) — rather than loose rows floating
      # EN | directly on the page background.
      # FR | Une liste verticale de lignes (un ecran par ligne), pas une
      # FR | grille de grosses cases — remplace la grille de tuiles a 3
      # FR | colonnes precedente, a la demande de l'utilisateur. Enveloppee
      # FR | dans un button-card stylise vssp_panel (show_icon/name/label a
      # FR | false, vrai contenu dans custom_fields.rows) uniquement pour
      # FR | que la liste se lise comme un seul panneau de menu enveloppe —
      # FR | meme technique deja utilisee pour la liste Top 10 de HOME
      # FR | (home.yaml.j2) — plutot que des lignes flottant directement sur
      # FR | le fond de page.
      - type: custom:button-card
        template: vssp_panel
        view_layout:
          grid-area: tiles
        show_icon: false
        show_name: false
        show_label: false
        styles:
          card:
            - padding: 6px 14px
          grid:
            - grid-template-areas: '"rows"'
          custom_fields:
            rows:
              - width: 100%
        custom_fields:
          rows:
            card:
              type: vertical-stack
              cards:
{% for screen, icon, key in screens %}
                - type: custom:button-card
                  template: vssp_admin_menu_row
                  icon: {{ icon }}
                  name: "{{ t('adminmenu.section.' ~ key) }}"
                  label: "{{ t('adminmenu.section.' ~ key ~ '_hint') }}"
                  tap_action:
                    action: navigate
                    navigation_path: {{ admin_path }}/{{ screen }}
{% endfor %}

{% for screen, icon, key in screens %}
  # =====================================================================
  # EN | SCREEN — {{ key | upper }}
  # FR | ECRAN — {{ key | upper }}
  # =====================================================================
  - title: "{{ t('adminmenu.section.' ~ key) }}"
    path: {{ screen }}
    # EN | subview: true hides it from the dashboard tab strip. The menu is
    # EN | the only way in, which is what makes this a console rather than
    # EN | six loose tabs.
    # FR | subview: true la masque de la barre d onglets du dashboard. Le menu
    # FR | est la seule entree, ce qui fait de ceci une console plutot que six
    # FR | onglets en vrac.
    subview: true
    type: custom:grid-layout
    layout:
      grid-template-columns: minmax(200px, auto) 1fr 1fr 1fr
      # EN | 1fr, not auto, for the screens that end in a full-height iframe
      # EN | (rooms, assign, theme): auto sizes the row to its content's
      # EN | natural height, which is exactly what left the iframe's own
      # EN | calc(100vh - Npx) height stranded above a dead strip of page
      # EN | background whenever N didn't match the real content above it —
      # EN | a number that breaks every time a card is added or removed up
      # EN | there (as it just did when the DISCOVERY SCAN button was added
      # EN | to this screen). 1fr makes the row — and everything stretched
      # EN | to fill it below — consume exactly what's left of the
      # EN | viewport, no matter what sits above. Screens without a
      # EN | fill-the-rest iframe (energy, dashboards) keep auto:
      # EN | their content should size to itself and let the page scroll,
      # EN | not stretch to the window.
      # FR | 1fr, pas auto, pour les ecrans qui se terminent par une iframe
      # FR | pleine hauteur (rooms, assign, theme) : auto dimensionne la ligne
      # FR | a la hauteur naturelle de son contenu, ce qui est precisement ce
      # FR | qui laissait la hauteur calc(100vh - Npx) de l'iframe echouee
      # FR | au-dessus d'une bande morte de fond de page des que N ne
      # FR | correspondait plus au contenu reel au-dessus — un nombre qui
      # FR | casse a chaque carte ajoutee ou retiree la-haut (ce qui vient
      # FR | de se produire avec l'ajout du bouton DISCOVERY SCAN sur cet
      # FR | ecran). 1fr fait que la ligne — et tout ce qui s'y etire en
      # FR | dessous — consomme exactement ce qu'il reste du viewport, quoi
      # FR | qu'il y ait au-dessus. Les ecrans sans iframe a etirer
      # FR | (energy, dashboards) gardent auto : leur contenu doit se
      # FR | dimensionner a lui-meme et laisser la page defiler, pas
      # FR | s'etirer jusqu'a la fenetre.
      grid-template-rows: 130px {{ '1fr' if screen in ['rooms', 'devices', 'assign', 'theme', 'calendar', 'vault'] else 'auto' }}
      grid-template-areas: |
        "nav header header header"
        "nav body body body"
      margin: 12px
      grid-gap: 14px 14px
    cards:
{% set page_title = t('adminmenu.section.' ~ key) %}
{% set page_subtitle = t('adminmenu.back') %}
{% set page_path = admin_path ~ '/menu' %}
{% include '_header.j2' %}

{% include '_nav.j2' %}

      - type: vertical-stack
        view_layout:
          grid-area: body
        cards:
{% if screen == 'assign' %}
          # EN | The one screen that is fully built. An iframe rather than
          # EN | native cards: assigning eighty entities needs a filterable
          # EN | table with two dependent dropdowns per row, and Lovelace has
          # EN | no card for that. The page posts to a local-only webhook, so
          # EN | no API token ever reaches the browser.
          # FR | Le seul ecran entierement construit. Une iframe plutot que des
          # FR | cartes natives : assigner quatre-vingts entites demande un
          # FR | tableau filtrable avec deux listes dependantes par ligne, et
          # FR | Lovelace n a pas de carte pour cela. La page poste vers un
          # FR | webhook local uniquement, donc aucun jeton d API n atteint le
          # FR | navigateur.
          - type: custom:button-card
            template: vssp_admin_button
            icon: mdi:radar
            name: "{{ t('adminmenu.scan') }}"
            label: "{{ t('adminmenu.scan_hint') }}"
            tap_action:
              action: call-service
              service: script.vssp_scan_and_prepare
          # EN | ?v=0 is a placeholder the build's cache-busting sed step
          # EN | rewrites to ?v=<VTOKEN> on every build (see .gitlab-ci.yml,
          # EN | "Automatic cache-busting of Lovelace resources"). Without it
          # EN | this exact URL never changes between deployments, so a
          # EN | browser that already cached assign.html once keeps serving
          # EN | that copy forever — indistinguishable from "the fix didn't
          # EN | deploy" when it actually did.
          # FR | ?v=0 est un placeholder que l'etape sed de cache-busting du
          # FR | build reecrit en ?v=<VTOKEN> a chaque build (voir
          # FR | .gitlab-ci.yml, "Automatic cache-busting of Lovelace
          # FR | resources"). Sans lui cette URL ne change jamais entre deux
          # FR | deploiements, donc un navigateur qui a deja mis en cache
          # FR | assign.html continue de servir cette copie indefiniment — ce
          # FR | qui est indiscernable de "le correctif n'a pas ete deploye"
          # FR | alors qu'il l'a ete.
          - type: iframe
            url: /local/vssp/wizard/assign.html?v={{ build_stamp }}
            # EN | :host{flex:1 1 0} instead of a fixed calc(100vh-Npx): the
            # EN | same pattern already used in _header.j2 to make a card
            # EN | grow to fill its stack. This card is the last in a
            # EN | vertical-stack whose row is now 1fr (see this screen's
            # EN | grid-template-rows above), so it inherits exactly the
            # EN | height left over after its siblings — no magic number to
            # EN | keep recalculating by hand every time a card is added
            # EN | above it.
            # FR | :host{flex:1 1 0} plutot qu'un calc(100vh-Npx) fige : le
            # FR | meme procede deja utilise dans _header.j2 pour faire
            # FR | grandir une carte jusqu'a remplir son stack. Cette carte
            # FR | est la derniere d'un vertical-stack dont la ligne est
            # FR | maintenant 1fr (voir le grid-template-rows de cet ecran
            # FR | plus haut), elle herite donc exactement de la hauteur
            # FR | restante apres ses voisines — plus de nombre magique a
            # FR | recalculer a la main a chaque carte ajoutee au-dessus.
            card_mod:
              style: |
                :host {
                  flex: 1 1 0;
                  min-height: 520px;
                }
                ha-card {
                  background: transparent !important;
                  border: none !important;
                  box-shadow: none !important;
                  overflow: hidden;
                  height: 100%;
                  border-radius: var(--ha-card-border-radius, 16px);
                }
                iframe { width: 100%; height: 100% !important; border: none; }

{% elif screen == 'rooms' %}
          # EN | Language and format are phase-0 choices in the wizard diagram
          # EN | — they drive what gets generated, so they sit on one row
          # EN | above the form: interface language, target format, and the
          # EN | two diagnostic sensors (deployed locale, unrendered
          # EN | placeholders) that show whether what's live matches the
          # EN | selection. No separate OPEN WIZARD button — the iframe below
          # EN | IS the wizard, so a link to the same page would be redundant.
          # EN | The language input_select is read live by the iframe itself
          # EN | (its own WebSocket subscription), so changing it here
          # EN | retranslates the form below without a page reload.
          # FR | La langue et le format sont des choix de phase 0 dans le
          # FR | schema du wizard — ils vivent sur une ligne au-dessus du
          # FR | formulaire : langue d'interface, format cible, et les deux
          # FR | capteurs de diagnostic (locale deployee, placeholders non
          # FR | rendus) qui montrent si ce qui est en ligne correspond a la
          # FR | selection. Pas de bouton OPEN WIZARD separe — l'iframe en
          # FR | dessous EST le wizard, un lien vers la meme page serait
          # FR | redondant. Le selecteur de langue est lu en direct par
          # FR | l'iframe elle-meme (son propre abonnement WebSocket), donc le
          # FR | changer ici retraduit le formulaire en dessous sans recharger
          # FR | la page.
          - type: horizontal-stack
            cards:
              # EN | Same tile model as the DASHBOARDS screen — see the
              # EN | selector_card_mod macro at the top of this file for why
              # EN | an input_select is never an `entities` row here. These
              # EN | two used to be entities cards, which is exactly the
              # EN | native Material picker that renders as a wide white fill.
              # FR | Meme modele de tuile que l'ecran DASHBOARDS — voir la
              # FR | macro selector_card_mod en haut de ce fichier pour
              # FR | comprendre pourquoi un input_select n'est jamais une
              # FR | ligne d'`entities` ici. Ces deux-la etaient des cartes
              # FR | entities, c'est-a-dire precisement le picker Material
              # FR | natif qui se rend en remplissage blanc large.
              - type: tile
                entity: input_select.vssp_language
                name: "{{ t('admin.select_language') }}"
                icon: mdi:translate
                vertical: false
                features:
                  - type: select-options
                features_position: inline
                {{ selector_card_mod() }}
              - type: tile
                entity: input_select.vssp_format
                name: "{{ t('admin.select_format') }}"
                icon: mdi:tablet-cellphone
                vertical: false
                features:
                  - type: select-options
                features_position: inline
                {{ selector_card_mod() }}
              - type: entities
                entities:
                  - entity: sensor.vssp_deployed_locale
                    name: "{{ t('admin.deployed_locale') }}"
                card_mod:
                  style: |
                    ha-card {
                      background: var(--card-background-color, rgba(8,18,28,0.75)) !important;
                      border: 1px solid rgba(0, 229, 255, 0.28) !important;
                      border-radius: var(--ha-card-border-radius, 20px) !important;
                    }
              - type: entities
                entities:
                  - entity: sensor.vssp_unrendered_placeholders
                    name: "{{ t('admin.unrendered_markers') }}"
                card_mod:
                  style: |
                    ha-card {
                      background: var(--card-background-color, rgba(8,18,28,0.75)) !important;
                      border: 1px solid rgba(0, 229, 255, 0.28) !important;
                      border-radius: var(--ha-card-border-radius, 20px) !important;
                    }
          # EN | Same DISCOVERY SCAN button as the ASSIGN screen, not just a
          # EN | link to it: vssp_rooms_floors.html's "Next" button loads
          # EN | assign.html INSIDE this same iframe (a sandboxed iframe can
          # EN | navigate itself but not the parent frame — see that file's
          # EN | NEXT_URL comment), which means a visitor can land on the
          # EN | assignment table through this screen without ever reaching
          # EN | the dedicated ASSIGN screen that normally carries this
          # EN | button. Without it there, assign_data.json is 404 with no
          # EN | way to produce it.
          # FR | Meme bouton DISCOVERY SCAN que l'ecran ASSIGN, pas juste un
          # FR | lien vers lui : le bouton « Suivant » de
          # FR | vssp_rooms_floors.html charge assign.html DANS cette meme
          # FR | iframe (une iframe sandboxee peut se naviguer elle-meme mais
          # FR | pas la frame parente — voir le commentaire NEXT_URL de ce
          # FR | fichier), ce qui veut dire qu'on peut atteindre le tableau
          # FR | d'assignation par cet ecran sans jamais passer par l'ecran
          # FR | ASSIGN dedie qui porte normalement ce bouton. Sans lui ici,
          # FR | assign_data.json est en 404 sans aucun moyen de le produire.
          - type: custom:button-card
            template: vssp_admin_button
            icon: mdi:radar
            name: "{{ t('adminmenu.scan') }}"
            label: "{{ t('adminmenu.scan_hint') }}"
            tap_action:
              action: call-service
              service: script.vssp_scan_and_prepare
          # EN | ?v=0 is a placeholder the build's cache-busting sed step
          # EN | rewrites to ?v=<VTOKEN> on every build (see .gitlab-ci.yml,
          # EN | "Automatic cache-busting of Lovelace resources"). Without it
          # EN | this exact URL never changes between deployments, so a
          # EN | browser that already cached vssp_rooms_floors.html once keeps
          # EN | serving that copy forever — which is indistinguishable from
          # EN | "the fix didn't deploy" when it actually did.
          # FR | ?v=0 est un placeholder que l'etape sed de cache-busting du
          # FR | build reecrit en ?v=<VTOKEN> a chaque build (voir
          # FR | .gitlab-ci.yml, "Automatic cache-busting of Lovelace
          # FR | resources"). Sans lui cette URL ne change jamais entre deux
          # FR | deploiements, donc un navigateur qui a deja mis en cache
          # FR | vssp_rooms_floors.html continue de servir cette copie
          # FR | indefiniment — ce qui est indiscernable de "le correctif n'a
          # FR | pas ete deploye" alors qu'il l'a ete.
          - type: iframe
            url: /local/vssp/wizard/vssp_rooms_floors.html?v={{ build_stamp }}
            # EN | Same :host{flex:1 1 0} technique as the ASSIGN screen's
            # EN | iframe — see the comment there. This card is the last in
            # EN | a vertical-stack whose row is 1fr, so it grows to fill
            # EN | whatever is left after the language/format row and the
            # EN | DISCOVERY SCAN button above it, instead of a fixed
            # EN | calc(100vh-260px) that fell out of date the moment that
            # EN | button was added and left a gap of dead page background
            # EN | below the card.
            # FR | Meme technique :host{flex:1 1 0} que l'iframe de l'ecran
            # FR | ASSIGN — voir le commentaire la-bas. Cette carte est la
            # FR | derniere d'un vertical-stack dont la ligne est 1fr, elle
            # FR | grandit donc pour combler ce qu'il reste apres la ligne
            # FR | langue/format et le bouton DISCOVERY SCAN au-dessus,
            # FR | plutot qu'un calc(100vh-260px) fige devenu obsolete des
            # FR | l'ajout de ce bouton, laissant une bande de fond de page
            # FR | morte sous la carte.
            card_mod:
              style: |
                :host {
                  flex: 1 1 0;
                  min-height: 520px;
                }
                ha-card {
                  background: transparent !important;
                  border: none !important;
                  box-shadow: none !important;
                  overflow: hidden;
                  height: 100%;
                  border-radius: var(--ha-card-border-radius, 16px);
                }
                iframe { width: 100%; height: 100% !important; border: none; }

{% elif screen == 'devices' %}
          # EN | DETECTED DEVICES — the only screen made entirely of one
          # EN | iframe, with not a single card above it. Everything it does
          # EN | needs a live answer from Home Assistant: what is waiting on
          # EN | the network right now, what arrived this week, what stopped
          # EN | answering. None of that can be a button wired to a
          # EN | shell_command, so there is nothing to put outside the frame
          # EN | — unlike ROOMS & FLOORS, whose DISCOVERY SCAN button belongs
          # EN | to the console rather than to the page.
          # EN | Listing pending discoveries exists only on the WebSocket API,
          # EN | so this page authenticates with the same long-lived token as
          # EN | vssp_rooms_floors.html rather than through a webhook — see
          # EN | the header of vssp_devices.html for why that is the right
          # EN | trade here and the wrong one in assign.html.
          # FR | APPAREILS DETECTES — le seul ecran fait entierement d une
          # FR | iframe, sans une seule carte au-dessus. Tout ce qu il fait
          # FR | exige une reponse en direct de Home Assistant : ce qui attend
          # FR | sur le reseau maintenant, ce qui est arrive cette semaine, ce
          # FR | qui a cesse de repondre. Rien de tout cela ne peut etre un
          # FR | bouton cable sur un shell_command, donc il n y a rien a
          # FR | mettre hors du cadre — contrairement a PIECES & ETAGES, dont
          # FR | le bouton DISCOVERY SCAN appartient a la console plutot qu a
          # FR | la page.
          # FR | Lister les decouvertes en attente n existe que sur l API
          # FR | WebSocket, donc cette page s authentifie avec le meme jeton
          # FR | longue duree que vssp_rooms_floors.html plutot que par un
          # FR | webhook — voir l en-tete de vssp_devices.html pour pourquoi
          # FR | c est le bon compromis ici et le mauvais dans assign.html.
          - type: iframe
            url: /local/vssp/wizard/vssp_devices.html?v={{ build_stamp }}
            card_mod:
              style: |
                :host {
                  flex: 1 1 0;
                  min-height: 520px;
                }
                ha-card {
                  background: transparent !important;
                  border: none !important;
                  box-shadow: none !important;
                  overflow: hidden;
                  height: 100%;
                  border-radius: var(--ha-card-border-radius, 16px);
                }
                iframe { width: 100%; height: 100% !important; border: none; }

{% elif screen == 'vault' %}
          # EN | THE SAFE — split in two on purpose, and the split is the
          # EN | whole security argument rather than a layout choice.
          # EN | Above: native cards. An entities card for the state of the
          # EN | safe and a tally per branch, a markdown card listing the
          # EN | entry NAMES, and the maintenance controls. Everything they
          # EN | show comes from RESTful sensors whose Vault token carries
          # EN | the vssp-ha policy — secret/metadata/* and nothing at all
          # EN | on secret/data/*. These cards are structurally incapable of
          # EN | displaying a password: Vault refuses to give Home Assistant
          # EN | one.
          # EN | Below: the iframe, the only part that sees values. It talks
          # EN | to Vault directly with its own short-lived token, so a
          # EN | revealed password never becomes an entity state — never
          # EN | written in clear to home-assistant_v2.db by the recorder,
          # EN | never visible in Developer Tools > States, never in an
          # EN | automation trace.
          # EN | So create, modify and reveal live in the iframe; listing,
          # EN | state and deletion — which involve no value — stay native.
          # FR | LE COFFRE — coupe en deux a dessein, et cette coupure est
          # FR | tout l argument de securite plutot qu un choix de mise en
          # FR | page.
          # FR | Au-dessus : des cartes natives. Une carte entities pour
          # FR | l etat du coffre et un decompte par branche, une carte
          # FR | markdown listant les NOMS d entrees, et les commandes de
          # FR | maintenance. Tout ce qu elles affichent vient de capteurs
          # FR | RESTful dont le token Vault porte la policy vssp-ha —
          # FR | secret/metadata/* et absolument rien sur secret/data/*. Ces
          # FR | cartes sont structurellement incapables d afficher un mot
          # FR | de passe : Vault refuse d en donner un a Home Assistant.
          # FR | En dessous : l iframe, seule partie qui voie les valeurs.
          # FR | Elle parle a Vault directement avec son propre token de
          # FR | courte duree, donc un mot de passe revele ne devient jamais
          # FR | un etat d entite — jamais ecrit en clair dans
          # FR | home-assistant_v2.db par le recorder, jamais visible dans
          # FR | Outils de developpement > Etats, jamais dans une trace
          # FR | d automatisation.
          # FR | Creer, modifier et reveler vivent donc dans l iframe ;
          # FR | lister, l etat et la suppression — qui ne mettent en jeu
          # FR | aucune valeur — restent natifs.
          - type: horizontal-stack
            cards:
              - type: entities
                title: "{{ t('admin.vault_state') }}"
                entities:
                  - entity: sensor.vssp_vault_seal
                    name: "{{ t('admin.vault_seal') }}"
                  - entity: sensor.vssp_vault_infra
                    name: "{{ t('admin.vault_infra') }}"
                  - entity: sensor.vssp_vault_accounts
                    name: "{{ t('admin.vault_accounts') }}"
                  - entity: sensor.vssp_vault_apps
                    name: "{{ t('admin.vault_apps') }}"
                card_mod:
                  style: |
                    ha-card {
                      background: var(--card-background-color, rgba(8,18,28,0.75)) !important;
                      border: 1px solid rgba(0, 229, 255, 0.28) !important;
                      border-radius: var(--ha-card-border-radius, 20px) !important;
                    }
              # EN | The placeholder is filtered BEFORE the emptiness test, not
              # EN | inside the loop. Filtering inside meant `keys` was truthy
              # EN | on a new branch (it held .keep), the if-branch was taken,
              # EN | the loop then dropped everything, and the card showed a
              # EN | bold label with nothing under it — never the em dash the
              # EN | else-branch exists to print. Same mistake as the sensor
              # EN | counts, and the same fix.
              # FR | Le marqueur est filtre AVANT le test de vacuite, pas dans
              # FR | la boucle. Le filtrer dans la boucle rendait `keys` vrai
              # FR | sur une branche neuve (elle contenait .keep), la branche
              # FR | if etait prise, la boucle jetait ensuite tout, et la carte
              # FR | montrait un titre en gras sans rien dessous — jamais le
              # FR | tiret cadratin que la branche else existe pour afficher.
              # FR | Meme erreur que sur les decomptes de capteurs, meme
              # FR | correction.
              # EN | Names only, straight from the sensors' `keys` attribute.
              # EN | state_attr returns None when the sensor is unavailable
              # EN | — which it is whenever the safe is sealed, since those
              # EN | three sensors are authenticated — so every branch is
              # EN | guarded rather than rendering the word "None".
              # FR | Les noms seulement, directement depuis l attribut
              # FR | `keys` des capteurs. state_attr renvoie None quand le
              # FR | capteur est indisponible — ce qu il est des que le
              # FR | coffre est scelle, ces trois capteurs etant
              # FR | authentifies — donc chaque branche est gardee plutot
              # FR | que d afficher le mot « None ».
              # EN | The raw tag below opens with a plus sign right after
              # EN | its brace. That is not decoration: the environment runs
              # EN | with lstrip_blocks, which strips the whitespace in front
              # EN | of a block tag — here the eighteen spaces that indent
              # EN | the first line inside the `content: |` block scalar.
              # EN | Stripped, the Home Assistant template lands at column
              # EN | zero and the rendered dashboard stops being valid YAML.
              # EN | The plus modifier turns that off for that one tag.
              # EN | Note also that these comment lines carefully avoid
              # EN | writing the tag itself. A YAML comment is still template
              # EN | source: Jinja lexes it like any other text, so quoting
              # EN | the raw tag here would genuinely open a raw block from
              # EN | inside the explanation, and everything below — the card
              # EN | title included — would render as literal text.
              # FR | La balise raw ci-dessous s ouvre avec un signe plus
              # FR | juste apres son accolade. Ce n est pas decoratif :
              # FR | l environnement tourne avec lstrip_blocks, qui retire
              # FR | l espace devant une balise de bloc — ici les dix-huit
              # FR | espaces qui indentent la premiere ligne du bloc
              # FR | litteral `content: |`. Retires, le template Home
              # FR | Assistant atterrit en colonne zero et le dashboard
              # FR | rendu cesse d etre du YAML valide. Le modificateur plus
              # FR | desactive cela pour cette seule balise.
              # FR | A noter aussi que ces lignes de commentaire evitent
              # FR | soigneusement d ecrire la balise elle-meme. Un
              # FR | commentaire YAML reste du source de template : Jinja le
              # FR | lexe comme n importe quel autre texte, donc citer la
              # FR | balise raw ici ouvrirait pour de bon un bloc raw depuis
              # FR | l interieur de l explication, et tout ce qui suit — le
              # FR | titre de la carte compris — se rendrait en texte
              # FR | litteral.
              - type: markdown
                title: "{{ t('admin.vault_entries') }}"
                content: |
                  {%+ raw %}{% set branches = [
                       ('sensor.vssp_vault_infra', 'INFRA'),
                       ('sensor.vssp_vault_accounts', 'COMPTES'),
                       ('sensor.vssp_vault_apps', 'APPS')] %}
                  {% for eid, label in branches %}
                  **{{ label }}**
                  {% set keys = (state_attr(eid, 'keys') or [])
                       | reject('eq', '.keep') | list %}
                  {% if keys %}{% for k in keys %}
                  - `{{ k }}`
                  {% endfor %}{% else %}
                  _—_
                  {% endif %}
                  {% endfor %}{% endraw +%}
                card_mod:
                  style: |
                    ha-card {
                      background: var(--card-background-color, rgba(8,18,28,0.75)) !important;
                      border: 1px solid rgba(0, 229, 255, 0.28) !important;
                      border-radius: var(--ha-card-border-radius, 20px) !important;
                    }
          # EN | Maintenance, native and value-free. `Supprimer` is a soft
          # EN | delete: the version is hidden and stays restorable, which is
          # EN | why the restore row sits right beside it. `Detruire` takes
          # EN | the entry and every version of it, with no undo — hence its
          # EN | own row, and a wording that does not pretend otherwise.
          # FR | Maintenance, native et sans valeur. « Supprimer » est une
          # FR | suppression douce : la version est masquee et reste
          # FR | restaurable, d ou la ligne de restauration juste a cote.
          # FR | « Detruire » emporte l entree et toutes ses versions, sans
          # FR | retour — d ou sa propre ligne, et un libelle qui ne pretend
          # FR | pas le contraire.
          - type: entities
            title: "{{ t('admin.vault_maintenance') }}"
            entities:
              - entity: input_text.vssp_vault_target
                name: "{{ t('admin.vault_target') }}"
              - entity: input_number.vssp_vault_version
                name: "{{ t('admin.vault_version') }}"
              - entity: script.vssp_vault_delete_entry
                name: "{{ t('admin.vault_delete') }}"
                icon: mdi:delete-outline
              - entity: script.vssp_vault_restore_entry
                name: "{{ t('admin.vault_restore') }}"
                icon: mdi:history
              - entity: script.vssp_vault_destroy_entry
                name: "{{ t('admin.vault_destroy') }}"
                icon: mdi:delete-forever
              - entity: script.vssp_vault_refresh
                name: "{{ t('admin.vault_refresh') }}"
                icon: mdi:refresh
            # EN | card_mod belongs to the CARD, not to the last row above
            # EN | it. Indented one level deeper it was a row-level style,
            # EN | and its `ha-card` selector matched nothing — which is why
            # EN | this card alone sat on the safe screen with no cyan frame
            # EN | while the two beside it had one.
            # FR | card_mod appartient a la CARTE, pas a la derniere ligne
            # FR | au-dessus. Indente un niveau plus profond, c etait un
            # FR | style de ligne, et son selecteur `ha-card` ne
            # FR | correspondait a rien — d ou cette carte seule sur l ecran
            # FR | du coffre sans cadre cyan quand les deux d a cote en
            # FR | avaient un.
            card_mod:
              style: |
                ha-card {
                  background: var(--card-background-color, rgba(8,18,28,0.75)) !important;
                  border: 1px solid rgba(0, 229, 255, 0.28) !important;
                  border-radius: var(--ha-card-border-radius, 20px) !important;
                }
          # EN | `lang` carries the GENERATED locale into the iframe: this
          # EN | page has no Home Assistant token, so unlike the other
          # EN | wizards it cannot read input_select.vssp_language itself.
          # FR | `lang` transmet la locale GENEREE a l iframe : cette page
          # FR | n a pas de token Home Assistant, donc contrairement aux
          # FR | autres assistants elle ne peut pas lire
          # FR | input_select.vssp_language elle-meme.
          - type: iframe
            url: /local/vssp/wizard/vssp_vault.html?v={{ build_stamp }}&lang={{ locale }}
            card_mod:
              style: |
                :host {
                  flex: 1 1 0;
                  min-height: 560px;
                }
                ha-card {
                  background: transparent !important;
                  border: none !important;
                  box-shadow: none !important;
                  overflow: hidden;
                  height: 100%;
                  border-radius: var(--ha-card-border-radius, 16px);
                }
                iframe { width: 100%; height: 100% !important; border: none; }

{% elif screen == 'updates' %}
          # =================================================================
          # EN | WHY THE LIGHT IS THAT COLOUR — the first thing on the screen
          # FR | POURQUOI LE FEU EST DE CETTE COULEUR — en tete d ecran
          # =================================================================
          #
          # EN | The HOME dashboard's UPGRADE light links here, so this is
          # EN | where someone arrives asking "what made it orange?". It used
          # EN | to be possible to arrive and find nothing that answered
          # EN | that — the light computed its own verdict and this screen
          # EN | listed Home Assistant's update entities, which is a different
          # EN | question. A signal you cannot verify by clicking through
          # EN | teaches you to ignore it.
          # EN | This card renders `sensor.vssp_updates_verdict`, the same
          # EN | entity the light reads, and names every row that drove it.
          # EN | The two cannot disagree because there is only one of them.
          # FR | Le feu UPGRADE du dashboard HOME pointe ici, c est donc ici
          # FR | qu on arrive en demandant « qu est-ce qui l a mis a
          # FR | l orange ? ». Il etait possible d arriver et de ne rien
          # FR | trouver qui y reponde — le feu calculait son propre verdict
          # FR | et cet ecran listait les entites de mise a jour de Home
          # FR | Assistant, ce qui est une autre question. Un signal qu on ne
          # FR | peut pas verifier en cliquant apprend a etre ignore.
          # FR | Cette carte affiche `sensor.vssp_updates_verdict`, l entite
          # FR | meme que lit le feu, et nomme chaque ligne qui l a decide.
          # FR | Les deux ne peuvent pas diverger puisqu il n y en a qu une.
          - type: markdown
            title: "{{ t('admin.updates_verdict') }}"
            content: |
              {# EN | `| js` ON EVERY LABEL, not decoration. These become
                 EN | single-quoted string literals inside a Jinja dict that
                 EN | Home Assistant parses later, and French is full of
                 EN | apostrophes: "Le serveur n'a pas ete sonde" closes the
                 EN | literal at "n'" and the whole card dies with a template
                 EN | error. The filter escapes them, and it exists precisely
                 EN | because the generated JS hit this first (see the note
                 EN | beside env.filters["js"] in generate_dashboards.py).
                 FR | `| js` SUR CHAQUE LIBELLE, pas par decoration. Ils
                 FR | deviennent des litteraux entre quotes simples dans un
                 FR | dict Jinja que Home Assistant analysera plus tard, et le
                 FR | francais est plein d apostrophes : « Le serveur n'a pas
                 FR | ete sonde » ferme le litteral sur « n' » et toute la
                 FR | carte meurt sur une erreur de template. Le filtre les
                 FR | echappe, et il existe precisement parce que le JS genere
                 FR | a rencontre le piege en premier (voir la note pres de
                 FR | env.filters["js"] dans generate_dashboards.py). #}
              {{ '{%' }} set labels = {
                'green':  '{{ t('home.upgrade.clear') | js }}',
                'orange': '{{ t('home.upgrade.patches') | js }}',
                'red':    '{{ t('home.upgrade.major') | js }}',
                'major':  '{{ t('admin.updates_verdict_major') | js }}',
                'patch':  '{{ t('admin.updates_verdict_patch') | js }}',
                'none':   '{{ t('admin.updates_verdict_none') | js }}',
                'steps':  '{{ t('admin.updates_infra_steps') | js }}',
                'unprobed': '{{ t('admin.updates_verdict_unprobed') | js }}' } {{ '%}' }}
              {%+ raw %}{% set v = states('sensor.vssp_updates_verdict') %}
              {% set items = state_attr('sensor.vssp_updates_verdict', 'items') or [] %}
              {% set dot = '🔴' if v == 'red' else ('🟠' if v == 'orange' else '🟢') %}
              ## {{ dot }} {{ labels.get(v, v) }}
              {% set majors = items | selectattr('kind', 'eq', 'major') | list %}
              {% set patches = items | selectattr('kind', 'eq', 'patch') | list %}
              {% if majors %}
              **{{ labels['major'] }}**
              {% for i in majors %}
              - {{ i.name }} · `{{ i.installed or '?' }}` → `{{ i.next or i.latest or '?' }}`{% if (i.steps | default(1) | int) > 1 %} ({{ i.steps }} {{ labels['steps'] }} → `{{ i.latest }}`){% endif %}
              {% endfor %}
              {% endif %}
              {% if patches %}
              **{{ labels['patch'] }}**
              {% for i in patches %}
              - {{ i.name }}{% if i.installed %} · `{{ i.installed }}`{% endif %}{% if i.next and i.next != i.installed %} → `{{ i.next }}`{% endif %}{% if (i.steps | default(1) | int) > 1 %} ({{ i.steps }} {{ labels['steps'] }} → `{{ i.latest }}`){% endif %}
              {% endfor %}
              {% endif %}
              {% if not items %}
              _{{ labels['none'] }}_
              {% endif %}
              {% if not state_attr('sensor.vssp_updates_verdict', 'infra_probed') %}

              ⚠ _{{ labels['unprobed'] }}_
              {% endif %}{% endraw +%}
            card_mod:
              style: |
                ha-card {
                  background: var(--card-background-color, rgba(8,18,28,0.75)) !important;
                  border: 1px solid rgba(0, 229, 255, 0.28) !important;
                  border-radius: var(--ha-card-border-radius, 20px) !important;
                }

          # EN | UPDATES — everything Home Assistant already knows, in one
          # EN | place and split three ways. Settings > Updates shows the
          # EN | same entities; what it does not do is separate a Lovelace
          # EN | card download from the flash of a wall plug, which is the
          # EN | one distinction that decides whether you click without
          # EN | thinking or read the release notes first.
          # EN | No iframe and no token: an update is an `update.*` entity,
          # EN | so native cards reach all of it — and tapping a row opens
          # EN | Home Assistant's own dialog, with the release notes, the
          # EN | backup checkbox where the entity supports one, and Skip.
          # EN | That dialog is better than anything this console could
          # EN | rebuild, so the console does not rebuild it.
          # EN | The grouping itself comes from packages/vssp_updates.yaml,
          # EN | not from here: working out that browser_mod belongs to
          # EN | HACS needs `integration_entities()`, a template function
          # EN | that exists on the Python side only. The sensors publish
          # EN | each family as an `entity_ids` attribute and these cards
          # EN | render the list they are handed.
          # FR | MISES A JOUR — tout ce que Home Assistant sait deja, en un
          # FR | seul endroit et reparti en trois. Reglages > Mises a jour
          # FR | montre les memes entites ; ce qu il ne fait pas, c est
          # FR | separer le telechargement d une carte Lovelace du flash
          # FR | d une prise murale, seule distinction qui decide si l on
          # FR | clique sans reflechir ou si l on lit d abord les notes de
          # FR | version.
          # FR | Ni iframe ni token : une mise a jour est une entite
          # FR | `update.*`, les cartes natives atteignent donc tout — et
          # FR | toucher une ligne ouvre la boite de dialogue de Home
          # FR | Assistant lui-meme, avec les notes de version, la case de
          # FR | sauvegarde la ou l entite en supporte une, et Ignorer.
          # FR | Cette boite vaut mieux que tout ce que cette console
          # FR | pourrait reconstruire, donc la console ne la reconstruit
          # FR | pas.
          # FR | Le regroupement, lui, vient de packages/vssp_updates.yaml
          # FR | et non d ici : deviner que browser_mod appartient a HACS
          # FR | demande `integration_entities()`, fonction de template qui
          # FR | n existe que du cote Python. Les capteurs publient chaque
          # FR | famille en attribut `entity_ids` et ces cartes affichent la
          # FR | liste qu on leur tend.
          - type: horizontal-stack
            cards:
              - type: entities
                title: "{{ t('admin.updates_state') }}"
                entities:
                  - entity: sensor.vssp_updates_pending
                    name: "{{ t('admin.updates_total') }}"
                  - entity: sensor.vssp_updates_system
                    name: "{{ t('admin.updates_system') }}"
                  - entity: sensor.vssp_updates_hacs
                    name: "{{ t('admin.updates_hacs') }}"
                  - entity: sensor.vssp_updates_firmware
                    name: "{{ t('admin.updates_firmware') }}"
                  # EN | The fourth family sits with the other three because
                  # EN | that is how it is read — "what is waiting?" — even
                  # EN | though it is the only one with no entity behind it.
                  # FR | La quatrieme famille siege avec les trois autres
                  # FR | parce que c est ainsi qu on la lit — « qu est-ce qui
                  # FR | attend ? » — meme si elle est la seule sans entite
                  # FR | derriere elle.
                  - entity: sensor.vssp_updates_infra
                    name: "{{ t('admin.updates_infra') }}"
                card_mod:
                  style: |
                    ha-card {
                      background: var(--card-background-color, rgba(8,18,28,0.75)) !important;
                      border: 1px solid rgba(0, 229, 255, 0.28) !important;
                      border-radius: var(--ha-card-border-radius, 20px) !important;
                    }
              # EN | The inventory: what is waiting, and between which two
              # EN | versions. The rows below install; this card is what you
              # EN | read before deciding to.
              # EN | THE FIRST LINE IS NOT A RAW BLOCK, and that is the
              # EN | point. The three family labels are translated by the
              # EN | GENERATOR, the loop under them is executed by HOME
              # EN | ASSISTANT — two template engines on the same card, and
              # EN | the boundary has to fall between them. So the set-tag
              # EN | is emitted as text: `{{ '{%' }}` is an expression, the
              # EN | generator evaluates it and writes two characters that
              # EN | Home Assistant will later read as the start of a tag.
              # EN | An expression is also immune to lstrip_blocks, which
              # EN | strips the indentation in front of a BLOCK tag — the
              # EN | trap that a raw block on this line would have walked
              # EN | straight into, landing the template at column zero and
              # EN | breaking the YAML.
              # FR | L inventaire : ce qui attend, et entre quelles deux
              # FR | versions. Les lignes du dessous installent ; cette
              # FR | carte est ce qu on lit avant de le decider.
              # FR | LA PREMIERE LIGNE N EST PAS UN BLOC RAW, et c est tout
              # FR | l interet. Les trois libelles de famille sont traduits
              # FR | par le GENERATEUR, la boucle en dessous est executee
              # FR | par HOME ASSISTANT — deux moteurs de template sur la
              # FR | meme carte, et la frontiere doit tomber entre les deux.
              # FR | La balise set est donc emise en tant que texte :
              # FR | `{{ '{%' }}` est une expression, le generateur
              # FR | l evalue et ecrit deux caracteres que Home Assistant
              # FR | lira plus tard comme le debut d une balise.
              # FR | Une expression est de surcroit insensible a
              # FR | lstrip_blocks, qui retire l indentation devant une
              # FR | balise de BLOC — le piege dans lequel un bloc raw pose
              # FR | sur cette ligne serait tombe tout droit, ramenant le
              # FR | template en colonne zero et cassant le YAML.
              #
              # EN | THE FOURTH FAMILY, and it was missing from the one card
              # EN | whose whole job is naming what is waiting. The card beside
              # EN | this one counts four families; this one enumerated three.
              # EN | So an instance whose only pending update was
              # EN | infrastructure — a safe three series behind, say — read
              # EN | "Infrastructure 1" on the left and three em-dashes on the
              # EN | right. The panel looked broken because it was incomplete.
              # EN | It could not be a fourth entry in `groups` either. The
              # EN | other three read an `entity_ids` attribute and follow it to
              # EN | `update.*` entities; infrastructure HAS no entities, which
              # EN | is the entire reason it needed a probe of its own. So it
              # EN | reads the components list — the same source the light and
              # EN | the button card read — and shows `next` rather than
              # EN | `latest`: what is waiting is the step you can actually
              # EN | take, with the rest of the road in brackets after it.
              # FR | LA QUATRIEME FAMILLE, et elle manquait a la seule carte
              # FR | dont le travail est precisement de nommer ce qui attend.
              # FR | La carte d a cote compte quatre familles ; celle-ci en
              # FR | enumerait trois. Une instance dont la seule mise a jour en
              # FR | attente etait l infrastructure — un coffre avec trois
              # FR | series de retard, par exemple — lisait donc
              # FR | « Infrastructure 1 » a gauche et trois tirets cadratins a
              # FR | droite. Le volet avait l air casse parce qu il etait
              # FR | incomplet.
              # FR | Ce ne pouvait pas non plus etre une quatrieme entree dans
              # FR | `groups`. Les trois autres lisent un attribut `entity_ids`
              # FR | et le suivent jusqu a des entites `update.*` ;
              # FR | l infrastructure N A pas d entites, ce qui est toute la
              # FR | raison pour laquelle il lui fallait sa propre sonde. Elle
              # FR | lit donc la liste des composants — la meme source que le
              # FR | feu et la carte a boutons — et affiche `next` plutot que
              # FR | `latest` : ce qui attend, c est l etape que vous pouvez
              # FR | reellement faire, le reste de la route entre parentheses.
              - type: markdown
                title: "{{ t('admin.updates_pending') }}"
                content: |
                  {{ '{%' }} set groups = [
                       ('sensor.vssp_updates_system', '{{ t('admin.updates_system') | js }}'),
                       ('sensor.vssp_updates_hacs', '{{ t('admin.updates_hacs') | js }}'),
                       ('sensor.vssp_updates_firmware', '{{ t('admin.updates_firmware') | js }}')] {{ '%}' }}
                  {{ '{%' }} set infra_label = '{{ t('admin.updates_infra') | js }}' {{ '%}' }}
                  {{ '{%' }} set stepword = '{{ t('admin.updates_infra_steps') | js }}' {{ '%}' }}
                  {{ '{%' }} set unprobed = '{{ t('admin.updates_infra_notprobed') | js }}' {{ '%}' }}
                  {{ '{%' }} set names = {
                    'os_packages':   '{{ t('admin.updates_infra_os_packages') | js }}',
                    'os_reboot':     '{{ t('admin.updates_infra_os_reboot') | js }}',
                    'k3s':           '{{ t('admin.updates_infra_k3s') | js }}',
                    'gitlab_runner': '{{ t('admin.updates_infra_gitlab_runner') | js }}',
                    'gitlab':        '{{ t('admin.updates_infra_gitlab') | js }}',
                    'vault':         '{{ t('admin.updates_infra_vault') | js }}',
                    'docker_images': '{{ t('admin.updates_infra_docker_images') | js }}',
                    'k3s_workloads': '{{ t('admin.updates_infra_k3s_workloads') | js }}' } {{ '%}' }}
                  {%+ raw %}{% for eid, label in groups %}
                  **{{ label }}**
                  {% set ids = state_attr(eid, 'entity_ids') or [] %}
                  {% if ids %}{% for i in ids %}
                  - {{ state_attr(i, 'friendly_name') or i }} · `{{ state_attr(i, 'installed_version') or '?' }}` → `{{ state_attr(i, 'latest_version') or '?' }}`
                  {% endfor %}{% else %}
                  _—_
                  {% endif %}
                  {% endfor %}
                  **{{ infra_label }}**
                  {% set rows = state_attr('sensor.vssp_updates_infra', 'components') or [] %}
                  {% set waiting = rows | selectattr('pending') | list %}
                  {% if waiting %}{% for r in waiting %}
                  - {{ names.get(r.key, r.key) }}
                    {%- if r.installed %} · `{{ r.installed }}`{% endif %}
                    {%- if r.next %} → `{{ r.next }}`{% endif %}
                    {%- if (r.steps | default(1) | int) > 1 %} ({{ r.steps }} {{ stepword }} → `{{ r.latest }}`){% endif %}
                  {% endfor %}{% elif rows | rejectattr('probed') | list %}
                  _{{ unprobed }}_
                  {% else %}
                  _—_
                  {% endif %}{% endraw +%}
                card_mod:
                  style: |
                    ha-card {
                      background: var(--card-background-color, rgba(8,18,28,0.75)) !important;
                      border: 1px solid rgba(0, 229, 255, 0.28) !important;
                      border-radius: var(--ha-card-border-radius, 20px) !important;
                    }
          # EN | THE ACTIONABLE ROWS, one card per family, each one absent
          # EN | when its family is empty — a screen that says nothing when
          # EN | there is nothing to do.
          # EN | An `entities` card cannot filter: its list is fixed in YAML
          # EN | written months before the update existed. config-template-
          # EN | card evaluates a value that starts with the dollar-brace
          # EN | and assigns whatever comes back, an array included, so the
          # EN | list is read from the sensor at render time. It re-renders
          # EN | when an entity in its own `entities:` changes — hence the
          # EN | family sensor listed there, whose count moves the moment an
          # EN | install finishes.
          # EN | `states`, not `hass`: config-template-card exposes the
          # EN | state map under that name and nothing else. The guard is
          # EN | not superstition either — the sensor does not exist for the
          # EN | few seconds between a restart and the first template pass,
          # EN | and an entities card handed `undefined` throws rather than
          # EN | rendering empty.
          # EN | The conditions spell out unavailable and unknown one by
          # EN | one. `state_not: "0"` alone is true for both of those, so
          # EN | on a half-started instance the card would appear, ask the
          # EN | sensor for a list, and get nothing.
          # FR | LES LIGNES ACTIONNABLES, une carte par famille, chacune
          # FR | absente quand sa famille est vide — un ecran qui ne dit
          # FR | rien quand il n y a rien a faire.
          # FR | Une carte `entities` ne sait pas filtrer : sa liste est
          # FR | figee dans du YAML ecrit des mois avant que la mise a jour
          # FR | n existe. config-template-card evalue une valeur qui
          # FR | commence par le dollar-accolade et affecte ce qui revient,
          # FR | tableau compris, donc la liste est lue depuis le capteur au
          # FR | moment du rendu. Elle se re-rend quand une entite de son
          # FR | propre `entities:` change — d ou le capteur de famille
          # FR | liste la, dont le decompte bouge des qu une installation
          # FR | se termine.
          # FR | `states`, pas `hass` : config-template-card expose la carte
          # FR | des etats sous ce nom et sous aucun autre. La garde n est
          # FR | pas non plus de la superstition — le capteur n existe pas
          # FR | pendant les quelques secondes qui separent un redemarrage
          # FR | de la premiere passe de templates, et une carte entities a
          # FR | qui l on tend `undefined` leve au lieu de s afficher vide.
          # FR | Les conditions enumerent unavailable et unknown une par
          # FR | une. `state_not: "0"` seul est vrai pour les deux, donc sur
          # FR | une instance a moitie demarree la carte apparaitrait,
          # FR | demanderait sa liste au capteur, et n obtiendrait rien.
{% for fam, fam_icon in [('system', 'mdi:home-assistant'),
                         ('hacs', 'mdi:puzzle-outline'),
                         ('firmware', 'mdi:chip')] %}
          - type: conditional
            conditions:
              - entity: sensor.vssp_updates_{{ fam }}
                state_not: "0"
              - entity: sensor.vssp_updates_{{ fam }}
                state_not: "unavailable"
              - entity: sensor.vssp_updates_{{ fam }}
                state_not: "unknown"
            card:
              type: custom:config-template-card
              entities:
                - sensor.vssp_updates_{{ fam }}
              card:
                type: entities
                title: "{{ t('admin.updates_' ~ fam) }}"
                icon: {{ fam_icon }}
                entities: >-
                  ${ (states['sensor.vssp_updates_{{ fam }}'] && states['sensor.vssp_updates_{{ fam }}'].attributes.entity_ids) || [] }
                card_mod:
                  style: |
                    ha-card {
                      background: var(--card-background-color, rgba(8,18,28,0.75)) !important;
                      border: 1px solid rgba(0, 229, 255, 0.28) !important;
                      border-radius: var(--ha-card-border-radius, 20px) !important;
                    }
{% endfor %}
          # EN | AUTOMATIC UPDATES — an option, and it is off. The switch
          # EN | is the whole feature: with it closed this card is an
          # EN | announcement of what would happen, and nothing happens.
          # EN | The count beside it is not decoration either. It is read
          # EN | from the very sensor the nightly script reads, so the
          # EN | number on this row is the number of things that will be
          # EN | installed tonight — not a second calculation that agrees
          # EN | with the first until one of them is edited.
          # EN | HOME ASSISTANT CORE IS NEVER IN THAT NUMBER. The exclusion
          # EN | lives in the sensor, so this screen states it as something
          # EN | it reads back rather than as a promise. A broken Core takes
          # EN | down the interface you would use to notice, the console you
          # EN | would use to roll back, and every automation in the file;
          # EN | it wants the backup checkbox its own dialog offers, and a
          # EN | person watching.
          # EN | RUN NOW calls the same script as the automation, so testing
          # EN | the button tests the real nightly pass rather than a second
          # EN | copy of it that will drift.
          # FR | MISES A JOUR AUTOMATIQUES — une option, et elle est
          # FR | eteinte. L interrupteur est toute la fonctionnalite :
          # FR | ferme, cette carte est l annonce de ce qui se passerait, et
          # FR | il ne se passe rien.
          # FR | Le decompte a cote n est pas decoratif non plus. Il est lu
          # FR | depuis le capteur meme que lit le script nocturne, donc le
          # FR | nombre affiche sur cette ligne est le nombre de choses qui
          # FR | seront installees cette nuit — pas un second calcul qui
          # FR | s accorde avec le premier jusqu au jour ou l un des deux
          # FR | est modifie.
          # FR | HOME ASSISTANT CORE N EST JAMAIS DANS CE NOMBRE.
          # FR | L exclusion vit dans le capteur, donc cet ecran l enonce
          # FR | comme quelque chose qu il relit et non comme une promesse.
          # FR | Un Core casse emporte l interface qui servirait a s en
          # FR | apercevoir, la console qui servirait a revenir en arriere,
          # FR | et toutes les automatisations du fichier ; il veut la case
          # FR | de sauvegarde que sa propre boite propose, et quelqu un
          # FR | devant l ecran.
          # FR | LANCER MAINTENANT appelle le meme script que
          # FR | l automatisation : tester le bouton teste la vraie passe
          # FR | nocturne, pas une seconde copie qui divergera.
          # =================================================================
          # EN | INFRASTRUCTURE — the layer underneath Home Assistant
          # FR | INFRASTRUCTURE — la couche sous Home Assistant
          # =================================================================
          #
          # EN | The other three families each render an `entities:` card fed
          # EN | by a list of entity_ids, because each of their rows IS an
          # EN | entity. This one cannot: an Ubuntu package and a k3s release
          # EN | have no entity, so the whole family arrives as one attribute
          # EN | on one sensor and is rendered as markdown.
          # EN | The name map below is built HERE, at generation, because the
          # EN | markdown card's Jinja runs inside Home Assistant where `t()`
          # EN | does not exist. Same technique as the pending list above:
          # EN | the generator emits a `set` block whose values are already
          # EN | translated, and the raw block that follows only reads it.
          # EN | Do not write a raw tag inside a comment here — the generator
          # EN | processes comments too, and consumes it.
          # FR | Les trois autres familles affichent chacune une carte
          # FR | `entities:` alimentee par une liste d entity_ids, parce que
          # FR | chacune de leurs lignes EST une entite. Celle-ci ne le peut
          # FR | pas : un paquet Ubuntu et une version de k3s n ont pas
          # FR | d entite, la famille entiere arrive donc en un attribut sur
          # FR | un capteur et s affiche en markdown.
          # FR | La table de noms ci-dessous est construite ICI, a la
          # FR | generation, parce que le Jinja de la carte markdown tourne
          # FR | dans Home Assistant, ou `t()` n existe pas. Meme technique que
          # FR | la liste des mises a jour en attente plus haut : le generateur
          # FR | emet un bloc `set` dont les valeurs sont deja traduites, et le
          # FR | bloc raw qui suit se contente de le lire.
          # FR | Ne pas ecrire de balise raw dans un commentaire ici — le
          # FR | generateur traite aussi les commentaires, et la consomme.
          - type: conditional
            conditions:
              - entity: sensor.vssp_updates_infra
                state_not: "unavailable"
              - entity: sensor.vssp_updates_infra
                state_not: "unknown"
            card:
              type: markdown
              title: "{{ t('admin.updates_infra_state') }}"
              content: |
                {{ '{%' }} set names = {
                  'os_packages':   '{{ t('admin.updates_infra_os_packages') | js }}',
                  'os_reboot':     '{{ t('admin.updates_infra_os_reboot') | js }}',
                  'k3s':           '{{ t('admin.updates_infra_k3s') | js }}',
                  'gitlab_runner': '{{ t('admin.updates_infra_gitlab_runner') | js }}',
                  'gitlab':        '{{ t('admin.updates_infra_gitlab') | js }}',
                  'vault':         '{{ t('admin.updates_infra_vault') | js }}',
                  'docker_images': '{{ t('admin.updates_infra_docker_images') | js }}',
                  'k3s_workloads': '{{ t('admin.updates_infra_k3s_workloads') | js }}' } {{ '%}' }}
                {{ '{%' }} set tiers = {
                  'auto':   '{{ t('admin.updates_infra_auto') | js }}',
                  'manual': '{{ t('admin.updates_infra_manual') | js }}',
                  'locked': '{{ t('admin.updates_infra_locked') | js }}' } {{ '%}' }}
                {{ '{%' }} set wheres = {
                  'host':   '{{ t('admin.updates_infra_where_host') | js }}',
                  'docker': '{{ t('admin.updates_infra_where_docker') | js }}',
                  'k3s':    '{{ t('admin.updates_infra_where_k3s') | js }}' } {{ '%}' }}
                {{ '{%' }} set stepword = '{{ t('admin.updates_infra_steps') | js }}' {{ '%}' }}
                {%+ raw %}{% set rows = state_attr('sensor.vssp_updates_infra', 'components') or [] %}
                {% if not rows %}
                _{% endraw +%}{{ t('admin.updates_infra_never_probed') }}{%+ raw %}_
                {% else %}
                {% for layer in ['host', 'docker', 'k3s'] %}
                {% set group = rows | selectattr('where', 'defined')
                                    | selectattr('where', 'eq', layer) | list %}
                {% if layer == 'host' %}
                {% set group = group + (rows | rejectattr('where', 'defined') | list) %}
                {% endif %}
                {% if group %}
                **{{ wheres.get(layer, layer) }}**
                {% for r in group %}
                - {% if r.pending %}⬤{% else %}○{% endif %} {{ names.get(r.key, r.key) }} · _{{ tiers.get(r.tier, r.tier) }}_
                  {%- if r.installed %} · `{{ r.installed }}`{% endif %}
                  {%- if r.next %} → `{{ r.next }}`{% endif %}
                  {%- if (r.steps | default(0) | int) > 1 %} ({{ r.steps }} {{ stepword }} → `{{ r.latest }}`){% endif %}
                  {%- if not r.probed %} · ⚠{% endif %}
                {% endfor %}
                {% endif %}
                {% endfor %}
                {% endif %}{% endraw +%}
              card_mod:
                style: |
                  ha-card {
                    background: var(--card-background-color, rgba(8,18,28,0.75)) !important;
                    border: 1px solid rgba(0, 229, 255, 0.28) !important;
                    border-radius: var(--ha-card-border-radius, 20px) !important;
                  }

          # EN | The install buttons, one row per component the console is
          # EN | allowed to touch. `locked` components have no row here at
          # EN | all — the markdown above reports them, and that is the whole
          # EN | of what the console does with them.
          # EN | Each row calls the same script with a different key; the
          # EN | script checks the key against what the probe published before
          # EN | it opens anything.
          # FR | Les boutons d installation, une ligne par composant que la
          # FR | console a le droit de toucher. Les composants `locked` n ont
          # FR | aucune ligne ici — le markdown ci-dessus les remonte, et c est
          # FR | tout ce que la console en fait.
          # FR | Chaque ligne appelle le meme script avec une cle differente ;
          # FR | le script controle la cle face a ce qu a publie la sonde avant
          # FR | d ouvrir quoi que ce soit.
          # =================================================================
          # EN | THE INFRASTRUCTURE TABLE — one row per component, and every
          # EN | row says what its button would do
          # FR | LE TABLEAU INFRASTRUCTURE — une ligne par composant, et
          # FR | chaque ligne dit ce que ferait son bouton
          # =================================================================
          #
          # EN | This was four `type: button` entity rows: an icon, a name and
          # EN | an INSTALL button with nothing in between. The button showed
          # EN | even when the component had nothing pending, so the screen
          # EN | offered four ways to install and no way to tell what any of
          # EN | them would install — you were being asked to press a button
          # EN | whose consequence was written nowhere.
          # EN | Now each line carries its own versions, and the button exists
          # EN | ONLY when something is genuinely waiting. A component that is
          # EN | up to date says so and offers nothing; a locked one says why
          # EN | it will never be installed from here.
          # FR | C etaient quatre lignes `type: button` : une icone, un nom et
          # FR | un bouton INSTALLER avec rien entre les deux. Le bouton
          # FR | s affichait meme quand le composant n avait rien en attente,
          # FR | donc l ecran proposait quatre facons d installer et aucun
          # FR | moyen de savoir ce que chacune installerait — on demandait
          # FR | d appuyer sur un bouton dont la consequence n etait ecrite
          # FR | nulle part.
          # FR | Desormais chaque ligne porte ses propres versions, et le
          # FR | bouton n existe QUE si quelque chose attend vraiment. Un
          # FR | composant a jour le dit et ne propose rien ; un composant
          # FR | verrouille dit pourquoi il ne sera jamais installe d ici.
          - type: custom:button-card
            show_icon: false
            show_name: false
            show_state: false
            show_label: false
            entity: sensor.vssp_updates_infra
            tap_action:
              action: none
            custom_fields:
              head: >
                [[[
                  return `<div style="display:flex;align-items:center;
                      gap:8px;color:#FFFFFF;font-size:15px;font-weight:700;
                      letter-spacing:.4px;padding:2px 0 8px;">
                      <ha-icon icon="mdi:server-network"
                        style="--mdc-icon-size:20px;color:#00E5FF;margin:0;"
                        ></ha-icon>
                      {{ t('admin.updates_infra') | js }}</div>`;
                ]]]
              rows: >
                [[[
                  const L = {
                    packages:  '{{ t('admin.updates_infra_packages') | js }}',
                    security:  '{{ t('admin.updates_infra_security') | js }}',
                    uptodate:  '{{ t('admin.updates_infra_uptodate') | js }}',
                    required:  '{{ t('admin.updates_infra_required') | js }}',
                    notreq:    '{{ t('admin.updates_infra_not_required') | js }}',
                    unprobed:  '{{ t('admin.updates_infra_notprobed') | js }}',
                    images:    '{{ t('admin.updates_infra_images') | js }}',
                    workloads: '{{ t('admin.updates_infra_workloads') | js }}',
                    install:   '{{ t('admin.updates_infra_install') | js }}',
                    restart:   '{{ t('admin.updates_infra_restart') | js }}',
                    locked:    '{{ t('admin.updates_infra_locked_short') | js }}',
                    steps:     '{{ t('admin.updates_infra_steps') | js }}',
                    then:      '{{ t('admin.updates_infra_then') | js }}',
                    names: {
                      os_packages:   '{{ t('admin.updates_infra_os_packages') | js }}',
                      os_reboot:     '{{ t('admin.updates_infra_os_reboot') | js }}',
                      k3s:           '{{ t('admin.updates_infra_k3s') | js }}',
                      gitlab_runner: '{{ t('admin.updates_infra_gitlab_runner') | js }}',
                      gitlab:        '{{ t('admin.updates_infra_gitlab') | js }}',
                      vault:         '{{ t('admin.updates_infra_vault') | js }}',
                      docker_images: '{{ t('admin.updates_infra_docker_images') | js }}',
                      k3s_workloads: '{{ t('admin.updates_infra_k3s_workloads') | js }}'
                    },
                    // EN | The layer headings the rows are grouped under.
                    // FR | Les titres de couche sous lesquels les lignes sont
                    // FR | regroupees.
                    where: {
                      host:   '{{ t('admin.updates_infra_where_host') | js }}',
                      docker: '{{ t('admin.updates_infra_where_docker') | js }}',
                      k3s:    '{{ t('admin.updates_infra_where_k3s') | js }}'
                    },
                    // EN | Keyed by the LOCALE KEY the row carries, not by the
                    // EN | component. A row says which sentence it wants in its
                    // EN | reason_key and confirm_key fields, exactly as it
                    // EN | already did for its name, and this table answers.
                    // EN | Adding a component is then one entry here rather
                    // EN | than a new branch in the rendering code.
                    // FR | Indexe par la CLE DE LANGUE que porte la ligne, pas
                    // FR | par le composant. Une ligne dit quelle phrase elle
                    // FR | veut dans ses champs reason_key et confirm_key,
                    // FR | exactement comme elle le faisait deja pour son nom,
                    // FR | et cette table repond. Ajouter un composant est alors
                    // FR | une entree ici plutot qu une nouvelle branche dans le
                    // FR | code de rendu.
                    txt: {
                      '': '',
                      'admin.updates_infra_why_docker_images':
                        '{{ t('admin.updates_infra_why_docker_images') | js }}',
                      'admin.updates_infra_why_k3s_workloads':
                        '{{ t('admin.updates_infra_why_k3s_workloads') | js }}',
                      'admin.updates_infra_confirm_reboot':
                        '{{ t('admin.updates_infra_confirm_reboot') | js }}',
                      'admin.updates_infra_confirm_gitlab':
                        '{{ t('admin.updates_infra_confirm_gitlab') | js }}',
                      'admin.updates_infra_confirm_vault':
                        '{{ t('admin.updates_infra_confirm_vault') | js }}',
                      'admin.updates_infra_confirm_k3s':
                        '{{ t('admin.updates_infra_confirm_k3s') | js }}'
                    }
                  };
                  // EN | margin:0 ON EVERY ha-icon, and it is not
                  // EN | cosmetic. button-card styles its OWN icon with
                  // EN | `margin: auto` to centre it, and custom_fields HTML
                  // EN | lives in the same shadow root, so that rule applies
                  // EN | here too. On a flex row, auto margins absorb all the
                  // EN | free space: the icon was pushed to the middle of a
                  // EN | 1663px card and the label to the far right. It
                  // EN | measured as margin-left: 768px.
                  // FR | margin:0 SUR CHAQUE ha-icon, et ce n est pas
                  // FR | cosmetique. button-card style SA PROPRE icone avec
                  // FR | `margin: auto` pour la centrer, et le HTML des
                  // FR | custom_fields vit dans le meme shadow root, donc
                  // FR | cette regle s applique ici aussi. Sur une ligne
                  // FR | flex, les marges auto absorbent tout l espace libre :
                  // FR | l icone etait poussee au milieu d une carte de
                  // FR | 1663px et le libelle a l extreme droite. Mesure :
                  // FR | margin-left: 768px.
                  const rows = (entity && entity.attributes.components) || [];
                  if (!rows.length) {
                    return `<div style="color:#56707E;font-size:12px;
                      padding:8px 0;">${L.unprobed}</div>`;
                  }

                  // EN | What the row is about, as [text, colour, sub-line].
                  // EN | The third element is the one that is new, and it earns
                  // EN | its line: the stops AFTER the next one, or why a locked
                  // EN | row is locked. Those answer a different question from
                  // EN | the first line — "how long is this road" and "why is
                  // EN | there no button" rather than "what does this button do"
                  // EN | — and folding them into one cell made all of it
                  // EN | unreadable.
                  // FR | De quoi parle la ligne, en [texte, couleur, sous-ligne].
                  // FR | Le troisieme element est le nouveau, et il merite sa
                  // FR | ligne : les escales APRES la prochaine, ou pourquoi une
                  // FR | ligne verrouillee l est. Cela repond a une autre
                  // FR | question que la premiere ligne — « quelle est la
                  // FR | longueur de la route » et « pourquoi n y a-t-il pas de
                  // FR | bouton » plutot que « que fait ce bouton » — et tout
                  // FR | tasser dans une cellule rendait l ensemble illisible.
                  const why = r => L.txt[r.reason_key] || '';
                  const detail = r => {
                    if (!r.probed) return [L.unprobed, '#56707E', ''];
                    if (r.key === 'os_packages') {
                      if (!r.count) return [L.uptodate, '#56707E', ''];
                      const sec = r.security
                        ? ` · ${r.security} ${L.security}` : '';
                      return [`${r.count} ${L.packages}${sec}`,
                              r.security ? '#FF9800' : '#8FB6C9', ''];
                    }
                    if (r.key === 'os_reboot') {
                      return r.pending ? [L.required, '#FF9800', '']
                                       : [L.notreq, '#56707E', ''];
                    }
                    if (r.key === 'docker_images') {
                      return [`${r.installed} ${L.images}`, '#8FB6C9', why(r)];
                    }
                    if (r.key === 'k3s_workloads') {
                      return [`${r.installed} ${L.workloads}`, '#8FB6C9',
                              why(r)];
                    }
                    // EN | THE HOP, not the horizon. `next` is the single
                    // EN | version this press installs; it used to be `latest`,
                    // EN | and on the safe that read "1.20.4 → 2.1.0" beside an
                    // EN | INSTALL button — an offer to skip 1.21 and 2.0, and
                    // EN | with them two storage migrations HashiCorp does not
                    // EN | support skipping. The remaining stops are named on
                    // EN | the second line with a count, so the first line is
                    // EN | never mistaken for the whole journey.
                    // FR | LE SAUT, pas l horizon. `next` est la seule version
                    // FR | qu installe cette pression ; c etait `latest`, et sur
                    // FR | le coffre cela affichait « 1.20.4 → 2.1.0 » a cote
                    // FR | d un bouton INSTALLER — une proposition de sauter
                    // FR | 1.21 et 2.0, et avec elles deux migrations de
                    // FR | stockage que HashiCorp ne supporte pas de sauter. Les
                    // FR | escales restantes sont nommees sur la seconde ligne
                    // FR | avec un decompte, pour que la premiere ne soit jamais
                    // FR | prise pour tout le voyage.
                    if (r.pending && r.installed && r.next) {
                      const rest = (r.path || []).slice(1);
                      const sub = rest.length
                        ? `${L.then} ${rest.join(' → ')} · ${r.steps} ${L.steps}`
                        : '';
                      return [`${r.installed} → ${r.next}`, '#FF9800', sub];
                    }
                    if (r.installed) return [`${r.installed} · ${L.uptodate}`,
                                             '#56707E', ''];
                    return [L.uptodate, '#56707E', ''];
                  };

                  // EN | The button is the ONLY thing that changes anything,
                  // EN | so it appears only when there is something to
                  // EN | change. `locked` shows a muted chip instead — it is
                  // EN | information, not an offer.
                  // FR | Le bouton est la SEULE chose qui modifie quoi que ce
                  // FR | soit, il n apparait donc que s il y a quelque chose a
                  // FR | modifier. `locked` affiche une pastille eteinte a la
                  // FR | place — c est une information, pas une proposition.
                  const action = r => {
                    if (r.tier === 'locked') {
                      return `<span style="font-size:9px;color:#56707E;
                        border:1px solid rgba(86,112,126,.45);border-radius:6px;
                        padding:3px 8px;white-space:nowrap;">${L.locked}</span>`;
                    }
                    if (!r.probed || !r.pending) return '';
                    const label = r.key === 'os_reboot' ? L.restart : L.install;
                    const call = `document.querySelector('home-assistant')`
                      + `.hass.callService('script','vssp_infra_install_one',`
                      + `{component:'${r.key}'})`;
                    // EN | The warning belongs to the COMPONENT, declared beside
                    // EN | its tier in vssp_infra_updates.py and looked up here
                    // EN | by key. One sentence used to cover every heavy
                    // EN | button, which had the safe and the host reboot asking
                    // EN | the same question about two entirely different
                    // EN | consequences: one reseals a container, the other
                    // EN | takes the house offline. A component with no
                    // EN | confirm_key installs on the press, as the host
                    // EN | packages and the runner always did.
                    // FR | L avertissement appartient au COMPOSANT, declare a
                    // FR | cote de son palier dans vssp_infra_updates.py et
                    // FR | retrouve ici par sa cle. Une seule phrase couvrait
                    // FR | tous les boutons lourds, ce qui faisait poser la meme
                    // FR | question au coffre et au redemarrage de l hote pour
                    // FR | deux consequences entierement differentes : l un
                    // FR | rescelle un conteneur, l autre met la maison a
                    // FR | l arret. Un composant sans confirm_key s installe a
                    // FR | la pression, comme l ont toujours fait les paquets de
                    // FR | l hote et le runner.
                    // EN | PERCENT-ENCODED, and this is load-bearing.
                    // EN | A sentence on its way into an onclick attribute
                    // EN | crosses two parsers: HTML reads the attribute, then
                    // EN | JS reads the code inside it. "il faudra ressaisir 3
                    // EN | des 5 cles" is fine; "pour que l'ecran" is not — the
                    // EN | apostrophe closes the JS string literal and the
                    // EN | button dies silently on click, which is the worst way
                    // EN | for a confirmation dialog to fail. The `| js` filter
                    // EN | did escape the sentence, but it escaped it for the
                    // EN | GENERATED SOURCE; by the time the same sentence is a
                    // EN | runtime value being interpolated into markup, that
                    // EN | escaping has already been consumed. Percent-encoding
                    // EN | is the one form that survives both parsers intact.
                    // EN | encodeURIComponent leaves the apostrophe alone — it
                    // EN | is an unreserved character — so it is replaced by
                    // EN | hand, and that single replace is the whole fix.
                    // FR | ENCODE EN POURCENTS, et ce n est pas cosmetique.
                    // FR | Une phrase en route vers un attribut onclick traverse
                    // FR | deux analyseurs : HTML lit l attribut, puis JS lit le
                    // FR | code dedans. « il faudra ressaisir 3 des 5 cles » va
                    // FR | bien ; « pour que l'ecran » non — l apostrophe ferme
                    // FR | le litteral JS et le bouton meurt en silence au clic,
                    // FR | la pire facon pour une demande de confirmation
                    // FR | d echouer. Le filtre `| js` a bien echappe la phrase,
                    // FR | mais pour la SOURCE GENEREE ; quand cette meme phrase
                    // FR | est une valeur d execution interpolee dans du
                    // FR | balisage, cet echappement a deja ete consomme.
                    // FR | L encodage en pourcents est la seule forme qui
                    // FR | survive intacte aux deux analyseurs.
                    // FR | encodeURIComponent laisse l apostrophe telle quelle —
                    // FR | c est un caractere non reserve — elle est donc
                    // FR | remplacee a la main, et ce seul replace est tout le
                    // FR | correctif.
                    const warn = L.txt[r.confirm_key] || '';
                    const safe = encodeURIComponent(warn).replace(/'/g, '%27');
                    const onclick = warn
                      ? `if(confirm(decodeURIComponent('${safe}'))){${call}}`
                      : call;
                    return `<span onclick="${onclick}" style="font-size:9px;
                      font-weight:700;letter-spacing:.3px;cursor:pointer;
                      color:#00E5FF;border:1px solid rgba(0,229,255,.5);
                      background:rgba(0,229,255,.10);border-radius:6px;
                      padding:3px 10px;white-space:nowrap;">${label}</span>`;
                  };

                  // EN | GROUPED BY LAYER, in the order the component table
                  // EN | declares. Seven rows in one flat list could not say
                  // EN | that recreating Vault costs a reseal while restarting
                  // EN | k3s takes this very screen down with it — and the
                  // EN | cluster, which appeared only as a version number, now
                  // EN | has a heading of its own with its contents under it.
                  // EN | A heading says it once for everything below it.
                  // EN | A row whose layer this card does not recognise falls
                  // EN | under the server heading rather than vanishing: the
                  // EN | report on disk can be older than the card reading it,
                  // EN | for the minutes between a deploy and the next probe.
                  // FR | REGROUPEES PAR COUCHE, dans l ordre que declare la
                  // FR | table des composants. Sept lignes en liste plate ne
                  // FR | pouvaient pas dire que recreer Vault coute un
                  // FR | rescellement quand redemarrer k3s emporte cet ecran
                  // FR | meme — et le cluster, qui n apparaissait que comme un
                  // FR | numero de version, a desormais son propre titre avec
                  // FR | son contenu dessous. Un titre le dit une fois pour tout
                  // FR | ce qui est en dessous.
                  // FR | Une ligne dont cette carte ne reconnait pas la couche
                  // FR | tombe sous le titre serveur plutot que de disparaitre :
                  // FR | le rapport sur disque peut etre plus ancien que la carte
                  // FR | qui le lit, le temps qui separe un deploiement de la
                  // FR | sonde suivante.
                  // EN | text-align:left ON THE NAME CELL, and it is the
                  // EN | same shadow-DOM trap as the margin:0 above, one rule
                  // EN | further down. button-card centres its own label, and
                  // EN | custom_fields HTML lives in that same shadow root, so
                  // EN | `text-align: center` is inherited by anything here
                  // EN | that is not itself a flex container. The layer
                  // EN | headings and the row wrappers are flex and were never
                  // EN | affected; the name div is not, so every component name
                  // EN | floated in the middle of a row half a screen wide with
                  // EN | its version stranded at the far right. Nothing reads
                  // EN | as a list that way.
                  // FR | text-align:left SUR LA CELLULE DU NOM, et c est le
                  // FR | meme piege de shadow DOM que le margin:0 ci-dessus,
                  // FR | une regle plus bas. button-card centre son propre
                  // FR | libelle, et le HTML des custom_fields vit dans ce meme
                  // FR | shadow root : `text-align: center` est donc herite par
                  // FR | tout ce qui n est pas lui-meme un conteneur flex. Les
                  // FR | titres de couche et les enveloppes de ligne sont flex
                  // FR | et n ont jamais ete touches ; le div du nom, non, donc
                  // FR | chaque nom de composant flottait au milieu d une ligne
                  // FR | large d un demi-ecran, sa version echouee a l extreme
                  // FR | droite. Rien ne se lit comme une liste ainsi.
                  const layers = ['host', 'docker', 'k3s'];
                  const layerOf = r => layers.indexOf(r.where) >= 0
                    ? r.where : 'host';
                  const line = r => {
                    const [text, colour, sub] = detail(r);
                    return `<div style="display:flex;align-items:center;
                        gap:10px;padding:7px 0;
                        border-top:1px solid rgba(0,229,255,.10);">
                        <ha-icon icon="${r.icon}" style="--mdc-icon-size:18px;
                          color:${r.pending ? '#00E5FF' : '#56707E'};
                          flex:0 0 auto;margin:0;"></ha-icon>
                        <div style="flex:1 1 auto;min-width:0;text-align:left;
                          color:#FFFFFF;font-size:12px;font-weight:600;
                          white-space:nowrap;overflow:hidden;
                          text-overflow:ellipsis;">${L.names[r.key] || r.key}</div>
                        <div style="flex:0 1 auto;min-width:0;max-width:52%;
                          text-align:right;">
                          <div style="color:${colour};font-size:11px;
                            white-space:nowrap;overflow:hidden;
                            text-overflow:ellipsis;">${text}</div>
                          ${sub ? `<div style="color:#56707E;font-size:9px;
                            line-height:1.35;padding-top:2px;
                            ">${sub}</div>` : ''}
                        </div>
                        <div style="flex:0 0 auto;">${action(r)}</div>
                      </div>`;
                  };
                  return layers.map(w => {
                    const group = rows.filter(r => layerOf(r) === w);
                    if (!group.length) return '';
                    return `<div style="display:flex;align-items:center;gap:6px;
                        padding:12px 0 2px;color:#00E5FF;font-size:9px;
                        font-weight:700;letter-spacing:.6px;
                        text-transform:uppercase;">${L.where[w] || w}</div>`
                      + group.map(line).join('');
                  }).join('');
                ]]]
              foot: >
                [[[
                  // EN | WHY THE ROWS LOOK LIKE THAT, when they look wrong.
                  // EN | Until now this card rendered the report and said
                  // EN | nothing about whether the run that produced it had
                  // EN | succeeded. On a sealed safe — the normal state after a
                  // EN | host reboot, since no auto-unseal is configured — the
                  // EN | probe cannot read the host credentials, so every row
                  // EN | that needs ssh goes "not probed" and the INSTALL button
                  // EN | on the rows that remain cannot do its work either.
                  // EN | Both of those are correct behaviour and both are
                  // EN | baffling without a sentence, so here is the sentence.
                  // EN | The message_key is translated where this card has a
                  // EN | translation for it and the script's own rendered
                  // EN | English is the fallback — the same contract every other
                  // EN | status file in the project uses. A key carrying
                  // EN | variables is left to its rendered form rather than
                  // EN | re-implementing the interpolation here.
                  // FR | POURQUOI LES LIGNES RESSEMBLENT A CELA, quand elles
                  // FR | ont l air fausses. Jusqu ici cette carte affichait le
                  // FR | rapport et ne disait rien de la reussite de
                  // FR | l execution qui l avait produit. Sur un coffre scelle —
                  // FR | etat normal apres un redemarrage d hote, puisqu aucun
                  // FR | descellement automatique n est configure — la sonde ne
                  // FR | peut pas lire les identifiants de l hote : chaque ligne
                  // FR | qui a besoin de ssh passe en « non sondee », et le
                  // FR | bouton INSTALLER des lignes restantes ne peut pas
                  // FR | travailler non plus. Les deux comportements sont
                  // FR | corrects et les deux sont deroutants sans une phrase,
                  // FR | alors voici la phrase.
                  // FR | Le message_key est traduit la ou cette carte a une
                  // FR | traduction pour lui, et l anglais rendu par le script
                  // FR | sert de repli — le meme contrat que tout autre fichier
                  // FR | de statut du projet. Une cle porteuse de variables est
                  // FR | laissee a sa forme rendue plutot que de reimplementer
                  // FR | l interpolation ici.
                  const MSG = {
                    'error.vault_sealed':
                      '{{ t('admin.updates_infra_msg_sealed') | js }}',
                    'error.no_token':
                      '{{ t('admin.updates_infra_msg_no_token') | js }}'
                  };
                  // EN | THE REMEDY, not just the diagnosis. Knowing the safe
                  // EN | is sealed and knowing what to type are two different
                  // EN | pieces of information, and the second one is the one
                  // EN | that ends the outage. The SAFE screen already prints
                  // EN | this exact line (sealed_how in vssp_vault.html) and
                  // EN | this is the other screen the seal takes down, so it
                  // EN | prints it too rather than sending anyone hunting.
                  // EN | NOT TRANSLATED, and no host in it. A shell command is
                  // EN | a machine token — the same rule every status file in
                  // EN | this project follows — and hard-coding 192.168.1.11
                  // EN | into a generated dashboard would be a local fact
                  // EN | shipped to every other instance. The prose beside it
                  // EN | says "on the host", which is where it runs.
                  // FR | LE REMEDE, pas seulement le diagnostic. Savoir que le
                  // FR | coffre est scelle et savoir quoi taper sont deux
                  // FR | informations differentes, et c est la seconde qui met
                  // FR | fin a la panne. L ecran COFFRE-FORT imprime deja cette
                  // FR | ligne exacte (sealed_how dans vssp_vault.html), et cet
                  // FR | ecran-ci est l autre que le scellement met a terre :
                  // FR | il l imprime donc aussi plutot que d envoyer qui que
                  // FR | ce soit la chercher.
                  // FR | PAS TRADUITE, et sans hote dedans. Une commande shell
                  // FR | est un jeton machine — la regle que suit tout fichier
                  // FR | de statut de ce projet — et coder 192.168.1.11 en dur
                  // FR | dans un dashboard genere serait un fait local livre a
                  // FR | toutes les autres instances. La phrase a cote dit
                  // FR | « sur l hote », c est la que cela s execute.
                  const CMD = {
                    'error.vault_sealed':
                      'docker exec -it vssp-vault vault operator unseal'
                  };
                  const st = states['sensor.vssp_updates_infra_status'];
                  const bad = (st && st.state === 'error')
                    ? (MSG[st.attributes.message_key]
                       || st.attributes.message || '') : '';
                  const cmd = (st && st.state === 'error')
                    ? (CMD[st.attributes.message_key] || '') : '';
                  const call = `document.querySelector('home-assistant')`
                    + `.hass.callService('script','vssp_infra_check')`;
                  // EN | user-select:all so one click selects the whole
                  // EN | command: it is going to be retyped into a terminal,
                  // EN | and a half-selected docker invocation is worse than
                  // EN | none.
                  // FR | user-select:all pour qu un clic selectionne toute la
                  // FR | commande : elle va etre retapee dans un terminal, et
                  // FR | une invocation docker a moitie selectionnee est pire
                  // FR | que pas de selection du tout.
                  const warn = bad
                    ? `<div style="padding:8px 10px;margin:8px 0 2px;
                        border-radius:8px;background:rgba(255,152,0,.10);
                        border:1px solid rgba(255,152,0,.45);color:#FF9800;
                        font-size:10px;line-height:1.4;">
                        <div style="display:flex;align-items:flex-start;
                          gap:7px;">
                          <ha-icon icon="mdi:alert-outline"
                            style="--mdc-icon-size:14px;margin:0;flex:0 0 auto;"
                            ></ha-icon><span>${bad}</span></div>
                        ${cmd ? `<div style="margin:6px 0 0 21px;padding:4px 8px;
                          border-radius:5px;background:rgba(0,0,0,.35);
                          color:#FFD180;font-size:10px;user-select:all;
                          overflow-x:auto;white-space:nowrap;font-family:
                          ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
                          ">${cmd}</div>` : ''}
                      </div>`
                    : '';
                  return warn + `<div style="display:flex;align-items:center;
                      justify-content:space-between;gap:10px;padding:10px 0 2px;
                      border-top:1px solid rgba(0,229,255,.10);">
                      <div style="color:#56707E;font-size:10px;line-height:1.35;
                        ">{{ t('admin.updates_infra_locked_note') | js }}</div>
                      <span onclick="${call}" style="font-size:9px;
                        font-weight:700;letter-spacing:.3px;cursor:pointer;
                        color:#00E5FF;border:1px solid rgba(0,229,255,.5);
                        background:rgba(0,229,255,.10);border-radius:6px;
                        padding:4px 10px;white-space:nowrap;flex:0 0 auto;"
                        >{{ t('admin.updates_infra_check') | js }}</span>
                    </div>`;
                ]]]
            styles:
              grid:
                - grid-template-areas: '"head" "rows" "foot"'
                - grid-template-rows: min-content 1fr min-content
              card:
                - background: var(--card-background-color, rgba(8,18,28,0.75))
                - border: 1px solid rgba(0, 229, 255, 0.28)
                - border-radius: var(--ha-card-border-radius, 20px)
                - padding: 14px 18px
              custom_fields:
                head:
                  - width: 100%
                rows:
                  - width: 100%
                foot:
                  - width: 100%

          - type: entities
            title: "{{ t('admin.updates_auto') }}"
            entities:
              - entity: input_boolean.vssp_updates_auto
                name: "{{ t('admin.updates_auto_enabled') }}"
              - entity: input_datetime.vssp_updates_auto_time
                name: "{{ t('admin.updates_auto_time') }}"
              - entity: sensor.vssp_updates_auto
                name: "{{ t('admin.updates_auto_targets') }}"
                icon: mdi:autorenew
              - entity: script.vssp_updates_install_auto
                name: "{{ t('admin.updates_auto_now') }}"
                icon: mdi:play-circle-outline
              # EN | The infrastructure switch is a SECOND control on the same
              # EN | schedule, not a second schedule. It sits next to the first
              # EN | so the difference is visible: one installs cards, the
              # EN | other runs apt-get on the server. See vssp_updates.yaml.
              # FR | L interrupteur infrastructure est une SECONDE commande sur
              # FR | le meme horaire, pas un second horaire. Il siege a cote du
              # FR | premier pour que la difference se voie : l un installe des
              # FR | cartes, l autre lance apt-get sur le serveur. Voir
              # FR | vssp_updates.yaml.
              - entity: input_boolean.vssp_updates_infra_auto
                name: "{{ t('admin.updates_infra_auto_enabled') }}"
                icon: mdi:server-network
              - entity: sensor.vssp_infra_auto
                name: "{{ t('admin.updates_infra_auto') }}"
                icon: mdi:autorenew
              - type: section
                label: "{{ t('admin.updates_auto_protected') }}"
            # EN | --ha-color-form-background is the ONE token that darkens
            # EN | the time field. It is a Web Awesome control four shadow
            # EN | roots down (ha-time-input > ha-base-time-input > ha-input
            # EN | > wa-input), and what paints it is `.text-field` inside
            # EN | wa-input's own shadow root — unreachable by any selector
            # EN | written here. Left alone it renders #f3f3f3, a white slab
            # EN | on a dark console.
            # EN | Setting it on the CARD is what makes it work. A custom
            # EN | property is substituted where it is DECLARED, and Home
            # EN | Assistant declares the Web Awesome chain from this one
            # EN | above the card — so overriding the downstream
            # EN | --wa-form-control-background-color here changes a value
            # EN | that was already resolved and inherited as a literal.
            # EN | And when checking it in a browser: the field carries a
            # EN | background transition, so reading the computed style
            # EN | immediately after setting the property returns the OLD
            # EN | colour and the fix looks like it failed. Let it settle.
            # FR | --ha-color-form-background est le SEUL token qui assombrit
            # FR | le champ d heure. C est un controle Web Awesome quatre
            # FR | shadow roots plus bas (ha-time-input > ha-base-time-input
            # FR | > ha-input > wa-input), et ce qui le peint est
            # FR | `.text-field` dans le shadow root de wa-input lui-meme —
            # FR | hors d atteinte de tout selecteur ecrit ici. Laisse tel
            # FR | quel, il se rend en #f3f3f3, une dalle blanche sur une
            # FR | console sombre.
            # FR | C est de le poser sur la CARTE qui le fait fonctionner.
            # FR | Une propriete personnalisee est substituee la ou elle est
            # FR | DECLAREE, et Home Assistant declare la chaine Web Awesome
            # FR | a partir de celle-ci au-dessus de la carte — donc
            # FR | surcharger ici le --wa-form-control-background-color en
            # FR | aval modifie une valeur deja resolue et heritee en dur.
            # FR | Et pour le verifier dans un navigateur : le champ porte
            # FR | une transition de fond, donc lire le style calcule juste
            # FR | apres avoir pose la propriete renvoie l ANCIENNE couleur
            # FR | et la correction semble avoir echoue. Laisser reposer.
            card_mod:
              style: |
                ha-card {
                  background: var(--card-background-color, rgba(8,18,28,0.75)) !important;
                  border: 1px solid rgba(0, 229, 255, 0.28) !important;
                  border-radius: var(--ha-card-border-radius, 20px) !important;
                  --ha-color-form-background: rgba(0, 30, 45, 0.55);
                }

          # EN | MAINTENANCE. CHECK NOW matters more than it looks:
          # EN | integrations poll on their own schedule, so an empty screen
          # EN | means "nothing found last time we asked", and only this
          # EN | button turns that into "nothing found just now".
          # EN | The bulk install stops at HACS on purpose — see the
          # EN | reasoning in packages/vssp_updates.yaml. System updates and
          # EN | firmware are installed from their own row, where the native
          # EN | dialog offers the backup checkbox and the release notes
          # EN | first.
          # FR | MAINTENANCE. VERIFIER MAINTENANT compte plus qu il n y
          # FR | parait : les integrations interrogent leur source a leur
          # FR | propre rythme, donc un ecran vide signifie « rien trouve la
          # FR | derniere fois qu on a demande », et seul ce bouton
          # FR | transforme cela en « rien trouve a l instant ».
          # FR | L installation groupee s arrete a HACS a dessein — le
          # FR | raisonnement est dans packages/vssp_updates.yaml. Les mises
          # FR | a jour systeme et les micrologiciels s installent depuis
          # FR | leur propre ligne, ou la boite native propose d abord la
          # FR | case de sauvegarde et les notes de version.
          - type: entities
            title: "{{ t('admin.updates_maintenance') }}"
            entities:
              - entity: script.vssp_updates_check
                name: "{{ t('admin.updates_check') }}"
                icon: mdi:cloud-search-outline
              - entity: script.vssp_updates_install_hacs
                name: "{{ t('admin.updates_install_hacs') }}"
                icon: mdi:puzzle-plus-outline
            card_mod:
              style: |
                ha-card {
                  background: var(--card-background-color, rgba(8,18,28,0.75)) !important;
                  border: 1px solid rgba(0, 229, 255, 0.28) !important;
                  border-radius: var(--ha-card-border-radius, 20px) !important;
                }

{% elif screen == 'dashboards' %}
          # EN | Generation controls, moved here from the old HOME view.
          # FR | Controles de generation, deplaces ici depuis l ancienne vue HOME.
          #
          # EN | Language/format/chatbot as native type: tile cards with an
          # EN | inline select-options feature (user-provided pattern),
          # EN | instead of type: entities rows — a plain `input_select` row
          # EN | renders via the native Material select, which falls back to
          # EN | a wide white fill unless every MDC theme variable is set
          # EN | (fixed regardless, in theme.yaml.j2, but still a big inline
          # EN | picker rather than this compact look). tile cards are
          # EN | already well-themed by HA, but card_mod still points the
          # EN | background at selector_background (editable in the THEME
          # EN | screen) so it stays independently tunable from every other
          # EN | card's background, same as originally asked. grid_options
          # EN | (rows/columns) is a "sections" view concept and a no-op
          # EN | inside this project's custom:grid-layout views, so it is
          # EN | dropped — the existing 3-column type: grid wrapper already
          # EN | places these side by side.
          # FR | Langue/format/chatbot en cartes type: tile natives avec une
          # FR | fonctionnalite select-options en ligne (motif fourni par
          # FR | l'utilisateur), plutot qu'en lignes type: entities — une
          # FR | ligne `input_select` classique se rend via le select
          # FR | Material natif, qui retombe sur un remplissage blanc large
          # FR | tant que chaque variable de theme MDC n'est pas definie
          # FR | (corrige quand meme, dans theme.yaml.j2, mais reste un gros
          # FR | picker en ligne plutot que ce look compact). Les cartes tile
