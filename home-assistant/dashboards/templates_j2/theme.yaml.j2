{{ design.name }}:

  primary-color: "{{ design.palette.primary }}"
  accent-color: "{{ design.palette.accent }}"

  primary-background-color: "{{ design.palette.background }}"
  secondary-background-color: "{{ design.palette.background_secondary }}"

  card-background-color: "{{ design.palette.card_background }}"

  text-primary-color: "{{ design.palette.text_primary }}"
  secondary-text-color: "{{ design.palette.text_secondary }}"

  primary-text-color: "{{ design.palette.text_primary }}"

  app-header-background-color: "{{ design.header.background }}"
  app-header-text-color: "{{ design.header.text }}"

  divider-color: "{{ design.divider }}"

  paper-item-icon-color: "{{ design.icons.default }}"
  paper-item-icon-active-color: "{{ design.icons.active }}"

  state-icon-color: "{{ design.icons.default }}"

  ha-card-border-radius: "{{ design.shape.card_radius }}"
  ha-card-border-width: "{{ design.shape.card_border_width }}"
  ha-card-background: "{{ design.palette.card_background }}"

  # browser_mod popup dialogs
  mdc-dialog-scrim-color: "{{ design.dialog.scrim }}"
  ha-dialog-border-radius: "{{ design.shape.dialog_radius }}"

  # sidebar
  sidebar-background-color: "{{ design.sidebar.background }}"
  sidebar-text-color: "{{ design.sidebar.text }}"
  sidebar-icon-color: "{{ design.sidebar.icon }}"
  sidebar-selected-background-color: "{{ design.sidebar.selected_background }}"
  sidebar-selected-text-color: "{{ design.sidebar.selected_text }}"
  sidebar-selected-icon-color: "{{ design.sidebar.selected_icon }}"

  # transparence
  bubble-default-backdrop-background-color: "{{ design.bubble_backdrop }}"
