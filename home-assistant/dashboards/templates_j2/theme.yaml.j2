{#
  EN | Visio Sapiens — Home Assistant theme, generated from
  EN | model/design_system.yaml. Rendered by generate_dashboards.py
  EN | (--only theme) into themes/visio_sapiens.yaml.
  EN | *** GENERATED FILE — the OUTPUT is not for hand editing any more.
  EN | Edit design_system.yaml, not this template's output. ***
  FR | Visio Sapiens — theme Home Assistant, genere depuis
  FR | model/design_system.yaml. Rendu par generate_dashboards.py
  FR | (--only theme) vers themes/visio_sapiens.yaml.
  FR | *** FICHIER GENERE — la SORTIE n'est plus a editer a la main.
  FR | Editez design_system.yaml, pas la sortie de ce template. ***
#}
{{ design.name }}:

  primary-color: "{{ design.palette.primary }}"
  accent-color: "{{ design.palette.accent }}"

  primary-background-color: "{{ design.palette.background }}"
  secondary-background-color: "{{ design.palette.background_secondary }}"

  card-background-color: "{{ design.palette.card_background }}"

  # EN | Independent from card-background-color on purpose — the compact
  # EN | selector rows (ADMIN's Interface language, Target format, Chatbot
  # EN | provider) get their own token so it can be tuned without changing
  # EN | every other card's background too. Editable in the THEME screen
  # EN | (Palette > Selector background).
  # FR | Independant de card-background-color volontairement — les cases
  # FR | selecteur compactes (Langue d'interface, Format cible, Fournisseur
  # FR | chatbot de l'ADMIN) ont leur propre token pour pouvoir etre ajustees
  # FR | sans changer le fond de toutes les autres cartes. Modifiable dans
  # FR | l'ecran THEME (Palette > Fond des selecteurs).
  selector-background: "{{ design.palette.selector_background }}"

  text-primary-color: "{{ design.palette.text_primary }}"
  secondary-text-color: "{{ design.palette.text_secondary }}"

  primary-text-color: "{{ design.palette.text_primary }}"

  app-header-background-color: "{{ design.header.background }}"
  app-header-text-color: "{{ design.header.text }}"

  divider-color: "{{ design.divider }}"

  paper-item-icon-color: "{{ design.icons.default }}"
  paper-item-icon-active-color: "{{ design.icons.active }}"

  state-icon-color: "{{ design.icons.default }}"

  ha-card-border-radius: "{{ design.shape.card_radius }}"
  ha-card-border-width: "{{ design.shape.card_border_width }}"
  ha-card-background: "{{ design.palette.card_background }}"

  # browser_mod popup dialogs
  mdc-dialog-scrim-color: "{{ design.dialog.scrim }}"
  ha-dialog-border-radius: "{{ design.shape.dialog_radius }}"

  # sidebar
  sidebar-background-color: "{{ design.sidebar.background }}"
  sidebar-text-color: "{{ design.sidebar.text }}"
  sidebar-icon-color: "{{ design.sidebar.icon }}"
  sidebar-selected-background-color: "{{ design.sidebar.selected_background }}"
  sidebar-selected-text-color: "{{ design.sidebar.selected_text }}"
  sidebar-selected-icon-color: "{{ design.sidebar.selected_icon }}"

  # transparence
  bubble-default-backdrop-background-color: "{{ design.bubble_backdrop }}"

  # EN | TYPOGRAPHY — two faces. vssp-font-display is the HUD face every
  # EN | template names explicitly (nav rail, header clock, titles, values:
  # EN | `var(--vssp-font-display, Orbitron, sans-serif)`); the body face goes
  # EN | into Home Assistant's own font variables, so every piece of text
  # EN | that names no font — card contents, native rows, dialogs — follows
  # EN | it with no template change. Four names because HA read a different
  # EN | one in each generation of its components (ha-font-family-body today,
  # EN | primary-font-family and paper-font-* before it, the MWC typography
  # EN | one inside Material fields). The files come from vssp_fonts.css.
  # FR | TYPOGRAPHIE — deux polices. vssp-font-display est la police HUD que
  # FR | chaque template nomme explicitement (bandeau de nav, horloge du
  # FR | header, titres, valeurs : `var(--vssp-font-display, Orbitron,
  # FR | sans-serif)`) ; la police de texte va dans les variables de police de
  # FR | Home Assistant lui-meme, pour que tout texte qui ne nomme aucune
  # FR | police — contenu des cartes, lignes natives, dialogues — la suive sans
  # FR | toucher aux templates. Quatre noms parce que HA en a lu un different
  # FR | a chaque generation de ses composants (ha-font-family-body
  # FR | aujourd'hui, primary-font-family et paper-font-* avant, celle de la
  # FR | typographie MWC dans les champs Material). Les fichiers viennent de
  # FR | vssp_fonts.css.
  vssp-font-display: "{{ font_stack(design, 'font_display') }}"
  vssp-font-body: "{{ font_stack(design, 'font_body') }}"
  ha-font-family-body: "{{ font_stack(design, 'font_body') }}"
  primary-font-family: "{{ font_stack(design, 'font_body') }}"
  paper-font-common-base_-_font-family: "{{ font_stack(design, 'font_body') }}"
  mdc-typography-font-family: "{{ font_stack(design, 'font_body') }}"

  # EN | TEXT SIZES BY USAGE — multipliers, not sizes: every template size is
  # EN | calc(<px> * var(--vssp-scale-<role>, 1)), so the hierarchy inside a
  # EN | role (20px header title, 11px subsection title) survives any scale.
  # EN | The text scale also drives ha-font-size-scale, Home Assistant's own
  # EN | multiplier, so native cards and rows grow with the generated ones.
  # FR | TAILLES DE TEXTE PAR USAGE — des multiplicateurs, pas des tailles :
  # FR | chaque taille des templates vaut calc(<px> * var(--vssp-scale-<role>,
  # FR | 1)), la hierarchie interne d'un role (titre du header 20px, titre de
  # FR | sous-section 11px) survit donc a toute echelle. L'echelle du texte
  # FR | pilote aussi ha-font-size-scale, le multiplicateur propre a Home
  # FR | Assistant, pour que cartes et lignes natives grandissent avec les
  # FR | generees.
  vssp-scale-clock: "{{ size_scale(design, 'size_clock') }}"
  vssp-scale-title: "{{ size_scale(design, 'size_title') }}"
  vssp-scale-value: "{{ size_scale(design, 'size_value') }}"
  vssp-scale-text: "{{ size_scale(design, 'size_text') }}"
  vssp-scale-label: "{{ size_scale(design, 'size_label') }}"
  ha-font-size-scale: "{{ size_scale(design, 'size_text') }}"

  # EN | NAV LOGO — the square under the navigation rail (_nav.j2) paints
  # EN | this image; "none" hides the square. In the theme rather than in
  # EN | the dashboards so a new logo is live on APPLY, like a color — no
  # EN | regeneration, and HOME, which a deploy never regenerates, follows.
  # FR | LOGO DE NAV — le carre sous le bandeau de navigation (_nav.j2)
  # FR | peint cette image ; "none" masque le carre. Dans le theme plutot que
  # FR | dans les dashboards pour qu'un nouveau logo soit actif des
  # FR | l'APPLIQUER, comme une couleur — sans regeneration, et HOME, qu'un
  # FR | deploiement ne regenere jamais, suit.
{% set logo = nav_logo(design, house) %}
  vssp-nav-logo: "{{ logo.image }}"
  vssp-nav-logo-display: "{{ logo.display }}"

  # EN | input_select / mwc-select dropdowns (ADMIN's Interface language,
  # EN | Target format, Chatbot provider...) — without these, HA's Material
  # EN | select falls back to its own light-mode default fill (a bright
  # EN | white box) instead of inheriting the dark theme, because these are
  # EN | MDC component variables, never set anywhere in this file before.
  # FR | Menus deroulants input_select / mwc-select (Langue d'interface,
  # FR | Format cible, Fournisseur chatbot... de l'ADMIN) — sans elles, le
  # FR | select Material de HA retombe sur son propre remplissage clair par
  # FR | defaut (une boite blanche vive) au lieu d'heriter du theme sombre,
  # FR | car ce sont des variables de composant MDC, jamais definies dans ce
  # FR | fichier avant.
  mdc-select-fill-color: "{{ design.palette.card_background }}"
  mdc-select-ink-color: "{{ design.palette.text_primary }}"
  mdc-select-label-ink-color: "{{ design.palette.text_secondary }}"
  mdc-select-idle-line-color: "{{ design.divider }}"
  mdc-select-hover-line-color: "{{ design.palette.primary }}"
  mdc-select-outlined-idle-border-color: "{{ design.divider }}"
  mdc-select-outlined-hover-border-color: "{{ design.palette.primary }}"
  mdc-text-field-fill-color: "{{ design.palette.card_background }}"
  mdc-text-field-ink-color: "{{ design.palette.text_primary }}"
  mdc-text-field-label-ink-color: "{{ design.palette.text_secondary }}"
  mdc-text-field-idle-line-color: "{{ design.divider }}"
  mdc-text-field-hover-line-color: "{{ design.palette.primary }}"
  mdc-theme-surface: "{{ design.palette.card_background }}"
  mdc-theme-on-surface: "{{ design.palette.text_primary }}"
