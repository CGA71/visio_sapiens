{#
########################################################################
# EN | ONE FRAMED GROUP OF SWITCHES — the reference presentation for the
# FR | UN GROUPE ENCADRE D'INTERRUPTEURS — la presentation de reference
# EN | `switches` slot, everywhere it is drawn EXCEPT the ENERGY breaker
# FR | du slot `switches`, partout ou il est dessine SAUF le tableau
# EN | panel, which keeps its own two-column layout.
# FR | electrique d'ENERGY, qui garde sa mise en page a deux colonnes.
#
# EN | The shape comes from the entrance hall panel: a titled frame per
# EN | kind of switch — lights, outlets, shutters — side by side, each
# EN | holding a list of vssp_circuit_row lines. Two things make it worth
# EN | generalising. The frame says what the group IS, where a bare label
# EN | above a list only whispers it. And side by side, three short
# EN | groups read at once instead of scrolling past one another in a
# EN | single pile.
# FR | La forme vient du panneau de l'entree : un cadre titre par nature
# FR | d'interrupteur — lumieres, prises, volets — cote a cote, chacun
# FR | portant une liste de lignes vssp_circuit_row. Deux choses valent
# FR | de la generaliser. Le cadre dit ce qu'EST le groupe, la ou un
# FR | simple libelle au-dessus d'une liste ne fait que le murmurer. Et
# FR | cote a cote, trois groupes courts se lisent d'un coup au lieu de
# FR | defiler l'un derriere l'autre dans un tas unique.
#
# EN | Called as:
# FR | Appel :
#     {% import '_switch_group.j2' as sw %}
#     {{ sw.group(title, rows) }}
#
# EN | `rows` is a list of mappings: entity (required), icon, name, tap.
# FR | `rows` est une liste de mappings : entity (requis), icon, name, tap.
########################################################################
#}
{% macro group(title, rows) %}
              - type: vertical-stack
                card_mod:
                  style: |
                    :host { flex: 1 1 0; height: 100%; }
                    #root {
                      height: 100%;
                      box-sizing: border-box;
                      display: flex;
                      flex-direction: column;
                      background: rgba(0,0,0,.16);
                      border: 1px solid rgba(0, 229, 255, 0.15);
                      border-radius: 16px;
                      padding: 8px 10px;
                    }
                    /* EN | `auto` basis, never 0. A slot's height is
                       EN | sometimes definite (the entrance strip is 220px)
                       EN | and sometimes not (a room's default slot is 1fr,
                       EN | and the frame ends up content-sized). From a zero
                       EN | basis the list collapsed to nothing in the second
                       EN | case and its rows spilled OUTSIDE the frame — the
                       EN | border wrapped the title alone. From `auto` it
                       EN | starts at its content height, grows into the space
                       EN | a fixed slot leaves, and min-height:0 still lets
                       EN | it shrink and scroll rather than push the frame
                       EN | past its slot.
                       FR | Base `auto`, jamais 0. La hauteur d'un slot est
                       FR | parfois definie (le bandeau de l'entree fait
                       FR | 220px), parfois non (le slot par defaut d'une
                       FR | piece vaut 1fr, et le cadre finit dimensionne par
                       FR | son contenu). Depuis une base nulle, la liste
                       FR | s'effondrait a rien dans le second cas et ses
                       FR | lignes debordaient HORS du cadre — la bordure
                       FR | n'entourait que le titre. Depuis `auto`, elle part
                       FR | de la hauteur de son contenu, s'etend dans la
                       FR | place qu'un slot fixe laisse, et min-height:0 lui
                       FR | permet toujours de retrecir et defiler plutot que
                       FR | de pousser le cadre au-dela de son slot. */
                    #root > *:last-child {
                      flex: 1 1 auto;
                      min-height: 0;
                    }
                cards:
                  - type: custom:button-card
                    template: vssp_section_title
                    name: "{{ title }}"
                  # EN | The list fills the frame rather than capping at a
                  # EN | fixed height: the slot's own height is computed per
                  # EN | room (260px, 140px or 1fr), so any number written
                  # EN | here would be wrong somewhere — three rows drew a
                  # EN | scrollbar for the sake of eight pixels. It scrolls
                  # EN | only when the content really exceeds the frame.
                  # FR | La liste remplit le cadre plutot que de plafonner a
                  # FR | une hauteur fixe : la hauteur du slot est calculee
                  # FR | par piece (260px, 140px ou 1fr), donc tout nombre
                  # FR | ecrit ici serait faux quelque part — trois lignes
                  # FR | affichaient une barre de defilement pour huit pixels.
                  # FR | Elle ne defile que si le contenu deborde vraiment.
                  - type: custom:button-card
                    show_icon: false
                    show_name: false
                    show_state: false
                    tap_action:
                      action: none
                    styles:
                      grid:
                        - grid-template-areas: '"list"'
                      card:
                        - background: transparent
                        - box-shadow: none
                        - border: none
                        - border-radius: 0
                        - padding: 0
                        - cursor: default
                      custom_fields:
                        list:
                          - display: block
                          - width: 100%
                          - height: 100%
                          - overflow-y: auto
                          - overflow-x: hidden
                          - padding-right: 4px
                          - scrollbar-width: thin
                          - scrollbar-color: rgba(0, 229, 255, 0.35) rgba(0, 229, 255, 0.06)
                    custom_fields:
                      list:
                        card:
                          type: vertical-stack
                          cards:
{% if not rows %}
                            # EN | A vertical-stack with an EMPTY cards list is
                            # EN | a configuration error in Home Assistant, not
                            # EN | an empty box — the entrance hall's "Lights"
                            # EN | frame has been showing a red "Configuration
                            # EN | error" ever since this slot started drawing
                            # EN | both frames whether or not they hold
                            # EN | anything. A frame that says "nothing here"
                            # EN | is the whole point of drawing it empty; a
                            # EN | frame that says "error" is worse than no
                            # EN | frame.
                            # FR | Un vertical-stack a la liste de cartes VIDE
                            # FR | est une erreur de configuration pour Home
                            # FR | Assistant, pas une boite vide — le cadre
                            # FR | « Lumieres » de l'entree affiche une
                            # FR | « Erreur de configuration » rouge depuis que
                            # FR | ce tableau dessine les deux cadres qu'ils
                            # FR | contiennent quelque chose ou non. Un cadre
                            # FR | qui dit « rien ici » est toute la raison de
                            # FR | le dessiner vide ; un cadre qui dit
                            # FR | « erreur » vaut moins que pas de cadre.
                            - type: custom:button-card
                              show_icon: false
                              show_name: false
                              show_state: false
                              show_label: true
                              label: "—"
                              tap_action:
                                action: none
                              styles:
                                card:
                                  - background: transparent
                                  - box-shadow: none
                                  - border: none
                                  - padding: 10px 0
                                  - cursor: default
                                  - pointer-events: none
                                label:
                                  - color: rgba(143, 182, 201, 0.45)
                                  - font-size: 13px
{% endif %}
{% for r in rows %}
                            - type: custom:button-card
                              template: vssp_circuit_row
                              entity: {{ r.entity }}
{% if r.get('name') %}
                              name: "{{ r.get('name') }}"
{% endif %}
{% if r.get('icon') %}
                              icon: {{ r.get('icon') }}
{% endif %}
{% if r.get('tap') %}
                              tap_action:
                                action: {{ r.get('tap') }}
                              hold_action:
                                action: toggle
{% endif %}
                              variables:
                                model: ""
                                amp: ""
                                image: ""
{% endfor %}
{% endmacro %}
