########################################################################
# Visio Sapiens — ROOM Dashboard, MOBILE format
#
# EN | *** GENERATED FILE — DO NOT EDIT BY HAND ***
# EN | Source: room_mobile.yaml.j2 + model/house.yaml + locales/<code>.yaml
# EN | Regenerate with: python3 generate_dashboards.py --format mobile
# FR | *** FICHIER GENERE — NE PAS EDITER A LA MAIN ***
# FR | Source : room_mobile.yaml.j2 + model/house.yaml + locales/<code>.yaml
# FR | Regenerer avec : python3 generate_dashboards.py --format mobile
#
# EN | WHY A SEPARATE FILE RATHER THAN BRANCHES IN room.yaml.j2
# EN | A phone is not a narrow tablet. Four things differ, and none of them
# EN | is a width adjustment:
# EN |   1. NAVIGATION — the vertical rail becomes a horizontally scrolling
# EN |      chip bar (_nav_mobile.j2).
# EN |   2. GRID — a single column, `minmax(0, 1fr)`, one slot per row. There
# EN |      is no slot-set-specific layout here: with one column, a reduced
# EN |      slot set simply means fewer rows.
# EN |   3. READING ORDER — secondary slots (by device count, heaviest
# EN |      first), then the room's `default_slot` last — mirrors its
# EN |      "biggest, at the bottom" desktop position without needing 2-D
# EN |      tiering. Computed by compute_mobile_order() in
# EN |      generate_dashboards.py, not hardcoded here.
# EN |   4. TYPE SCALE — smaller titles, shorter lists, one-column mosaics.
# FR | POURQUOI UN FICHIER SEPARE PLUTOT QUE DES BRANCHES DANS room.yaml.j2
# FR | Un telephone n'est pas une tablette etroite. Quatre choses different,
# FR | et aucune n'est un ajustement de largeur :
# FR |   1. NAVIGATION — le bandeau vertical devient une barre de chips
# FR |      defilant horizontalement (_nav_mobile.j2).
# FR |   2. GRILLE — une seule colonne, `minmax(0, 1fr)`, un tableau par
# FR |      ligne. Aucune disposition propre au jeu de tableaux ici : avec une
# FR |      colonne, un jeu reduit signifie simplement moins de lignes.
# FR |   3. ORDRE DE LECTURE — tableaux secondaires (par nombre d'appareils,
# FR |      le plus charge en premier), puis le `default_slot` de la piece en
# FR |      dernier — reprend sa position desktop « le plus grand, en bas »
# FR |      sans repartition 2D. Calcule par compute_mobile_order() dans
# FR |      generate_dashboards.py, pas code en dur ici.
# FR |   4. ECHELLE TYPO — titres plus petits, listes plus courtes,
# FR |      mosaiques sur une colonne.
#
# EN | Slot states (filled / empty) are decided by generate_dashboards.py and
# EN | behave exactly as on tablet — an empty slot is absent entirely, no
# EN | placeholder card.
# FR | Les etats des tableaux (filled / empty) sont decides par
# FR | generate_dashboards.py et se comportent exactement comme en tablette —
# FR | un tableau vide est totalement absent, pas de carte de remplacement.
########################################################################

{# EN | Vertical reading order comes pre-computed and already
    EN | empty-filtered from generate_dashboards.py (compute_mobile_order()) —
    EN | see the READING ORDER note above.
    FR | L'ordre de lecture vertical arrive deja calcule et deja filtre des
    FR | tableaux vides depuis generate_dashboards.py (compute_mobile_order())
    FR | — voir la note ORDRE DE LECTURE ci-dessus. #}
{% set shown = room.slot_order_mobile %}

title: {{ room.label }}
theme: {{ house.theme }}

# EN | Without these includes every custom:button-card shows "Configuration
# EN | error". Path is relative to dashboards/views/.
# FR | Sans ces includes, chaque custom:button-card affiche « Erreur de
# FR | configuration ». Chemin relatif a dashboards/views/.
button_card_templates: !include ../templates/button_card_templates.yaml
decluttering_templates: !include ../templates/decluttering_templates.yaml

views:
  - title: {{ room.label }}
    path: {{ room.id }}
    subview: false
    type: custom:grid-layout
    layout:
      # EN | minmax(0,1fr), not 1fr: `1fr` means minmax(auto,1fr) and refuses
      # EN | to go below the natural width of its content, so one wide element
      # EN | (the scrolling nav, a chart) would widen the whole page — the
      # EN | "tablet look" on a phone. minmax(0,1fr) locks the column to the
      # EN | screen width whatever it contains.
      # FR | minmax(0,1fr) et non 1fr : `1fr` vaut minmax(auto,1fr) et refuse
      # FR | de descendre sous la largeur naturelle de son contenu, donc un
      # FR | element large (la nav defilante, un graphe) elargirait toute la
      # FR | page — l'effet « format tablette » sur telephone. minmax(0,1fr)
      # FR | verrouille la colonne a la largeur de l'ecran quoi qu'elle
      # FR | contienne.
      grid-template-columns: minmax(0, 1fr)
      grid-template-rows: auto
      grid-template-areas: |
        "header"
        "nav"
{% for slot_id in shown %}
        "{{ slot_id }}"
{% endfor %}
      margin: 8px
      grid-gap: 12px 0px
    cards:
      # ═══════════════════════════════════════════════════════════════
      # EN | COMPACT HEADER — title + time on a single card
      # FR | HEADER COMPACT — titre + heure sur une seule carte
      # ═══════════════════════════════════════════════════════════════
{% set page_title = room.name %}
{% set page_subtitle = room.label %}
{% set page_icon = room.icon %}
{% set page_path = room.path_mobile %}
{% include '_header_mobile.j2' %}

      # ═══════════════════════════════════════════════════════════════
      # EN | NAVIGATION — one-line scrolling chip bar
      # FR | NAVIGATION — barre de chips defilante sur une ligne
      # ═══════════════════════════════════════════════════════════════
{% include '_nav_mobile.j2' %}

{% for slot_id in shown %}
{% import '_switch_group.j2' as sw %}
{% set slot = room.slots[slot_id] %}
      # ═══════════════════════════════════════════════════════════════
      # EN | SLOT {{ loop.index }} — {{ slot_id | upper }} ({{ slot.state }})
      # FR | TABLEAU {{ loop.index }} — {{ slot_id | upper }} ({{ slot.state }})
      # ═══════════════════════════════════════════════════════════════
      - type: vertical-stack
        view_layout:
          grid-area: {{ slot_id }}
        card_mod:
          style: |
            :host {
              display: block;
              width: 100%;
              background: var(--card-background-color, rgba(8,18,28,0.75));
              border-radius: var(--ha-card-border-radius, 18px);
              border: 1px solid rgba(0, 229, 255, 0.28);
              backdrop-filter: blur(12px);
              box-shadow: 0 0 18px rgba(0, 229, 255, 0.15);
              padding: 12px 14px;
              overflow: hidden;
            }
        cards:
          # EN | Smaller section title than on tablet — the shared
          # EN | vssp_section_title is sized for a 6-panel HUD.
          # FR | Titre de section plus petit qu'en tablette — le
          # FR | vssp_section_title partage est calibre pour un HUD a 6 cases.
          - type: custom:button-card
            template: vssp_section_title
            name: "{{ t('slot.' ~ slot_id) }}"
            card_mod:
              style: |
                ha-card { padding: 0 0 6px 0 !important; }
                #name { font-size: 12px !important; letter-spacing: 1px !important; }

{% if slot_id in ['appliances', 'sensors'] %}
          # EN | Line by line with an internal scrollbar, capped shorter than
          # EN | on tablet: on a phone the panel competes with the whole page
          # EN | for vertical space, and a 320px list would push everything
          # EN | below it out of reach.
          # FR | Ligne par ligne avec un ascenseur interne, plafonne plus bas
          # FR | qu'en tablette : sur telephone le panneau se dispute l'espace
          # FR | vertical avec toute la page, et une liste de 320px repousserait
          # FR | hors de portee tout ce qui suit.
          - type: custom:button-card
            show_icon: false
            show_name: false
            show_state: false
            tap_action:
              action: none
            styles:
              grid:
                - grid-template-areas: '"list"'
              card:
                - background: transparent
                - box-shadow: none
                - border: none
                - border-radius: 0
                - padding: 0
                - cursor: default
              custom_fields:
                list:
                  - display: block
                  - width: 100%
                  - height: 210px
                  - overflow-y: auto
                  - overflow-x: hidden
                  - touch-action: pan-y
                  - "-webkit-overflow-scrolling": touch
                  - padding-right: 4px
                  - scrollbar-width: none
            custom_fields:
              list:
                card:
                  type: vertical-stack
                  cards:
{% for e in slot.entities %}
                    - type: custom:button-card
                      entity: {{ e }}
                      show_state: true
                      size: 18px
                      styles:
                        grid:
                          - grid-template-areas: '"i n s"'
                          - grid-template-columns: 26px 1fr auto
                          - align-items: center
                          - column-gap: 8px
                        card:
                          - background: rgba(0,0,0,.22)
                          - border: 1px solid rgba(0, 229, 255, 0.12)
                          - border-radius: 10px
                          - padding: 6px 10px
                          - margin-bottom: 6px
                          - height: 42px
                        name:
                          - justify-self: start
                          - text-align: left
                          - font-size: 11px
                          - color: "var(--text-primary-color, #DCEEF6)"
                          - white-space: nowrap
                          - overflow: hidden
                          - text-overflow: ellipsis
                        state:
                          - justify-self: end
                          - text-align: right
                          - font-size: 11px
                          - color: "#00E5FF"
                        icon:
                          - color: "var(--paper-item-icon-color, #00E5FF)"
                      tap_action:
                        action: toggle
                      hold_action:
                        action: more-info
{% endfor %}

{% elif slot_id == 'security' %}
          # EN | One column on a phone. Two side-by-side camera feeds on a
          # EN | 380px screen give 180px each — too small to recognise anyone
          # EN | at the door, which is the whole point of the intercom.
          # FR | Une colonne sur telephone. Deux flux camera cote a cote sur un
          # FR | ecran de 380px donnent 180px chacun — trop petit pour
          # FR | reconnaitre qui sonne, ce qui est tout l'interet de
          # FR | l'interphone.
{% set alarms = slot.by_domain.get('alarm_control_panel', []) %}
{% set cameras = slot.by_domain.get('camera', []) %}
{% set others = slot.entities | reject('in', alarms + cameras) | list %}
{% for e in alarms %}
          - type: custom:button-card
            entity: {{ e }}
            show_state: true
            show_name: true
            size: 24px
            state:
              - value: "disarmed"
                color: "#8FB6C9"
                icon: mdi:shield-off-outline
              - value: "triggered"
                color: "#FF4D6D"
                icon: mdi:shield-alert
              - operator: default
                color: "#00FFC3"
                icon: mdi:shield-check
            styles:
              grid:
                - grid-template-areas: '"i n" "i s"'
                - grid-template-columns: 40px 1fr
                - align-items: center
              card:
                - background: rgba(0,0,0,.28)
                - border: 1px solid rgba(0, 229, 255, 0.18)
                - border-radius: 12px
                - padding: 8px 10px
                - margin-bottom: 8px
                - height: 58px
              name:
                - justify-self: start
                - text-align: left
                - font-size: 11px
                - color: "var(--secondary-text-color, #8FB6C9)"
              state:
                - justify-self: start
                - text-align: left
                - font-size: 13px
                - font-family: Orbitron, sans-serif
                - text-transform: uppercase
            tap_action:
              action: more-info
{% endfor %}
{% for e in cameras %}
          - type: picture-entity
            entity: {{ e }}
            camera_view: live
            show_name: true
            show_state: false
            card_mod:
              style: |
                ha-card {
                  background: rgba(0,0,0,.35) !important;
                  border: 1px solid rgba(0, 229, 255, 0.18) !important;
                  border-radius: 12px !important;
                  overflow: hidden;
                  margin-bottom: 8px;
                }
{% endfor %}
{% if others %}
          - type: grid
            columns: 2
            square: false
            cards:
{% for e in others %}
              - type: custom:button-card
                entity: {{ e }}
                show_state: true
                size: 18px
                styles:
                  card:
                    - background: rgba(0,0,0,.22)
                    - border: 1px solid rgba(0, 229, 255, 0.12)
                    - border-radius: 10px
                    - padding: 6px
                  name:
                    - font-size: 10px
                    - color: "var(--text-primary-color, #DCEEF6)"
                  state:
                    - font-size: 10px
                    - color: "#00E5FF"
                tap_action:
                  action: more-info
{% endfor %}
{% endif %}

{% elif slot_id == 'switches' %}
          # EN | Same reference presentation as the tablet — a titled FRAME
          # EN | per kind of switch, holding a list of vssp_circuit_row lines
          # EN | — stacked one under the other instead of side by side. On a
          # EN | phone, three frames abreast would leave each group a third of
          # EN | an already narrow screen, and a row needs its width for the
          # EN | name far more than the groups need to be adjacent.
          # FR | Meme presentation de reference que la tablette — un CADRE
          # FR | titre par nature d'interrupteur, portant une liste de lignes
          # FR | vssp_circuit_row — empiles l'un sous l'autre au lieu d'etre
          # FR | cote a cote. Sur un telephone, trois cadres de front
          # FR | laisseraient a chaque groupe un tiers d'un ecran deja etroit,
          # FR | et une ligne a bien plus besoin de sa largeur pour le nom que
          # FR | les groupes d'etre voisins.
{% set known_switch_domains = ['light', 'switch', 'cover'] %}
{% set groups = [] %}
{% if slot.by_domain.get('light', []) %}
{% set rows = [] %}
{% for e in slot.by_domain.get('light', []) %}
{% set _ = rows.append({'entity': e, 'icon': 'mdi:lightbulb'}) %}
{% endfor %}
{% set _ = groups.append({'title': t('slot.switches_lights'), 'rows': rows}) %}
{% endif %}
{% if slot.by_domain.get('switch', []) %}
{% set rows = [] %}
{% for e in slot.by_domain.get('switch', []) %}
{% set _ = rows.append({'entity': e, 'icon': 'mdi:power-socket-fr'}) %}
{% endfor %}
{% set _ = groups.append({'title': t('slot.switches_outlets'), 'rows': rows}) %}
{% endif %}
{% if slot.by_domain.get('cover', []) %}
{% set rows = [] %}
{% for e in slot.by_domain.get('cover', []) %}
{% set _ = rows.append({'entity': e, 'icon': 'mdi:window-shutter', 'tap': 'more-info'}) %}
{% endfor %}
{% set _ = groups.append({'title': t('slot.switches_shutters'), 'rows': rows}) %}
{% endif %}
{% set other = [] %}
{% for domain, ents in slot.by_domain.items() if domain not in known_switch_domains %}
{% for e in ents %}
{% set _ = other.append({'entity': e}) %}
{% endfor %}
{% endfor %}
{% if other %}
{% set _ = groups.append({'title': t('slot.switches_other'), 'rows': other}) %}
{% endif %}
          - type: vertical-stack
            cards:
{% for g in groups %}
{{ sw.group(g.title, g.rows) }}
{% endfor %}

{% elif slot_id == 'infrastructure' %}
          # EN | Same scrollable-list idiom as appliances above.
          # FR | Meme idiome de liste defilante que appliances ci-dessus.
          - type: custom:button-card
            show_icon: false
            show_name: false
            show_state: false
            tap_action:
              action: none
            styles:
              grid:
                - grid-template-areas: '"list"'
              card:
                - background: transparent
                - box-shadow: none
                - border: none
                - border-radius: 0
                - padding: 0
                - cursor: default
              custom_fields:
                list:
                  - display: block
                  - width: 100%
                  - height: 210px
                  - overflow-y: auto
                  - overflow-x: hidden
                  - touch-action: pan-y
                  - "-webkit-overflow-scrolling": touch
                  - padding-right: 4px
                  - scrollbar-width: none
            custom_fields:
              list:
                card:
                  type: vertical-stack
                  cards:
{% for e in slot.entities %}
                    - type: custom:button-card
                      entity: {{ e }}
                      show_state: true
                      size: 18px
                      styles:
                        grid:
                          - grid-template-areas: '"i n s"'
                          - grid-template-columns: 26px 1fr auto
                          - align-items: center
                          - column-gap: 8px
                        card:
                          - background: rgba(0,0,0,.22)
                          - border: 1px solid rgba(0, 229, 255, 0.12)
                          - border-radius: 10px
                          - padding: 6px 10px
                          - margin-bottom: 6px
                          - height: 42px
                        name:
                          - justify-self: start
                          - text-align: left
                          - font-size: 11px
                          - color: "var(--text-primary-color, #DCEEF6)"
                          - white-space: nowrap
                          - overflow: hidden
                          - text-overflow: ellipsis
                        state:
                          - justify-self: end
                          - text-align: right
                          - font-size: 11px
                          - color: "#00E5FF"
                        icon:
                          - color: "var(--paper-item-icon-color, #00E5FF)"
                      tap_action:
                        action: more-info
{% endfor %}

{% else %}
          # EN | SENSORS — one row per device. sensor/binary_sensor entities
          # EN | are read-only, so they open more-info instead of toggling.
          # FR | SENSORS — une ligne par appareil. Les entites
          # FR | sensor/binary_sensor sont en lecture seule, donc elles
          # FR | ouvrent more-info plutot que de basculer.
{% for e in slot.entities %}
{% set domain = e.split('.')[0] %}
          - type: custom:button-card
            entity: {{ e }}
            show_state: true
            size: 20px
            styles:
              grid:
                - grid-template-areas: '"i n s"'
                - grid-template-columns: 28px 1fr auto
                - align-items: center
                - column-gap: 8px
              card:
                - background: rgba(0,0,0,.22)
                - border: 1px solid rgba(0, 229, 255, 0.12)
                - border-radius: 10px
                - padding: 8px 10px
                - margin-bottom: 6px
                - height: 46px
              name:
                - justify-self: start
                - text-align: left
                - font-size: 12px
                - color: "var(--text-primary-color, #DCEEF6)"
                - white-space: nowrap
                - overflow: hidden
                - text-overflow: ellipsis
              state:
                - justify-self: end
                - text-align: right
                - font-size: 12px
                - font-family: Orbitron, sans-serif
                - color: "#00E5FF"
              icon:
                - color: "var(--paper-item-icon-color, #00E5FF)"
{% if domain in ['sensor', 'binary_sensor'] %}
            tap_action:
              action: more-info
{% else %}
            tap_action:
              action: toggle
            hold_action:
              action: more-info
{% endif %}
{% endfor %}
{% endif %}

{% endfor %}
