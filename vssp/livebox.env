# ══════════════════════════════════════════════════════════════════════
#  Visio Sapiens — sonde LAN : réglages NON SECRETS
#
#  Emplacement dans le repo :  vssp/livebox.env
#  Déployé par la CI dans   :  /config/vssp/livebox.env
#
#  Ce fichier EST versionné : il ne contient aucun secret, uniquement des
#  paramètres d'infrastructure déjà présents ailleurs dans le repo
#  (.gitlab-ci.yml expose HA_HOST 192.168.1.26, STAGING_URL 192.168.1.11…).
#
#  Le mot de passe admin de la Livebox, lui, n'apparaît JAMAIS ici. Il est
#  écrit dans /config/vssp/.livebox.env par le job de déploiement, depuis
#  la variable CI/CD masquée LIVEBOX_PASSWORD — même mécanisme que
#  HA_SSH_KEY et HA_TOKEN_STAGING.
#
#  Ordre de priorité lu par vssp_lan_probe.py :
#      livebox.env  <  .livebox.env  <  variables d'environnement
# ══════════════════════════════════════════════════════════════════════

# Adresse de la Livebox sur le LAN
LIVEBOX_HOST=192.168.1.1

# Compte d'administration de la box (le mot de passe vient de la CI)
LIVEBOX_USER=admin

# "static" => le dashboard affiche le badge IP FIXE.
# Passer à "dhcp" si l'offre repasse en IP dynamique.
LIVEBOX_IP_MODE=static

# Nombre de ports du commutateur, borne le compteur "Ports actifs"
NETGEAR_PORTS=10
