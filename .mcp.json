{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ]
    },
    "visio-sapiens": {
      "type": "http",
      "url": "http://192.168.1.200:8099/mcp",
      "headers": {
        "Authorization": "Bearer ${VSSP_MCP_TOKEN}"
      }
    }
  }
}
